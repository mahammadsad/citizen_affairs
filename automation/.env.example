# Required for AI research, SEO drafting and independent fact-checking.
GEMINI_API_KEY=server-only-key
GEMINI_RESEARCH_MODEL=configured-research-model
GEMINI_WRITING_MODEL=configured-writing-model
GEMINI_FACTCHECK_MODEL=configured-factcheck-model

# Optional: enables live search-result context for SEO intent/gap research only.
# It is never treated as factual authority for an article.
TAVILY_API_KEY=

# Accepts official RSS/Atom feeds and official notice/listing pages.
# If omitted, the code defaults to PIB releases plus SSC and UPSC listing pages.
OFFICIAL_FEED_URLS=https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=1,https://ssc.gov.in/,https://www.upsc.gov.in/
DRAFT_LANGUAGES=en
MAX_DRAFTS_PER_RUN=3

# Optional future private editorial backend. Not required for GitHub-only drafts.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
AUTOMATION_WEBHOOK_SECRET=
