---
import '../styles/global.css';
import '../styles/performance.css';
import '../styles/components.css';
import '../styles/worldclass.css';
import '../styles/dark-mode.css';
import ServiceWorkerRegistration from '@components/ServiceWorkerRegistration.astro';
import { BRAND, getBrandName, getBrandTagline, SITE, SOCIALS } from '@utils/constants';
import {
  localizedFeedUrl,
  normalizeCanonicalUrl,
  SCHEMA_IDS,
  schemaLanguage,
  toAbsoluteUrl
} from '@lib/seo';
import { locales, type Locale, ui } from '../i18n';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  structuredData?: object | object[];
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  robots?: string;
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  canonical = Astro.url.href,
  ogType = 'website',
  structuredData,
  locale = 'en',
  alternateUrls = {},
  robots = 'index, follow'
} = Astro.props;

const brandName = getBrandName(locale);
const resolvedCanonical = normalizeCanonicalUrl(canonical, SITE.url);
const suppliedAlternateUrls = Object.fromEntries(
  Object.entries(alternateUrls).map(([lang, url]) => [
    lang,
    url ? normalizeCanonicalUrl(url, SITE.url) : undefined
  ])
) as Partial<Record<Locale, string>>;
const resolvedAlternateUrls = {
  ...suppliedAlternateUrls,
  [locale]: suppliedAlternateUrls[locale] || resolvedCanonical
} as Partial<Record<Locale, string>>;
const xDefaultUrl = resolvedAlternateUrls.en || resolvedCanonical;
const alternateOgLocales = locales.filter(
  (lang) => lang !== locale && Boolean(resolvedAlternateUrls[lang])
);
const resolvedTitle = title || brandName;
const fullTitle = resolvedTitle === brandName ? resolvedTitle : `${resolvedTitle} | ${brandName}`;
const ogImage = toAbsoluteUrl(image, SITE.url);
const ogImageType = ogImage.toLowerCase().endsWith('.png')
  ? 'image/png'
  : ogImage.toLowerCase().endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const ogImageAlt = `${brandName} — ${getBrandTagline(locale)}`;
const searchUrl = locale === 'en' ? `${SITE.url}/search/` : `${SITE.url}/${locale}/search/`;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': SCHEMA_IDS.website,
  name: getBrandName('en'),
  alternateName: [BRAND.brandNameBn, BRAND.brandNameHi, BRAND.brandShortName],
  url: SITE.url,
  description: SITE.description,
  inLanguage: locales.map(schemaLanguage),
  publisher: { '@id': SCHEMA_IDS.organization },
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${searchUrl}?q={search_term_string}`
    },
    'query-input': 'required name=search_term_string'
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': SCHEMA_IDS.organization,
  name: getBrandName('en'),
  alternateName: [BRAND.brandNameBn, BRAND.brandNameHi],
  url: SITE.url,
  logo: {
    '@type': 'ImageObject',
    url: toAbsoluteUrl(SITE.logo, SITE.url)
  },
  email: BRAND.contactEmail,
  description: SITE.description,
  sameAs: [SOCIALS.telegram, SOCIALS.whatsapp],
  publishingPrinciples: `${SITE.url}/en/editorial-policy/`,
  ethicsPolicy: `${SITE.url}/en/editorial-policy/`,
  correctionsPolicy: `${SITE.url}/corrections/`
};

const extraSchemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
const ogLocale = locale === 'bn' ? 'bn_IN' : locale === 'hi' ? 'hi_IN' : 'en_IN';
const ogLocaleFor = (lang: Locale) => lang === 'bn' ? 'bn_IN' : lang === 'hi' ? 'hi_IN' : 'en_IN';
const publicSupabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseOrigin = (() => {
  if (!publicSupabaseUrl) return '';
  try {
    const url = new URL(publicSupabaseUrl);
    return url.protocol === 'https:' ? url.origin : '';
  } catch {
    return '';
  }
})();
const contentSecurityPolicy = `default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'${supabaseOrigin ? ` ${supabaseOrigin}` : ''}; form-action 'self' mailto:; upgrade-insecure-requests`;
const t = ui(locale);
---
<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
        } catch (_) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content={robots} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="x-build-commit" content={import.meta.env.PUBLIC_BUILD_COMMIT || 'local'} />
    <link rel="canonical" href={resolvedCanonical} />
    {locales.map((lang) => resolvedAlternateUrls[lang] && <link rel="alternate" hreflang={lang} href={resolvedAlternateUrls[lang]} />)}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
    <link rel="manifest" href={`${SITE.basePath}site.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title={`${brandName} RSS`} href={localizedFeedUrl(locale)} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${SITE.basePath}assets/favicon-32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${SITE.basePath}assets/favicon-192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${SITE.basePath}assets/favicon-180.png`} />
    <meta name="theme-color" content="#0A817A" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:locale" content={ogLocale} />
    {alternateOgLocales.map((lang) => <meta property="og:locale:alternate" content={ogLocaleFor(lang)} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {extraSchemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body id="top">
    <a href="#page-content" class="skip-link">{t.skipToContent}</a>
    <span id="page-content" class="sr-only" tabindex="-1"></span>
    <slot />
    <ServiceWorkerRegistration {locale} />
  </body>
</html>
