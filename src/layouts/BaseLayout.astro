---
import '../styles/global.css';
import '../styles/components.css';
import { SITE } from '@utils/constants';
import { toAbsoluteUrl } from '@lib/seo';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.name,
  description = SITE.description,
  image = SITE.ogImage,
  // Default to *this page's own* URL, not the homepage. Every page that doesn't
  // explicitly override this (e.g. an article syndicated elsewhere) gets a
  // correct, unique canonical automatically.
  canonical = Astro.url.href,
  ogType = 'website',
  structuredData,
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const siteUrl = SITE.url;
const ogImage = toAbsoluteUrl(image, siteUrl);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: siteUrl,
  description: SITE.description,
  inLanguage: SITE.language,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: siteUrl,
  logo: toAbsoluteUrl(SITE.logo, siteUrl),
  description: SITE.description,
};

const extraSchemas = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!DOCTYPE html>
<html lang={SITE.language} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <!--
      Blocking, runs before first paint: reads the saved theme (or system
      preference) and sets it on <html> immediately. Without this, the page
      always paints as data-theme="light" first and only corrects itself
      after Header.astro's script loads — a visible flash for anyone who
      has dark mode saved. is:inline keeps Astro from bundling/deferring it.
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          // localStorage can throw in some privacy modes — fall back to light silently.
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS Feed`} href={`${SITE.basePath}rss.xml`} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/sarkari-tathya-kendra/assets/logo-mark.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/sarkari-tathya-kendra/assets/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/sarkari-tathya-kendra/assets/favicon-180.png" />
    <meta name="theme-color" content="#0A4D8C" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Noto+Serif+Bengali:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <a href="#main-content" class="skip-link">মূল কনটেন্টে যান</a>
    <slot />
  </body>
</html>
