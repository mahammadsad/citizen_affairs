---
import BaseLayout from './BaseLayout.astro';
import PortalHeader from '@components/PortalHeader.astro';
import PortalRuntime from '@components/PortalRuntime.astro';
import MobileNavigationRuntime from '@components/MobileNavigationRuntime.astro';
import Footer from '@components/Footer.astro';
import '../styles/portal-renovation.css';
import '../styles/content-first-mobile.css';
import '../styles/typography.css';
import type { Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  ogType?: 'website' | 'article';
  structuredData?: object | object[];
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  robots?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  canonical,
  ogType,
  structuredData,
  locale = 'en',
  alternateUrls,
  robots,
} = Astro.props;

const routeSegments = Astro.url.pathname.split('/').filter(Boolean);
const articleSegmentIndex = routeSegments.indexOf('articles');
const isArticleDetailPage =
  articleSegmentIndex >= 0 && routeSegments.length > articleSegmentIndex + 1;
const bodyClass = isArticleDetailPage ? 'article-reading-mode' : undefined;
---

<BaseLayout
  {title}
  {description}
  {image}
  {imageAlt}
  {imageWidth}
  {imageHeight}
  {canonical}
  {ogType}
  {structuredData}
  {locale}
  {alternateUrls}
  {robots}
  {bodyClass}
>
  <PortalHeader {locale} {alternateUrls} />
  <PortalRuntime />
  <MobileNavigationRuntime />
  <main id="main-content" tabindex="-1">
    <slot />
  </main>
  <Footer {locale} />
</BaseLayout>

<style>
  main { min-height: calc(100vh - 360px); }

  :global(.news-home .top-news) {
    padding: clamp(1rem, 2.6vw, 1.8rem) 0 clamp(1.7rem, 3.5vw, 2.8rem) !important;
  }

  :global(.news-home .lead-story) {
    border-top: 0 !important;
  }

  :global(.news-home .lead-story.has-image) {
    border-top: 1px solid var(--color-border) !important;
  }

  :global(.news-home .news-section-list) {
    gap: clamp(1.7rem, 4vw, 3rem) !important;
  }

  :global(.news-home .news-section-block) {
    padding-top: .7rem !important;
  }

  :global(.news-home .news-section-block > header) {
    margin-bottom: .75rem !important;
  }

  /* Jobs should identify the page before asking readers to operate controls. */
  :global(.jobs-listing) {
    display: flex !important;
    flex-direction: column;
  }

  :global(.jobs-result-line) {
    order: -3;
    padding: 1rem !important;
    border-top: 0 !important;
    background: transparent !important;
  }

  :global(.jobs-controls) { order: -2; }
  :global(.jobs-stage-tabs) { order: -1; }

  /* Horizontal controls should advertise that more options exist. */
  :global(.jobs-stage-tabs),
  :global(.category-filters),
  :global(.article-actions) {
    scrollbar-width: thin !important;
    scrollbar-color: var(--color-border) transparent !important;
  }

  :global(.jobs-stage-tabs::-webkit-scrollbar),
  :global(.category-filters::-webkit-scrollbar),
  :global(.article-actions::-webkit-scrollbar) {
    display: block !important;
    height: 3px !important;
  }

  :global(.jobs-stage-tabs::-webkit-scrollbar-thumb),
  :global(.category-filters::-webkit-scrollbar-thumb),
  :global(.article-actions::-webkit-scrollbar-thumb) {
    border-radius: 999px;
    background: var(--color-border);
  }

  /* Search should feel like search first, filtering second. */
  :global(.citizen-search.section) {
    padding-top: 1.5rem !important;
  }

  :global(.citizen-search .verification-note) {
    display: none !important;
  }

  :global(.citizen-search .control-actions .btn-secondary) {
    border-color: transparent !important;
    background: transparent !important;
    box-shadow: none !important;
  }

  /* Articles: establish trust once, then let the story breathe. */
  :global(body.article-reading-mode .article-labels > span),
  :global(body.article-reading-mode .reading-time),
  :global(body.article-reading-mode #copyLink) {
    display: none !important;
  }

  :global(body.article-reading-mode .verification-strip) {
    align-items: center !important;
    margin-top: .9rem !important;
    padding: .65rem 0 !important;
    border: 0 !important;
    border-top: 1px solid var(--color-border) !important;
    border-bottom: 1px solid var(--color-border) !important;
    border-radius: 0 !important;
    background: transparent !important;
  }

  :global(body.article-reading-mode .verification-state) {
    gap: .5rem !important;
  }

  :global(body.article-reading-mode .verification-state > svg) {
    width: 18px !important;
    height: 18px !important;
    color: var(--color-green-text);
  }

  :global(body.article-reading-mode .verification-state small) {
    display: none !important;
  }

  :global(body.article-reading-mode .verification-strip dl) {
    gap: 0 !important;
  }

  :global(body.article-reading-mode .verification-strip dl div) {
    min-width: 0 !important;
    padding: .15rem .7rem !important;
    border-left: 1px solid var(--color-border);
    border-radius: 0 !important;
    background: transparent !important;
  }

  :global(body.article-reading-mode .verification-strip dt) {
    font-size: .7rem !important;
  }

  :global(body.article-reading-mode .verification-strip dd) {
    font-size: .78rem !important;
    font-weight: 650 !important;
  }

  @media (max-width: 700px) {
    /* Give the mobile jobs filter panel a real bottom-sheet separation. */
    :global(.jobs-filter-details[open]::before) {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 35;
      background: rgba(7, 30, 52, .42);
      backdrop-filter: blur(1.5px);
    }

    :global(body .jobs-filter-panel) {
      z-index: 40 !important;
      bottom: calc(env(safe-area-inset-bottom) + .75rem) !important;
      max-height: calc(100dvh - env(safe-area-inset-bottom) - 1.5rem) !important;
      border-radius: 16px !important;
      border-color: rgba(7, 30, 52, .18) !important;
      box-shadow: 0 18px 48px rgba(7, 30, 52, .24) !important;
    }

    :global(body .jobs-filter-panel::before) {
      content: '';
      display: block;
      grid-column: 1 / -1;
      width: 38px;
      height: 4px;
      margin: -.15rem auto .15rem;
      border-radius: 999px;
      background: var(--color-border);
    }
  }

  @media (max-width: 680px) {
    :global(body) {
      padding-bottom: env(safe-area-inset-bottom) !important;
    }

    :global(body.article-reading-mode) {
      padding-bottom: max(18px, env(safe-area-inset-bottom)) !important;
    }

    :global(body.article-reading-mode .verification-strip) {
      gap: .55rem !important;
    }

    :global(body.article-reading-mode .verification-strip dl) {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    :global(body.article-reading-mode .verification-strip dl div) {
      padding: .3rem .55rem !important;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }

    :global(.news-home .top-news) {
      padding-top: .55rem !important;
    }

    :global(.news-home .section-title-row) {
      margin-bottom: .55rem !important;
      padding-bottom: .4rem !important;
    }
  }
</style>
