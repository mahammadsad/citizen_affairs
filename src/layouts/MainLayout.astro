---
import BaseLayout from './BaseLayout.astro';
import PortalHeader from '@components/PortalHeader.astro';
import PortalRuntime from '@components/PortalRuntime.astro';
import Footer from '@components/Footer.astro';
import '../styles/portal-renovation.css';
import type { Locale } from '../i18n';
interface Props { title?: string; description?: string; image?: string; canonical?: string; ogType?: 'website'|'article'; structuredData?: object|object[]; locale?: Locale; alternateUrls?: Partial<Record<Locale,string>>; robots?: string; }
const { title, description, image, canonical, ogType, structuredData, locale = 'en', alternateUrls, robots } = Astro.props;
---
<BaseLayout {title} {description} {image} {canonical} {ogType} {structuredData} {locale} {alternateUrls} {robots}>
  <PortalHeader {locale} {alternateUrls} />
  <PortalRuntime />
  <main id="main-content"><slot /></main>
  <Footer {locale} />
</BaseLayout>
<style>main{min-height:calc(100vh - 420px)}</style>
