---
import BaseLayout from './BaseLayout.astro';
import PortalHeader from '@components/PortalHeader.astro';
import PortalRuntime from '@components/PortalRuntime.astro';
import Footer from '@components/Footer.astro';
import '../styles/portal-renovation.css';
import type { Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  structuredData?: object | object[];
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  robots?: string;
}

const {
  title,
  description,
  image,
  canonical,
  ogType,
  structuredData,
  locale = 'en',
  alternateUrls,
  robots
} = Astro.props;
---

<BaseLayout {title} {description} {image} {canonical} {ogType} {structuredData} {locale} {alternateUrls} {robots}>
  <PortalHeader {locale} {alternateUrls} />
  <PortalRuntime />
  <main id="main-content">
    <slot />
  </main>
  <Footer {locale} />
</BaseLayout>

<style>
  main { min-height: calc(100vh - 420px); }

  :global(.portal-utility) {
    display: none !important;
  }

  :global(.portal-navbar-inner) {
    min-height: 74px;
  }

  :global(.portal-brand) {
    flex: 0 0 clamp(158px, 18vw, 184px);
    min-width: 158px;
    overflow: visible;
  }

  :global(.portal-brand-logo) {
    width: clamp(158px, 18vw, 184px) !important;
    max-width: none !important;
    max-height: 56px !important;
  }

  @media (max-width: 680px) {
    :global(.portal-navbar-inner) {
      min-height: 68px;
      gap: .45rem;
    }

    :global(.portal-brand) {
      flex: 0 1 clamp(136px, 42vw, 154px);
      min-width: 136px;
    }

    :global(.portal-brand-logo) {
      width: clamp(136px, 42vw, 154px) !important;
      max-height: 50px !important;
    }

    :global(.portal-mobile-panel) {
      top: 68px !important;
      max-height: calc(100vh - 88px) !important;
    }
  }
</style>
