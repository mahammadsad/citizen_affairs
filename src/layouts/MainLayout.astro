---
import BaseLayout from './BaseLayout.astro';
import PortalHeader from '@components/PortalHeader.astro';
import PortalRuntime from '@components/PortalRuntime.astro';
import MobileNavigationRuntime from '@components/MobileNavigationRuntime.astro';
import MobileBottomNavigationRuntime from '@components/MobileBottomNavigationRuntime.astro';
import FormSubmissionRuntime from '@components/FormSubmissionRuntime.astro';
import Footer from '@components/Footer.astro';
import '../styles/portal-renovation.css';
import '../styles/content-first-mobile.css';
import '../styles/typography.css';
import type { Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  structuredData?: object | object[];
  locale?: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  robots?: string;
}

const {
  title,
  description,
  image,
  canonical,
  ogType,
  structuredData,
  locale = 'en',
  alternateUrls,
  robots,
} = Astro.props;

const routeSegments = Astro.url.pathname.split('/').filter(Boolean);
const articleSegmentIndex = routeSegments.indexOf('articles');
const isArticleDetailPage =
  articleSegmentIndex >= 0 && routeSegments.length > articleSegmentIndex + 1;
const bodyClass = isArticleDetailPage ? 'article-reading-mode' : undefined;
---

<BaseLayout
  {title}
  {description}
  {image}
  {canonical}
  {ogType}
  {structuredData}
  {locale}
  {alternateUrls}
  {robots}
  {bodyClass}
>
  <PortalHeader {locale} {alternateUrls} />
  <PortalRuntime />
  <MobileNavigationRuntime />
  <MobileBottomNavigationRuntime />
  <main id="main-content">
    <slot />
  </main>
  <FormSubmissionRuntime />
  <Footer {locale} />
</BaseLayout>

<style>
  main { min-height: calc(100vh - 420px); }

  :global(.portal-utility) {
    display: none !important;
  }

  :global(.portal-navbar-inner) {
    min-height: 82px !important;
    gap: .5rem !important;
  }

  :global(.portal-brand) {
    --portal-logo-width: clamp(196px, 20vw, 224px);
    display: flex !important;
    align-items: center;
    justify-content: flex-start;
    flex: 0 0 var(--portal-logo-width) !important;
    min-width: 196px !important;
    max-width: 224px !important;
    overflow: hidden !important;
    border-radius: 10px;
    background: transparent;
    line-height: 0;
    transition: background-color 160ms ease, box-shadow 160ms ease;
  }

  :global(.portal-brand-logo) {
    width: var(--portal-logo-width) !important;
    max-width: none !important;
    max-height: 82px !important;
    height: auto !important;
    object-fit: contain !important;
    object-position: left center !important;
    opacity: 1 !important;
    filter: none !important;
    mix-blend-mode: normal !important;
    /* Trim only the PNG's safe transparent gutter. A larger offset clips the C. */
    transform: translateX(-.3rem);
    transform-origin: left center;
  }

  /* The approved artwork uses navy lettering. Keep the exact logo colours and
     provide a restrained white isolation surface when the header is dark. */
  :global(html[data-theme='dark'] .portal-header .portal-brand) {
    background: #ffffff !important;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .16), 0 5px 16px rgba(0, 0, 0, .22);
  }

  :global(.portal-header-actions) {
    flex: 0 0 auto !important;
    min-width: max-content;
  }

  :global(.news-home .top-news) {
    padding: clamp(1rem, 2.6vw, 1.8rem) 0 clamp(1.7rem, 3.5vw, 2.8rem) !important;
  }

  :global(.news-home .news-section-list) {
    gap: clamp(1.7rem, 4vw, 3rem) !important;
  }

  :global(.news-home .news-section-block) {
    padding-top: .7rem !important;
  }

  :global(.news-home .news-section-block > header) {
    margin-bottom: .75rem !important;
  }

  :global(body.article-reading-mode .category-nav-shell),
  :global(body.article-reading-mode .portal-mobile-bottom) {
    display: none !important;
  }

  @media (max-width: 680px) {
    :global(body.article-reading-mode) {
      padding-bottom: max(18px, env(safe-area-inset-bottom)) !important;
    }

    :global(.portal-navbar-inner) {
      min-height: 74px !important;
      padding-inline: .75rem !important;
      gap: .25rem !important;
    }

    :global(.portal-brand) {
      --portal-logo-width: clamp(168px, calc(100vw - 176px), 204px);
      flex: 0 1 var(--portal-logo-width) !important;
      min-width: 168px !important;
      max-width: 204px !important;
    }

    :global(.portal-brand-logo) {
      width: var(--portal-logo-width) !important;
      max-width: none !important;
      max-height: 72px !important;
    }

    :global(.portal-language > summary) {
      min-width: 54px !important;
      padding-inline: .42rem !important;
    }

    :global(.portal-mobile-panel) {
      top: 74px !important;
      max-height: calc(100vh - 94px) !important;
    }

    :global(.news-home .top-news) {
      padding-top: .7rem !important;
    }

    :global(.news-home .section-title-row) {
      margin-bottom: .65rem !important;
      padding-bottom: .45rem !important;
    }
  }

  @media (max-width: 350px) {
    :global(.portal-theme-toggle) {
      display: none !important;
    }

    :global(.portal-brand) {
      --portal-logo-width: clamp(160px, calc(100vw - 142px), 178px);
      min-width: 160px !important;
      max-width: 178px !important;
    }

    :global(.portal-brand-logo) {
      width: var(--portal-logo-width) !important;
    }
  }
</style>
