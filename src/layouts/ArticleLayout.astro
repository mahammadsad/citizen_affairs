---
import MainLayout from './MainLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import Icon from '@components/Icon.astro';
import { generateBreadcrumbs, toAbsoluteUrl } from '@lib/seo';
import { getCategoryData, getAuthorData, categoryName } from '@lib/content';
import { BRAND, getBrandName, resolveAssetPath, SITE } from '@utils/constants';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n';
import { authorProfilePath, dateLocale, localizedPath, trustPagePath, ui, verificationLabels } from '../i18n';

export interface Props {
  locale: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
  contentType: 'job' | 'scheme' | 'explainer';
  title: string;
  description: string;
  author: string;
  assignedEditor?: string;
  factCheckedBy?: string;
  reviewedBy?: string;
  publishedBy?: string;
  date: Date;
  updated?: Date;
  lastVerified?: Date;
  deadline?: Date;
  category: string;
  tags?: string[];
  canonical?: string;
  featuredImage?: string;
  featuredImageAvif?: string;
  featuredImageSrcSet?: string;
  featuredImageAvifSrcSet?: string;
  featuredImageWidth?: number;
  featuredImageHeight?: number;
  featuredImageAlt?: string;
  seoTitle?: string;
  seoDescription?: string;
  verificationStatus: 'officially-confirmed' | 'partially-confirmed' | 'under-verification' | 'corrected' | 'withdrawn' | 'closed';
  sourceUrls?: string[];
  sources?: Array<{
    title: string;
    url: string;
    publishingAuthority: string;
    designation: 'primary' | 'secondary';
    documentNumber?: string;
    publicationDate?: Date;
    accessedDate: Date;
    notes?: string;
  }>;
  officialNoticeUrl?: string;
  applicationUrl?: string;
  urlSlug: string;
  quickSummary?: string[];
  importantDates?: string[];
  qualification?: string[];
  requiredDocuments?: string[];
  updateHistory?: string[];
  amountOrVacancies?: string;
  faqs?: Array<{ question: string; answer: string }>;
  related?: CollectionEntry<'articles'>[];
}

const p = Astro.props;
const {
  locale,
  alternateUrls,
  contentType,
  title,
  description,
  author,
  assignedEditor,
  factCheckedBy,
  reviewedBy,
  publishedBy,
  date,
  updated,
  lastVerified,
  deadline,
  category,
  tags = [],
  canonical,
  featuredImage,
  featuredImageAvif,
  featuredImageSrcSet,
  featuredImageAvifSrcSet,
  featuredImageWidth = 1200,
  featuredImageHeight = 675,
  featuredImageAlt,
  seoTitle,
  seoDescription,
  verificationStatus,
  sourceUrls = [],
  sources = [],
  officialNoticeUrl,
  applicationUrl,
  urlSlug,
  quickSummary = [],
  importantDates = [],
  qualification = [],
  requiredDocuments = [],
  updateHistory = [],
  amountOrVacancies,
  faqs = [],
  related = [],
} = p;

const resolveSrcSet = (value?: string) =>
  value
    ?.split(',')
    .map((entry) => {
      const [url, width] = entry.trim().split(/\s+/);
      return `${resolveAssetPath(url)} ${width}`;
    })
    .join(', ');

const t = ui(locale);
const categoryEntry = await getCategoryData(category);
const categoryLabel = categoryEntry ? categoryName(categoryEntry, locale) : category;
const normalizedAuthor = author.trim();
const showHumanCredits = normalizedAuthor.length > 0 && normalizedAuthor !== 'mahammad-sad';
const authorEntry = showHumanCredits ? await getAuthorData(normalizedAuthor) : undefined;
const authorName = showHumanCredits ? (authorEntry?.data.name ?? normalizedAuthor) : undefined;
const resolveStaffName = async (slug?: string) => (slug ? (await getAuthorData(slug))?.data.name ?? slug : undefined);
const editorName = showHumanCredits ? await resolveStaffName(assignedEditor) : undefined;
const factCheckerName = showHumanCredits ? await resolveStaffName(factCheckedBy) : undefined;
const reviewerName = showHumanCredits ? await resolveStaffName(reviewedBy) : undefined;
const publisherName = showHumanCredits ? await resolveStaffName(publishedBy) : undefined;
const pageUrl = canonical || Astro.url.href;
const formatter = new Intl.DateTimeFormat(dateLocale(locale), { year: 'numeric', month: 'long', day: 'numeric' });
const resolvedFeaturedImage = featuredImage ? resolveAssetPath(featuredImage) : undefined;
const resolvedFeaturedImageAvif = featuredImageAvif ? resolveAssetPath(featuredImageAvif) : undefined;
const resolvedFeaturedImageSrcSet = resolveSrcSet(featuredImageSrcSet);
const resolvedFeaturedImageAvifSrcSet = resolveSrcSet(featuredImageAvifSrcSet);
const ogImage = resolvedFeaturedImage ? toAbsoluteUrl(resolvedFeaturedImage, SITE.url) : undefined;
const brandName = getBrandName(locale);

const articleCopy = {
  en: {
    minutesRead: 'min read',
    onThisPage: 'On this page',
    verifiedInformation: 'Verification',
    officialActions: 'Official actions',
    officialNotice: 'Open official notice',
    officialApplication: 'Open official application',
    primary: 'Primary',
    secondary: 'Secondary',
    accessed: 'Accessed',
    sourceNotes: 'Source note',
    topics: 'Topics',
    shareStory: 'Share this guide',
    sourcesIntro: 'Use the original authority or document to verify important details before you act.',
    transparency: 'Transparency & updates',
    related: 'Continue reading',
  },
  bn: {
    minutesRead: 'মিনিট পড়া',
    onThisPage: 'এই পাতায়',
    verifiedInformation: 'যাচাই তথ্য',
    officialActions: 'অফিসিয়াল লিংক',
    officialNotice: 'অফিসিয়াল নোটিশ খুলুন',
    officialApplication: 'অফিসিয়াল আবেদন খুলুন',
    primary: 'প্রাথমিক সূত্র',
    secondary: 'সহায়ক সূত্র',
    accessed: 'যাচাই করা হয়েছে',
    sourceNotes: 'সূত্র নোট',
    topics: 'বিষয়',
    shareStory: 'গাইডটি শেয়ার করুন',
    sourcesIntro: 'কোনও পদক্ষেপ নেওয়ার আগে গুরুত্বপূর্ণ তথ্য মূল কর্তৃপক্ষ বা নথি থেকে যাচাই করুন।',
    transparency: 'স্বচ্ছতা ও আপডেট',
    related: 'আরও পড়ুন',
  },
  hi: {
    minutesRead: 'मिनट पढ़ने का समय',
    onThisPage: 'इस पेज पर',
    verifiedInformation: 'सत्यापन',
    officialActions: 'आधिकारिक लिंक',
    officialNotice: 'आधिकारिक सूचना खोलें',
    officialApplication: 'आधिकारिक आवेदन खोलें',
    primary: 'प्राथमिक स्रोत',
    secondary: 'सहायक स्रोत',
    accessed: 'जाँचा गया',
    sourceNotes: 'स्रोत नोट',
    topics: 'विषय',
    shareStory: 'गाइड साझा करें',
    sourcesIntro: 'कोई कदम उठाने से पहले महत्वपूर्ण जानकारी मूल प्राधिकरण या दस्तावेज़ से जाँचें।',
    transparency: 'पारदर्शिता और अपडेट',
    related: 'आगे पढ़ें',
  },
}[locale];

const reportCopy = {
  en: {
    title: 'Report outdated or incorrect information',
    intro: 'Tell the editorial team exactly what needs review. An official supporting source helps us respond faster.',
    issue: 'Reported issue',
    source: 'Supporting official source',
    contact: 'Your email (optional)',
    consent: 'I consent to this information being used to review my report.',
    send: 'Prepare email report',
  },
  bn: {
    title: 'পুরোনো বা ভুল তথ্য জানান',
    intro: 'কোন তথ্যটি পর্যালোচনা করা দরকার তা স্পষ্টভাবে লিখুন। অফিসিয়াল সমর্থনকারী সূত্র দিলে দ্রুত যাচাই করা যায়।',
    issue: 'সমস্যার বিবরণ',
    source: 'সমর্থনকারী অফিসিয়াল সূত্র',
    contact: 'আপনার ইমেইল (ঐচ্ছিক)',
    consent: 'আমার প্রতিবেদন যাচাইয়ের জন্য এই তথ্য ব্যবহারে আমি সম্মত।',
    send: 'ইমেইল প্রতিবেদন তৈরি করুন',
  },
  hi: {
    title: 'पुरानी या गलत जानकारी की सूचना दें',
    intro: 'संपादकीय टीम को स्पष्ट बताएँ कि किस जानकारी की समीक्षा चाहिए। आधिकारिक समर्थक स्रोत से जाँच तेज होती है।',
    issue: 'समस्या का विवरण',
    source: 'समर्थक आधिकारिक स्रोत',
    contact: 'आपका ईमेल (वैकल्पिक)',
    consent: 'मैं अपनी रिपोर्ट की समीक्षा के लिए इस जानकारी के उपयोग पर सहमत हूँ।',
    send: 'ईमेल रिपोर्ट तैयार करें',
  },
}[locale];

const knownSourceUrls = new Set(sources.map((source) => source.url));
const fallbackSourceUrls = sourceUrls.filter((url) => !knownSourceUrls.has(url) && url !== officialNoticeUrl);
const officialNoticeIsUnique = Boolean(officialNoticeUrl && !knownSourceUrls.has(officialNoticeUrl));
const sourceCount = sources.length + fallbackSourceUrls.length + (officialNoticeIsUnique ? 1 : 0);
const hasFactPanels = importantDates.length > 0 || qualification.length > 0 || Boolean(amountOrVacancies) || requiredDocuments.length > 0;
const hasOfficialActions = Boolean(officialNoticeUrl || applicationUrl);

const breadcrumbSchema = generateBreadcrumbs([
  { name: t.home, url: locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/` },
  { name: t.articles, url: `${SITE.url}/${locale}/articles/` },
  { name: categoryLabel, url: `${SITE.url}/${locale}/categories/${category}/` },
  { name: title },
]);

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : undefined;

const schemas = faqSchema ? [breadcrumbSchema, faqSchema] : [breadcrumbSchema];
---

<MainLayout
  title={seoTitle || title}
  description={seoDescription || description}
  canonical={pageUrl}
  ogType="article"
  image={ogImage}
  structuredData={schemas}
  {locale}
  {alternateUrls}
>
  <div class="reading-progress" aria-hidden="true"><span id="readingProgressBar"></span></div>

  <article
    class="article-shell"
    data-article
    data-id={`${locale}:${urlSlug}`}
    data-url={pageUrl}
    data-title={title}
    data-description={description}
    data-reading-wpm={locale === 'en' ? '220' : '180'}
  >
    <div class="container article-container">
      <nav class="breadcrumbs" aria-label={t.breadcrumb}>
        <a href={localizedPath(locale)}>{t.home}</a><span>›</span>
        <a href={localizedPath(locale, 'articles')}>{t.articles}</a><span>›</span>
        <a href={localizedPath(locale, `categories/${category}`)}>{categoryLabel}</a>
      </nav>

      <header class="article-header">
        <div class="article-labels">
          <a href={localizedPath(locale, `categories/${category}`)}>{categoryLabel}</a>
          <span class={`status-${verificationStatus}`}>● {verificationLabels[locale][verificationStatus]}</span>
        </div>

        <h1>{title}</h1>
        <p class="article-deck">{description}</p>

        <div class="article-meta-row">
          <div class="article-byline">
            {showHumanCredits && authorName && (
              <a class="author-credit" href={authorProfilePath(locale, normalizedAuthor)}>{t.writtenBy}: {authorName}</a>
            )}
            <span>{t.published}: {formatter.format(date)}</span>
            {updated && <span>{t.updated}: {formatter.format(updated)}</span>}
            <span class="reading-time"><Icon name="clock" size={16} /><span id="readingTime">— {articleCopy.minutesRead}</span></span>
          </div>
          {(editorName || factCheckerName || reviewerName || publisherName) && (
            <details class="editorial-credits">
              <summary>{articleCopy.transparency}</summary>
              <div>
                {editorName && <span>{t.editedBy}: {editorName}</span>}
                {factCheckerName && <span>{t.factCheckedBy}: {factCheckerName}</span>}
                {reviewerName && <span>{t.reviewedBy}: {reviewerName}</span>}
                {publisherName && <span>{t.publishedBy}: {publisherName}</span>}
              </div>
            </details>
          )}
        </div>
      </header>

      {resolvedFeaturedImage && (
        <picture class="article-hero-picture">
          {resolvedFeaturedImageAvif && (
            <source
              srcset={resolvedFeaturedImageAvifSrcSet || resolvedFeaturedImageAvif}
              sizes="(max-width: 900px) calc(100vw - 2rem), 920px"
              type="image/avif"
            />
          )}
          <img
            src={resolvedFeaturedImage}
            srcset={resolvedFeaturedImageSrcSet}
            sizes="(max-width: 900px) calc(100vw - 2rem), 920px"
            alt={featuredImageAlt || title}
            class="article-hero-image"
            width={featuredImageWidth}
            height={featuredImageHeight}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      )}

      <aside class={`verification-strip status-${verificationStatus}`} aria-label={articleCopy.verifiedInformation}>
        <div class="verification-state">
          <Icon name="check" />
          <span><strong>{verificationLabels[locale][verificationStatus]}</strong><small>{t.primarySource}</small></span>
        </div>
        <dl>
          {lastVerified && <div><dt>{t.lastVerified}</dt><dd>{formatter.format(lastVerified)}</dd></div>}
          {deadline && <div><dt>{t.deadline}</dt><dd>{formatter.format(deadline)}</dd></div>}
          <div><dt>{t.source}</dt><dd>{sourceCount}</dd></div>
        </dl>
      </aside>

      <div class="article-actions" aria-label={t.share}>
        <button id="saveArticle" data-save-label={t.save} data-saved-label={t.savedLabel} aria-pressed="false">
          <Icon name="bookmark" /><span aria-live="polite">{t.save}</span>
        </button>
        <button id="nativeShare"><Icon name="share" /><span>{t.share}</span></button>
        <a data-share="whatsapp" href="#">WhatsApp</a>
        <a data-share="telegram" href="#">Telegram</a>
        <a data-share="facebook" href="#">Facebook</a>
        <button id="copyLink" data-copy-label={t.copyLink} data-copied-label={t.copied}>
          <Icon name="copy" /><span aria-live="polite">{t.copyLink}</span>
        </button>
      </div>

      {quickSummary.length > 0 && (
        <section class="key-takeaways" aria-labelledby="key-takeaways-title">
          <div class="panel-kicker">{categoryLabel}</div>
          <h2 id="key-takeaways-title">{t.quickSummary}</h2>
          <ul>{quickSummary.map((item) => <li>{item}</li>)}</ul>
        </section>
      )}

      {hasFactPanels && (
        <div class="fact-grid">
          {importantDates.length > 0 && (
            <section class="info-panel"><h2>{t.importantDates}</h2><ul>{importantDates.map((item) => <li>{item}</li>)}</ul></section>
          )}
          {qualification.length > 0 && (
            <section class="info-panel"><h2>{t.eligibility}</h2><ul>{qualification.map((item) => <li>{item}</li>)}</ul></section>
          )}
          {amountOrVacancies && (
            <section class="info-panel"><h2>{t.amount}</h2><p>{amountOrVacancies}</p></section>
          )}
          {requiredDocuments.length > 0 && (
            <section class="info-panel"><h2>{t.requiredDocuments}</h2><ul>{requiredDocuments.map((item) => <li>{item}</li>)}</ul></section>
          )}
        </div>
      )}

      <div class="reading-grid">
        <div class="reading-column">
          <div class="article-content"><slot /></div>
        </div>

        <aside class="article-rail" aria-label={articleCopy.onThisPage}>
          <nav class="toc-card" id="articleToc" hidden>
            <strong>{articleCopy.onThisPage}</strong>
            <ol id="articleTocList"></ol>
          </nav>

          <section class="rail-card">
            <strong>{articleCopy.verifiedInformation}</strong>
            <dl>
              <div><dt>{verificationLabels[locale][verificationStatus]}</dt><dd>{lastVerified ? formatter.format(lastVerified) : formatter.format(updated || date)}</dd></div>
              <div><dt>{t.source}</dt><dd>{sourceCount}</dd></div>
            </dl>
            <a class="rail-trust-link" href={localizedPath(locale, 'editorial-policy')}>{t.editorial} →</a>
          </section>

          {hasOfficialActions && (
            <section class="rail-card official-actions-card">
              <strong>{articleCopy.officialActions}</strong>
              {officialNoticeUrl && <a href={officialNoticeUrl} target="_blank" rel="noopener noreferrer">{articleCopy.officialNotice} ↗</a>}
              {applicationUrl && <a href={applicationUrl} target="_blank" rel="noopener noreferrer">{articleCopy.officialApplication} ↗</a>}
            </section>
          )}
        </aside>
      </div>

      {(officialNoticeUrl || applicationUrl || sources.length > 0 || fallbackSourceUrls.length > 0) && (
        <section class="source-panel" aria-labelledby="official-sources-title">
          <div class="section-heading-row">
            <div>
              <div class="panel-kicker">{articleCopy.verifiedInformation}</div>
              <h2 id="official-sources-title">{t.officialLinks}</h2>
            </div>
            <span class="source-count">{sourceCount} {t.source}</span>
          </div>
          <p>{articleCopy.sourcesIntro}</p>

          {hasOfficialActions && (
            <div class="source-actions">
              {officialNoticeUrl && <a class="btn btn-secondary" href={officialNoticeUrl} target="_blank" rel="noopener noreferrer">{articleCopy.officialNotice} ↗</a>}
              {applicationUrl && <a class="btn btn-primary" href={applicationUrl} target="_blank" rel="noopener noreferrer">{articleCopy.officialApplication} ↗</a>}
            </div>
          )}

          {sources.length > 0 && (
            <ol class="structured-sources">
              {sources.map((source) => (
                <li>
                  <div class="source-line">
                    <span class={`source-designation source-${source.designation}`}>{source.designation === 'primary' ? articleCopy.primary : articleCopy.secondary}</span>
                    <a href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.title}</strong></a>
                  </div>
                  <div class="source-meta">
                    <span>{source.publishingAuthority}</span>
                    {source.documentNumber && <span>{source.documentNumber}</span>}
                    {source.publicationDate && <span>{t.published}: {formatter.format(source.publicationDate)}</span>}
                    <span>{articleCopy.accessed}: {formatter.format(source.accessedDate)}</span>
                  </div>
                  {source.notes && <p class="source-note"><strong>{articleCopy.sourceNotes}:</strong> {source.notes}</p>}
                </li>
              ))}
            </ol>
          )}

          {fallbackSourceUrls.length > 0 && (
            <ol class="structured-sources additional-source-cards" start={sources.length + 1}>
              {fallbackSourceUrls.map((url) => (
                <li>
                  <div class="source-line">
                    <span class="source-designation source-secondary">{t.sourceItem}</span>
                    <a href={url} target="_blank" rel="noopener noreferrer"><strong>{new URL(url).hostname.replace(/^www\./, '')}</strong></a>
                  </div>
                  <div class="source-meta">
                    <span>{url}</span>
                  </div>
                </li>
              ))}
            </ol>
          )}
        </section>
      )}

      {updateHistory.length > 0 && (
        <section class="update-panel">
          <div class="panel-kicker">{articleCopy.transparency}</div>
          <h2>{t.updateHistory}</h2>
          <ol>{updateHistory.map((item) => <li>{item}</li>)}</ol>
        </section>
      )}

      {faqs.length > 0 && (
        <section class="faq-section">
          <h2>{t.faq}</h2>
          {faqs.map((f) => <details><summary>{f.question}</summary><p>{f.answer}</p></details>)}
        </section>
      )}

      <section class="article-endcap">
        {tags.length > 0 && (
          <div class="article-topics">
            <strong>{articleCopy.topics}</strong>
            <div class="article-tags">
              {tags.map((tag) => <a href={`${localizedPath(locale, 'search')}?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}
            </div>
          </div>
        )}

        <div class="bottom-share">
          <strong>{articleCopy.shareStory}</strong>
          <div>
            <a data-share="whatsapp" href="#">WhatsApp</a>
            <a data-share="telegram" href="#">Telegram</a>
            <a data-share="facebook" href="#">Facebook</a>
          </div>
        </div>
      </section>

      {related.length > 0 && (
        <section class="related">
          <div class="section-heading-row"><h2>{articleCopy.related}</h2><a href={localizedPath(locale, `categories/${category}`)}>{categoryLabel} →</a></div>
          <div>{related.slice(0, 3).map((article) => <ArticleCard {article} {locale} />)}</div>
        </section>
      )}

      <details class="correction-report">
        <summary>{reportCopy.title}</summary>
        <p>{reportCopy.intro}</p>
        <form id="correctionReport" data-email={BRAND.contactEmail} data-article-title={title} data-article-url={pageUrl}>
          <label><span>{reportCopy.issue}</span><textarea name="issue" rows="5" required maxlength="3000"></textarea></label>
          <label><span>{reportCopy.source}</span><input name="source" type="url" inputmode="url" placeholder="https://" required /></label>
          <label><span>{reportCopy.contact}</span><input name="contact" type="email" autocomplete="email" /></label>
          <label class="report-consent"><input name="consent" type="checkbox" required /><span>{reportCopy.consent}</span></label>
          <button class="btn btn-primary" type="submit">{reportCopy.send}</button>
        </form>
      </details>

      <p class="article-disclaimer">
        <strong>{brandName}</strong> — {t.disclaimerShort}
        <a href={trustPagePath(locale, 'corrections')}>{t.corrections}</a> ·
        <a href={trustPagePath(locale, 'contact')}>{t.reportCorrection}</a>
      </p>
    </div>
  </article>
</MainLayout>

<script>
  const article = document.querySelector<HTMLElement>('[data-article]');

  if (article) {
    const item = {
      id: article.dataset.id,
      title: article.dataset.title,
      url: article.dataset.url,
      description: article.dataset.description,
    };

    try {
      const viewed = JSON.parse(localStorage.getItem('recently-viewed') || '[]');
      localStorage.setItem('recently-viewed', JSON.stringify([item, ...viewed.filter((v: { id: string }) => v.id !== item.id)].slice(0, 8)));
    } catch {}

    const save = document.getElementById('saveArticle');
    const updateSave = () => {
      try {
        const saved = JSON.parse(localStorage.getItem('saved-articles') || '[]');
        const exists = saved.some((v: { id: string }) => v.id === item.id);
        save?.classList.toggle('is-saved', exists);
        save?.setAttribute('aria-pressed', String(exists));
        const span = save?.querySelector('span');
        if (span) span.textContent = exists ? (save?.dataset.savedLabel || 'Saved') : (save?.dataset.saveLabel || 'Save for later');
      } catch {}
    };

    save?.addEventListener('click', () => {
      try {
        const saved = JSON.parse(localStorage.getItem('saved-articles') || '[]');
        const next = saved.some((v: { id: string }) => v.id === item.id)
          ? saved.filter((v: { id: string }) => v.id !== item.id)
          : [item, ...saved];
        localStorage.setItem('saved-articles', JSON.stringify(next));
        updateSave();
      } catch {}
    });
    updateSave();

    const shareUrl = encodeURIComponent(item.url || location.href);
    const shareText = encodeURIComponent(item.title || '');
    document.querySelectorAll<HTMLAnchorElement>('[data-share]').forEach((a) => {
      const type = a.dataset.share;
      a.href = type === 'whatsapp'
        ? `https://wa.me/?text=${shareText}%20${shareUrl}`
        : type === 'telegram'
          ? `https://t.me/share/url?url=${shareUrl}&text=${shareText}`
          : `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
    });

    document.getElementById('nativeShare')?.addEventListener('click', () =>
      navigator.share
        ? navigator.share({ title: item.title, text: item.description, url: item.url })
        : navigator.clipboard.writeText(item.url || location.href),
    );

    const copyLink = document.getElementById('copyLink');
    copyLink?.addEventListener('click', async () => {
      await navigator.clipboard.writeText(item.url || location.href);
      const label = copyLink.querySelector('span');
      if (label) {
        label.textContent = copyLink.dataset.copiedLabel || 'Copied';
        setTimeout(() => (label.textContent = copyLink.dataset.copyLabel || 'Copy link'), 1600);
      }
    });

    const content = document.querySelector<HTMLElement>('.article-content');
    const readingTime = document.getElementById('readingTime');
    if (content && readingTime) {
      const wordCount = (content.textContent || '').trim().split(/\s+/).filter(Boolean).length;
      const wpm = Number(article.dataset.readingWpm || 220);
      const minutes = Math.max(1, Math.ceil(wordCount / wpm));
      readingTime.textContent = `${minutes} ${readingTime.textContent?.replace(/^—\s*/, '').replace(/^\d+\s*/, '') || 'min read'}`;
    }

    const toc = document.getElementById('articleToc');
    const tocList = document.getElementById('articleTocList');
    if (content && toc && tocList) {
      const headings = Array.from(content.querySelectorAll<HTMLHeadingElement>('h2, h3'));
      const usedIds = new Set<string>();
      headings.forEach((heading, index) => {
        let id = heading.id || heading.textContent?.trim().toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '') || `section-${index + 1}`;
        const baseId = id;
        let suffix = 2;
        while (usedIds.has(id) || (document.getElementById(id) && document.getElementById(id) !== heading)) id = `${baseId}-${suffix++}`;
        usedIds.add(id);
        heading.id = id;
        const li = document.createElement('li');
        li.className = heading.tagName === 'H3' ? 'toc-level-3' : 'toc-level-2';
        const link = document.createElement('a');
        link.href = `#${id}`;
        link.textContent = heading.textContent || '';
        li.appendChild(link);
        tocList.appendChild(li);
      });
      if (headings.length >= 2) toc.hidden = false;
    }

    const progressBar = document.getElementById('readingProgressBar');
    const updateProgress = () => {
      if (!progressBar) return;
      const rect = article.getBoundingClientRect();
      const available = Math.max(1, article.offsetHeight - window.innerHeight);
      const travelled = Math.min(available, Math.max(0, -rect.top));
      progressBar.style.transform = `scaleX(${travelled / available})`;
    };
    updateProgress();
    addEventListener('scroll', updateProgress, { passive: true });
    addEventListener('resize', updateProgress, { passive: true });
  }

  const report = document.getElementById('correctionReport') as HTMLFormElement | null;
  report?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!report.reportValidity()) return;
    const data = new FormData(report);
    const body = [
      `Article: ${report.dataset.articleTitle || ''}`,
      `URL: ${report.dataset.articleUrl || location.href}`,
      `Reported issue: ${data.get('issue') || ''}`,
      `Supporting official source: ${data.get('source') || ''}`,
      `Optional contact: ${data.get('contact') || ''}`,
      'Privacy consent: yes',
    ].join('\n\n');
    const subject = `Correction report — ${report.dataset.articleTitle || 'Citizen Affairs'}`;
    location.href = `mailto:${report.dataset.email || ''}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

