---
import MainLayout from './MainLayout.astro';
import AdSlot from '@components/AdSlot.astro';
import { generateArticleSchema, generateBreadcrumbs, toAbsoluteUrl } from '@lib/seo';
import { getCategoryData, getAuthorData, categoryName } from '@lib/content';
import { SITE } from '@utils/constants';
import type { Locale } from '../i18n';
import { localizedPath, ui, verificationLabels } from '../i18n';

export interface Props {
  locale: Locale;
  alternateUrl?: string;
  title: string;
  description: string;
  author: string;
  date: Date;
  updated?: Date;
  lastVerified?: Date;
  deadline?: Date;
  category: string;
  tags?: string[];
  canonical?: string;
  featuredImage?: string;
  featuredImageAlt?: string;
  seoTitle?: string;
  seoDescription?: string;
  verificationStatus: 'officially-confirmed' | 'under-verification' | 'corrected' | 'withdrawn' | 'closed';
  sourceUrls?: string[];
  officialNoticeUrl?: string;
  applicationUrl?: string;
}

const props = Astro.props;
const { locale, alternateUrl, title, description, author, date, updated, lastVerified, deadline, category, tags = [], canonical, featuredImage, featuredImageAlt, seoTitle, seoDescription, verificationStatus, sourceUrls = [], officialNoticeUrl, applicationUrl } = props;
const t = ui(locale);
const categoryEntry = await getCategoryData(category);
const authorEntry = await getAuthorData(author);
const categoryLabel = categoryEntry ? categoryName(categoryEntry, locale) : category;
const authorName = authorEntry?.data.name ?? author;
const pageUrl = canonical || Astro.url.href;
const formatter = new Intl.DateTimeFormat(locale === 'bn' ? 'bn-IN' : 'en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
const ogImage = featuredImage ? toAbsoluteUrl(featuredImage, SITE.url) : undefined;
const articleSchema = generateArticleSchema({ title, description, image: ogImage, datePublished: date, dateModified: updated, author: authorName, url: pageUrl });
const breadcrumbSchema = generateBreadcrumbs([
  { name: t.home, url: `${SITE.url}/${locale}/` },
  { name: t.articles, url: `${SITE.url}/${locale}/articles/` },
  { name: categoryLabel, url: `${SITE.url}/${locale}/categories/${category}/` },
  { name: title },
]);
const statusClass = `status-${verificationStatus}`;
---

<MainLayout title={seoTitle || title} description={seoDescription || description} canonical={pageUrl} ogType="article" image={ogImage} structuredData={[articleSchema, breadcrumbSchema]} {locale} {alternateUrl}>
  <article class="article-shell">
    <div class="container article-container">
      <nav class="breadcrumbs"><a href={localizedPath(locale)}>{t.home}</a><span>›</span><a href={localizedPath(locale, 'articles')}>{t.articles}</a><span>›</span><span>{categoryLabel}</span></nav>

      <header class="article-header">
        <div class="article-labels"><a href={localizedPath(locale, `categories/${category}`)}>{categoryLabel}</a><span class={statusClass}>● {verificationLabels[locale][verificationStatus]}</span></div>
        <h1>{title}</h1>
        <p class="article-deck">{description}</p>
        <div class="article-byline"><span>{formatter.format(date)}</span><span>•</span><span>{authorName}</span>{updated && <><span>•</span><span>{t.updated}: {formatter.format(updated)}</span></>}</div>
      </header>

      {featuredImage && <img src={featuredImage} alt={featuredImageAlt || title} class="article-hero-image" loading="eager" decoding="async" />}

      <aside class={`trust-box ${statusClass}`}>
        <div class="trust-box-title"><span>✓</span><div><strong>{t.verification}</strong><small>{verificationLabels[locale][verificationStatus]}</small></div></div>
        <dl>
          {lastVerified && <div><dt>{t.lastVerified}</dt><dd>{formatter.format(lastVerified)}</dd></div>}
          {deadline && <div><dt>{locale === 'bn' ? 'শেষ তারিখ' : 'Deadline'}</dt><dd>{formatter.format(deadline)}</dd></div>}
          <div><dt>{t.source}</dt><dd>{sourceUrls.length || (officialNoticeUrl ? 1 : 0)}</dd></div>
        </dl>
      </aside>

      <div class="article-content"><slot /></div>
      <AdSlot position="article-inline" />

      {(officialNoticeUrl || applicationUrl || sourceUrls.length > 0) && (
        <section class="source-panel">
          <h2>{locale === 'bn' ? 'অফিসিয়াল লিঙ্ক ও সূত্র' : 'Official links and sources'}</h2>
          <p>{locale === 'bn' ? 'চূড়ান্ত সিদ্ধান্ত নেওয়ার আগে মূল বিজ্ঞপ্তি বা পোর্টাল যাচাই করুন।' : 'Check the original notice or portal before making a final decision.'}</p>
          <div class="source-actions">
            {officialNoticeUrl && <a class="btn btn-secondary" href={officialNoticeUrl} target="_blank" rel="noopener noreferrer">{t.source} ↗</a>}
            {applicationUrl && <a class="btn btn-primary" href={applicationUrl} target="_blank" rel="noopener noreferrer">{t.apply} ↗</a>}
          </div>
          {sourceUrls.length > 0 && <ol>{sourceUrls.map((url, index) => <li><a href={url} target="_blank" rel="noopener noreferrer">{locale === 'bn' ? `সূত্র ${index + 1}` : `Source ${index + 1}`} — {new URL(url).hostname}</a></li>)}</ol>}
        </section>
      )}

      {tags.length > 0 && <div class="article-tags">{tags.map((tag) => <span>#{tag}</span>)}</div>}
      <p class="article-disclaimer">{t.disclaimerShort}</p>
      <AdSlot position="article-end" />
    </div>
  </article>
</MainLayout>

<style is:global>
  .article-shell{padding:2rem 0 5rem}.article-container{max-width:800px}.breadcrumbs{display:flex;gap:.5rem;align-items:center;flex-wrap:wrap;color:var(--color-text-muted);font-size:.8rem;margin-bottom:2rem}.breadcrumbs a:hover{color:var(--color-primary)}.article-header h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.12;letter-spacing:-.025em;margin:.85rem 0 1rem}.article-labels{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:center}.article-labels a{color:var(--color-primary);font-weight:800;font-size:.8rem;text-transform:uppercase;letter-spacing:.04em}.article-labels span{font-size:.76rem;font-weight:700;color:var(--color-green-text)}.article-labels .status-under-verification{color:#a85c00}.article-labels .status-withdrawn,.article-labels .status-closed{color:#b42318}.article-deck{font-size:1.15rem;color:var(--color-text-muted);line-height:1.65}.article-byline{display:flex;flex-wrap:wrap;gap:.55rem;color:var(--color-text-muted);font-size:.82rem;margin-top:1.2rem}.article-hero-image{width:100%;aspect-ratio:16/9;object-fit:cover;border-radius:22px;margin:2rem 0}.trust-box{margin:2rem 0;padding:1.15rem;border:1px solid rgba(var(--color-green-rgb),.25);border-radius:18px;background:linear-gradient(135deg,rgba(var(--color-green-rgb),.08),rgba(var(--color-primary-rgb),.05));display:grid;gap:1rem}.trust-box-title{display:flex;gap:.8rem;align-items:center}.trust-box-title>span{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--color-green);color:#fff;font-weight:800}.trust-box-title div{display:flex;flex-direction:column}.trust-box-title small{color:var(--color-text-muted)}.trust-box dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.75rem}.trust-box dl div{padding:.7rem;background:rgba(255,255,255,.55);border-radius:12px}[data-theme="dark"] .trust-box dl div{background:rgba(0,0,0,.15)}.trust-box dt{font-size:.7rem;color:var(--color-text-muted)}.trust-box dd{font-weight:700}.article-content{font-size:1.06rem;line-height:1.85}.article-content h2,.article-content h3{margin:2rem 0 .8rem}.article-content p{margin-bottom:1.1rem}.article-content ul,.article-content ol{list-style:revert;margin:0 0 1.25rem 1.4rem}.article-content li{margin-bottom:.45rem}.article-content a,.source-panel a{color:var(--color-primary);text-decoration:underline;text-underline-offset:3px}.article-content blockquote{border-left:4px solid var(--color-primary);padding:1rem 1.25rem;background:var(--color-surface-alt);border-radius:0 12px 12px 0;margin:1.5rem 0}.article-content table{width:100%;border-collapse:collapse;display:block;overflow-x:auto}.article-content th,.article-content td{border:1px solid var(--color-border);padding:.75rem}.source-panel{margin-top:2.5rem;padding:1.35rem;border:1px solid var(--color-border);background:var(--color-surface);border-radius:20px}.source-panel h2{font-size:1.35rem}.source-panel p{color:var(--color-text-muted)}.source-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin:1rem 0}.source-actions .btn{text-decoration:none}.source-panel ol{list-style:decimal;margin-left:1.25rem}.article-tags{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:1.5rem}.article-tags span{padding:.35rem .7rem;background:var(--color-surface-alt);border-radius:99px;font-size:.78rem}.article-disclaimer{margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--color-border);font-size:.8rem;color:var(--color-text-muted)}
</style>
