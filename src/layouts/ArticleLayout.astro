---
import MainLayout from './MainLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import Icon from '@components/Icon.astro';
import { generateArticleSchema, generateBreadcrumbs, toAbsoluteUrl } from '@lib/seo';
import { getCategoryData, getAuthorData, categoryName } from '@lib/content';
import { BRAND, getBrandName, resolveAssetPath, SITE } from '@utils/constants';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n';
import { authorProfilePath, dateLocale, localizedPath, trustPagePath, ui, verificationLabels } from '../i18n';

export interface Props {
  locale:Locale; alternateUrls?:Partial<Record<Locale,string>>; contentType:'job'|'scheme'|'explainer'; title:string; description:string; author:string; assignedEditor?:string; factCheckedBy?:string; reviewedBy?:string; publishedBy?:string; date:Date; updated?:Date; lastVerified?:Date; deadline?:Date; category:string; tags?:string[]; canonical?:string; featuredImage?:string; featuredImageAvif?:string; featuredImageSrcSet?:string; featuredImageAvifSrcSet?:string; featuredImageWidth?:number; featuredImageHeight?:number; featuredImageAlt?:string; seoTitle?:string; seoDescription?:string; verificationStatus:'officially-confirmed'|'partially-confirmed'|'under-verification'|'corrected'|'withdrawn'|'closed'; sourceUrls?:string[]; sources?:Array<{title:string;url:string;publishingAuthority:string;designation:'primary'|'secondary';documentNumber?:string;publicationDate?:Date;accessedDate:Date;notes?:string}>; officialNoticeUrl?:string; applicationUrl?:string; urlSlug:string; quickSummary?:string[]; importantDates?:string[]; qualification?:string[]; requiredDocuments?:string[]; updateHistory?:string[]; amountOrVacancies?:string; faqs?:Array<{question:string;answer:string}>; related?:CollectionEntry<'articles'>[];
}
const p=Astro.props; const { locale, alternateUrls, contentType, title, description, author, assignedEditor, factCheckedBy, reviewedBy, publishedBy, date, updated, lastVerified, deadline, category, tags=[], canonical, featuredImage, featuredImageAvif, featuredImageSrcSet, featuredImageAvifSrcSet, featuredImageWidth=1200, featuredImageHeight=675, featuredImageAlt, seoTitle, seoDescription, verificationStatus, sourceUrls=[], sources=[], officialNoticeUrl, applicationUrl, urlSlug, quickSummary=[], importantDates=[], qualification=[], requiredDocuments=[], updateHistory=[], amountOrVacancies, faqs=[], related=[] }=p;
const resolveSrcSet=(value?:string)=>value?.split(',').map((entry)=>{const [url,width]=entry.trim().split(/\s+/);return `${resolveAssetPath(url)} ${width}`}).join(', '); const t=ui(locale), categoryEntry=await getCategoryData(category), authorEntry=await getAuthorData(author); const categoryLabel=categoryEntry?categoryName(categoryEntry,locale):category; const authorName=authorEntry?.data.name??author; const resolveStaffName=async(slug?:string)=>slug?(await getAuthorData(slug))?.data.name??slug:undefined; const editorName=await resolveStaffName(assignedEditor), factCheckerName=await resolveStaffName(factCheckedBy), reviewerName=await resolveStaffName(reviewedBy), publisherName=await resolveStaffName(publishedBy); const pageUrl=canonical||Astro.url.href; const formatter=new Intl.DateTimeFormat(dateLocale(locale),{year:'numeric',month:'long',day:'numeric'}); const resolvedFeaturedImage=featuredImage?resolveAssetPath(featuredImage):undefined; const resolvedFeaturedImageAvif=featuredImageAvif?resolveAssetPath(featuredImageAvif):undefined; const resolvedFeaturedImageSrcSet=resolveSrcSet(featuredImageSrcSet); const resolvedFeaturedImageAvifSrcSet=resolveSrcSet(featuredImageAvifSrcSet); const ogImage=resolvedFeaturedImage?toAbsoluteUrl(resolvedFeaturedImage,SITE.url):undefined;
const brandName=getBrandName(locale);
const reportCopy={
  en:{title:'Report outdated or incorrect information',intro:'Tell the editorial team exactly what needs review. An official supporting source helps us respond faster.',issue:'Reported issue',source:'Supporting official source',contact:'Your email (optional)',consent:'I consent to this information being used to review my report.',send:'Prepare email report'},
  bn:{title:'পুরোনো বা ভুল তথ্য জানান',intro:'কোন তথ্যটি পর্যালোচনা করা দরকার তা স্পষ্টভাবে লিখুন। অফিসিয়াল সমর্থনকারী সূত্র দিলে দ্রুত যাচাই করা যায়।',issue:'সমস্যার বিবরণ',source:'সমর্থনকারী অফিসিয়াল সূত্র',contact:'আপনার ইমেইল (ঐচ্ছিক)',consent:'আমার প্রতিবেদন যাচাইয়ের জন্য এই তথ্য ব্যবহারে আমি সম্মত।',send:'ইমেইল প্রতিবেদন তৈরি করুন'},
  hi:{title:'पुरानी या गलत जानकारी की सूचना दें',intro:'संपादकीय टीम को स्पष्ट बताएँ कि किस जानकारी की समीक्षा चाहिए। आधिकारिक समर्थक स्रोत से जाँच तेज होती है।',issue:'समस्या का विवरण',source:'समर्थक आधिकारिक स्रोत',contact:'आपका ईमेल (वैकल्पिक)',consent:'मैं अपनी रिपोर्ट की समीक्षा के लिए इस जानकारी के उपयोग पर सहमत हूँ।',send:'ईमेल रिपोर्ट तैयार करें'},
}[locale];
const articleSchema=generateArticleSchema({title,description,image:ogImage,datePublished:date,dateModified:updated,author:authorName,url:pageUrl,schemaType:contentType==='explainer'?'Article':'NewsArticle'});
const breadcrumbSchema=generateBreadcrumbs([{name:t.home,url:locale==='en'?`${SITE.url}/`:`${SITE.url}/${locale}/`},{name:t.articles,url:`${SITE.url}/${locale}/articles/`},{name:categoryLabel,url:`${SITE.url}/${locale}/categories/${category}/`},{name:title}]);
const faqSchema=faqs.length?{'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))}:undefined;
const schemas=faqSchema?[articleSchema,breadcrumbSchema,faqSchema]:[articleSchema,breadcrumbSchema];
---
<MainLayout title={seoTitle||title} description={seoDescription||description} canonical={pageUrl} ogType="article" image={ogImage} structuredData={schemas} {locale} {alternateUrls}>
  <article class="article-shell" data-article data-id={`${locale}:${urlSlug}`} data-url={pageUrl} data-title={title} data-description={description}>
    <div class="container article-container">
      <nav class="breadcrumbs" aria-label={t.breadcrumb}><a href={localizedPath(locale)}>{t.home}</a><span>›</span><a href={localizedPath(locale,'articles')}>{t.articles}</a><span>›</span><a href={localizedPath(locale,`categories/${category}`)}>{categoryLabel}</a></nav>
      <header class="article-header"><div class="article-labels"><span>{categoryLabel}</span><span class={`status-${verificationStatus}`}>● {verificationLabels[locale][verificationStatus]}</span></div><h1>{title}</h1><p class="article-deck">{description}</p><div class="article-byline"><span>{t.published}: {formatter.format(date)}</span>{updated&&<span>{t.updated}: {formatter.format(updated)}</span>}<a href={authorProfilePath(locale,author)}>{t.writtenBy}: {authorName}</a>{editorName&&<span>{t.editedBy}: {editorName}</span>}{factCheckerName&&<span>{t.factCheckedBy}: {factCheckerName}</span>}{reviewerName&&<span>{t.reviewedBy}: {reviewerName}</span>}{publisherName&&<span>{t.publishedBy}: {publisherName}</span>}</div></header>
      {resolvedFeaturedImage&&<picture class="article-hero-picture">{resolvedFeaturedImageAvif&&<source srcset={resolvedFeaturedImageAvifSrcSet||resolvedFeaturedImageAvif} sizes="(max-width: 900px) calc(100vw - 2rem), 860px" type="image/avif"/>}<img src={resolvedFeaturedImage} srcset={resolvedFeaturedImageSrcSet} sizes="(max-width: 900px) calc(100vw - 2rem), 860px" alt={featuredImageAlt||title} class="article-hero-image" width={featuredImageWidth} height={featuredImageHeight} loading="eager" fetchpriority="high" decoding="async"/></picture>}
      <aside class={`trust-box status-${verificationStatus}`}><div><Icon name="check"/><span><strong>{verificationLabels[locale][verificationStatus]}</strong><small>{t.primarySource}</small></span></div><dl>{lastVerified&&<div><dt>{t.lastVerified}</dt><dd>{formatter.format(lastVerified)}</dd></div>}{deadline&&<div><dt>{t.deadline}</dt><dd>{formatter.format(deadline)}</dd></div>}<div><dt>{t.source}</dt><dd>{sources.length+sourceUrls.length+(officialNoticeUrl?1:0)}</dd></div></dl></aside>
      <div class="article-actions"><button id="saveArticle" data-save-label={t.save} data-saved-label={t.savedLabel} aria-pressed="false"><Icon name="bookmark"/><span aria-live="polite">{t.save}</span></button><button id="nativeShare"><Icon name="share"/><span>{t.share}</span></button><a data-share="whatsapp" href="#">WhatsApp</a><a data-share="telegram" href="#">Telegram</a><a data-share="facebook" href="#">Facebook</a><button id="copyLink" data-copy-label={t.copyLink} data-copied-label={t.copied}><Icon name="copy"/><span aria-live="polite">{t.copyLink}</span></button></div>
      {quickSummary.length>0&&<section class="info-panel"><h2>{t.quickSummary}</h2><ul>{quickSummary.map(item=><li>{item}</li>)}</ul></section>} {importantDates.length>0&&<section class="info-panel"><h2>{t.importantDates}</h2><ul>{importantDates.map(item=><li>{item}</li>)}</ul></section>} {qualification.length>0&&<section class="info-panel"><h2>{t.eligibility}</h2><ul>{qualification.map(item=><li>{item}</li>)}</ul></section>} {amountOrVacancies&&<section class="info-panel"><h2>{t.amount}</h2><p>{amountOrVacancies}</p></section>} {requiredDocuments.length>0&&<section class="info-panel"><h2>{t.requiredDocuments}</h2><ul>{requiredDocuments.map(item=><li>{item}</li>)}</ul></section>}
      <div class="article-content"><slot /></div>
      {(officialNoticeUrl||applicationUrl||sources.length>0||sourceUrls.length>0)&&<section class="source-panel"><h2>{t.officialLinks}</h2><p>{t.checkOriginal}</p><div class="source-actions">{officialNoticeUrl&&<a class="btn btn-secondary" href={officialNoticeUrl} target="_blank" rel="noopener noreferrer">{t.source} ↗</a>}{applicationUrl&&<a class="btn btn-primary" href={applicationUrl} target="_blank" rel="noopener noreferrer">{t.apply} ↗</a>}</div>{sources.length>0&&<ol>{sources.map((source)=><li><a href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.title}</strong> — {source.publishingAuthority}</a>{source.documentNumber&&<small>{source.documentNumber}</small>}</li>)}</ol>}{sourceUrls.length>0&&<ol>{sourceUrls.map((url,i)=><li><a href={url} target="_blank" rel="noopener noreferrer">{t.sourceItem} {i+1} — {new URL(url).hostname}</a></li>)}</ol>}</section>}
      {faqs.length>0&&<section class="faq-section"><h2>{t.faq}</h2>{faqs.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</section>}
      {updateHistory.length>0&&<section class="info-panel"><h2>{t.updateHistory}</h2><ul>{updateHistory.map(item=><li>{item}</li>)}</ul></section>} {tags.length>0&&<div class="article-tags">{tags.map(tag=><span>#{tag}</span>)}</div>}
      {related.length>0&&<section class="related"><h2>{t.relatedArticles}</h2><div>{related.map(article=><ArticleCard {article} {locale}/>)}</div></section>}
      <details class="correction-report">
        <summary>{reportCopy.title}</summary>
        <p>{reportCopy.intro}</p>
        <form id="correctionReport" data-email={BRAND.contactEmail} data-article-title={title} data-article-url={pageUrl}>
          <label><span>{reportCopy.issue}</span><textarea name="issue" rows="5" required maxlength="3000"></textarea></label>
          <label><span>{reportCopy.source}</span><input name="source" type="url" inputmode="url" placeholder="https://" required /></label>
          <label><span>{reportCopy.contact}</span><input name="contact" type="email" autocomplete="email" /></label>
          <label class="report-consent"><input name="consent" type="checkbox" required /><span>{reportCopy.consent}</span></label>
          <button class="btn btn-primary" type="submit">{reportCopy.send}</button>
        </form>
      </details>
      <p class="article-disclaimer"><strong>{brandName}</strong> — {t.disclaimerShort} <a href={trustPagePath(locale,'corrections')}>{t.corrections}</a> · <a href={trustPagePath(locale,'contact')}>{t.reportCorrection}</a></p>
    </div>
  </article>
</MainLayout>
<script>
  const article=document.querySelector<HTMLElement>('[data-article]');if(article){const item={id:article.dataset.id,title:article.dataset.title,url:article.dataset.url,description:article.dataset.description};try{const viewed=JSON.parse(localStorage.getItem('recently-viewed')||'[]');localStorage.setItem('recently-viewed',JSON.stringify([item,...viewed.filter((v:{id:string})=>v.id!==item.id)].slice(0,8)))}catch{}
  const save=document.getElementById('saveArticle');const updateSave=()=>{try{const saved=JSON.parse(localStorage.getItem('saved-articles')||'[]');const exists=saved.some((v:{id:string})=>v.id===item.id);save?.classList.toggle('is-saved',exists);save?.setAttribute('aria-pressed',String(exists));const span=save?.querySelector('span');if(span)span.textContent=exists?(save?.dataset.savedLabel||'Saved'):(save?.dataset.saveLabel||'Save for later')}catch{}};save?.addEventListener('click',()=>{try{const saved=JSON.parse(localStorage.getItem('saved-articles')||'[]');const next=saved.some((v:{id:string})=>v.id===item.id)?saved.filter((v:{id:string})=>v.id!==item.id):[item,...saved];localStorage.setItem('saved-articles',JSON.stringify(next));updateSave()}catch{}});updateSave();
  const shareUrl=encodeURIComponent(item.url||location.href),shareText=encodeURIComponent(item.title||'');document.querySelectorAll<HTMLAnchorElement>('[data-share]').forEach(a=>{const type=a.dataset.share;a.href=type==='whatsapp'?`https://wa.me/?text=${shareText}%20${shareUrl}`:type==='telegram'?`https://t.me/share/url?url=${shareUrl}&text=${shareText}`:`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;a.target='_blank';a.rel='noopener noreferrer'});document.getElementById('nativeShare')?.addEventListener('click',()=>navigator.share?navigator.share({title:item.title,text:item.description,url:item.url}):navigator.clipboard.writeText(item.url||location.href));const copyLink=document.getElementById('copyLink');copyLink?.addEventListener('click',async()=>{await navigator.clipboard.writeText(item.url||location.href);const label=copyLink.querySelector('span');if(label){label.textContent=copyLink.dataset.copiedLabel||'Copied';setTimeout(()=>label.textContent=copyLink.dataset.copyLabel||'Copy link',1600)}});}
  const report=document.getElementById('correctionReport') as HTMLFormElement|null;report?.addEventListener('submit',(event)=>{event.preventDefault();if(!report.reportValidity())return;const data=new FormData(report);const body=[`Article: ${report.dataset.articleTitle||''}`,`URL: ${report.dataset.articleUrl||location.href}`,`Reported issue: ${data.get('issue')||''}`,`Supporting official source: ${data.get('source')||''}`,`Optional contact: ${data.get('contact')||''}`,`Privacy consent: yes`].join('\n\n');const subject=`Correction report — ${report.dataset.articleTitle||'Citizen Affairs'}`;location.href=`mailto:${report.dataset.email||''}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`});
</script>
<style is:global>
  .article-shell{padding:2rem 0 5rem}.article-container{max-width:860px}.breadcrumbs{display:flex;gap:.5rem;flex-wrap:wrap;color:var(--color-text-muted);font-size:.82rem;margin-bottom:1.6rem}.article-header h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.12;margin:.8rem 0}.article-labels,.article-byline,.article-actions{display:flex;gap:.7rem;flex-wrap:wrap}.article-labels{justify-content:space-between;font-weight:800;font-size:.78rem;color:var(--color-primary)}.article-deck{font-size:1.14rem;color:var(--color-text-muted)}.article-byline{font-size:.8rem;color:var(--color-text-muted);margin-top:1rem}.article-byline a,.article-disclaimer a{color:var(--color-primary);text-decoration:underline;text-underline-offset:.15em}.article-hero-picture{display:block;width:100%;margin:1.8rem 0;border-radius:22px;overflow:hidden;background:var(--color-surface-alt)}.article-hero-image{display:block;width:100%;max-width:100%;height:auto;object-fit:contain;object-position:center}.trust-box{padding:1.1rem;border:1px solid rgba(var(--color-green-rgb),.28);border-radius:18px;background:linear-gradient(135deg,rgba(var(--color-green-rgb),.08),rgba(var(--color-primary-rgb),.05));margin:1.5rem 0}.trust-box>div{display:flex;gap:.8rem}.trust-box>div>span{display:flex;flex-direction:column}.trust-box small{color:var(--color-text-muted)}.trust-box dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:.6rem;margin-top:1rem}.trust-box dl div{padding:.65rem;background:var(--color-surface);border-radius:10px}.trust-box dt{font-size:.7rem;color:var(--color-text-muted)}.trust-box dd{font-weight:800}.article-actions{position:sticky;top:122px;z-index:5;background:var(--color-surface);border:1px solid var(--color-border);padding:.55rem;border-radius:14px;margin:1.2rem 0}.article-actions button,.article-actions a{display:flex;align-items:center;gap:.35rem;min-height:44px;padding:.45rem .65rem;border-radius:9px;font-weight:700;font-size:.78rem}.article-actions button:hover,.article-actions a:hover,.article-actions .is-saved{background:var(--color-surface-alt);color:var(--color-primary)}.info-panel,.source-panel,.faq-section{margin:1.5rem 0;padding:1.25rem;border:1px solid var(--color-border);background:var(--color-surface);border-radius:18px}.info-panel h2,.source-panel h2,.faq-section h2,.related h2{font-size:1.3rem;margin-bottom:.7rem}.info-panel ul,.source-panel ol{list-style:revert;margin-left:1.2rem}.article-content{font-size:1.04rem;line-height:1.85}.article-content h2,.article-content h3{margin:2rem 0 .8rem}.article-content p{margin-bottom:1rem}.article-content ul,.article-content ol{list-style:revert;margin:0 0 1rem 1.3rem}.source-panel p{color:var(--color-text-muted)}.source-actions{display:flex;gap:.7rem;flex-wrap:wrap;margin:1rem 0}.source-panel a,.article-content a{color:var(--color-primary);text-decoration:underline}.faq-section details{border-top:1px solid var(--color-border);padding:.8rem 0}.faq-section summary{font-weight:800;cursor:pointer}.faq-section p{color:var(--color-text-muted);padding-top:.5rem}.article-tags{display:flex;gap:.4rem;flex-wrap:wrap}.article-tags span{padding:.3rem .6rem;background:var(--color-surface-alt);border-radius:999px}.related{margin-top:2.5rem}.related>div{display:grid;gap:1rem}@media(min-width:700px){.related>div{grid-template-columns:repeat(3,1fr)}}.correction-report{margin-top:2.5rem;padding:1rem 1.2rem;border:1px solid var(--color-border);border-radius:16px;background:var(--color-surface)}.correction-report summary{cursor:pointer;font-weight:850;color:var(--color-primary);min-height:44px;display:flex;align-items:center}.correction-report>p{color:var(--color-text-muted);font-size:.88rem}.correction-report form{display:grid;gap:.9rem;margin-top:1rem}.correction-report label:not(.report-consent){display:grid;gap:.35rem}.correction-report label>span{font-size:.8rem;font-weight:750}.correction-report textarea,.correction-report input[type='url'],.correction-report input[type='email']{width:100%;padding:.7rem;border:1px solid var(--color-border);border-radius:9px;background:var(--color-bg);color:var(--color-text);font:inherit}.report-consent{display:flex;align-items:start;gap:.55rem}.report-consent input{margin-top:.2rem}.correction-report button{width:max-content}.article-disclaimer{margin-top:2rem;border-top:1px solid var(--color-border);padding-top:1rem;color:var(--color-text-muted);font-size:.82rem}@media(max-width:620px){.article-actions{position:static}.article-actions a[data-share]{display:none}.correction-report button{width:100%}}
</style>
