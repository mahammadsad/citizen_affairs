---
import { SITE } from '@utils/constants';
const widths = [320, 360, 375, 390, 412, 430, 768, 1024];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Responsive QA</title>
  </head>
  <body>
    <h1>Responsive QA</h1>
    <pre id="results">Running…</pre>
    <div class="frames">
      {widths.map((width) => <iframe title={`${width}px test`} data-width={width} style={`width:${width}px;height:900px`} src={`${SITE.basePath}?qa=${width}`}></iframe>)}
    </div>
    <script is:inline type="module">
      const widths = [320, 360, 375, 390, 412, 430, 768, 1024];
      const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
      const frames = [...document.querySelectorAll('iframe')];
      const ready = (frame) => new Promise((resolve) => frame.contentDocument?.readyState === 'complete' ? resolve() : frame.addEventListener('load', resolve, { once: true }));
      await Promise.all(frames.map(ready));
      await wait(300);
      const results = [];
      for (const [index, frame] of frames.entries()) {
        const win = frame.contentWindow;
        const doc = frame.contentDocument;
        const width = widths[index];
        const prefooter = doc.querySelector('.prefooter')?.getBoundingClientRect();
        const menuButton = doc.querySelector('#menuToggle');
        menuButton?.click();
        await wait(30);
        const drawer = doc.querySelector('#mobileMenu');
        const drawerRect = drawer?.getBoundingClientRect();
        const backdrop = doc.querySelector('#mobileBackdrop');
        const navLinks = drawer?.querySelectorAll('a[href]').length || 0;
        backdrop?.click();
        const languageButton = doc.querySelector('#languageTrigger');
        languageButton?.click();
        await wait(20);
        const languageMenu = doc.querySelector('#languageMenu');
        const languageRect = languageMenu?.getBoundingClientRect();
        const languageOptions = languageMenu?.querySelectorAll('[role="menuitem"]').length || 0;
        doc.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));
        if (width === 390) doc.documentElement.dataset.theme = 'dark';
        const footerColor = getComputedStyle(doc.querySelector('.site-footer')).backgroundColor;
        results.push({
          width,
          innerWidth: win.innerWidth,
          clientWidth: doc.documentElement.clientWidth,
          scrollWidth: doc.documentElement.scrollWidth,
          overflow: doc.documentElement.scrollWidth > win.innerWidth,
          prefooterLeft: prefooter && Math.round(prefooter.left),
          prefooterRight: prefooter && Math.round(win.innerWidth - prefooter.right),
          prefooterInside: Boolean(prefooter && prefooter.left >= 0 && prefooter.right <= win.innerWidth),
          drawerOpen: menuButton?.getAttribute('aria-expanded') === 'true' || drawer?.getAttribute('aria-hidden') === 'false',
          drawerInside: width >= 860 || Boolean(drawerRect && drawerRect.left >= 0 && drawerRect.right <= win.innerWidth),
          backdropVisible: width >= 860 || Boolean(backdrop && !backdrop.hidden),
          navLinks,
          languageOptions,
          languageInside: Boolean(languageRect && languageRect.left >= 0 && languageRect.right <= win.innerWidth),
          noPublicDemo: !/\b(?:DEMO|Demo Brand|Demo version)\b/.test(doc.body.innerText),
          footerColor,
        });
      }
      document.querySelector('#results').textContent = JSON.stringify(results, null, 2);
    </script>
  </body>
</html>
<style>
  body{font:14px/1.45 system-ui;margin:1rem;background:#eef2f7;color:#17202e}.frames{display:grid;gap:1rem}.frames iframe{display:block;border:2px solid #58708a;background:#fff}pre{white-space:pre-wrap;background:#fff;padding:1rem;border-radius:10px}
</style>
