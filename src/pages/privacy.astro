---
import MainLayout from '@layouts/MainLayout.astro';
---
<MainLayout title="গোপনীয়তা নীতি" description="সরকারি তথ্যকেন্দ্র - আপনার তথ্য সুরক্ষা নীতি">
  <a href="/#main-content" class="skip-link">মূল কনটেন্টে যান</a>
  <header class="site-header">
    <nav class="navbar container" aria-label="প্রধান নেভিগেশন">
      <a href="/" class="brand">
        <img src="/assets/logo-mark.svg" alt="" class="brand-logo" width="42" height="42" />
        <span class="brand-text">
          <span class="brand-name">সরকারি তথ্যকেন্দ্র</span>
          <span class="brand-tagline">সঠিক তথ্য, সবার জন্য।</span>
        </span>
      </a>
      <ul class="nav-links">
        <li><a href="/">হোমে ফিরুন</a></li>
      </ul>
    </nav>
  </header>

  <main id="main-content" class="section container legal-content">
    <span class="eyebrow">গোপনীয়তা</span>
    <h1 style="font-size:clamp(1.6rem,1.3rem+1.2vw,2.2rem); margin-bottom:var(--space-2);">Privacy Policy</h1>
    <p class="legal-updated">সর্বশেষ হালনাগাদ: ২০২৬</p>
    <h2>১. আমরা কী তথ্য সংগ্রহ করি</h2>
    <p>এই ওয়েবসাইট বর্তমানে একটি স্ট্যাটিক (স্থির) সাইট এবং কোনো ব্যবহারকারীর ব্যক্তিগত তথ্য সংরক্ষণকারী সার্ভার নেই। নিউজলেটার সাবস্ক্রিপশন ফর্মে দেওয়া ইমেইল ঠিকানা শুধুমাত্র হালনাগাদ পাঠানোর উদ্দেশ্যে ব্যবহৃত হবে, যখন এই ফিচারটি সক্রিয় করা হবে।</p>
    <h2>২. টেলিগ্রাম ও হোয়াটসঅ্যাপ</h2>
    <p>আমাদের Telegram বা WhatsApp চ্যানেলে যুক্ত হলে, সেই প্ল্যাটফর্মগুলোর নিজস্ব প্রাইভেসি নীতি প্রযোজ্য হবে। সরকারি তথ্যকেন্দ্র সেসব প্ল্যাটফর্মে আপনার তথ্য কীভাবে ব্যবহৃত হয় তার জন্য দায়ী নয়।</p>
    <h2>৩. কুকি ও অ্যানালিটিক্স</h2>
    <p>বর্তমানে এই ওয়েবসাইটে কোনো ট্র্যাকিং কুকি বা বিজ্ঞাপন ব্যবহৃত হয় না। ভবিষ্যতে ওয়েবসাইট উন্নত করার জন্য বেসিক, প্রাইভacy-ফ্রেন্ডলি অ্যানালিটিক্স যোগ করা হতে পারে, যা এই নীতিতে হালনাগাদ করে জানানো হবে।</p>
    <h2>৪. তৃতীয় পক্ষের লিঙ্ক</h2>
    <p>এই সাইটে থাকা বাহ্যিক (সরকারি বা অন্যান্য) ওয়েবসাইটের লিঙ্কের জন্য সংশ্লিষ্ট ওয়েবসাইটের নিজস্ব প্রাইভেসি নীতি প্রযোজ্য হবে।</p>
    <h2>৫. যোগাযোগ</h2>
    <p>গোপনীয়তা সংক্রান্ত কোনো প্রশ্ন থাকলে আমাদের Telegram চ্যানেলের মাধ্যমে যোগাযোগ করতে পারেন।</p>
  </main>

  <footer class="site-footer">
    <div class="container footer-bottom">
      <p class="footer-disclaimer"><strong>দাবিত্যাগ:</strong> সরকারি তথ্যকেন্দ্র কোনো সরকারি প্রতিষ্ঠানের অংশ নয়।</p>
      <p>© <span id="year"></span> সরকারি তথ্যকেন্দ্র। সর্বস্বত্ব সংরক্ষিত। — <a href="/" style="color:var(--color-orange)">হোমে ফিরুন</a></p>
    </div>
  </footer>

  <script>
    const yearEl = document.getElementById('year');
    if (yearEl) yearEl.textContent = new Date().getFullYear().toString();
  </script>
</MainLayout>
