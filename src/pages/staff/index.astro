---
import BaseLayout from '@layouts/BaseLayout.astro';
import BrandLogo from '@components/BrandLogo.astro';
---
<BaseLayout title="Editorial workspace" description="Private Citizen Affairs India editorial workspace" robots="noindex, nofollow">
  <main class="workspace-shell">
    <section class="workspace-card" id="setupState" hidden>
      <BrandLogo variant="horizontal" class="workspace-logo" />
      <p class="eyebrow">Citizen Affairs India</p>
      <h1>Editorial workspace setup required</h1>
      <p>Add <code>PUBLIC_SUPABASE_URL</code> and <code>PUBLIC_SUPABASE_PUBLISHABLE_KEY</code> to the deployment environment. Never add a secret or service-role key.</p>
    </section>

    <section class="workspace-card auth-card" id="authState" hidden>
      <BrandLogo variant="horizontal" class="workspace-logo" />
      <p class="eyebrow">Citizen Affairs India</p>
      <h1>Staff sign in</h1>
      <p>Drafts, verification notes and approvals remain private and are protected by database permissions.</p>
      <form id="signInForm">
        <label>Email<input name="email" type="email" autocomplete="username" required /></label>
        <label>Password<input name="password" type="password" autocomplete="current-password" required /></label>
        <button type="submit">Sign in</button>
        <button class="secondary" id="resetRequestButton" type="button">Reset password</button>
        <p class="form-status" id="authMessage" role="status"></p>
      </form>
    </section>

    <section class="workspace-card auth-card" id="passwordState" hidden>
      <BrandLogo variant="horizontal" class="workspace-logo" />
      <p class="eyebrow">Protected account recovery</p>
      <h1>Choose a new password</h1>
      <form id="passwordForm">
        <label>New password<input name="password" type="password" autocomplete="new-password" minlength="12" required /></label>
        <label>Confirm password<input name="confirmation" type="password" autocomplete="new-password" minlength="12" required /></label>
        <button type="submit">Update password</button>
        <p class="form-status" id="passwordMessage" role="status"></p>
      </form>
    </section>

    <section class="workspace-card auth-card" id="mfaState" hidden>
      <BrandLogo variant="horizontal" class="workspace-logo" />
      <p class="eyebrow">Required account protection</p>
      <h1>Two-factor verification</h1>
      <p id="mfaInstructions">Enter the current code from your authenticator app.</p>
      <img id="mfaQr" class="mfa-qr" alt="Authenticator enrollment QR code" hidden />
      <code id="mfaSecret" class="mfa-secret" hidden></code>
      <form id="mfaForm">
        <label>6-digit code<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" required /></label>
        <button type="submit">Verify and continue</button>
        <p class="form-status" id="mfaMessage" role="status"></p>
      </form>
    </section>

    <section class="workspace" id="dashboardState" hidden>
      <header class="workspace-header">
        <div><BrandLogo variant="horizontal" class="workspace-logo" /><p class="eyebrow">Private editorial workspace</p><h1>Welcome, <span id="staffName">staff member</span></h1><p id="staffRole"></p></div>
        <button class="secondary" id="signOutButton" type="button">Sign out</button>
      </header>

      <div class="metrics" aria-label="Editorial overview">
        <article><strong id="draftCount">0</strong><span>Drafts</span></article>
        <article><strong id="reviewCount">0</strong><span>Awaiting review</span></article>
        <article><strong id="verificationCount">0</strong><span>Fact-checking</span></article>
        <article><strong id="dueCount">0</strong><span>Re-verification due</span></article>
      </div>

      <div class="workspace-grid">
        <section class="panel">
          <div class="panel-heading"><div><p class="eyebrow">Assignments</p><h2>Articles you can access</h2></div><button class="secondary" id="refreshButton" type="button">Refresh</button></div>
          <div class="article-list" id="articleList"><p>Loading assignments…</p></div>
        </section>

        <section class="panel">
          <p class="eyebrow">New work</p>
          <h2>Create a private draft</h2>
          <form id="draftForm">
            <label>Content type<select name="content_type" required><option value="job">Government job</option><option value="scheme">Welfare scheme</option><option value="explainer">Explainer</option></select></label>
            <label>Language<select name="language" required><option value="en">English</option><option value="bn">Bengali</option><option value="hi">Hindi</option></select></label>
            <label>Section<select name="section" required><option value="jobs">Government Jobs</option><option value="projects">Welfare Schemes</option></select></label>
            <label>Title<input name="title" required maxlength="180" /></label>
            <label>URL slug<input name="slug" required pattern="[a-z0-9]+(?:-[a-z0-9]+)*" placeholder="lowercase-words-only" /></label>
            <label>Short description<textarea name="short_description" required maxlength="320"></textarea></label>
            <button type="submit">Create draft</button>
            <p class="form-status" id="draftMessage" role="status"></p>
          </form>
        </section>
      </div>

      <section class="panel automation-panel" aria-labelledby="automationTitle">
        <div class="panel-heading">
          <div><p class="eyebrow">Human-reviewed automation</p><h2 id="automationTitle">Research and draft queue</h2></div>
          <button class="secondary" id="refreshAutomationButton" type="button">Refresh automation</button>
        </div>
        <p class="automation-notice">AI output is private and cannot publish itself. Critical unsupported claims block review.</p>
        <div class="automation-metrics">
          <article><strong id="topicCount">0</strong><span>Discovered topics</span></article>
          <article><strong id="researchCount">0</strong><span>Research dossiers</span></article>
          <article><strong id="blockedCount">0</strong><span>Fact-check blockers</span></article>
          <article><strong id="automationRunCount">0</strong><span>Automation runs</span></article>
        </div>
        <div class="automation-grid">
          <section><h3>Discovered topics and scores</h3><div class="automation-list" id="topicList"><p>Loading private topics…</p></div></section>
          <section><h3>Research, evidence and drafts</h3><div class="automation-list" id="researchList"><p>Loading private research…</p></div></section>
          <section><h3>Fact-check and image status</h3><div class="automation-list" id="factCheckList"><p>Loading private checks…</p></div></section>
          <section><h3>Automation history</h3><div class="automation-list" id="automationList"><p>Loading run history…</p></div></section>
        </div>
        <p class="form-status" id="automationMessage" role="status"></p>
      </section>
    </section>
    <dialog id="publishDialog" class="publish-dialog">
      <form id="publishForm" method="dialog">
        <div><p class="eyebrow">Controlled publication</p><h2>Request publication</h2><p id="publishArticleTitle"></p></div>
        <input type="hidden" name="article_id" />
        <label>Publication reason<textarea name="reason" required minlength="10" maxlength="500" placeholder="Explain why this approved version is ready to publish."></textarea></label>
        <p class="form-status" id="publishMessage" role="status"></p>
        <div class="dialog-actions"><button class="secondary" id="cancelPublish" type="button">Cancel</button><button id="publishSubmit" type="submit">Start protected build</button></div>
      </form>
    </dialog>
  </main>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const url = import.meta.env.PUBLIC_SUPABASE_URL;
  const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
    const setupState = document.getElementById('setupState');
    const authState = document.getElementById('authState');
    const passwordState = document.getElementById('passwordState');
    const mfaState = document.getElementById('mfaState');
    const dashboardState = document.getElementById('dashboardState');

  if (!url || !key) {
    setupState?.removeAttribute('hidden');
  } else {
    const supabase = createClient(url, key, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true } });
    const authMessage = document.getElementById('authMessage');
    const draftMessage = document.getElementById('draftMessage');
    const publishDialog = document.getElementById('publishDialog') as HTMLDialogElement | null;
    const publishForm = document.getElementById('publishForm') as HTMLFormElement | null;
    const publishMessage = document.getElementById('publishMessage');
    const publishSubmit = document.getElementById('publishSubmit') as HTMLButtonElement | null;
    const cancelPublish = document.getElementById('cancelPublish') as HTMLButtonElement | null;
    let publicationInFlight = false;
    let mfaFactorId = '';

    const functionErrorMessage = async (error: unknown) => {
      const fallback = error instanceof Error ? error.message : 'The protected publication request failed.';
      const context = (error as { context?: Response } | null)?.context;
      if (!(context instanceof Response)) return fallback;
      try {
        const payload = await context.clone().json() as { message?: string };
        return payload.message || fallback;
      } catch {
        return fallback;
      }
    };

    const setPublicationBusy = (busy: boolean) => {
      publicationInFlight = busy;
      if (publishSubmit) {
        publishSubmit.disabled = busy;
        publishSubmit.textContent = busy ? 'Starting protected build…' : 'Start protected build';
      }
      if (cancelPublish) cancelPublish.disabled = busy;
    };

    const show = (state: 'auth' | 'password' | 'mfa' | 'dashboard') => {
      authState?.toggleAttribute('hidden', state !== 'auth');
      passwordState?.toggleAttribute('hidden', state !== 'password');
      mfaState?.toggleAttribute('hidden', state !== 'mfa');
      dashboardState?.toggleAttribute('hidden', state !== 'dashboard');
    };

    const setText = (id: string, value: string | number) => {
      const element = document.getElementById(id);
      if (element) element.textContent = String(value);
    };

    const prepareRequiredMfa = async () => {
      const { data: assurance, error: assuranceError } = await supabase.auth.mfa.getAuthenticatorAssuranceLevel();
      if (assuranceError) throw assuranceError;
      if (assurance.currentLevel === 'aal2') return true;
      show('mfa');
      const message = document.getElementById('mfaMessage');
      const instructions = document.getElementById('mfaInstructions');
      const qr = document.getElementById('mfaQr') as HTMLImageElement | null;
      const secret = document.getElementById('mfaSecret');
      const { data: factors, error: factorsError } = await supabase.auth.mfa.listFactors();
      if (factorsError) throw factorsError;
      const verified = factors.totp.find((factor) => factor.status === 'verified');
      if (verified) {
        mfaFactorId = verified.id;
        if (instructions) instructions.textContent = 'Enter the current code from your authenticator app.';
        qr?.setAttribute('hidden', '');
        secret?.setAttribute('hidden', '');
        return false;
      }
      const { data: enrollment, error: enrollmentError } = await supabase.auth.mfa.enroll({ factorType: 'totp', friendlyName: 'Citizen Affairs staff' });
      if (enrollmentError) throw enrollmentError;
      mfaFactorId = enrollment.id;
      if (instructions) instructions.textContent = 'Scan this QR code in your authenticator app, then enter its 6-digit code.';
      if (qr) { qr.src = enrollment.totp.qr_code; qr.removeAttribute('hidden'); }
      if (secret) { secret.textContent = enrollment.totp.secret; secret.removeAttribute('hidden'); }
      if (message) message.textContent = 'Two-factor authentication is required for this staff account.';
      return false;
    };

    const textCard = (title: string, details: string[]) => {
      const card = document.createElement('article');
      const heading = document.createElement('h4'); heading.textContent = title;
      card.append(heading);
      for (const detail of details.filter(Boolean)) {
        const paragraph = document.createElement('p'); paragraph.textContent = detail; card.append(paragraph);
      }
      return card;
    };

    const loadAutomation = async () => {
      const message = document.getElementById('automationMessage');
      if (message) message.textContent = '';
      const [topicsResult, dossiersResult, generationsResult, checksResult, imagesResult, runsResult] = await Promise.all([
        supabase.from('topic_candidates').select('id,normalized_topic,source_url,source_authority,status,freshness_label,deadline_urgency,topic_scores(total_score,search_demand_label)').order('discovered_at', { ascending: false }).limit(25),
        supabase.from('research_dossiers').select('id,confidence,conflicts,missing_information,unverified_claims,research_model,completed_at').order('completed_at', { ascending: false }).limit(20),
        supabase.from('article_generation_runs').select('id,dossier_id,status,model_name,prompt_version,sanitized_markdown,created_at').order('created_at', { ascending: false }).limit(20),
        supabase.from('fact_check_runs').select('id,status,model_name,approval_blocked,critical_blockers,checked_at').order('created_at', { ascending: false }).limit(20),
        supabase.from('thumbnail_assets').select('id,status,public_path,alt_text,width,height,byte_size,created_at').order('created_at', { ascending: false }).limit(20),
        supabase.from('automation_runs').select('id,run_type,status,attempt,max_attempts,model_name,error_code,error_message,created_at,duration_ms').order('created_at', { ascending: false }).limit(25),
      ]);
      const failed = [topicsResult, dossiersResult, generationsResult, checksResult, imagesResult, runsResult].find((result) => result.error);
      if (failed?.error) {
        if (message) message.textContent = failed.error.code === '42501' ? 'Your role does not include private automation access.' : failed.error.message;
        return;
      }
      const topics = topicsResult.data || [];
      const dossiers = dossiersResult.data || [];
      const generations = generationsResult.data || [];
      const checks = checksResult.data || [];
      const images = imagesResult.data || [];
      const runs = runsResult.data || [];
      setText('topicCount', topics.length);
      setText('researchCount', dossiers.length);
      setText('blockedCount', checks.filter((item) => item.approval_blocked).length);
      setText('automationRunCount', runs.length);

      const topicList = document.getElementById('topicList');
      topicList?.replaceChildren();
      if (!topics.length) topicList?.append(textCard('No topics yet', ['Official-source discovery has not produced a candidate.']));
      for (const topic of topics) {
        const scores = Array.isArray(topic.topic_scores) ? topic.topic_scores : [topic.topic_scores];
        const score = scores[0];
        const card = textCard(topic.normalized_topic, [
          topic.source_authority + ' · ' + topic.status,
          'Freshness: ' + (topic.freshness_label || 'unknown') + ' · Deadline: ' + (topic.deadline_urgency || 'none') + ' · Score: ' + (score?.total_score ?? 'pending') + ' · Demand: ' + (score?.search_demand_label || 'unknown'),
        ]);
        const source = document.createElement('a'); source.href = topic.source_url; source.target = '_blank'; source.rel = 'noopener noreferrer'; source.textContent = 'Open official source ↗'; card.append(source);
        if (['discovered', 'research_failed'].includes(topic.status)) {
          const queue = document.createElement('button'); queue.type = 'button'; queue.textContent = 'Queue research';
          queue.addEventListener('click', async () => {
            queue.disabled = true;
            const { error: updateError } = await supabase.from('topic_candidates').update({ status: 'queued' }).eq('id', topic.id);
            if (message) message.textContent = updateError ? updateError.message : 'Topic queued for the private worker.';
            await loadAutomation();
          });
          card.append(queue);
        }
        if (topic.status === 'needs_review') {
          const approve = document.createElement('button'); approve.type = 'button'; approve.textContent = 'Approve reviewed topic';
          approve.addEventListener('click', async () => {
            approve.disabled = true;
            const { error: updateError } = await supabase.from('topic_candidates').update({ status: 'approved' }).eq('id', topic.id);
            if (message) message.textContent = updateError ? updateError.message : 'Topic approved for editorial drafting; no article was published.';
            await loadAutomation();
          });
          const reject = document.createElement('button'); reject.type = 'button'; reject.className = 'secondary'; reject.textContent = 'Reject topic';
          reject.addEventListener('click', async () => {
            reject.disabled = true;
            const { error: updateError } = await supabase.from('topic_candidates').update({ status: 'rejected' }).eq('id', topic.id);
            if (message) message.textContent = updateError ? updateError.message : 'Topic rejected.';
            await loadAutomation();
          });
          card.append(approve, reject);
        }
        topicList?.append(card);
      }

      const researchList = document.getElementById('researchList'); researchList?.replaceChildren();
      for (const dossier of dossiers) {
        const generated = generations.find((item) => item.dossier_id === dossier.id);
        const card = textCard('Dossier ' + dossier.id.slice(0, 8), [
          'Confidence: ' + dossier.confidence + ' · ' + new Date(dossier.completed_at).toLocaleString(),
          'Conflicts: ' + (dossier.conflicts?.length || 0) + ' · missing: ' + (dossier.missing_information?.length || 0) + ' · unverified: ' + (dossier.unverified_claims?.length || 0),
          generated ? 'Draft: ' + generated.status + ' · ' + generated.model_name + ' · prompt ' + generated.prompt_version : 'Draft not generated',
        ]);
        if (generated?.sanitized_markdown) {
          const preview = document.createElement('details'); const summary = document.createElement('summary'); summary.textContent = 'Preview generated Markdown';
          const pre = document.createElement('pre'); pre.textContent = generated.sanitized_markdown.slice(0, 4000); preview.append(summary, pre); card.append(preview);
        }
        researchList?.append(card);
      }
      if (!dossiers.length) researchList?.append(textCard('No dossier yet', ['Research begins only for a queued official-source candidate.']));

      const factList = document.getElementById('factCheckList'); factList?.replaceChildren();
      for (const check of checks) factList?.append(textCard('Fact check ' + check.id.slice(0, 8), [
        check.status + ' · ' + (check.approval_blocked ? 'BLOCKED' : 'eligible for human review'),
        'Critical blockers: ' + (check.critical_blockers?.length || 0) + ' · model: ' + check.model_name,
      ]));
      for (const asset of images) factList?.append(textCard('Image ' + asset.status, [
        asset.width + ' × ' + asset.height + ' · ' + Math.round(asset.byte_size / 1024) + ' KB', asset.alt_text, asset.public_path || 'Private editorial asset',
      ]));
      if (!checks.length && !images.length) factList?.append(textCard('No checks or images yet', ['Drafts remain private until independent verification completes.']));

      const runList = document.getElementById('automationList'); runList?.replaceChildren();
      for (const run of runs) runList?.append(textCard(run.run_type + ' · ' + run.status, [
        'Attempt ' + run.attempt + '/' + run.max_attempts + ' · ' + (run.duration_ms ?? 0) + ' ms · ' + new Date(run.created_at).toLocaleString(),
        run.error_message ? (run.error_code || 'error') + ': ' + run.error_message : (run.model_name || 'No model used'),
      ]));
      if (!runs.length) runList?.append(textCard('No automation history', ['Scheduled discovery remains disabled until explicitly configured.']));
    };

    const loadDashboard = async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return show('auth');
      const [{ data: profile, error: profileError }, { data: articles, error: articleError }] = await Promise.all([
        supabase.from('staff_profiles').select('full_name, account_status, department, two_factor_required').eq('id', user.id).single(),
        supabase.from('articles').select('id,title,slug,language,content_type,workflow_status,verification_status,updated_date,next_review_date,version').is('deleted_at', null).order('updated_date', { ascending: false }).limit(50),
      ]);
      if (profileError || profile?.account_status !== 'active') {
        await supabase.auth.signOut();
        if (authMessage) authMessage.textContent = 'Your staff account is not active. Contact an administrator.';
        return show('auth');
      }
      if (profile.two_factor_required) {
        try {
          if (!(await prepareRequiredMfa())) return;
        } catch (error) {
          if (authMessage) authMessage.textContent = error instanceof Error ? error.message : 'Two-factor verification could not start.';
          return show('auth');
        }
      }
      if (articleError) {
        if (authMessage) authMessage.textContent = articleError.message;
        return;
      }
      show('dashboard');
      setText('staffName', profile.full_name);
      setText('staffRole', [profile.department, profile.account_status].filter(Boolean).join(' · '));
      const items = articles || [];
      setText('draftCount', items.filter((item) => ['idea','assigned','draft','changes-requested'].includes(item.workflow_status)).length);
      setText('reviewCount', items.filter((item) => ['submitted','editorial-review','copy-review','final-review'].includes(item.workflow_status)).length);
      setText('verificationCount', items.filter((item) => ['fact-checking','verification-failed'].includes(item.workflow_status)).length);
      setText('dueCount', items.filter((item) => item.next_review_date && new Date(item.next_review_date) <= new Date()).length);
      const list = document.getElementById('articleList');
      if (!list) return;
      list.replaceChildren();
      if (!items.length) {
        const empty = document.createElement('p'); empty.textContent = 'No assignments are visible to this account.'; list.append(empty); return;
      }
      for (const item of items) {
        const card = document.createElement('article');
        const heading = document.createElement('h3'); heading.textContent = item.title;
        const meta = document.createElement('p'); meta.textContent = `${item.language.toUpperCase()} · ${item.content_type} · ${item.workflow_status} · v${item.version}`;
        const badge = document.createElement('span'); badge.textContent = item.verification_status;
        card.append(heading, meta, badge);
        if (['approved', 'scheduled'].includes(item.workflow_status)) {
          const publish = document.createElement('button'); publish.type = 'button'; publish.className = 'publish-button'; publish.textContent = 'Request publication';
          publish.addEventListener('click', () => {
            if (!publishForm || !publishDialog) return;
            (publishForm.elements.namedItem('article_id') as HTMLInputElement).value = item.id;
            setText('publishArticleTitle', `${item.title} · version ${item.version}`);
            if (publishMessage) publishMessage.textContent = '';
            setPublicationBusy(false);
            publishDialog.showModal();
          });
          card.append(publish);
        }
        list.append(card);
      }
      await loadAutomation();
    };

    document.getElementById('signInForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget as HTMLFormElement);
      if (authMessage) authMessage.textContent = 'Signing in…';
      const { error } = await supabase.auth.signInWithPassword({ email: String(form.get('email')), password: String(form.get('password')) });
      if (error) { if (authMessage) authMessage.textContent = error.message; return; }
      if (authMessage) authMessage.textContent = '';
      await loadDashboard();
    });

    document.getElementById('resetRequestButton')?.addEventListener('click', async () => {
      const email = (document.querySelector('#signInForm input[name="email"]') as HTMLInputElement | null)?.value.trim();
      if (!email) { if (authMessage) authMessage.textContent = 'Enter your staff email first.'; return; }
      if (authMessage) authMessage.textContent = 'Sending a protected password-reset link…';
      const { error } = await supabase.auth.resetPasswordForEmail(email, { redirectTo: window.location.href.split(/[?#]/)[0] });
      if (authMessage) authMessage.textContent = error ? error.message : 'If this is an active staff account, a reset link has been sent.';
    });

    document.getElementById('passwordForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget as HTMLFormElement);
      const password = String(form.get('password') || '');
      const confirmation = String(form.get('confirmation') || '');
      const message = document.getElementById('passwordMessage');
      if (password !== confirmation) { if (message) message.textContent = 'The passwords do not match.'; return; }
      if (message) message.textContent = 'Updating password…';
      const { error } = await supabase.auth.updateUser({ password });
      if (error) { if (message) message.textContent = error.message; return; }
      if (message) message.textContent = 'Password updated. Loading your protected workspace…';
      await loadDashboard();
    });

    document.getElementById('mfaForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget as HTMLFormElement);
      const message = document.getElementById('mfaMessage');
      if (!mfaFactorId) { if (message) message.textContent = 'Authenticator setup expired. Sign in again.'; return; }
      if (message) message.textContent = 'Verifying code…';
      const { error } = await supabase.auth.mfa.challengeAndVerify({ factorId: mfaFactorId, code: String(form.get('code') || '') });
      if (error) { if (message) message.textContent = error.message; return; }
      (event.currentTarget as HTMLFormElement).reset();
      if (message) message.textContent = '';
      await loadDashboard();
    });

    document.getElementById('draftForm')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget as HTMLFormElement);
      if (draftMessage) draftMessage.textContent = 'Creating private draft…';
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) return show('auth');
      const { data: section, error: sectionError } = await supabase.from('sections').select('id').eq('slug', String(form.get('section'))).single();
      if (sectionError) { if (draftMessage) draftMessage.textContent = sectionError.message; return; }
      const { data: group, error: groupError } = await supabase.from('translation_groups').insert({}).select('id').single();
      if (groupError) { if (draftMessage) draftMessage.textContent = groupError.message; return; }
      const { error } = await supabase.from('articles').insert({
        content_type: form.get('content_type'), language: form.get('language'), translation_group_id: group.id,
        title: form.get('title'), slug: form.get('slug'), short_description: form.get('short_description'),
        primary_section_id: section.id, author_id: user.id, workflow_status: 'draft', verification_status: 'under-verification',
      });
      if (error) { if (draftMessage) draftMessage.textContent = error.message; return; }
      (event.currentTarget as HTMLFormElement).reset();
      if (draftMessage) draftMessage.textContent = 'Draft created. Structured job or scheme details are required before review.';
      await loadDashboard();
    });

    document.getElementById('refreshButton')?.addEventListener('click', loadDashboard);
    document.getElementById('refreshAutomationButton')?.addEventListener('click', loadAutomation);
    publishForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (publicationInFlight || !publishForm.reportValidity()) return;
      const form = new FormData(publishForm);
      setPublicationBusy(true);
      if (publishMessage) publishMessage.textContent = 'Checking approvals and starting the protected build…';
      const { data, error } = await supabase.functions.invoke('publish-content', { body: { article_id: form.get('article_id'), reason: form.get('reason') } });
      if (error) {
        if (publishMessage) publishMessage.textContent = await functionErrorMessage(error);
        setPublicationBusy(false);
        return;
      }
      if (publishMessage) publishMessage.textContent = data.message || `Publication event ${data.publication_event_id} is building. The article will not be marked published until deployment succeeds.`;
      window.setTimeout(() => { publishDialog?.close(); publishForm.reset(); loadDashboard(); }, 2400);
    });
    cancelPublish?.addEventListener('click', () => { if (!publicationInFlight) { publishDialog?.close(); publishForm?.reset(); setPublicationBusy(false); } });
    document.getElementById('signOutButton')?.addEventListener('click', async () => { await supabase.auth.signOut(); show('auth'); });
    supabase.auth.onAuthStateChange((authEvent, session) => {
      if (authEvent === 'PASSWORD_RECOVERY') show('password');
      else if (!session) show('auth');
    });
    loadDashboard();
  }
</script>

