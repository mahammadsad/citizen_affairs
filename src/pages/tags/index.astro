---
import MainLayout from '@layouts/MainLayout.astro';
import { getAllTags, getArticlesByTagSlug } from '@lib/content';

const tags = await getAllTags();
const tagsWithCounts = await Promise.all(
  tags.map(async ({ tag, slug }) => ({
    tag,
    slug,
    count: (await getArticlesByTagSlug(slug)).length,
  }))
);
tagsWithCounts.sort((a, b) => b.count - a.count);
---

<MainLayout title="ট্যাগসমূহ" description="সকল ট্যাগ অনুযায়ী আর্টিকেল ব্রাউজ করুন।">
  <div class="container" style="padding-block: var(--space-5);">
    <h1 style="margin-bottom: var(--space-4);">ট্যাগসমূহ</h1>
    <div style="display: flex; flex-wrap: wrap; gap: 0.6rem;">
      {tagsWithCounts.map(({ tag, slug, count }) => (
        <a
          href={`/sarkari-tathya-kendra/tags/${slug}/`}
          style="background: rgba(var(--color-primary-rgb), 0.1); color: var(--color-primary); padding: 0.4em 1em; border-radius: var(--radius-pill); font-size: 0.9rem; text-decoration: none;"
        >
          #{tag} <span style="opacity: 0.7;">({count})</span>
        </a>
      ))}
    </div>
    {tagsWithCounts.length === 0 && (
      <p style="color: var(--color-text-muted);">এখনো কোনো ট্যাগ নেই।</p>
    )}
  </div>
</MainLayout>
