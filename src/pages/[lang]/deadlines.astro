---
import DeadlineActionCenter from '@components/DeadlineActionCenter.astro';
import MainLayout from '@layouts/MainLayout.astro';
import { getUpcomingDeadlines } from '@lib/content';
import { locales, type Locale, ui } from '../../i18n';
import { SITE } from '@utils/constants';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const articles = await getUpcomingDeadlines(locale);
const canonical = `${SITE.url}/${locale}/deadlines/`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, `${SITE.url}/${lang}/deadlines/`])
) as Record<Locale, string>;
---

<MainLayout
  title={t.deadlines}
  description={t.deadlinesDescription}
  {locale}
  {canonical}
  {alternateUrls}
>
  <DeadlineActionCenter {articles} {locale} />
</MainLayout>
