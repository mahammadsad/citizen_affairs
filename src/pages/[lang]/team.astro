---
import TeamPage from '@components/TeamPage.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return (['bn', 'hi'] as Locale[]).map((locale) => ({ params: { lang: locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<TeamPage {locale} />
