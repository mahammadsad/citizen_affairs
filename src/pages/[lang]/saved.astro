---
import SavedActionCenter from '@components/SavedActionCenter.astro';
import MainLayout from '@layouts/MainLayout.astro';
import { locales, type Locale, ui } from '../../i18n';
import { SITE } from '@utils/constants';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const canonical = `${SITE.url}/${locale}/saved/`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, `${SITE.url}/${lang}/saved/`])
) as Record<Locale, string>;
const indexUrl = `${SITE.basePath}${locale}/search-index.json`;
---

<MainLayout
  title={t.saved}
  description={t.savedDescription}
  {locale}
  {canonical}
  {alternateUrls}
  robots="noindex, follow"
>
  <SavedActionCenter {locale} {indexUrl} />
</MainLayout>
