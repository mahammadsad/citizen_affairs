---
import TrustPage from '@components/TrustPage.astro';
import type { Locale } from '../../i18n';
export function getStaticPaths() { return ['bn', 'hi'].map((locale) => ({ params: { lang: locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
---
<TrustPage {locale} page="about" />
