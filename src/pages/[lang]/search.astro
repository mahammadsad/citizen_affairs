---
import SearchPage from '@components/SearchPage.astro';
import SearchResultPlaceholderFix from '@components/SearchResultPlaceholderFix.astro';
import SearchResultsCardEnhancer from '@components/SearchResultsCardEnhancer.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return ['bn', 'hi'].map((lang) => ({ params: { lang }, props: { locale: lang } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<SearchPage {locale} />
<SearchResultsCardEnhancer />
<SearchResultPlaceholderFix />
