---
import MainLayout from '@layouts/MainLayout.astro';
import { BRAND, SITE } from '@utils/constants';
import { policyCopy, type PolicyId } from '../../i18n/policies';
import type { Locale } from '../../i18n';
import { locales, ui } from '../../i18n';

export function getStaticPaths() {
  const policies: PolicyId[] = ['privacy', 'terms', 'disclaimer'];
  return locales.flatMap((locale) => policies.map((policy) => ({ params: { lang: locale, policy }, props: { locale, policy } })));
}
const { locale, policy } = Astro.props as { locale: Locale; policy: PolicyId };
const t = ui(locale);
const titles = { privacy: t.privacy, terms: t.terms, disclaimer: t.disclaimer };
const copy = policyCopy(locale, BRAND.brandName, BRAND.contactEmail);
const canonical = `${SITE.url}/${locale}/${policy}/`;
const alternateUrls = Object.fromEntries(locales.map(lang => [lang, `${SITE.url}/${lang}/${policy}/`])) as Record<Locale, string>;
---
<MainLayout title={titles[policy]} description={t.disclaimerShort} {locale} {canonical} {alternateUrls}>
  <article class="policy container">
    <span class="eyebrow">{titles[policy]}</span>
    <h1>{titles[policy]}</h1>
    <p class="updated">{t.policyUpdated}</p>
    {copy[policy].map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}
  </article>
</MainLayout>
<style>.policy{max-width:780px;padding-block:4rem}.policy h1{font-size:clamp(2rem,5vw,3.4rem);margin-bottom:.4rem}.updated{color:var(--color-text-muted);font-size:.85rem;margin-bottom:2.5rem}.policy section{margin:2rem 0}.policy h2{font-size:1.35rem;margin-bottom:.55rem}.policy p{line-height:1.8;color:var(--color-text-muted)}</style>
