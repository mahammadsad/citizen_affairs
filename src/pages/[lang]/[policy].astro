---
import MainLayout from '@layouts/MainLayout.astro';
import { SITE } from '@utils/constants';
import type { Locale } from '../../i18n';
import { ui } from '../../i18n';

type Policy = 'privacy' | 'terms' | 'disclaimer';
export function getStaticPaths() {
  const policies: Policy[] = ['privacy', 'terms', 'disclaimer'];
  return (['en', 'bn'] as Locale[]).flatMap((locale) => policies.map((policy) => ({ params: { lang: locale, policy }, props: { locale, policy } })));
}
const { locale, policy } = Astro.props as { locale: Locale; policy: Policy };
const t = ui(locale);
const titles = { privacy: t.privacy, terms: t.terms, disclaimer: t.disclaimer };
const copy = {
  en: {
    privacy: [
      ['Information we collect', 'This is currently a static website. It does not operate an account system or store visitor profiles. A language or theme preference may be saved on your device.'],
      ['Analytics and advertising', 'Tracking analytics and advertising are disabled by default. This policy will be updated before either is activated.'],
      ['External services', 'Telegram, WhatsApp and linked government portals apply their own privacy policies when you visit them.'],
      ['Contact', 'For a privacy question, contact us at contact.mahammadsad@gmail.com.'],
    ],
    terms: [
      ['Informational purpose', 'Content is provided to make public information easier to understand. It is not legal, financial or official government advice.'],
      ['Final authority', 'The original notification, order or government portal is the final authority. Always check it before applying or making a payment.'],
      ['Acceptable use', 'Do not reproduce the site in a misleading way, impersonate a government body or use its content for fraud.'],
    ],
    disclaimer: [
      ['Independent platform', 'Sarkari Tathya Kendra is an independent information platform. It is not a government department and does not issue official approvals.'],
      ['Accuracy and corrections', 'We aim to verify dates, amounts, eligibility and links. Government information can change, and corrections are added when identified.'],
      ['External links', 'We link to original sources for convenience but do not control the availability or security of external websites.'],
    ],
  },
  bn: {
    privacy: [
      ['আমরা যে তথ্য সংগ্রহ করি', 'এটি বর্তমানে একটি static website। এখানে account system বা visitor profile সংরক্ষণ করা হয় না। আপনার ভাষা বা theme পছন্দ device-এ সংরক্ষিত হতে পারে।'],
      ['Analytics ও বিজ্ঞাপন', 'Tracking analytics ও বিজ্ঞাপন default অবস্থায় বন্ধ। এগুলো চালু করার আগে এই নীতি update করা হবে।'],
      ['বাহ্যিক পরিষেবা', 'Telegram, WhatsApp ও লিঙ্ক করা সরকারি portal-এ গেলে সংশ্লিষ্ট পরিষেবার privacy policy প্রযোজ্য হবে।'],
      ['যোগাযোগ', 'Privacy সংক্রান্ত প্রশ্নে contact.mahammadsad@gmail.com-এ যোগাযোগ করুন।'],
    ],
    terms: [
      ['তথ্যগত উদ্দেশ্য', 'জনসাধারণের তথ্য সহজে বোঝানোর জন্য content প্রকাশ করা হয়। এটি আইনি, আর্থিক বা সরকারি পরামর্শ নয়।'],
      ['চূড়ান্ত কর্তৃপক্ষ', 'মূল বিজ্ঞপ্তি, order বা সরকারি portal-ই চূড়ান্ত। আবেদন বা payment করার আগে সেটি অবশ্যই যাচাই করুন।'],
      ['গ্রহণযোগ্য ব্যবহার', 'ওয়েবসাইটকে বিভ্রান্তিকরভাবে নকল করা, সরকারি প্রতিষ্ঠান হিসেবে পরিচয় দেওয়া বা প্রতারণায় content ব্যবহার করা যাবে না।'],
    ],
    disclaimer: [
      ['স্বাধীন প্ল্যাটফর্ম', 'সরকারি তথ্যকেন্দ্র একটি স্বাধীন তথ্য প্ল্যাটফর্ম। এটি কোনো সরকারি দপ্তর নয় এবং কোনো official approval প্রদান করে না।'],
      ['নির্ভুলতা ও সংশোধন', 'আমরা তারিখ, অর্থের পরিমাণ, যোগ্যতা ও লিঙ্ক যাচাই করার চেষ্টা করি। সরকারি তথ্য পরিবর্তিত হতে পারে; ভুল শনাক্ত হলে সংশোধন করা হয়।'],
      ['বাহ্যিক লিঙ্ক', 'সুবিধার জন্য মূল সূত্রের লিঙ্ক দেওয়া হয়, কিন্তু বাহ্যিক ওয়েবসাইটের availability বা security আমাদের নিয়ন্ত্রণে নেই।'],
    ],
  },
};
const canonical = `${SITE.url}/${locale}/${policy}/`;
const alternateUrl = `${SITE.url}/${locale === 'en' ? 'bn' : 'en'}/${policy}/`;
---
<MainLayout title={titles[policy]} description={t.disclaimerShort} {locale} {canonical} {alternateUrl}>
  <article class="policy container"><span class="eyebrow">{titles[policy]}</span><h1>{titles[policy]}</h1><p class="updated">{locale === 'bn' ? 'সর্বশেষ আপডেট: জুলাই ২০২৬' : 'Last updated: July 2026'}</p>{copy[locale][policy].map(([heading, body]) => <section><h2>{heading}</h2><p>{body}</p></section>)}</article>
</MainLayout>
<style>.policy{max-width:780px;padding-block:4rem}.policy h1{font-size:clamp(2rem,5vw,3.4rem);margin-bottom:.4rem}.updated{color:var(--color-text-muted);font-size:.85rem;margin-bottom:2.5rem}.policy section{margin:2rem 0}.policy h2{font-size:1.35rem;margin-bottom:.55rem}.policy p{line-height:1.8;color:var(--color-text-muted)}</style>
