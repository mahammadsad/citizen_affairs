---
import MainLayout from '@layouts/MainLayout.astro';
import { getCollection } from 'astro:content';
import { categoryDescription, categoryName } from '@lib/content';
import { locales, type Locale, localizedPath, ui } from '../../../i18n';
import { SITE } from '@utils/constants';

export function getStaticPaths() { return locales.map((lang) => ({ params: { lang }, props: { locale: lang } })); }
const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const categories = await getCollection('categories');
const canonical = `${SITE.url}/${locale}/categories/`;
const alternateUrls = Object.fromEntries(locales.map(lang=>[lang,`${SITE.url}/${lang}/categories/`])) as Record<Locale,string>;
---
<MainLayout title={t.categories} description={t.whatWeCover} {locale} {canonical} {alternateUrls}>
  <section class="listing-hero"><div class="container"><span class="eyebrow">{t.categories}</span><h1>{t.whatWeCover}</h1><p>{t.categoriesDescription}</p></div></section>
  <section class="section"><div class="container category-grid">{categories.map((category) => <a class="category-card" href={localizedPath(locale, `categories/${category.id}`)}><span class={`bar color-${category.data.color || 'primary'}`}></span><div><h2>{categoryName(category, locale)}</h2><p>{categoryDescription(category, locale)}</p></div><b>→</b></a>)}</div></section>
</MainLayout>
<style>.listing-hero{padding:3.5rem 0;background:linear-gradient(135deg,rgba(var(--color-primary-rgb),.08),rgba(var(--color-green-rgb),.06))}.listing-hero h1{font-size:clamp(2rem,5vw,3.5rem)}.listing-hero p{color:var(--color-text-muted);max-width:62ch}.category-grid{display:grid;gap:1rem}.category-card{display:grid;grid-template-columns:6px 1fr auto;gap:1.1rem;align-items:center;padding:1.4rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:18px}.category-card:hover{box-shadow:var(--shadow-md);transform:translateY(-2px)}.bar{height:100%;min-height:60px;border-radius:99px;background:var(--color-primary)}.color-green{background:var(--color-green)}.color-orange{background:var(--color-orange)}.category-card h2{font-size:1.15rem}.category-card p{color:var(--color-text-muted);font-size:.88rem}.category-card b{color:var(--color-primary)}@media(min-width:760px){.category-grid{grid-template-columns:repeat(2,1fr)}}</style>
