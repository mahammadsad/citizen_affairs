---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import CategoryPortal from '@components/CategoryPortal.astro';
import GovernmentJobsPortal from '@components/GovernmentJobsPortal.astro';
import GovernmentJobsRegionFilter from '@components/GovernmentJobsRegionFilter.astro';
import MainLayout from '@layouts/MainLayout.astro';
import { categoryDescription, categoryName, getLocalizedArticlesByCategory } from '@lib/content';
import { ACTIVE_CATEGORY_IDS, SITE } from '@utils/constants';
import { locales, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  const categories = (await getCollection('categories')).filter((category) =>
    ACTIVE_CATEGORY_IDS.includes(category.id)
  );
  return locales.flatMap((locale) =>
    categories.map((category) => ({
      params: { lang: locale, category: category.id },
      props: { locale, category }
    }))
  );
}

const { locale, category } = Astro.props as {
  locale: Locale;
  category: CollectionEntry<'categories'>;
};
const articles = await getLocalizedArticlesByCategory(locale, category.id);
const name = categoryName(category, locale);
const description = categoryDescription(category, locale) || name;
const canonical = `${SITE.url}/${locale}/categories/${category.id}/`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, `${SITE.url}/${lang}/categories/${category.id}/`])
) as Record<Locale, string>;
---

<MainLayout title={name} {description} {locale} {canonical} {alternateUrls}>
  {category.id === 'jobs' ? (
    <>
      <GovernmentJobsPortal {locale} {category} {articles} />
      <GovernmentJobsRegionFilter {locale} {articles} />
    </>
  ) : (
    <CategoryPortal {locale} {category} {articles} />
  )}
</MainLayout>
