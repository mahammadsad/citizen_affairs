---
import { getCollection, type CollectionEntry } from 'astro:content';
import AuthorProfile from '@components/AuthorProfile.astro';
import type { Locale } from '../../../i18n';

export async function getStaticPaths() {
  const authors = (await getCollection('authors')).filter((author) => author.id !== 'citizen-affairs-editorial-desk');
  return (['bn', 'hi'] as Locale[]).flatMap((locale) => authors.map((author) => ({ params: { lang: locale, slug: author.id }, props: { locale, author } })));
}
const { locale, author } = Astro.props as { locale: Locale; author: CollectionEntry<'authors'> };
---
<AuthorProfile {locale} {author} />
