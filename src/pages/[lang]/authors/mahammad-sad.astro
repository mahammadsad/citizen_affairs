---
import LanguageRedirect from '@components/LanguageRedirect.astro';
import type { Locale } from '../../../i18n';

export function getStaticPaths() {
  return (['bn', 'hi'] as Locale[]).map((locale) => ({ params: { lang: locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<LanguageRedirect target={`/${locale}/team/`} title="Continue to the Citizen Affairs team" />
