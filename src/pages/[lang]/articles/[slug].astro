---
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { getCollection } from 'astro:content';
import { getArticleTranslation } from '@lib/content';
import type { Locale } from '../../../i18n';
import { SITE } from '@utils/constants';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { lang: article.data.language, slug: article.data.urlSlug }, props: { article } }));
}
const { article } = Astro.props;
const locale = article.data.language as Locale;
const otherLocale: Locale = locale === 'en' ? 'bn' : 'en';
const translation = await getArticleTranslation(article.data.translationKey, otherLocale);
const alternateUrl = translation ? `${SITE.url}/${otherLocale}/articles/${translation.data.urlSlug}/` : undefined;
const canonical = article.data.canonical || `${SITE.url}/${locale}/articles/${article.data.urlSlug}/`;
const { Content } = await article.render();
---
<ArticleLayout locale={locale} {alternateUrl} title={article.data.title} description={article.data.description} author={article.data.author} date={article.data.date} updated={article.data.updated} lastVerified={article.data.lastVerified} deadline={article.data.deadline} category={article.data.category} tags={article.data.tags} {canonical} featuredImage={article.data.featuredImage} featuredImageAlt={article.data.featuredImageAlt} seoTitle={article.data.seoTitle} seoDescription={article.data.seoDescription} verificationStatus={article.data.verificationStatus} sourceUrls={article.data.sourceUrls} officialNoticeUrl={article.data.officialNoticeUrl} applicationUrl={article.data.applicationUrl}>
  <Content />
</ArticleLayout>
