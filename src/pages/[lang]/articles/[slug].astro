---
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { getCollection, render } from 'astro:content';
import { getArticleTranslation, getRelatedArticles } from '@lib/content';
import { locales, type Locale } from '../../../i18n';
import { SITE } from '@utils/constants';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) =>
    !data.draft && ['published', 'corrected', 'closed'].includes(data.workflowStatus) && data.verificationStatus !== 'withdrawn'
  );
  return articles.map((article) => ({ params: { lang: article.data.language, slug: article.data.urlSlug }, props: { article } }));
}
const { article } = Astro.props;
const locale = article.data.language as Locale;
const translations = await Promise.all(locales.map(async (lang) => [lang, await getArticleTranslation(article.data.translationKey, lang)] as const));
const alternateUrls = Object.fromEntries(translations.filter(([,entry]) => Boolean(entry)).map(([lang,entry]) => [lang, `${SITE.url}/${lang}/articles/${entry!.data.urlSlug}/`])) as Partial<Record<Locale,string>>;
const canonical = article.data.canonical || `${SITE.url}/${locale}/articles/${article.data.urlSlug}/`;
const related = await getRelatedArticles(locale, article.data.category, article.data.urlSlug);
const { Content } = await render(article);
---
<ArticleLayout locale={locale} {alternateUrls} contentType={article.data.contentType} title={article.data.title} description={article.data.description} author={article.data.author} assignedEditor={article.data.assignedEditor} factCheckedBy={article.data.factCheckedBy} reviewedBy={article.data.reviewedBy} publishedBy={article.data.publishedBy} date={article.data.date} updated={article.data.updated} lastVerified={article.data.lastVerified} deadline={article.data.deadline} category={article.data.category} tags={article.data.tags} {canonical} featuredImage={article.data.featuredImage} featuredImageAvif={article.data.featuredImageAvif} featuredImageSrcSet={article.data.featuredImageSrcSet} featuredImageAvifSrcSet={article.data.featuredImageAvifSrcSet} featuredImageWidth={article.data.featuredImageWidth} featuredImageHeight={article.data.featuredImageHeight} featuredImageAlt={article.data.featuredImageAlt} seoTitle={article.data.seoTitle} seoDescription={article.data.seoDescription} verificationStatus={article.data.verificationStatus} sourceUrls={article.data.sourceUrls} sources={article.data.sources} officialNoticeUrl={article.data.officialNoticeUrl} applicationUrl={article.data.applicationUrl} urlSlug={article.data.urlSlug} quickSummary={article.data.quickSummary} importantDates={article.data.importantDates} qualification={article.data.qualification} requiredDocuments={article.data.requiredDocuments} updateHistory={article.data.updateHistory} amountOrVacancies={article.data.amountOrVacancies} faqs={article.data.faqs} {related}>
  <Content />
</ArticleLayout>
