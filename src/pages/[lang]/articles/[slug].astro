---
import ArticleLayout from '@layouts/ArticleLayout.astro';
import ArticleEntryExperience from '@components/ArticleEntryExperience.astro';
import ArticleDecisionWorkspace from '@components/ArticleDecisionWorkspace.astro';
import ArticleChangeHistory from '@components/ArticleChangeHistory.astro';
import ArticleFreshnessNotice from '@components/ArticleFreshnessNotice.astro';
import ArticleStructuredData from '@components/ArticleStructuredData.astro';
import { getCollection, render } from 'astro:content';
import { getArticleTranslation, getRelatedArticles } from '@lib/content';
import { canOfferApplicationAction } from '@lib/freshness';
import { locales, type Locale } from '../../../i18n';
import { SITE } from '@utils/constants';

const articleUrl = (locale: Locale, slug: string) =>
  locale === 'en'
    ? `${SITE.url}/articles/${slug}/`
    : `${SITE.url}/${locale}/articles/${slug}/`;

export async function getStaticPaths() {
  const articles = await getCollection(
    'articles',
    ({ data }) =>
      data.language !== 'en' &&
      !data.draft &&
      ['published', 'corrected', 'closed'].includes(data.workflowStatus) &&
      data.verificationStatus !== 'withdrawn'
  );
  return articles.map((article) => ({
    params: { lang: article.data.language, slug: article.data.urlSlug },
    props: { article }
  }));
}

const { article } = Astro.props;
const locale = article.data.language as Locale;
const translations = await Promise.all(
  locales.map(async (lang) => [lang, await getArticleTranslation(article.data.translationKey, lang)] as const)
);
const alternateUrls = Object.fromEntries(
  translations
    .filter(([, entry]) => Boolean(entry))
    .map(([lang, entry]) => [lang, articleUrl(lang, entry!.data.urlSlug)])
) as Partial<Record<Locale, string>>;
const canonical = article.data.canonical || articleUrl(locale, article.data.urlSlug);
const related = await getRelatedArticles(locale, article.data.category, article.data.urlSlug);
const layoutContentType =
  article.data.contentType === 'job' || article.data.contentType === 'scheme'
    ? article.data.contentType
    : 'explainer';
const { Content } = await render(article);

const officialNoticeUrl =
  article.data.officialNoticeUrl ||
  article.data.job?.officialNotificationUrl ||
  article.data.admission?.officialProspectusUrl ||
  article.data.alert?.officialOrderUrl;
const applicationUrl =
  article.data.applicationUrl ||
  article.data.job?.officialApplicationUrl ||
  article.data.scheme?.officialPortal ||
  article.data.admission?.officialApplicationUrl ||
  article.data.scholarship?.officialPortal ||
  article.data.service?.officialPortal;
const safeApplicationUrl = canOfferApplicationAction(article.data) ? applicationUrl : undefined;
const decisionQualification = article.data.qualification.length
  ? article.data.qualification
  : article.data.job?.qualification ||
    article.data.scheme?.eligibilityCriteria ||
    article.data.admission?.eligibilityCriteria ||
    article.data.scholarship?.eligibilityCriteria ||
    article.data.service?.eligibilityCriteria ||
    [];
const decisionDocuments = article.data.requiredDocuments.length
  ? article.data.requiredDocuments
  : article.data.scheme?.requiredDocuments ||
    article.data.scholarship?.requiredDocuments ||
    article.data.service?.requiredDocuments ||
    [];
const decisionAmount =
  article.data.amountOrVacancies ||
  (article.data.job ? article.data.job.totalVacancies.toLocaleString(locale) : undefined) ||
  article.data.scheme?.benefitAmount ||
  article.data.scholarship?.benefitAmount;
const sourceLinks = [
  ...article.data.sources.map((source) => source.url),
  ...article.data.sourceUrls,
  officialNoticeUrl,
  applicationUrl
].filter((value): value is string => Boolean(value));
const sourceCount = new Set(sourceLinks).size;
---

<ArticleLayout
  locale={locale}
  {alternateUrls}
  contentType={layoutContentType}
  title={article.data.title}
  description={article.data.description}
  author={article.data.author}
  assignedEditor={article.data.assignedEditor}
  factCheckedBy={article.data.factCheckedBy}
  reviewedBy={article.data.reviewedBy}
  publishedBy={article.data.publishedBy}
  date={article.data.date}
  updated={article.data.updated}
  lastVerified={article.data.lastVerified}
  deadline={article.data.deadline}
  category={article.data.category}
  tags={article.data.tags}
  {canonical}
  featuredImage={article.data.featuredImage}
  featuredImageAvif={article.data.featuredImageAvif}
  featuredImageSrcSet={article.data.featuredImageSrcSet}
  featuredImageAvifSrcSet={article.data.featuredImageAvifSrcSet}
  featuredImageWidth={article.data.featuredImageWidth}
  featuredImageHeight={article.data.featuredImageHeight}
  featuredImageAlt={article.data.featuredImageAlt}
  seoTitle={article.data.seoTitle}
  seoDescription={article.data.seoDescription}
  verificationStatus={article.data.verificationStatus}
  sourceUrls={article.data.sourceUrls}
  sources={article.data.sources}
  {officialNoticeUrl}
  applicationUrl={safeApplicationUrl}
  urlSlug={article.data.urlSlug}
  quickSummary={[]}
  importantDates={[]}
  qualification={[]}
  requiredDocuments={[]}
  updateHistory={[]}
  amountOrVacancies={undefined}
  faqs={article.data.faqs}
  {related}
>
  <ArticleStructuredData
    {article}
    {canonical}
    applicationUrl={safeApplicationUrl}
  />
  <Content />
  <ArticleEntryExperience locale={locale}>
    <ArticleDecisionWorkspace
      locale={locale}
      contentType={layoutContentType}
      verificationStatus={article.data.verificationStatus}
      lastVerified={article.data.lastVerified}
      deadline={article.data.deadline}
      {sourceCount}
      {officialNoticeUrl}
      applicationUrl={safeApplicationUrl}
      quickSummary={article.data.quickSummary}
      importantDates={article.data.importantDates}
      qualification={decisionQualification}
      requiredDocuments={decisionDocuments}
      amountOrVacancies={decisionAmount}
    />
  </ArticleEntryExperience>
  <ArticleFreshnessNotice
    locale={locale}
    contentType={article.data.contentType}
    workflowStatus={article.data.workflowStatus}
    verificationStatus={article.data.verificationStatus}
    lastVerified={article.data.lastVerified}
    nextReviewDate={article.data.nextReviewDate}
    deadline={article.data.deadline}
  />
  <ArticleChangeHistory
    locale={locale}
    updateHistory={article.data.updateHistory}
    correctionHistory={article.data.correctionHistory}
  />
</ArticleLayout>
