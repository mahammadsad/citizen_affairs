---
import MainLayout from '@layouts/MainLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import { getLocalizedArticles } from '@lib/content';
import { locales, type Locale, localizedPath, ui } from '../../../i18n';
import { SITE } from '@utils/constants';

export function getStaticPaths() { return locales.map((lang) => ({ params: { lang }, props: { locale: lang } })); }
const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const articles = await getLocalizedArticles(locale);
const canonical = `${SITE.url}/${locale}/articles/`;
const alternateUrls = Object.fromEntries(locales.map(lang=>[lang,`${SITE.url}/${lang}/articles/`])) as Record<Locale,string>;
---
<MainLayout title={t.articles} description={t.latestDescription} {locale} {canonical} {alternateUrls}>
  <section class="listing-hero"><div class="container"><span class="eyebrow">{t.articles}</span><h1>{t.latest}</h1><p>{t.latestDescription}</p></div></section>
  <section class="section"><div class="container"><details class="filter-panel"><summary>{locale==='bn'?'ফিল্টার ও সাজানো':locale==='hi'?'फ़िल्टर और क्रम':'Filters & sorting'}</summary><div class="filters"><select id="levelFilter" aria-label="Government level"><option value="">{locale==='bn'?'সব সরকার':locale==='hi'?'सभी सरकारें':'All governments'}</option><option value="central">Central Government</option><option value="west-bengal">West Bengal</option><option value="other-state">Other states</option></select><select id="categoryFilter" aria-label="Category"><option value="">{t.allCategories}</option>{['jobs','projects','exams','affairs','notices','materials'].map(id=><option value={id}>{id}</option>)}</select><select id="statusFilter" aria-label="Deadline status"><option value="">{locale==='bn'?'সব অবস্থা':locale==='hi'?'सभी स्थितियाँ':'All statuses'}</option><option value="open">Open</option><option value="closing-soon">Closing Soon</option><option value="urgent">3 days or fewer</option><option value="closed">Closed</option></select><select id="verificationFilter" aria-label="Verification"><option value="">{t.verification}</option><option value="officially-confirmed">Confirmed</option><option value="under-verification">Under Verification</option></select><select id="sortArticles" aria-label="Sort"><option value="latest">Latest</option><option value="deadline">Nearest Deadline</option></select></div></details><div class="listing-toolbar"><span id="resultCount">{articles.length} {t.articleCount}</span><a href={localizedPath(locale,'deadlines')}>{t.deadlines} →</a></div><div class="articles-grid" id="articleGrid">{articles.map((article) => <ArticleCard {article} {locale} />)}</div>{!articles.length && <p class="empty-state">{t.noArticles}</p>}<p id="filteredEmpty" class="empty-state" hidden>{t.noResults}</p></div></section>
</MainLayout>
<script>const grid=document.getElementById('articleGrid');const selects=[...document.querySelectorAll<HTMLSelectElement>('.filters select')];const apply=()=>{if(!grid)return;const [level,category,status,verification,sort]=selects.map(s=>s.value);const cards=[...grid.children] as HTMLElement[];let visible=0;cards.forEach(card=>{const show=(!level||card.dataset.level===level)&&(!category||card.dataset.category===category)&&(!status||card.dataset.status===status)&&(!verification||card.dataset.verification===verification);card.hidden=!show;if(show)visible++});cards.sort((a,b)=>sort==='deadline'?(Date.parse(a.dataset.deadline||'9999-12-31')-Date.parse(b.dataset.deadline||'9999-12-31')):(Date.parse(b.dataset.date||'')-Date.parse(a.dataset.date||''))).forEach(c=>grid.append(c));const count=document.getElementById('resultCount');if(count)count.textContent=String(visible);const empty=document.getElementById('filteredEmpty');if(empty)empty.hidden=visible>0};selects.forEach(s=>s.addEventListener('change',apply));</script>
<style>.listing-hero{padding:3.5rem 0;background:linear-gradient(135deg,rgba(var(--color-primary-rgb),.08),rgba(var(--color-green-rgb),.06))}.listing-hero h1{font-size:clamp(2rem,5vw,3.5rem)}.listing-hero p{color:var(--color-text-muted);max-width:60ch}.filter-panel{margin-bottom:1rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;padding:.8rem}.filter-panel summary{cursor:pointer;font-weight:800;min-height:44px;display:flex;align-items:center}.filters{display:grid;grid-template-columns:repeat(5,1fr);gap:.6rem;padding-top:.6rem}.filters select{min-height:44px;border:1px solid var(--color-border);border-radius:10px;padding:.5rem}.listing-toolbar{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem;color:var(--color-text-muted)}.listing-toolbar a{color:var(--color-primary);font-weight:700}.articles-grid{display:grid;gap:1.2rem}@media(min-width:680px){.articles-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:980px){.articles-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:760px){.filters{grid-template-columns:1fr}.filter-panel[open]{position:relative}}</style>
