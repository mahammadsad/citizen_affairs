---
import ContactPage from '@components/ContactPage.astro';
import type { Locale } from '../../i18n';
export function getStaticPaths() {
  return ['bn', 'hi'].map((locale) => ({ params: { lang: locale }, props: { locale } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<ContactPage {locale} />
