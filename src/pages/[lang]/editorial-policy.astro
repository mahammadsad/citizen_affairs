---
import MainLayout from '@layouts/MainLayout.astro';
import { locales, type Locale, ui } from '../../i18n';
import { SITE } from '@utils/constants';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang }, props: { locale: lang } })); }
const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const canonical = `${SITE.url}/${locale}/editorial-policy/`;
const alternateUrl = `${SITE.url}/${locale === 'en' ? 'bn' : 'en'}/editorial-policy/`;
---
<MainLayout title={t.editorial} description={t.disclaimerShort} {locale} {canonical} {alternateUrl}>
  <article class="policy container"><span class="eyebrow">{t.editorial}</span><h1>{t.editorial}</h1>{locale === 'bn' ? <><p>সরকারি তথ্যকেন্দ্র কোনো সরকারি প্রতিষ্ঠান নয়। আমরা অফিসিয়াল দপ্তর, বিজ্ঞপ্তি, PDF ও সরকারি পোর্টালকে প্রাথমিক সূত্র হিসেবে ব্যবহার করি।</p><h2>প্রকাশের নিয়ম</h2><ul><li>তারিখ, অর্থের পরিমাণ, শূন্যপদ ও যোগ্যতা মূল নথির সঙ্গে মিলিয়ে দেখা হয়।</li><li>শুধু সংবাদমাধ্যমে প্রকাশিত দাবি অফিসিয়াল নিশ্চিতকরণ না পাওয়া পর্যন্ত “যাচাই চলছে” হিসেবে চিহ্নিত থাকে।</li><li>সংশোধনী, বাতিল বা সময়সীমা বৃদ্ধির তথ্য পাওয়া গেলে article update করা হয়।</li><li>গুরুত্বপূর্ণ সিদ্ধান্তের আগে পাঠককে মূল বিজ্ঞপ্তি পড়তে বলা হয়।</li></ul><h2>সংশোধন</h2><p>ভুল শনাক্ত হলে তথ্য সংশোধন করে update date ও verification status পরিবর্তন করা হবে।</p></> : <><p>Sarkari Tathya Kendra is not a government body. Official departments, notifications, PDFs and government portals are our primary sources.</p><h2>Publishing rules</h2><ul><li>Dates, amounts, vacancies and eligibility are checked against the original document.</li><li>Claims reported only by media remain labelled “under verification” until official confirmation is available.</li><li>Corrections, withdrawals and deadline extensions are added to the relevant article.</li><li>Readers are directed to the original notice before making an important decision.</li></ul><h2>Corrections</h2><p>When an error is identified, the information, update date and verification status are corrected transparently.</p></>}</article>
</MainLayout>
<style>.policy{max-width:780px;padding-block:4rem}.policy h1{font-size:clamp(2rem,5vw,3.4rem);margin-bottom:1.5rem}.policy h2{margin:2rem 0 .7rem}.policy p,.policy li{line-height:1.8;color:var(--color-text-muted)}.policy ul{list-style:disc;margin-left:1.3rem}</style>
