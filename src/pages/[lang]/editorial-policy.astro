---
import EditorialPolicyPage from '@components/EditorialPolicyPage.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return ['bn', 'hi'].map((lang) => ({ params: { lang }, props: { locale: lang } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<EditorialPolicyPage {locale} />
