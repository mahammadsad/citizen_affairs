---
import MainLayout from '@layouts/MainLayout.astro';
import { locales, type Locale, ui } from '../../i18n';
import { SITE } from '@utils/constants';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang }, props: { locale: lang } })); }
const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const canonical = `${SITE.url}/${locale}/editorial-policy/`;
const alternateUrls = Object.fromEntries(locales.map(lang=>[lang,`${SITE.url}/${lang}/editorial-policy/`])) as Record<Locale,string>;
---
<MainLayout title={t.editorial} description={t.disclaimerShort} {locale} {canonical} {alternateUrls}>
  <article class="policy container"><span class="eyebrow">{t.editorial}</span><h1>{t.editorial}</h1><p>{t.disclaimerShort}</p><h2>{t.howItWorks}</h2><ol><li>{t.stepDiscover}</li><li>{t.stepVerify}</li><li>{t.stepExplain}</li><li>{t.stepUpdate}</li></ol><h2>{locale==='bn'?'প্রকাশ ও সংশোধন':locale==='hi'?'प्रकाशन और सुधार':'Publishing and corrections'}</h2><p>{locale==='bn'?'তারিখ, অর্থ, শূন্যপদ ও যোগ্যতা মূল সরকারি নথির সঙ্গে মিলিয়ে দেখা হয়। নতুন সংশোধনী বা সময়সীমা পরিবর্তন হলে article-এ update history যোগ করা হয়।':locale==='hi'?'तारीख, राशि, रिक्ति और पात्रता मूल सरकारी दस्तावेज़ से मिलाई जाती है। सुधार या अंतिम तिथि बदलने पर लेख का अपडेट इतिहास बदला जाता है।':'Dates, amounts, vacancies and eligibility are checked against original government documents. Corrections and deadline changes are recorded in the article update history.'}</p></article>
</MainLayout>
<style>.policy{max-width:780px;padding-block:4rem}.policy h1{font-size:clamp(2rem,5vw,3.4rem);margin-bottom:1.5rem}.policy h2{margin:2rem 0 .7rem}.policy p,.policy li{line-height:1.8;color:var(--color-text-muted)}.policy ol{list-style:decimal;margin-left:1.3rem}</style>
