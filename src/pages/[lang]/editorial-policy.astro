---
import EditorialPolicyPage from '@components/EditorialPolicyPage.astro';
import { locales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang }, props: { locale: lang } }));
}
const { locale } = Astro.props as { locale: Locale };
---
<EditorialPolicyPage {locale} />
