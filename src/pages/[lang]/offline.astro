---
import OfflineDocument from '@components/OfflineDocument.astro';
import type { Locale } from '../../i18n';

export function getStaticPaths() {
  return ['bn', 'hi'].map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<OfflineDocument {locale} />
