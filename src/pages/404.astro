---
import MainLayout from '@layouts/MainLayout.astro';
import { SITE } from '@utils/constants';
---
<MainLayout
  title="Page not found | Citizen Affairs"
  description="The requested Citizen Affairs page could not be found. Search verified updates or return to the homepage."
  locale="en"
  canonical={`${SITE.url}/404.html`}
  robots="noindex, follow"
>
  <main class="not-found" id="main-content">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page may have moved or the link may be incorrect.</p>
    <nav aria-label="Page not found actions">
      <a class="btn btn-primary" href="/">Homepage</a>
      <a class="btn btn-outline" href="/en/search/">Search</a>
      <a href="/en/categories/jobs/">Government Jobs</a>
      <a href="/en/categories/projects/">Welfare Schemes</a>
    </nav>
    <p class="languages"><a href="/">English</a> · <a href="/bn/">বাংলা</a> · <a href="/hi/">हिन्दी</a></p>
    <a href="mailto:contact.mahammadsad@gmail.com?subject=Broken%20Citizen%20Affairs%20link">Report a broken link</a>
  </main>
</MainLayout>
<style>
  .not-found{min-height:65vh;display:grid;place-content:center;justify-items:start;gap:1rem;width:min(720px,calc(100% - 2rem));margin:auto;padding:4rem 0}.not-found h1{font-size:clamp(2.4rem,8vw,5rem)}.not-found>p{color:var(--color-text-muted)}.not-found nav{display:flex;align-items:center;gap:.8rem;flex-wrap:wrap}.not-found nav a{min-height:44px;display:inline-flex;align-items:center}.languages a,.not-found>a{color:var(--color-primary);text-decoration:underline}
</style>
