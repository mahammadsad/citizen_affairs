---
import { SITE } from '@utils/constants';
const cases = [
  { width: 320, height: 720, locale: 'hi', label: '320 portrait' },
  { width: 360, height: 780, locale: 'bn', label: '360 portrait' },
  { width: 375, height: 812, locale: 'en', label: '375 portrait' },
  { width: 390, height: 844, locale: 'hi', label: '390 portrait' },
  { width: 412, height: 915, locale: 'bn', label: '412 portrait' },
  { width: 480, height: 800, locale: 'en', label: '480 portrait' },
  { width: 768, height: 1024, locale: 'bn', label: '768 portrait' },
  { width: 768, height: 360, locale: 'hi', label: '768 landscape' },
  { width: 1024, height: 768, locale: 'en', label: '1024 desktop' }
];
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Mobile navigation QA</title></head>
  <body>
    <main data-base-path={SITE.basePath}>
      <h1>Mobile navigation QA</h1>
      <p id="status">Running…</p>
      <div id="results"></div>
      <div id="frames">
        {cases.map((item, index) => <iframe title={item.label} data-index={index} data-label={item.label} data-width={item.width} data-height={item.height} data-locale={item.locale} width={item.width} height={item.height}></iframe>)}
      </div>
    </main>
    <script>
      type Result = { label:string; width:number; height:number; locale:string; pass:boolean; checks:Record<string,boolean|number|string|null> };
      const basePath=(document.querySelector('main') as HTMLElement).dataset.basePath||'/';
      const wait=(ms:number)=>new Promise(resolve=>setTimeout(resolve,ms));
      const frames=[...document.querySelectorAll<HTMLIFrameElement>('iframe[data-width]')];
      const results:Result[]=[];

      const runCase=async(frame:HTMLIFrameElement,index:number)=>{
        const width=Number(frame.dataset.width),height=Number(frame.dataset.height),locale=frame.dataset.locale||'en',label=frame.dataset.label||String(width);
        frame.src=`${basePath}${locale}/?nav-qa=${width}-${height}`;
        await new Promise<void>((resolve,reject)=>{const timeout=setTimeout(()=>reject(new Error(`${label} load timeout`)),15000);frame.addEventListener('load',()=>{clearTimeout(timeout);resolve()},{once:true})});
        await wait(80);
        const win=frame.contentWindow!,doc=frame.contentDocument!,html=doc.documentElement;
        const toggle=doc.getElementById('menuToggle') as HTMLButtonElement|null;
        const drawer=doc.getElementById('mobileMenu') as HTMLElement|null;
        const backdrop=doc.getElementById('mobileBackdrop') as HTMLElement|null;
        const main=doc.getElementById('main-content') as HTMLElement|null;
        const search=doc.getElementById('searchToggle') as HTMLElement|null;
        const language=doc.getElementById('languageTrigger') as HTMLElement|null;
        const desktop=width>=860;
        const beforeMain=main?.getBoundingClientRect().width||0;
        const checks:Record<string,boolean|number|string|null>={
          exactViewport:win.innerWidth===width,
          closedHidden:!!drawer?.hidden&&toggle?.getAttribute('aria-expanded')==='false',
          controlsVisible:!!search&&!!language&&getComputedStyle(search).display!=='none'&&getComputedStyle(language).display!=='none',
          closedNoOverflow:html.scrollWidth<=win.innerWidth+2,
          desktopNav:desktop?getComputedStyle(doc.querySelector('.nav-links') as Element).display==='flex':true
        };
        if(!desktop&&toggle&&drawer&&backdrop&&main){
          toggle.focus();toggle.click();await wait(400);
          const rect=drawer.getBoundingClientRect();
          const labels=[...drawer.querySelectorAll<HTMLAnchorElement>('.drawer-scroll a[href]')].map(a=>a.textContent?.trim()||'');
          checks.openVisible=!drawer.hidden&&drawer.classList.contains('is-open')&&getComputedStyle(drawer).visibility!=='hidden';
          checks.ariaOpen=toggle.getAttribute('aria-expanded')==='true'&&drawer.getAttribute('aria-hidden')==='false';
          checks.completeLinks=labels.length>=15&&labels.some(v=>/Government Jobs|সরকারি চাকরি|सरकारी नौकरियाँ/.test(v))&&labels.some(v=>/Welfare Schemes|জনকল্যাণ প্রকল্প|कल्याणकारी योजनाएँ/.test(v))&&labels.some(v=>/Exams|পরীক্ষা|परीक्षाएँ/.test(v))&&labels.some(v=>/Public Services|জনসেবা|सार्वजनिक सेवाएँ/.test(v));
          checks.activePage=!!drawer.querySelector('[aria-current="page"]');
          checks.insideViewport=rect.left>=-1&&rect.right<=win.innerWidth+1&&rect.width<=win.innerWidth+1;
          checks.mainWidthStable=Math.abs(main.getBoundingClientRect().width-beforeMain)<=1;
          checks.openNoOverflow=html.scrollWidth<=win.innerWidth+2;
          checks.bodyLocked=doc.body.classList.contains('menu-open');
          checks.backdropVisible=backdrop.classList.contains('is-open')&&getComputedStyle(backdrop).visibility==='visible';

          if(index%4===0)(doc.getElementById('menuClose') as HTMLButtonElement).click();
          else if(index%4===1)backdrop.click();
          else if(index%4===2)doc.dispatchEvent(new KeyboardEvent('keydown',{key:'Escape',bubbles:true}));
          else {const first=drawer.querySelector<HTMLAnchorElement>('.drawer-quick-links a');first?.addEventListener('click',event=>event.preventDefault(),{once:true});first?.click()}
          await wait(400);
          checks.closedReliably=drawer.hidden&&backdrop.hidden&&toggle.getAttribute('aria-expanded')==='false'&&!doc.body.classList.contains('menu-open');
          checks.focusRestored=index%4===3||doc.activeElement===toggle;

          if(width===390){
            toggle.focus();toggle.click();await wait(400);(drawer.querySelector('.mobile-theme') as HTMLButtonElement)?.click();
            const footer=doc.querySelector('footer');checks.darkMode=html.dataset.theme==='dark'&&footer?getComputedStyle(footer).backgroundColor==='rgb(16, 36, 61)':false;
            (doc.getElementById('menuClose') as HTMLButtonElement).click();await wait(400);
          }
        }
        checks.finalNoOverflow=html.scrollWidth<=win.innerWidth+2;
        const pass=Object.values(checks).every(value=>value===true||typeof value==='number'||typeof value==='string'||value===null);
        results.push({label,width,height,locale,pass,checks});
      };

      try{
        for(let i=0;i<frames.length;i++)await runCase(frames[i],i);
        const resizeFrame=frames.find(frame=>frame.dataset.width==='768')!;
        const resizeDoc=resizeFrame.contentDocument!,resizeToggle=resizeDoc.getElementById('menuToggle') as HTMLButtonElement,resizeDrawer=resizeDoc.getElementById('mobileMenu') as HTMLElement;
        resizeToggle.focus();resizeToggle.click();await wait(400);resizeFrame.width='1024';resizeFrame.style.width='1024px';await wait(500);
        results.push({label:'zoom/viewport expansion while open',width:1024,height:Number(resizeFrame.dataset.height),locale:resizeFrame.dataset.locale||'bn',pass:resizeDrawer.hidden&&resizeToggle.getAttribute('aria-expanded')==='false'&&resizeDoc.documentElement.scrollWidth<=resizeFrame.contentWindow!.innerWidth+2,checks:{drawerClosed:resizeDrawer.hidden,ariaClosed:resizeToggle.getAttribute('aria-expanded')==='false',noOverflow:resizeDoc.documentElement.scrollWidth<=resizeFrame.contentWindow!.innerWidth+2}});
      }catch(error){results.push({label:'harness',width:0,height:0,locale:'en',pass:false,checks:{error:error instanceof Error?error.message:String(error)}})}
      const box=document.getElementById('results')!;box.textContent=JSON.stringify(results,null,2);document.getElementById('status')!.textContent=results.every(result=>result.pass)?'PASS':'FAIL';document.body.dataset.complete='true';
    </script>
    <style>body{font:14px/1.4 system-ui;margin:20px;background:#eef2f7;color:#17202e}h1{margin:0}#status{font-size:1.25rem;font-weight:800}#results{white-space:pre-wrap;background:#fff;border:1px solid #ccd5df;border-radius:10px;padding:12px;margin:12px 0;max-height:45vh;overflow:auto}#frames{display:grid;gap:18px;overflow:auto;align-items:start}iframe{display:block;border:2px solid #8091a5;background:#fff;max-width:none}</style>
  </body>
</html>
