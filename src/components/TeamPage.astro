---
import MainLayout from '@layouts/MainLayout.astro';
import { generateBreadcrumbs } from '@lib/seo';
import { getBrandName, SITE } from '@utils/constants';
import { locales, localizedPath, type Locale } from '../i18n';
import { teamMembers } from '../data/team';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const brandName = getBrandName(locale);
const copy = {
  en: {
    eyebrow: 'Citizen Affairs',
    title: 'Our Team',
    description: 'Meet the people building and supporting Citizen Affairs.',
    intro: 'Citizen Affairs is built as an independent citizen-information platform. Team profiles describe organizational responsibilities; they do not automatically represent article authorship.',
    bylineTitle: 'How article bylines work',
    bylineBody: 'AI-assisted articles do not carry a personal author name. When a human contributor writes an article, they may choose whether their name and public profile appear with that work.',
    growingTitle: 'A growing organization',
    growingBody: 'As new members join, this page will list each person and their role in Citizen Affairs.',
    home: 'Home',
  },
  bn: {
    eyebrow: 'Citizen Affairs',
    title: 'আমাদের টিম',
    description: 'Citizen Affairs গড়ে তোলা ও পরিচালনার সঙ্গে যুক্ত মানুষদের পরিচয়।',
    intro: 'Citizen Affairs একটি স্বাধীন নাগরিক-তথ্য প্ল্যাটফর্ম। টিম প্রোফাইলে সংগঠনের দায়িত্ব দেখানো হয়; তা স্বয়ংক্রিয়ভাবে কোনো নিবন্ধের লেখকত্ব বোঝায় না।',
    bylineTitle: 'নিবন্ধে লেখকের নাম দেখানোর নিয়ম',
    bylineBody: 'AI-এর সহায়তায় তৈরি নিবন্ধে কোনো ব্যক্তির নাম লেখক হিসেবে দেখানো হবে না। কোনো মানুষ নিবন্ধ লিখলে তিনি নিজের নাম ও পাবলিক প্রোফাইল দেখাবেন কি না, তা বেছে নিতে পারবেন।',
    growingTitle: 'বাড়তে থাকা সংগঠন',
    growingBody: 'ভবিষ্যতে নতুন সদস্য যুক্ত হলে এই পেজে প্রত্যেকের নাম ও Citizen Affairs-এ তাঁদের ভূমিকা যোগ করা হবে।',
    home: 'হোম',
  },
  hi: {
    eyebrow: 'Citizen Affairs',
    title: 'हमारी टीम',
    description: 'Citizen Affairs को बनाने और आगे बढ़ाने वाले लोगों से मिलिए।',
    intro: 'Citizen Affairs एक स्वतंत्र नागरिक-सूचना प्लेटफ़ॉर्म है। टीम प्रोफ़ाइल संगठन की जिम्मेदारियाँ बताती है; इससे किसी लेख का लेखक होना अपने-आप सिद्ध नहीं होता।',
    bylineTitle: 'लेखों में नाम दिखाने की नीति',
    bylineBody: 'AI की सहायता से तैयार लेखों पर किसी व्यक्ति का नाम लेखक के रूप में नहीं दिखाया जाएगा। जब कोई मानव योगदानकर्ता लेख लिखता है, तो वह चुन सकता है कि उसका नाम और सार्वजनिक प्रोफ़ाइल उस लेख के साथ दिखे या नहीं।',
    growingTitle: 'बढ़ता हुआ संगठन',
    growingBody: 'नए सदस्य जुड़ने पर इस पेज पर प्रत्येक व्यक्ति और Citizen Affairs में उनकी भूमिका जोड़ी जाएगी।',
    home: 'होम',
  },
}[locale];

const route = locale === 'en' ? '/team/' : `/${locale}/team/`;
const canonical = `${SITE.url}${route}`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, `${SITE.url}${lang === 'en' ? '/team/' : `/${lang}/team/`}`])
) as Record<Locale, string>;
const members = [...teamMembers].sort((a, b) => a.order - b.order);
const breadcrumbSchema = generateBreadcrumbs([
  { name: copy.home, url: locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/` },
  { name: copy.title },
]);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: brandName,
  url: SITE.url,
  founder: members
    .filter((member) => member.id === 'mahammad-sad')
    .map((member) => ({
      '@type': 'Person',
      name: member.name,
      jobTitle: member.role[locale],
      description: member.bio[locale],
    })),
};
---
<MainLayout
  title={copy.title}
  description={copy.description}
  {locale}
  {canonical}
  {alternateUrls}
  structuredData={[organizationSchema, breadcrumbSchema]}
>
  <main class="team-page container">
    <nav class="team-breadcrumbs" aria-label="Breadcrumb">
      <a href={localizedPath(locale)}>{copy.home}</a><span aria-hidden="true">›</span><span>{copy.title}</span>
    </nav>

    <header class="team-hero">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <section class="member-grid" aria-label={copy.title}>
      {members.map((member) => (
        <article class="member-card">
          <div class="member-avatar" aria-hidden="true">{member.initials}</div>
          <div>
            <p class="member-role">{member.role[locale]}</p>
            <h2>{member.name}</h2>
            <p>{member.bio[locale]}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="team-policy" aria-labelledby="bylinePolicyTitle">
      <div>
        <span class="policy-number" aria-hidden="true">01</span>
        <h2 id="bylinePolicyTitle">{copy.bylineTitle}</h2>
        <p>{copy.bylineBody}</p>
      </div>
      <div>
        <span class="policy-number" aria-hidden="true">02</span>
        <h2>{copy.growingTitle}</h2>
        <p>{copy.growingBody}</p>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .team-page{max-width:1040px;padding-block:2rem 5rem}.team-breadcrumbs{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;color:var(--color-text-muted);font-size:.84rem;margin-bottom:2rem}.team-breadcrumbs a{color:var(--color-primary);font-weight:750}.team-hero{max-width:820px;margin-bottom:2.4rem}.team-hero h1{font-size:clamp(2.5rem,7vw,5rem);line-height:1.02;margin:.8rem 0 1rem}.team-hero>p{font-size:clamp(1.05rem,2vw,1.24rem);line-height:1.85;color:var(--color-text-muted)}.member-grid{display:grid;gap:1.2rem}.member-card{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;align-items:start;padding:clamp(1.25rem,3vw,2rem);border:1px solid var(--color-border);border-radius:24px;background:linear-gradient(145deg,var(--color-surface),var(--color-surface-alt));box-shadow:0 18px 60px rgba(15,23,42,.06)}.member-avatar{width:76px;height:76px;border-radius:22px;display:grid;place-items:center;background:var(--color-primary);color:white;font-size:1.35rem;font-weight:900;letter-spacing:.04em}.member-role{display:inline-flex;width:max-content;padding:.3rem .65rem;border-radius:999px;background:rgba(var(--color-primary-rgb),.1);color:var(--color-primary);font-size:.76rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.member-card h2{font-size:clamp(1.55rem,3vw,2.15rem);margin:.55rem 0}.member-card div>p:last-child{max-width:700px;color:var(--color-text-muted);line-height:1.8}.team-policy{display:grid;gap:1rem;margin-top:1.5rem}.team-policy>div{padding:1.4rem;border:1px solid var(--color-border);border-radius:20px;background:var(--color-surface)}.policy-number{display:block;color:var(--color-primary);font-size:.72rem;font-weight:900;letter-spacing:.12em}.team-policy h2{font-size:1.28rem;margin:.45rem 0}.team-policy p{color:var(--color-text-muted);line-height:1.8}@media(min-width:760px){.team-policy{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.team-page{padding-inline:1rem}.member-card{grid-template-columns:1fr}.member-avatar{width:64px;height:64px;border-radius:18px}}
</style>
