---
import MainLayout from '@layouts/MainLayout.astro';
import { generateBreadcrumbs } from '@lib/seo';
import { getBrandName, SITE } from '@utils/constants';
import { locales, localizedPath, type Locale } from '../i18n';
import { teamMembers } from '../data/team';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const brandName = getBrandName(locale);
const copy = {
  en: {
    eyebrow: 'Citizen Affairs',
    title: 'Our Team',
    description: 'Learn how Citizen Affairs handles publication responsibility without publishing individual identities.',
    intro: 'Citizen Affairs is an independent citizen-information platform. Public work is attributed to the publication desk rather than individual profiles.',
    home: 'Home',
  },
  bn: {
    eyebrow: 'Citizen Affairs',
    title: 'আমাদের টিম',
    description: 'ব্যক্তিগত পরিচয় প্রকাশ না করে Citizen Affairs কীভাবে প্রকাশনার দায়িত্ব দেখায় তা জানুন।',
    intro: 'Citizen Affairs একটি স্বাধীন নাগরিক-তথ্য প্ল্যাটফর্ম। এখানে ব্যক্তিগত প্রোফাইলের বদলে প্রকাশনা ডেস্কের নামে কাজ প্রকাশ করা হয়।',
    home: 'হোম',
  },
  hi: {
    eyebrow: 'Citizen Affairs',
    title: 'हमारी टीम',
    description: 'जानें कि Citizen Affairs व्यक्तिगत पहचान प्रकाशित किए बिना प्रकाशन की जिम्मेदारी कैसे दिखाता है।',
    intro: 'Citizen Affairs एक स्वतंत्र नागरिक-सूचना प्लेटफ़ॉर्म है। यहाँ काम व्यक्तिगत प्रोफ़ाइल के बजाय प्रकाशन डेस्क के नाम से प्रकाशित होता है।',
    home: 'होम',
  },
}[locale];

const route = locale === 'en' ? '/team/' : `/${locale}/team/`;
const canonical = `${SITE.url}${route}`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, `${SITE.url}${lang === 'en' ? '/team/' : `/${lang}/team/`}`])
) as Record<Locale, string>;
const members = [...teamMembers].sort((a, b) => a.order - b.order);
const breadcrumbSchema = generateBreadcrumbs([
  { name: copy.home, url: locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/` },
  { name: copy.title },
]);
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: brandName,
  url: SITE.url,
  description: copy.description,
};
---
<MainLayout
  title={copy.title}
  description={copy.description}
  {locale}
  {canonical}
  {alternateUrls}
  structuredData={[organizationSchema, breadcrumbSchema]}
>
  <article class="team-page container">
    <nav class="team-breadcrumbs" aria-label="Breadcrumb">
      <a href={localizedPath(locale)}>{copy.home}</a><span aria-hidden="true">›</span><span>{copy.title}</span>
    </nav>

    <header class="team-hero">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <section class="member-grid" aria-label={copy.title}>
      {members.map((member) => (
        <article class="member-card">
          <div class="member-avatar" aria-hidden="true">{member.initials}</div>
          <div>
            <p class="member-role">{member.role[locale]}</p>
            <h2>{member.name}</h2>
            <p>{member.bio[locale]}</p>
          </div>
        </article>
      ))}
    </section>
  </article>
</MainLayout>

<style>
  .team-page{max-width:1040px;padding-block:2rem 5rem}.team-breadcrumbs{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;color:var(--color-text-muted);font-size:.84rem;margin-bottom:2rem}.team-breadcrumbs a{color:var(--color-primary);font-weight:750}.team-hero{max-width:820px;margin-bottom:2.4rem}.team-hero h1{font-size:clamp(2.5rem,7vw,5rem);line-height:1.02;margin:.8rem 0 1rem}.team-hero>p{font-size:clamp(1.05rem,2vw,1.24rem);line-height:1.85;color:var(--color-text-muted)}.member-grid{display:grid;gap:1.2rem}.member-card{display:grid;grid-template-columns:auto 1fr;gap:1.2rem;align-items:start;padding:clamp(1.25rem,3vw,2rem);border:1px solid var(--color-border);border-radius:24px;background:linear-gradient(145deg,var(--color-surface),var(--color-surface-alt));box-shadow:0 18px 60px rgba(15,23,42,.06)}.member-avatar{width:76px;height:76px;border-radius:22px;display:grid;place-items:center;background:var(--color-primary);color:white;font-size:1.35rem;font-weight:900;letter-spacing:.04em}.member-role{display:inline-flex;width:max-content;padding:.3rem .65rem;border-radius:999px;background:rgba(var(--color-primary-rgb),.1);color:var(--color-primary);font-size:.76rem;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.member-card h2{font-size:clamp(1.55rem,3vw,2.15rem);margin:.55rem 0}.member-card div>p:last-child{max-width:700px;color:var(--color-text-muted);line-height:1.8}@media(max-width:560px){.team-page{padding-inline:1rem}.member-card{grid-template-columns:1fr}.member-avatar{width:64px;height:64px;border-radius:18px}}
</style>
