<script is:inline>
  (() => {
    const trigger = document.querySelector('.portal-mobile-trigger');
    const panel = document.querySelector('.portal-mobile-panel');
    const panelInner = panel?.querySelector('.portal-mobile-panel-inner');
    if (
      !(trigger instanceof HTMLButtonElement) ||
      !(panel instanceof HTMLElement) ||
      !(panelInner instanceof HTMLElement)
    ) return;
    if (trigger.dataset.menuReady === 'true') return;
    trigger.dataset.menuReady = 'true';

    const locale = ['bn', 'hi'].includes(document.documentElement.lang)
      ? document.documentElement.lang
      : 'en';

    /* The persistent bottom bar is intentionally hidden on small screens to
       reclaim reading space. Reuse its localized Search and Saved anchors in
       the expanding menu so those destinations remain one tap away. */
    const navigation = panelInner.querySelector('nav');
    const legacyBottomNavigation = document.querySelector('.portal-mobile-bottom');
    if (navigation instanceof HTMLElement && legacyBottomNavigation instanceof HTMLElement) {
      const homeLink = navigation.querySelector('a');
      const arrowTemplate = homeLink?.querySelector('svg:last-child');
      const utilityFragment = document.createDocumentFragment();
      const utilityLinks = [...legacyBottomNavigation.querySelectorAll('a')].filter((link) => {
        try {
          const pathname = new URL(link.href, location.href).pathname.replace(/\/+$/, '');
          return pathname.endsWith('/search') || pathname.endsWith('/saved');
        } catch (_) {
          return false;
        }
      });

      utilityLinks.forEach((sourceLink) => {
        const link = sourceLink.cloneNode(true);
        if (!(link instanceof HTMLAnchorElement)) return;
        link.classList.add('portal-mobile-utility-link');

        try {
          const currentPath = location.pathname.replace(/\/+$/, '') || '/';
          const targetPath = new URL(link.href, location.href).pathname.replace(/\/+$/, '') || '/';
          if (currentPath === targetPath) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        } catch (_) {}

        if (arrowTemplate) link.append(arrowTemplate.cloneNode(true));
        utilityFragment.append(link);
      });

      homeLink?.after(utilityFragment);
      legacyBottomNavigation.setAttribute('aria-hidden', 'true');
    }

    const followCopy = {
      en: 'Follow Citizen Affairs on',
      bn: 'সিটিজেন অ্যাফেয়ার্সকে অনুসরণ করুন',
      hi: 'Citizen Affairs को फ़ॉलो करें'
    }[locale];
    const socialPlatforms = [
      {
        name: 'X',
        href: 'https://x.com/citizenaffairIn',
        color: '#000000',
        path: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z'
      },
      {
        name: 'Facebook',
        href: 'https://www.facebook.com/profile.php?id=61593098155563',
        color: '#1877F2',
        path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z'
      },
      {
        name: 'WhatsApp',
        href: 'https://whatsapp.com/channel/0029Vb8NQAX9cDDTfaEDwk3r',
        color: '#25D366',
        path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z'
      },
      {
        name: 'Telegram',
        href: 'https://t.me/CitizenAffairsBangla',
        color: '#26A5E4',
        path: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
      }
    ];

    const socialAriaLabel = (platform) => {
      if (locale === 'bn') return `সিটিজেন অ্যাফেয়ার্সকে ${platform}-এ অনুসরণ করুন`;
      if (locale === 'hi') return `Citizen Affairs को ${platform} पर फ़ॉलो करें`;
      return `Follow Citizen Affairs on ${platform}`;
    };

    const socialSection = document.createElement('section');
    socialSection.className = 'container portal-mobile-social';
    socialSection.setAttribute('aria-labelledby', 'portalMobileSocialTitle');

    const socialHeading = document.createElement('h2');
    socialHeading.id = 'portalMobileSocialTitle';
    socialHeading.textContent = followCopy;

    const socialLinks = document.createElement('div');
    socialLinks.className = 'portal-mobile-social-links';
    socialPlatforms.forEach((platform) => {
      const link = document.createElement('a');
      link.className = 'portal-mobile-social-link';
      link.href = platform.href;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.title = platform.name;
      link.setAttribute('aria-label', socialAriaLabel(platform.name));
      link.style.setProperty('--social-color', platform.color);
      link.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="${platform.path}"></path></svg>`;
      socialLinks.append(link);
    });
    socialSection.append(socialHeading, socialLinks);
    panelInner.append(socialSection);

    const desktopQuery = window.matchMedia('(min-width: 1100px)');
    const menuLabel = trigger.dataset.menuLabel || trigger.getAttribute('aria-label') || 'Menu';
    const closeLabel = trigger.dataset.closeLabel || menuLabel;

    const setOpen = (open, restoreFocus = false) => {
      trigger.setAttribute('aria-expanded', String(open));
      trigger.setAttribute('aria-label', open ? closeLabel : menuLabel);
      panel.classList.toggle('is-open', open);
      panel.setAttribute('aria-hidden', String(!open));

      if (open) panel.removeAttribute('inert');
      else panel.setAttribute('inert', '');

      if (!open && restoreFocus) trigger.focus();
    };

    trigger.addEventListener('click', () => {
      setOpen(trigger.getAttribute('aria-expanded') !== 'true');
    });

    panel.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        event.preventDefault();
        setOpen(false, true);
      }
    });

    document.addEventListener('click', (event) => {
      if (trigger.getAttribute('aria-expanded') !== 'true') return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!panel.contains(target) && !trigger.contains(target)) setOpen(false);
    });

    const closeForDesktop = (event) => {
      if (event.matches) setOpen(false);
    };
    desktopQuery.addEventListener('change', closeForDesktop);

    window.addEventListener('pageshow', () => setOpen(false));
    setOpen(false);
  })();
</script>

<style is:global>
  .portal-mobile-social {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .9rem;
    padding-block: .8rem .95rem;
    border-bottom: 1px solid var(--color-border);
    opacity: 0;
    transform: translateY(-6px);
    transition: opacity 170ms ease 55ms, transform 240ms cubic-bezier(.22, 1, .36, 1) 55ms;
  }

  .portal-mobile-panel.is-open .portal-mobile-social {
    opacity: 1;
    transform: translateY(0);
  }

  .portal-mobile-social h2 {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .72rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .portal-mobile-social-links {
    display: flex;
    align-items: center;
    gap: .5rem;
    flex: 0 0 auto;
  }

  .portal-mobile-social-link {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface-alt);
    color: var(--social-color);
    transition: transform 160ms ease, border-color 160ms ease, background-color 160ms ease;
  }

  .portal-mobile-social-link svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .portal-mobile-social-link:hover,
  .portal-mobile-social-link:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--social-color) 50%, var(--color-border));
  }

  .portal-mobile-social-link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }

  @media (max-width: 420px) {
    .portal-mobile-social {
      align-items: flex-start;
      flex-direction: column;
      gap: .55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portal-mobile-social,
    .portal-mobile-social-link {
      transition-duration: .01ms !important;
      transition-delay: 0ms !important;
    }
  }
</style>
