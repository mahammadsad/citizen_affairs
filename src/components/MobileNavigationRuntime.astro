<script is:inline>
  (() => {
    const copy = {
      en: {
        close: 'Close menu',
        search: 'Search',
        searchPlaceholder: 'Search news, jobs, schemes and more',
        home: 'Home',
        sections: 'Sections',
        follow: 'Follow Citizen Affairs on'
      },
      bn: {
        close: 'মেনু বন্ধ করুন',
        search: 'খুঁজুন',
        searchPlaceholder: 'খবর, চাকরি, প্রকল্প ও আরও তথ্য খুঁজুন',
        home: 'হোম',
        sections: 'বিভাগ',
        follow: 'সিটিজেন অ্যাফেয়ার্সকে অনুসরণ করুন'
      },
      hi: {
        close: 'मेनू बंद करें',
        search: 'खोजें',
        searchPlaceholder: 'समाचार, नौकरियाँ, योजनाएँ और अधिक खोजें',
        home: 'होम',
        sections: 'अनुभाग',
        follow: 'Citizen Affairs को फ़ॉलो करें'
      }
    };

    const socialPlatforms = [
      {
        name: 'X',
        href: 'https://x.com/citizenaffairIn',
        color: '#000000',
        path: 'M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182z'
      },
      {
        name: 'Facebook',
        href: 'https://www.facebook.com/profile.php?id=61593098155563',
        color: '#1877F2',
        path: 'M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z'
      },
      {
        name: 'WhatsApp',
        href: 'https://whatsapp.com/channel/0029Vb8NQAX9cDDTfaEDwk3r',
        color: '#25D366',
        path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z'
      },
      {
        name: 'Telegram',
        href: 'https://t.me/CitizenAffairsBangla',
        color: '#26A5E4',
        path: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
      }
    ];

    const locale = ['bn', 'hi'].includes(document.documentElement.lang)
      ? document.documentElement.lang
      : 'en';
    const text = copy[locale];
    const details = document.querySelector('.portal-mobile-menu');
    if (!(details instanceof HTMLDetailsElement)) return;
    if (details.dataset.fullscreenMenuReady === 'true') return;

    const trigger = details.querySelector(':scope > summary');
    const panel = details.querySelector('.portal-mobile-panel');
    const head = panel?.querySelector('.portal-mobile-head');
    const nav = panel?.querySelector('nav');
    if (
      !(trigger instanceof HTMLElement) ||
      !(panel instanceof HTMLElement) ||
      !(head instanceof HTMLElement) ||
      !(nav instanceof HTMLElement)
    ) {
      return;
    }

    details.dataset.fullscreenMenuReady = 'true';
    const originalTriggerLabel = trigger.getAttribute('aria-label') || text.sections;

    const createSpan = (value, className = '') => {
      const span = document.createElement('span');
      span.textContent = value;
      if (className) span.className = className;
      return span;
    };

    const socialAriaLabel = (platform) => {
      if (locale === 'bn') return `সিটিজেন অ্যাফেয়ার্সকে ${platform}-এ অনুসরণ করুন`;
      if (locale === 'hi') return `Citizen Affairs को ${platform} पर फ़ॉलो करें`;
      return `Follow Citizen Affairs on ${platform}`;
    };

    panel.setAttribute('role', 'dialog');
    panel.setAttribute('aria-modal', 'true');
    panel.setAttribute('aria-label', text.sections);
    panel.tabIndex = -1;

    const closeButton = document.createElement('button');
    closeButton.type = 'button';
    closeButton.className = 'portal-mobile-close';
    closeButton.setAttribute('aria-label', text.close);
    closeButton.append(createSpan('×', 'portal-mobile-close-symbol'));

    const sourceBrand = document.querySelector('.portal-brand');
    const mobileBrand = sourceBrand?.cloneNode(true);
    if (mobileBrand instanceof HTMLAnchorElement) {
      mobileBrand.className = 'portal-mobile-brand';
      mobileBrand.removeAttribute('aria-current');
      mobileBrand.querySelector('.portal-brand-logo')?.classList.add('portal-mobile-brand-logo');
    }

    const spacer = document.createElement('span');
    spacer.className = 'portal-mobile-head-spacer';
    spacer.setAttribute('aria-hidden', 'true');
    head.replaceChildren(closeButton, mobileBrand || createSpan(text.sections), spacer);

    const searchSource =
      document.querySelector('.portal-mobile-bottom a[href*="/search"]') ||
      document.querySelector('.portal-search-action');
    const searchForm = document.createElement('form');
    searchForm.className = 'portal-mobile-menu-search';
    searchForm.method = 'get';
    searchForm.action =
      searchSource instanceof HTMLAnchorElement ? searchSource.href : `/${locale}/search/`;
    searchForm.setAttribute('role', 'search');

    const searchInput = document.createElement('input');
    searchInput.type = 'search';
    searchInput.name = 'q';
    searchInput.autocomplete = 'off';
    searchInput.placeholder = text.searchPlaceholder;
    searchInput.setAttribute('aria-label', text.searchPlaceholder);

    const searchButton = document.createElement('button');
    searchButton.type = 'submit';
    searchButton.setAttribute('aria-label', text.search);
    searchButton.innerHTML =
      '<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>';
    searchForm.append(searchInput, searchButton);
    panel.insertBefore(searchForm, nav);

    const homeSource = document.querySelector('.portal-mobile-bottom a:first-child');
    const homeLink = document.createElement('a');
    homeLink.className = 'portal-mobile-home';
    homeLink.href = homeSource instanceof HTMLAnchorElement ? homeSource.href : '/';
    const homeLabel = homeSource?.querySelector('span')?.textContent?.trim() || text.home;
    homeLink.append(createSpan(homeLabel), createSpan('→', 'portal-mobile-row-arrow'));
    nav.prepend(homeLink);

    const socialSection = document.createElement('section');
    socialSection.className = 'portal-mobile-social';
    socialSection.setAttribute('aria-labelledby', 'portalMobileSocialTitle');

    const socialHeading = document.createElement('h2');
    socialHeading.id = 'portalMobileSocialTitle';
    socialHeading.textContent = text.follow;

    const socialLinks = document.createElement('div');
    socialLinks.className = 'portal-mobile-social-links';
    socialPlatforms.forEach((platform) => {
      const link = document.createElement('a');
      link.className = 'portal-mobile-social-link';
      link.href = platform.href;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.title = platform.name;
      link.setAttribute('aria-label', socialAriaLabel(platform.name));
      link.style.setProperty('--social-color', platform.color);
      link.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="${platform.path}"></path></svg>`;
      socialLinks.append(link);
    });
    socialSection.append(socialHeading, socialLinks);
    panel.append(socialSection);

    const closeMenu = (restoreFocus = true) => {
      if (!details.open) return;
      details.removeAttribute('open');
      if (restoreFocus) window.setTimeout(() => trigger.focus(), 0);
    };

    const syncOpenState = () => {
      const isOpen = details.open;
      document.documentElement.classList.toggle('portal-menu-open', isOpen);
      document.body.classList.toggle('portal-menu-open', isOpen);
      trigger.setAttribute('aria-label', isOpen ? text.close : originalTriggerLabel);
      if (isOpen) {
        window.setTimeout(() => {
          searchInput.focus();
          searchInput.select();
        }, 0);
      }
    };

    details.addEventListener('toggle', syncOpenState);
    closeButton.addEventListener('click', () => closeMenu(true));
    panel.addEventListener('click', (event) => {
      const target = event.target;
      if (target instanceof Element && target.closest('a')) closeMenu(false);
    });
    searchForm.addEventListener('submit', () => closeMenu(false));

    const focusableSelector = [
      'a[href]',
      'button:not([disabled])',
      'input:not([disabled])',
      'select:not([disabled])',
      'textarea:not([disabled])',
      '[tabindex]:not([tabindex="-1"])'
    ].join(',');

    document.addEventListener('keydown', (event) => {
      if (!details.open) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = [...panel.querySelectorAll(focusableSelector)].filter(
        (element) =>
          element instanceof HTMLElement &&
          !element.hidden &&
          element.getAttribute('aria-hidden') !== 'true' &&
          element.getClientRects().length > 0
      );
      if (!focusable.length) {
        event.preventDefault();
        panel.focus();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const desktopQuery = window.matchMedia('(min-width: 1100px)');
    desktopQuery.addEventListener?.('change', (event) => {
      if (event.matches) closeMenu(false);
    });
    syncOpenState();
  })();
</script>

<style is:global>
  html.portal-menu-open,
  body.portal-menu-open {
    overflow: hidden !important;
    overscroll-behavior: none;
  }

  body.portal-menu-open .portal-mobile-bottom {
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
  }

  @media (max-width: 1099px) {
    html body .portal-mobile-menu[open] > .portal-mobile-panel {
      position: fixed !important;
      inset: 0 !important;
      z-index: 1000 !important;
      display: flex !important;
      flex-direction: column;
      width: 100vw !important;
      height: 100vh !important;
      height: 100dvh !important;
      max-height: none !important;
      overflow: hidden !important;
      border: 0 !important;
      border-radius: 0 !important;
      background: var(--color-surface) !important;
      box-shadow: none !important;
      overscroll-behavior: contain;
    }

    html body .portal-mobile-panel .portal-mobile-head {
      position: relative;
      z-index: 2;
      display: grid;
      flex: 0 0 auto;
      grid-template-columns: 52px minmax(0, 1fr) 52px;
      align-items: center;
      min-height: calc(72px + env(safe-area-inset-top));
      padding: env(safe-area-inset-top) 1rem 0;
      border-bottom: 1px solid var(--color-border);
      background: var(--color-surface);
    }

    .portal-mobile-close {
      display: grid;
      place-items: center;
      width: 48px;
      height: 48px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--color-text);
      cursor: pointer;
    }

    .portal-mobile-close:hover,
    .portal-mobile-close:focus-visible {
      background: var(--color-surface-alt);
    }

    .portal-mobile-close-symbol {
      font-family: Arial, sans-serif;
      font-size: 2.7rem;
      font-weight: 300;
      line-height: .8;
    }

    .portal-mobile-brand {
      display: grid;
      place-items: center;
      justify-self: center;
      width: min(180px, 52vw);
      min-width: 0;
      line-height: 0;
    }

    .portal-mobile-brand .portal-mobile-brand-logo,
    .portal-mobile-brand .portal-brand-logo {
      display: block;
      width: min(174px, 50vw) !important;
      max-width: 100% !important;
      max-height: 50px !important;
      height: auto !important;
      object-fit: contain;
    }

    .portal-mobile-head-spacer {
      display: block;
      width: 48px;
      height: 48px;
    }

    .portal-mobile-menu-search {
      display: grid;
      flex: 0 0 auto;
      grid-template-columns: minmax(0, 1fr) 58px;
      margin: .85rem 1rem;
      border: 3px solid var(--color-text);
      background: var(--color-surface);
    }

    .portal-mobile-menu-search input {
      min-width: 0;
      min-height: 58px;
      padding: .75rem 1rem;
      border: 0;
      border-radius: 0;
      outline: 0;
      background: transparent;
      color: var(--color-text);
      font: inherit;
      font-size: 1rem;
    }

    .portal-mobile-menu-search input::placeholder {
      color: var(--color-text-muted);
      opacity: 1;
    }

    .portal-mobile-menu-search:focus-within {
      outline: 3px solid rgba(var(--color-primary-rgb), .24);
      outline-offset: 2px;
    }

    .portal-mobile-menu-search button {
      display: grid;
      place-items: center;
      min-width: 58px;
      min-height: 58px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: var(--color-navy);
      color: #fff;
      cursor: pointer;
    }

    .portal-mobile-menu-search button:hover,
    .portal-mobile-menu-search button:focus-visible {
      background: #173a66;
    }

    .portal-mobile-menu-search svg {
      width: 29px;
      height: 29px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-width: 2;
    }

    html body .portal-mobile-panel nav {
      display: block;
      flex: 1 1 auto;
      min-height: 0;
      overflow-x: hidden;
      overflow-y: auto;
      padding: 0 1rem 1.25rem !important;
      scrollbar-gutter: stable;
      -webkit-overflow-scrolling: touch;
    }

    html body .portal-mobile-panel nav a {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 1rem;
      min-height: 64px;
      padding: .8rem 1rem;
      border-bottom: 1px solid var(--color-border);
      border-radius: 0 !important;
      color: var(--color-text);
      font-size: 1rem;
      font-weight: 800;
    }

    html body .portal-mobile-panel nav a:first-child {
      border-left: 5px solid var(--color-primary);
      background: var(--color-surface-alt);
    }

    html body .portal-mobile-panel nav a > svg:first-child {
      display: none;
    }

    html body .portal-mobile-panel nav a > svg:last-child,
    .portal-mobile-row-arrow {
      width: 22px;
      color: var(--color-text);
      font-size: 1.35rem;
      line-height: 1;
    }

    html body .portal-mobile-panel nav a:hover,
    html body .portal-mobile-panel nav a:focus-visible {
      background: var(--color-surface-alt);
      color: var(--color-primary);
    }

    html body .portal-mobile-panel .portal-nav-count {
      position: absolute;
      top: 50%;
      right: 3.35rem;
      margin: 0;
      transform: translateY(-50%);
    }

    .portal-mobile-social {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: .8rem 1rem calc(.8rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--color-border);
      background: var(--color-surface-alt);
    }

    .portal-mobile-social h2 {
      max-width: 16rem;
      margin: 0;
      color: var(--color-text);
      font-size: .82rem;
      font-weight: 850;
      line-height: 1.25;
    }

    .portal-mobile-social-links {
      display: flex;
      flex: 0 0 auto;
      align-items: center;
      gap: .45rem;
    }

    .portal-mobile-social-link {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: #fff;
      color: var(--social-color);
      line-height: 0;
    }

    .portal-mobile-social-link svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    .portal-mobile-social-link:hover {
      border-color: var(--social-color);
      transform: translateY(-1px);
    }

    .portal-mobile-social-link:focus-visible {
      outline: 3px solid var(--color-primary);
      outline-offset: 2px;
    }
  }

  @media (max-width: 470px) {
    .portal-mobile-social {
      align-items: flex-start;
      flex-direction: column;
      gap: .65rem;
    }

    .portal-mobile-social-links {
      width: 100%;
      justify-content: flex-start;
    }
  }

  html[data-theme='dark'] .portal-mobile-menu-search button {
    background: #0a4f57;
  }

  html[data-theme='dark'] .portal-mobile-menu-search button:hover,
  html[data-theme='dark'] .portal-mobile-menu-search button:focus-visible {
    background: #0d6871;
  }
</style>
