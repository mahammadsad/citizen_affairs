---
import MainLayout from '@layouts/MainLayout.astro';
import { REGIONS } from '@lib/regions';
import { SITE } from '@utils/constants';
import { locales, type Locale, ui } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const copy = {
  en: {
    title: 'Search jobs and schemes',
    description: 'Search verified government jobs and welfare schemes by keyword, state, qualification and status.',
    type: 'Information type', allTypes: 'Jobs and schemes', job: 'Government job', scheme: 'Welfare scheme',
    state: 'State or Union Territory', allStates: 'All India', status: 'Current status', allStatuses: 'All statuses',
    open: 'Open', closingSoon: 'Closing soon', closed: 'Closed', qualification: 'Qualification', allQualifications: 'All qualifications',
    clear: 'Clear filters', loading: 'Loading the search index…', empty: 'No matching information found. Try fewer filters or another spelling.',
    count: '{count} result(s)', verified: 'Verification', eligibility: 'Eligibility depends on the official rules. Confirm final conditions on the official portal.',
  },
  bn: {
    title: 'চাকরি ও প্রকল্প খুঁজুন',
    description: 'কীওয়ার্ড, রাজ্য, যোগ্যতা ও অবস্থা অনুযায়ী যাচাইকৃত সরকারি চাকরি এবং জনকল্যাণ প্রকল্প খুঁজুন।',
    type: 'তথ্যের ধরন', allTypes: 'চাকরি ও প্রকল্প', job: 'সরকারি চাকরি', scheme: 'জনকল্যাণ প্রকল্প',
    state: 'রাজ্য বা কেন্দ্রশাসিত অঞ্চল', allStates: 'সারা ভারত', status: 'বর্তমান অবস্থা', allStatuses: 'সব অবস্থা',
    open: 'চলমান', closingSoon: 'শীঘ্রই বন্ধ', closed: 'বন্ধ', qualification: 'যোগ্যতা', allQualifications: 'সব যোগ্যতা',
    clear: 'ফিল্টার মুছুন', loading: 'সার্চ তথ্য লোড হচ্ছে…', empty: 'মিলছে এমন তথ্য পাওয়া যায়নি। কম ফিল্টার বা অন্য বানান দিয়ে চেষ্টা করুন।',
    count: '{count}টি ফলাফল', verified: 'যাচাই', eligibility: 'যোগ্যতা অফিসিয়াল নিয়মের উপর নির্ভর করে। অফিসিয়াল পোর্টালে চূড়ান্ত শর্ত যাচাই করুন।',
  },
  hi: {
    title: 'नौकरियाँ और योजनाएँ खोजें',
    description: 'कीवर्ड, राज्य, योग्यता और स्थिति के अनुसार सत्यापित सरकारी नौकरियाँ और कल्याणकारी योजनाएँ खोजें।',
    type: 'जानकारी का प्रकार', allTypes: 'नौकरियाँ और योजनाएँ', job: 'सरकारी नौकरी', scheme: 'कल्याणकारी योजना',
    state: 'राज्य या केंद्र शासित प्रदेश', allStates: 'संपूर्ण भारत', status: 'वर्तमान स्थिति', allStatuses: 'सभी स्थितियाँ',
    open: 'खुला', closingSoon: 'जल्द बंद', closed: 'बंद', qualification: 'योग्यता', allQualifications: 'सभी योग्यताएँ',
    clear: 'फ़िल्टर हटाएँ', loading: 'खोज सूची लोड हो रही है…', empty: 'कोई मिलती-जुलती जानकारी नहीं मिली। कम फ़िल्टर या दूसरी वर्तनी आज़माएँ।',
    count: '{count} परिणाम', verified: 'सत्यापन', eligibility: 'पात्रता आधिकारिक नियमों पर निर्भर करती है। आधिकारिक पोर्टल पर अंतिम शर्तें जाँचें।',
  },
}[locale];
const canonical = locale === 'en' ? `${SITE.url}/search/` : `${SITE.url}/${locale}/search/`;
const alternateUrls = Object.fromEntries(locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/search/` : `${SITE.url}/${lang}/search/`])) as Record<Locale, string>;
const indexUrl = `${SITE.basePath}${locale}/search-index.json`;
---

<MainLayout title={copy.title} description={copy.description} {locale} {canonical} {alternateUrls}>
  <section class="search-hero">
    <div class="container">
      <span class="eyebrow">{t.verifiedSources}</span>
      <h1>{copy.title}</h1>
      <p>{copy.description}</p>
    </div>
  </section>
  <main class="section" data-search-page data-index-url={indexUrl} data-empty={copy.empty} data-count={copy.count}>
    <div class="container search-layout">
      <form class="search-controls" id="structuredSearch" role="search">
        <label class="query-field">
          <span>{t.search}</span>
          <input id="query" name="q" type="search" placeholder={t.searchPlaceholder} autocomplete="off" />
        </label>
        <label><span>{copy.type}</span><select id="type" name="type"><option value="">{copy.allTypes}</option><option value="job">{copy.job}</option><option value="scheme">{copy.scheme}</option></select></label>
        <label><span>{copy.state}</span><select id="state" name="state"><option value="">{copy.allStates}</option>{REGIONS.map((region) => <option value={region.id}>{region[locale]}</option>)}</select></label>
        <label><span>{copy.status}</span><select id="status" name="status"><option value="">{copy.allStatuses}</option><option value="open">{copy.open}</option><option value="closing-soon">{copy.closingSoon}</option><option value="closed">{copy.closed}</option></select></label>
        <label><span>{copy.qualification}</span><select id="qualification" name="qualification"><option value="">{copy.allQualifications}</option></select></label>
        <div class="control-actions"><button class="btn btn-primary" type="submit">{t.search}</button><button class="btn btn-secondary" id="clearSearch" type="button">{copy.clear}</button></div>
      </form>
      <aside class="eligibility-note"><strong>{copy.eligibility}</strong></aside>
      <div class="result-heading"><p id="resultCount" aria-live="polite">{copy.loading}</p></div>
      <div class="search-page-results" id="searchPageResults" aria-live="polite" aria-busy="true"></div>
      <noscript><p class="empty-search">JavaScript is required for the interactive static search. The rest of the website remains available without it.</p></noscript>
    </div>
  </main>
</MainLayout>

<script>
  type SearchItem = {
    label: string; sub?: string; href: string; keywords?: string[]; verification?: string; verificationId?: string;
    category?: string; categoryId?: string; type?: string; state?: string; governmentLevel?: string;
    qualification?: string[]; status?: string; deadline?: string;
  };
  const root = document.querySelector<HTMLElement>('[data-search-page]');
  const form = document.getElementById('structuredSearch') as HTMLFormElement | null;
  const output = document.getElementById('searchPageResults');
  const count = document.getElementById('resultCount');
  const fields = ['q', 'type', 'state', 'status', 'qualification'] as const;
  const controls = Object.fromEntries(fields.map((name) => [name, form?.elements.namedItem(name)])) as Record<(typeof fields)[number], HTMLInputElement | HTMLSelectElement | null>;
  let items: SearchItem[] = [];
  const normalize = (value = '') => value.normalize('NFKD').toLocaleLowerCase().replace(/[\u0300-\u036f]/g, '').replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
  const synonymGroups = [
    ['job', 'jobs', 'naukri', 'নৌকরি', 'চাকরি', 'नौकरी', 'recruitment', 'ভর্তি', 'भर्ती'],
    ['scheme', 'schemes', 'yojana', 'যোজনা', 'প্রকল্প', 'योजना'],
    ['railway', 'railways', 'रेलवे', 'রেলওয়ে'],
    ['graduation', 'graduate', 'degree', 'স্নাতক', 'स्नातक'],
    ['10th', 'matric', 'madhyamik', 'মাধ্যমিক', 'मैट्रिक'],
    ['12th', 'higher secondary', 'উচ্চমাধ্যমিক', 'इंटरमीडिएट'],
  ].map((group) => group.map(normalize));
  const expand = (token: string) => synonymGroups.find((group) => group.includes(token)) || [token];
  const distanceAtMostOne = (a: string, b: string) => {
    if (Math.abs(a.length - b.length) > 1) return false;
    if (a === b) return true;
    let i = 0, j = 0, edits = 0;
    while (i < a.length && j < b.length) {
      if (a[i] === b[j]) { i++; j++; continue; }
      if (++edits > 1) return false;
      if (a.length > b.length) i++; else if (b.length > a.length) j++; else { i++; j++; }
    }
    return edits + Number(i < a.length || j < b.length) <= 1;
  };
  const matchesQuery = (item: SearchItem, raw: string) => {
    const query = normalize(raw);
    if (!query) return true;
    const haystack = normalize([item.label, item.sub, item.category, ...(item.keywords || [])].join(' '));
    const words = haystack.split(' ');
    return query.split(' ').every((token) => expand(token).some((variant) => haystack.includes(variant) || (variant.length > 3 && words.some((word) => distanceAtMostOne(variant, word)))));
  };
  const syncFromUrl = () => {
    const params = new URLSearchParams(location.search);
    fields.forEach((name) => { const control = controls[name]; if (control) control.value = params.get(name) || ''; });
  };
  const syncUrl = () => {
    const params = new URLSearchParams();
    fields.forEach((name) => { const value = controls[name]?.value.trim(); if (value) params.set(name, value); });
    history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
  };
  const render = () => {
    if (!output || !root) return;
    const q = controls.q?.value || '', type = controls.type?.value || '', state = controls.state?.value || '', status = controls.status?.value || '', qualification = normalize(controls.qualification?.value || '');
    const matches = items.filter((item) => matchesQuery(item, q)
      && (!type || item.type === type)
      && (!state || item.state === state)
      && (!status || item.status === status)
      && (!qualification || (item.qualification || []).some((value) => normalize(value) === qualification)));
    output.replaceChildren();
    output.setAttribute('aria-busy', 'false');
    if (count) count.textContent = (root.dataset.count || '{count} result(s)').replace('{count}', new Intl.NumberFormat(document.documentElement.lang).format(matches.length));
    if (!matches.length) {
      const p = document.createElement('p'); p.className = 'empty-search'; p.textContent = root.dataset.empty || ''; output.append(p); return;
    }
    matches.forEach((item) => {
      const a = document.createElement('a'); a.className = 'search-result-card'; a.href = item.href;
      const meta = document.createElement('span'); meta.className = 'result-meta'; meta.textContent = [item.category, item.verification].filter(Boolean).join(' · ');
      const title = document.createElement('strong'); title.textContent = item.label;
      const summary = document.createElement('span'); summary.className = 'result-summary'; summary.textContent = item.keywords?.[0] || item.sub || '';
      a.append(meta, title, summary); output.append(a);
    });
  };
  const apply = () => { syncUrl(); render(); };
  syncFromUrl();
  fetch(root?.dataset.indexUrl || '').then((response) => response.ok ? response.json() : []).then((data: SearchItem[]) => {
    items = data;
    const qualification = controls.qualification;
    if (qualification) {
      const selected = new URLSearchParams(location.search).get('qualification') || '';
      const values = [...new Set(items.flatMap((item) => item.qualification || []).filter(Boolean))].sort((a, b) => a.localeCompare(b));
      values.forEach((value) => { const option = document.createElement('option'); option.value = value; option.textContent = value; qualification.append(option); });
      qualification.value = selected;
    }
    render();
  }).catch(() => { items = []; render(); });
  form?.addEventListener('submit', (event) => { event.preventDefault(); apply(); });
  form?.querySelectorAll('select').forEach((select) => select.addEventListener('change', apply));
  let timer = 0;
  controls.q?.addEventListener('input', () => { window.clearTimeout(timer); timer = window.setTimeout(apply, 180); });
  document.getElementById('clearSearch')?.addEventListener('click', () => { form?.reset(); apply(); controls.q?.focus(); });
  addEventListener('popstate', () => { syncFromUrl(); render(); });
</script>

<style>
  .search-hero{padding:3.5rem 0;background:linear-gradient(135deg,rgba(var(--color-primary-rgb),.09),rgba(var(--color-green-rgb),.06))}.search-hero h1{font-size:clamp(2rem,5vw,3.7rem);margin:.45rem 0}.search-hero p{max-width:66ch;color:var(--color-text-muted);font-size:1.05rem}.search-layout{max-width:1050px}.search-controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem;padding:1rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:18px}.search-controls label{display:grid;gap:.35rem;min-width:0}.search-controls label>span{font-size:.75rem;font-weight:800;color:var(--color-text-muted)}.search-controls input,.search-controls select{width:100%;min-width:0;min-height:46px;padding:.65rem .75rem;border:1px solid var(--color-border);border-radius:10px;background:var(--color-bg);color:var(--color-text);font:inherit}.query-field{grid-column:1/-1}.query-field input{font-size:1.05rem}.control-actions{display:flex;align-items:end;gap:.6rem;grid-column:span 2}.control-actions .btn{min-height:46px}.eligibility-note{margin:1rem 0;padding:.8rem 1rem;border-left:4px solid var(--color-orange);border-radius:8px;background:rgba(var(--color-orange-rgb),.08);font-size:.82rem;color:var(--color-text-muted)}.result-heading{margin:1.4rem 0 .8rem;font-weight:800}.search-page-results{display:grid;gap:.8rem}.search-result-card{display:grid;gap:.35rem;padding:1rem 1.1rem;border:1px solid var(--color-border);border-radius:14px;background:var(--color-surface);transition:.2s}.search-result-card:hover,.search-result-card:focus-visible{border-color:var(--color-primary);transform:translateY(-2px);box-shadow:var(--shadow-md)}.search-result-card strong{font-size:1.05rem;color:var(--color-text)}.result-meta{font-size:.72rem;font-weight:800;color:var(--color-green-text)}.result-summary{font-size:.86rem;color:var(--color-text-muted)}.empty-search{padding:2rem;text-align:center;border:1px dashed var(--color-border);border-radius:14px;color:var(--color-text-muted)}@media(max-width:760px){.search-controls{grid-template-columns:1fr 1fr}.control-actions{grid-column:1/-1}}@media(max-width:480px){.search-controls{grid-template-columns:1fr}.control-actions{grid-column:auto;display:grid}.control-actions .btn{width:100%}}
</style>
