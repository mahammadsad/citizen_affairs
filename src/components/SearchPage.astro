---
import MainLayout from '@layouts/MainLayout.astro';
import Icon from './Icon.astro';
import { REGIONS } from '@lib/regions';
import { SITE } from '@utils/constants';
import { locales, localizedPath, type Locale, ui } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);

const copy = {
  en: {
    title: 'Search Citizen Affairs',
    description: 'Find verified articles, government jobs, welfare schemes, admissions and practical guides.',
    guidance: 'Enter a keyword first. Use filters only when you need to narrow the list.',
    type: 'Information type', allTypes: 'All information types',
    types: { job: 'Government jobs', scheme: 'Welfare schemes', admission: 'Admissions and exams', scholarship: 'Scholarships', service: 'Citizen services', alert: 'Notices and alerts', explainer: 'Guides and explainers' },
    level: 'Government scope', allLevels: 'Any government scope', central: 'Central government', stateLevel: 'State or Union Territory government',
    state: 'Applicable location', allStates: 'Anywhere in India',
    moreFilters: 'More filters', moreFiltersHint: 'Narrow by government scope, location, deadline, verification or eligibility.',
    status: 'Deadline status', allStatuses: 'Any deadline status', open: 'Open', closingSoon: 'Closing soon', closed: 'Closed', noDeadline: 'No deadline',
    verification: 'Verification', allVerification: 'All verification statuses', official: 'Officially confirmed', partial: 'Partially confirmed', checking: 'Under verification', corrected: 'Corrected', archived: 'Closed information',
    qualification: 'Qualification or audience', allQualifications: 'All qualifications',
    sort: 'Sort results', relevance: 'Best match', newest: 'Newest update', deadline: 'Nearest deadline', alphabetical: 'A–Z',
    clear: 'Clear all filters', loading: 'Loading search results…', count: '{count} result(s)', active: 'Active filters', remove: 'Remove',
    resultsTitle: 'Search results', allResults: 'Latest articles and updates', resultsFor: 'Results for “{query}”', readArticle: 'Read article',
    emptyTitle: 'No exact match found', emptyBody: 'Try a broader keyword or remove one or more filters.', broaden: 'Clear filters and search again', browse: 'Browse all sections',
    loadErrorTitle: 'Search index could not be loaded', loadErrorBody: 'The rest of Citizen Affairs is still available. Browse the sections or reload this page.', reload: 'Reload search',
    verifiedNote: 'Before acting, confirm the latest eligibility, deadline and instructions on the linked official government source.',
    published: 'Updated', deadlineLabel: 'Deadline', sources: 'source(s)', action: 'Official action available'
  },
  bn: {
    title: 'Citizen Affairs-এ খুঁজুন',
    description: 'যাচাইকৃত নিবন্ধ, সরকারি চাকরি, কল্যাণ প্রকল্প, ভর্তি ও ব্যবহারিক গাইড খুঁজুন।',
    guidance: 'প্রথমে একটি শব্দ লিখুন। ফলাফল আরও নির্দিষ্ট করতে প্রয়োজন হলে ফিল্টার ব্যবহার করুন।',
    type: 'তথ্যের ধরন', allTypes: 'সব ধরনের তথ্য',
    types: { job: 'সরকারি চাকরি', scheme: 'কল্যাণ প্রকল্প', admission: 'ভর্তি ও পরীক্ষা', scholarship: 'স্কলারশিপ', service: 'নাগরিক পরিষেবা', alert: 'নোটিশ ও সতর্কতা', explainer: 'গাইড ও ব্যাখ্যা' },
    level: 'সরকারের পরিধি', allLevels: 'যে কোনো সরকারি পরিধি', central: 'কেন্দ্রীয় সরকার', stateLevel: 'রাজ্য বা কেন্দ্রশাসিত অঞ্চলের সরকার',
    state: 'প্রযোজ্য এলাকা', allStates: 'ভারতের যে কোনো এলাকা',
    moreFilters: 'আরও ফিল্টার', moreFiltersHint: 'সরকার, এলাকা, শেষ তারিখ, যাচাই বা যোগ্যতা অনুযায়ী ফল ছোট করুন।',
    status: 'শেষ তারিখের অবস্থা', allStatuses: 'যে কোনো শেষ তারিখ', open: 'খোলা', closingSoon: 'শীঘ্রই বন্ধ', closed: 'বন্ধ', noDeadline: 'শেষ তারিখ নেই',
    verification: 'যাচাই', allVerification: 'সব যাচাই অবস্থা', official: 'অফিসিয়ালি নিশ্চিত', partial: 'আংশিক নিশ্চিত', checking: 'যাচাই চলছে', corrected: 'সংশোধিত', archived: 'বন্ধ তথ্য',
    qualification: 'যোগ্যতা বা লক্ষ্যগোষ্ঠী', allQualifications: 'সব যোগ্যতা',
    sort: 'ফলাফল সাজান', relevance: 'সেরা মিল', newest: 'সর্বশেষ আপডেট', deadline: 'নিকটতম শেষ তারিখ', alphabetical: 'অ–হ',
    clear: 'সব ফিল্টার মুছুন', loading: 'সার্চ ফলাফল লোড হচ্ছে…', count: '{count}টি ফলাফল', active: 'সক্রিয় ফিল্টার', remove: 'সরান',
    resultsTitle: 'সার্চ ফলাফল', allResults: 'সর্বশেষ নিবন্ধ ও আপডেট', resultsFor: '“{query}”-এর ফলাফল', readArticle: 'নিবন্ধটি পড়ুন',
    emptyTitle: 'সঠিক মিল পাওয়া যায়নি', emptyBody: 'আরও সাধারণ শব্দ লিখুন অথবা এক বা একাধিক ফিল্টার সরান।', broaden: 'ফিল্টার মুছে আবার খুঁজুন', browse: 'সব বিভাগ দেখুন',
    loadErrorTitle: 'সার্চ সূচি লোড করা যায়নি', loadErrorBody: 'Citizen Affairs-এর বাকি অংশ ব্যবহার করা যাবে। বিভাগগুলি দেখুন বা পেজটি আবার লোড করুন।', reload: 'সার্চ আবার লোড করুন',
    verifiedNote: 'পদক্ষেপ নেওয়ার আগে সংশ্লিষ্ট অফিসিয়াল সরকারি সূত্রে সর্বশেষ যোগ্যতা, শেষ তারিখ ও নির্দেশনা নিশ্চিত করুন।',
    published: 'আপডেট', deadlineLabel: 'শেষ তারিখ', sources: 'টি সূত্র', action: 'অফিসিয়াল পদক্ষেপ উপলব্ধ'
  },
  hi: {
    title: 'Citizen Affairs में खोजें',
    description: 'सत्यापित लेख, सरकारी नौकरियाँ, कल्याण योजनाएँ, प्रवेश और उपयोगी मार्गदर्शिकाएँ खोजें।',
    guidance: 'पहले कोई शब्द लिखें। परिणाम सीमित करने के लिए जरूरत होने पर फ़िल्टर इस्तेमाल करें।',
    type: 'जानकारी का प्रकार', allTypes: 'सभी प्रकार की जानकारी',
    types: { job: 'सरकारी नौकरियाँ', scheme: 'कल्याण योजनाएँ', admission: 'प्रवेश और परीक्षाएँ', scholarship: 'छात्रवृत्तियाँ', service: 'नागरिक सेवाएँ', alert: 'सूचनाएँ और अलर्ट', explainer: 'मार्गदर्शिकाएँ और व्याख्या' },
    level: 'सरकारी दायरा', allLevels: 'कोई भी सरकारी दायरा', central: 'केंद्र सरकार', stateLevel: 'राज्य या केंद्र शासित प्रदेश सरकार',
    state: 'लागू क्षेत्र', allStates: 'भारत में कहीं भी',
    moreFilters: 'और फ़िल्टर', moreFiltersHint: 'सरकारी दायरे, क्षेत्र, अंतिम तिथि, सत्यापन या पात्रता से परिणाम सीमित करें।',
    status: 'अंतिम तिथि की स्थिति', allStatuses: 'कोई भी अंतिम तिथि', open: 'खुला', closingSoon: 'जल्द बंद', closed: 'बंद', noDeadline: 'कोई अंतिम तिथि नहीं',
    verification: 'सत्यापन', allVerification: 'सभी सत्यापन स्थितियाँ', official: 'आधिकारिक रूप से पुष्टि', partial: 'आंशिक पुष्टि', checking: 'सत्यापन जारी', corrected: 'सुधारा गया', archived: 'बंद जानकारी',
    qualification: 'योग्यता या लक्षित समूह', allQualifications: 'सभी योग्यताएँ',
    sort: 'परिणाम क्रम', relevance: 'सर्वोत्तम मिलान', newest: 'नवीनतम अपडेट', deadline: 'निकटतम अंतिम तिथि', alphabetical: 'अ–ज्ञ',
    clear: 'सभी फ़िल्टर हटाएँ', loading: 'खोज परिणाम लोड हो रहे हैं…', count: '{count} परिणाम', active: 'सक्रिय फ़िल्टर', remove: 'हटाएँ',
    resultsTitle: 'खोज परिणाम', allResults: 'नवीनतम लेख और अपडेट', resultsFor: '“{query}” के परिणाम', readArticle: 'लेख पढ़ें',
    emptyTitle: 'सटीक मिलान नहीं मिला', emptyBody: 'व्यापक शब्द आज़माएँ या एक या अधिक फ़िल्टर हटाएँ।', broaden: 'फ़िल्टर हटाकर फिर खोजें', browse: 'सभी अनुभाग देखें',
    loadErrorTitle: 'खोज सूची लोड नहीं हो सकी', loadErrorBody: 'Citizen Affairs का बाकी भाग उपलब्ध है। अनुभाग देखें या यह पेज फिर लोड करें।', reload: 'खोज फिर लोड करें',
    verifiedNote: 'कार्रवाई से पहले संबंधित आधिकारिक सरकारी स्रोत पर नवीनतम पात्रता, अंतिम तिथि और निर्देशों की पुष्टि करें।',
    published: 'अपडेट', deadlineLabel: 'अंतिम तिथि', sources: 'स्रोत', action: 'आधिकारिक कार्रवाई उपलब्ध'
  }
}[locale];

const levelLabels = { central: copy.central, state: copy.stateLevel };
const canonical = locale === 'en' ? `${SITE.url}/search/` : `${SITE.url}/${locale}/search/`;
const alternateUrls = Object.fromEntries(locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/search/` : `${SITE.url}/${lang}/search/`])) as Record<Locale, string>;
const indexUrl = `${SITE.basePath}${locale}/search-index.json`;
const browseUrl = localizedPath(locale, 'categories');
---

<MainLayout title={copy.title} description={copy.description} {locale} {canonical} {alternateUrls} robots="noindex, follow">
  <section class="search-hero">
    <div class="container search-hero-inner">
      <p class="eyebrow"><Icon name="search" size={16} />{t.verifiedSources}</p>
      <h1>{copy.title}</h1>
      <p>{copy.description}</p>
      <small>{copy.guidance}</small>
    </div>
  </section>

  <section
    class="section citizen-search"
    data-search-page
    data-index-url={indexUrl}
    data-count={copy.count}
    data-results-for={copy.resultsFor}
    data-all-results={copy.allResults}
    data-empty-title={copy.emptyTitle}
    data-empty-body={copy.emptyBody}
    data-broaden={copy.broaden}
    data-browse={copy.browse}
    data-browse-url={browseUrl}
    data-load-error-title={copy.loadErrorTitle}
    data-load-error-body={copy.loadErrorBody}
    data-reload={copy.reload}
    data-active={copy.active}
    data-remove={copy.remove}
    data-published={copy.published}
    data-deadline-label={copy.deadlineLabel}
    data-sources={copy.sources}
    data-action={copy.action}
    data-read-article={copy.readArticle}
    data-type-labels={JSON.stringify(copy.types)}
    data-level-labels={JSON.stringify(levelLabels)}
  >
    <div class="container search-layout">
      <form class="search-controls" id="structuredSearch" role="search">
        <label class="query-field">
          <span>{t.search}</span>
          <div><Icon name="search" size={19} /><input id="query" name="q" type="search" placeholder={t.searchPlaceholder} autocomplete="off" /></div>
        </label>

        <div class="primary-filters">
          <label><span>{copy.type}</span><select id="type" name="type"><option value="">{copy.allTypes}</option>{Object.entries(copy.types).map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
          <label><span>{copy.sort}</span><select id="sort" name="sort"><option value="relevance">{copy.relevance}</option><option value="newest">{copy.newest}</option><option value="deadline">{copy.deadline}</option><option value="alphabetical">{copy.alphabetical}</option></select></label>
          <div class="control-actions"><button class="btn btn-primary" type="submit">{t.search}</button><button class="btn btn-secondary" id="clearSearch" type="button">{copy.clear}</button></div>
        </div>

        <details class="advanced-filters" id="advancedSearchFilters">
          <summary><span><strong>{copy.moreFilters}</strong><small>{copy.moreFiltersHint}</small></span></summary>
          <div class="advanced-filter-grid">
            <label><span>{copy.level}</span><select id="level" name="level"><option value="">{copy.allLevels}</option><option value="central">{copy.central}</option><option value="state">{copy.stateLevel}</option></select></label>
            <label><span>{copy.state}</span><select id="state" name="state"><option value="">{copy.allStates}</option>{REGIONS.map((region) => <option value={region.id}>{region[locale]}</option>)}</select></label>
            <label><span>{copy.status}</span><select id="status" name="status"><option value="">{copy.allStatuses}</option><option value="open">{copy.open}</option><option value="closing-soon">{copy.closingSoon}</option><option value="closed">{copy.closed}</option><option value="none">{copy.noDeadline}</option></select></label>
            <label><span>{copy.verification}</span><select id="verification" name="verification"><option value="">{copy.allVerification}</option><option value="officially-confirmed">{copy.official}</option><option value="partially-confirmed">{copy.partial}</option><option value="under-verification">{copy.checking}</option><option value="corrected">{copy.corrected}</option><option value="closed">{copy.archived}</option></select></label>
            <label><span>{copy.qualification}</span><select id="qualification" name="qualification"><option value="">{copy.allQualifications}</option></select></label>
          </div>
        </details>
      </form>

      <aside class="verification-note"><Icon name="check" size={19} /><strong>{copy.verifiedNote}</strong></aside>
      <div class="active-filters" id="activeFilters" aria-live="polite" hidden></div>
      <header class="result-heading">
        <div>
          <span>{copy.resultsTitle}</span>
          <h2 id="resultContext">{copy.allResults}</h2>
        </div>
        <p id="resultCount" aria-live="polite">{copy.loading}</p>
      </header>
      <div class="search-page-results" id="searchPageResults" aria-live="polite" aria-busy="true"></div>
      <noscript><p class="search-message">{locale === 'bn' ? 'ইন্টার‌্যাক্টিভ অনুসন্ধানের জন্য জাভাস্ক্রিপ্ট প্রয়োজন। ওয়েবসাইটের বাকি অংশ এটি ছাড়াও ব্যবহার করা যাবে।' : locale === 'hi' ? 'इंटरैक्टिव खोज के लिए जावास्क्रिप्ट आवश्यक है। वेबसाइट का बाकी भाग इसके बिना भी उपलब्ध है।' : 'JavaScript is required for interactive search. The rest of the website remains available without it.'}</p></noscript>
    </div>
  </section>
</MainLayout>

<script>
  type SearchItem = {
    label: string;
    sub?: string;
    href: string;
    description?: string;
    image?: string;
    imageAlt?: string;
    keywords?: string[];
    verification?: string;
    verificationId?: string;
    category?: string;
    type?: string;
    state?: string;
    regionLabel?: string;
    governmentLevel?: string;
    qualification?: string[];
    status?: string;
    deadline?: string;
    published?: string;
    updated?: string;
    sourceCount?: number;
    actionAvailable?: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-search-page]');
  const form = document.getElementById('structuredSearch') as HTMLFormElement | null;
  const output = document.getElementById('searchPageResults');
  const count = document.getElementById('resultCount');
  const resultContext = document.getElementById('resultContext');
  const activeFilters = document.getElementById('activeFilters');
  const advancedFilters = document.getElementById('advancedSearchFilters') as HTMLDetailsElement | null;
  const fields = ['q', 'type', 'level', 'state', 'status', 'verification', 'qualification', 'sort'] as const;
  const advancedFieldNames = ['level', 'state', 'status', 'verification', 'qualification'] as const;
  type FieldName = (typeof fields)[number];
  const controls = Object.fromEntries(fields.map((name) => [name, form?.elements.namedItem(name)])) as Record<FieldName, HTMLInputElement | HTMLSelectElement | null>;
  const typeLabels = JSON.parse(root?.dataset.typeLabels || '{}') as Record<string, string>;
  const levelLabels = JSON.parse(root?.dataset.levelLabels || '{}') as Record<string, string>;
  const legacyCategoryTypes: Record<string, string> = {
    jobs: 'job', projects: 'scheme', exams: 'admission', materials: 'explainer', guides: 'explainer', notices: 'alert', affairs: 'alert'
  };
  let items: SearchItem[] = [];
  let loadFailed = false;

  const normalize = (value = '') => value.normalize('NFKD').toLocaleLowerCase().replace(/[\u0300-\u036f]/g, '').replace(/[^\p{L}\p{N}]+/gu, ' ').trim();
  const normalizeScope = (value = '') => ['west-bengal', 'other-state'].includes(value) ? 'state' : value;
  const synonymGroups = [
    ['job', 'jobs', 'naukri', 'নৌকরি', 'চাকরি', 'नौकरी', 'recruitment', 'ভর্তি', 'भर्ती'],
    ['scheme', 'schemes', 'yojana', 'যোজনা', 'প্রকল্প', 'योजना'],
    ['admission', 'admissions', 'ভর্তি', 'प्रवेश'],
    ['scholarship', 'scholarships', 'স্কলারশিপ', 'বৃত্তি', 'छात्रवृत्ति'],
    ['service', 'services', 'পরিষেবা', 'सेवा'],
    ['notice', 'alert', 'নোটিশ', 'সতর্কতা', 'सूचना', 'अलर्ट'],
    ['railway', 'railways', 'रेलवे', 'রেলওয়ে'],
    ['graduation', 'graduate', 'degree', 'স্নাতক', 'स्नातक'],
    ['10th', 'matric', 'madhyamik', 'মাধ্যমিক', 'मैट्रिक'],
    ['12th', 'higher secondary', 'উচ্চমাধ্যমিক', 'इंटरमीडिएट']
  ].map((group) => group.map(normalize));
  const expand = (token: string) => synonymGroups.find((group) => group.includes(token)) || [token];

  const distanceAtMostOne = (a: string, b: string) => {
    if (Math.abs(a.length - b.length) > 1) return false;
    if (a === b) return true;
    let i = 0, j = 0, edits = 0;
    while (i < a.length && j < b.length) {
      if (a[i] === b[j]) { i++; j++; continue; }
      if (++edits > 1) return false;
      if (a.length > b.length) i++; else if (b.length > a.length) j++; else { i++; j++; }
    }
    return edits + Number(i < a.length || j < b.length) <= 1;
  };

  const queryScore = (item: SearchItem, raw: string) => {
    const query = normalize(raw);
    if (!query) return 0;
    const title = normalize(item.label);
    const category = normalize(item.category);
    const description = normalize(item.description || item.sub || '');
    const keywords = normalize((item.keywords || []).join(' '));
    const haystack = [title, category, description, keywords].join(' ');
    const words = haystack.split(' ');
    let score = 0;
    for (const token of query.split(' ')) {
      const variants = expand(token);
      const matched = variants.some((variant) => {
        if (title === variant) { score += 18; return true; }
        if (title.startsWith(variant)) { score += 12; return true; }
        if (title.includes(variant)) { score += 9; return true; }
        if (category.includes(variant)) { score += 6; return true; }
        if (description.includes(variant)) { score += 4; return true; }
        if (keywords.includes(variant)) { score += 3; return true; }
        if (variant.length > 3 && words.some((word) => distanceAtMostOne(variant, word))) { score += 1; return true; }
        return false;
      });
      if (!matched) return -1;
    }
    return score;
  };

  const updateAdvancedState = () => {
    if (!advancedFilters) return;
    advancedFilters.open = advancedFieldNames.some((name) => Boolean(controls[name]?.value.trim()));
  };

  const syncFromUrl = () => {
    const params = new URLSearchParams(location.search);
    fields.forEach((name) => {
      const control = controls[name];
      if (!control) return;
      control.value = params.get(name) || (name === 'sort' ? 'relevance' : '');
    });
    const legacyCategory = params.get('category') || '';
    if (!params.get('type') && legacyCategory && controls.type) controls.type.value = legacyCategoryTypes[legacyCategory] || '';
    updateAdvancedState();
  };

  const syncUrl = () => {
    const params = new URLSearchParams();
    fields.forEach((name) => {
      const value = controls[name]?.value.trim();
      if (value && !(name === 'sort' && value === 'relevance')) params.set(name, value);
    });
    history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
  };

  const filterLabel = (name: FieldName, value: string) => {
    const control = controls[name];
    if (name === 'q') return value;
    if (control instanceof HTMLSelectElement) return control.selectedOptions[0]?.textContent || value;
    return value;
  };

  const renderActiveFilters = () => {
    if (!activeFilters || !root) return;
    activeFilters.replaceChildren();
    const selected = fields.filter((name) => {
      const value = controls[name]?.value.trim();
      return Boolean(value && !(name === 'sort' && value === 'relevance'));
    });
    activeFilters.hidden = selected.length === 0;
    if (!selected.length) return;
    const label = document.createElement('strong');
    label.textContent = root.dataset.active || 'Active filters';
    activeFilters.append(label);
    selected.forEach((name) => {
      const value = controls[name]?.value || '';
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.clearField = name;
      button.setAttribute('aria-label', `${root.dataset.remove || 'Remove'} ${filterLabel(name, value)}`);
      button.textContent = `${filterLabel(name, value)} ×`;
      activeFilters.append(button);
    });
  };

  const addMessage = (kind: 'empty' | 'error') => {
    if (!output || !root) return;
    const section = document.createElement('section');
    section.className = 'search-message';
    const heading = document.createElement('h2');
    const body = document.createElement('p');
    heading.textContent = kind === 'error' ? root.dataset.loadErrorTitle || '' : root.dataset.emptyTitle || '';
    body.textContent = kind === 'error' ? root.dataset.loadErrorBody || '' : root.dataset.emptyBody || '';
    const actions = document.createElement('div');
    const primary = document.createElement('button');
    primary.type = 'button';
    primary.className = 'btn btn-primary';
    primary.dataset.messageAction = kind === 'error' ? 'reload' : 'clear';
    primary.textContent = kind === 'error' ? root.dataset.reload || '' : root.dataset.broaden || '';
    const browse = document.createElement('a');
    browse.className = 'btn btn-secondary';
    browse.href = root.dataset.browseUrl || '/categories/';
    browse.textContent = root.dataset.browse || '';
    actions.append(primary, browse);
    section.append(heading, body, actions);
    output.append(section);
  };

  const formatDate = (value?: string) => value ? new Intl.DateTimeFormat(document.documentElement.lang, { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(value)) : '';
  const deadlineRank = (item: SearchItem) => {
    if (!item.deadline || item.status === 'closed') return Number.POSITIVE_INFINITY;
    const timestamp = Date.parse(item.deadline);
    return Number.isNaN(timestamp) ? Number.POSITIVE_INFINITY : timestamp;
  };

  const updateResultContext = (query: string) => {
    if (!resultContext || !root) return;
    const value = query.trim();
    resultContext.textContent = value
      ? (root.dataset.resultsFor || 'Results for “{query}”').replace('{query}', value)
      : root.dataset.allResults || 'Latest articles and updates';
  };

  const render = () => {
    if (!output || !root) return;
    output.replaceChildren();
    output.setAttribute('aria-busy', 'false');
    renderActiveFilters();
    updateAdvancedState();
    if (loadFailed) {
      if (count) count.textContent = '';
      addMessage('error');
      return;
    }

    const q = controls.q?.value || '';
    const type = controls.type?.value || '';
    const level = controls.level?.value || '';
    const state = controls.state?.value || '';
    const status = controls.status?.value || '';
    const verification = controls.verification?.value || '';
    const qualification = normalize(controls.qualification?.value || '');
    const sort = controls.sort?.value || 'relevance';

    const matches = items
      .map((item) => ({ item, score: queryScore(item, q) }))
      .filter(({ item, score }) => score >= 0
        && (!type || item.type === type)
        && (!level || normalizeScope(item.governmentLevel) === level)
        && (!state || item.state === state)
        && (!status || (status === 'closing-soon' ? ['closing-soon', 'urgent'].includes(item.status || '') : item.status === status))
        && (!verification || item.verificationId === verification)
        && (!qualification || (item.qualification || []).some((value) => normalize(value) === qualification)))
      .sort((a, b) => {
        if (sort === 'newest') return Date.parse(b.item.updated || b.item.published || '') - Date.parse(a.item.updated || a.item.published || '');
        if (sort === 'deadline') return deadlineRank(a.item) - deadlineRank(b.item) || Date.parse(b.item.updated || '') - Date.parse(a.item.updated || '');
        if (sort === 'alphabetical') return a.item.label.localeCompare(b.item.label, document.documentElement.lang);
        return b.score - a.score || Date.parse(b.item.updated || b.item.published || '') - Date.parse(a.item.updated || a.item.published || '');
      });

    updateResultContext(q);
    if (count) count.textContent = (root.dataset.count || '{count} result(s)').replace('{count}', new Intl.NumberFormat(document.documentElement.lang).format(matches.length));
    if (!matches.length) { addMessage('empty'); return; }

    matches.forEach(({ item }) => {
      const row = document.createElement('article');
      row.className = 'search-result-row';
      const link = document.createElement('a');
      link.className = 'search-result-link';
      link.href = item.href;

      const body = document.createElement('div');
      body.className = 'result-body';
      const meta = document.createElement('span');
      meta.className = 'result-meta';
      meta.textContent = [typeLabels[item.type || ''], item.verification].filter(Boolean).join(' · ');
      const title = document.createElement('h3');
      title.textContent = item.label;
      const summary = document.createElement('p');
      summary.className = 'result-summary';
      summary.textContent = item.description || item.sub || '';

      const footer = document.createElement('div');
      footer.className = 'result-footer';
      const facts = document.createElement('span');
      facts.className = 'result-facts';
      const factValues = [
        item.updated || item.published ? `${root.dataset.published}: ${formatDate(item.updated || item.published)}` : '',
        item.category || '',
        item.deadline ? `${root.dataset.deadlineLabel}: ${formatDate(item.deadline)}` : '',
        item.regionLabel || levelLabels[normalizeScope(item.governmentLevel)] || ''
      ].filter(Boolean);
      facts.textContent = factValues.join(' · ');
      const read = document.createElement('span');
      read.className = 'result-read';
      read.textContent = `${root.dataset.readArticle || 'Read article'} →`;
      footer.append(facts, read);
      body.append(meta, title, summary, footer);

      const media = document.createElement('span');
      media.className = 'result-media';
      if (item.image) {
        const image = document.createElement('img');
        image.src = item.image;
        image.alt = item.imageAlt || '';
        image.loading = 'lazy';
        image.decoding = 'async';
        media.append(image);
      } else {
        media.classList.add('result-media-placeholder');
        media.setAttribute('aria-hidden', 'true');
        media.textContent = (typeLabels[item.type || ''] || 'CA').slice(0, 2).toUpperCase();
      }

      link.append(body, media);
      row.append(link);
      output.append(row);
    });
  };

  const apply = () => { syncUrl(); render(); };
  syncFromUrl();
  fetch(root?.dataset.indexUrl || '')
    .then((response) => response.ok ? response.json() : Promise.reject(new Error('Search index unavailable')))
    .then((data: SearchItem[]) => {
      items = data;
      const qualificationControl = controls.qualification;
      if (qualificationControl instanceof HTMLSelectElement) {
        const selected = new URLSearchParams(location.search).get('qualification') || '';
        const values = [...new Set(items.flatMap((item) => item.qualification || []).filter(Boolean))].sort((a, b) => a.localeCompare(b, document.documentElement.lang));
        values.forEach((value) => {
          const option = document.createElement('option');
          option.value = value;
          option.textContent = value;
          qualificationControl.append(option);
        });
        qualificationControl.value = selected;
      }
      syncUrl();
      render();
    })
    .catch(() => { items = []; loadFailed = true; render(); });

  form?.addEventListener('submit', (event) => { event.preventDefault(); apply(); });
  form?.querySelectorAll('select').forEach((select) => select.addEventListener('change', apply));
  let timer = 0;
  controls.q?.addEventListener('input', () => { window.clearTimeout(timer); timer = window.setTimeout(apply, 180); });
  document.getElementById('clearSearch')?.addEventListener('click', () => { form?.reset(); if (controls.sort) controls.sort.value = 'relevance'; apply(); controls.q?.focus(); });
  activeFilters?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('[data-clear-field]');
    const name = button?.dataset.clearField as FieldName | undefined;
    if (!name || !controls[name]) return;
    controls[name]!.value = name === 'sort' ? 'relevance' : '';
    apply();
  });
  output?.addEventListener('click', (event) => {
    const action = (event.target as Element).closest<HTMLElement>('[data-message-action]')?.dataset.messageAction;
    if (action === 'reload') location.reload();
    if (action === 'clear') { form?.reset(); if (controls.sort) controls.sort.value = 'relevance'; apply(); controls.q?.focus(); }
  });
  addEventListener('popstate', () => { syncFromUrl(); render(); });
</script>

<style>
  .search-hero { padding: 2.75rem 0 2.25rem; background: linear-gradient(135deg, rgba(var(--color-primary-rgb), .1), rgba(var(--color-green-rgb), .07)); }
  .search-hero-inner { max-width: 850px; }
  .search-hero .eyebrow { display: flex; align-items: center; gap: .4rem; color: var(--color-primary); font-weight: 850; }
  .search-hero h1 { margin: .45rem 0; font-size: clamp(2rem, 5vw, 3.35rem); }
  .search-hero p:not(.eyebrow) { max-width: 66ch; color: var(--color-text-muted); font-size: 1.05rem; }
  .search-hero small { display: block; max-width: 75ch; margin-top: .65rem; color: var(--color-text-muted); line-height: 1.55; }
  .search-layout { max-width: 1040px; }
  .search-controls { display: grid; gap: 1rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 16px; background: var(--color-surface); box-shadow: var(--shadow-sm); }
  .search-controls label { display: grid; gap: .35rem; min-width: 0; }
  .search-controls label > span { color: var(--color-text-muted); font-size: .73rem; font-weight: 800; }
  .search-controls input, .search-controls select { width: 100%; min-width: 0; min-height: 46px; padding: .65rem .75rem; border: 1px solid var(--color-border); border-radius: 9px; background: var(--color-bg); color: var(--color-text); font: inherit; }
  .query-field > div { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: .5rem; padding-left: .75rem; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); }
  .query-field > div:focus-within { border-color: var(--color-primary); outline: 2px solid rgba(var(--color-primary-rgb), .15); }
  .query-field input { border: 0; padding-left: 0; font-size: 1.03rem; outline: 0; }
  .primary-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)) auto; gap: .8rem; align-items: end; }
  .control-actions { display: flex; gap: .6rem; }
  .control-actions .btn { min-height: 46px; white-space: nowrap; }
  .advanced-filters { padding-top: .9rem; border-top: 1px solid var(--color-border); }
  .advanced-filters summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; list-style: none; border-radius: 9px; padding: .35rem .15rem; }
  .advanced-filters summary::-webkit-details-marker { display: none; }
  .advanced-filters summary::after { content: '+'; display: grid; place-items: center; width: 2rem; height: 2rem; flex: 0 0 auto; border: 1px solid var(--color-border); border-radius: 50%; color: var(--color-primary); font-size: 1.2rem; font-weight: 850; }
  .advanced-filters[open] summary::after { content: '−'; }
  .advanced-filters summary > span { display: grid; gap: .15rem; }
  .advanced-filters summary strong { color: var(--color-text); font-size: .92rem; }
  .advanced-filters summary small { color: var(--color-text-muted); line-height: 1.45; }
  .advanced-filter-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: .9rem; }
  .verification-note { display: flex; align-items: flex-start; gap: .55rem; margin: 1rem 0; padding: .8rem 1rem; border-left: 4px solid var(--color-green); border-radius: 8px; background: rgba(var(--color-green-rgb), .07); color: var(--color-text-muted); font-size: .82rem; }
  .verification-note svg { flex: 0 0 auto; color: var(--color-green-text); }
  .active-filters { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; margin: 1rem 0; }
  .active-filters strong { margin-right: .25rem; font-size: .78rem; }
  .active-filters button { min-height: 36px; padding: .35rem .65rem; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface); color: var(--color-text); font-size: .75rem; font-weight: 750; }
  .active-filters button:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .result-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin: 1.6rem 0 .35rem; padding-bottom: .8rem; border-bottom: 3px solid var(--color-text); }
  .result-heading span { color: var(--color-primary); font-size: .72rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .result-heading h2 { margin: .2rem 0 0; font-size: clamp(1.25rem, 3vw, 1.7rem); }
  .result-heading p { margin: 0; color: var(--color-text-muted); font-size: .82rem; font-weight: 800; white-space: nowrap; }
  .search-page-results { display: grid; }
  .search-result-row { border-bottom: 1px solid var(--color-border); }
  .search-result-link { display: grid; grid-template-columns: minmax(0, 1fr) 210px; gap: 1.2rem; padding: 1.25rem 0; color: inherit; }
  .search-result-link:hover h3, .search-result-link:focus-visible h3 { color: var(--color-primary); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .search-result-link:focus-visible { outline: 3px solid rgba(var(--color-primary-rgb), .22); outline-offset: 4px; border-radius: 6px; }
  .result-body { display: flex; min-width: 0; flex-direction: column; }
  .result-meta { color: var(--color-green-text); font-size: .72rem; font-weight: 900; letter-spacing: .02em; }
  .search-result-row h3 { margin: .38rem 0 .45rem; color: var(--color-text); font-size: clamp(1.08rem, 2.2vw, 1.35rem); line-height: 1.28; }
  .result-summary { display: -webkit-box; overflow: hidden; margin: 0; color: var(--color-text-muted); font-size: .9rem; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .result-footer { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .8rem; }
  .result-facts { color: var(--color-text-muted); font-size: .72rem; line-height: 1.45; }
  .result-read { flex: 0 0 auto; color: var(--color-primary); font-size: .78rem; font-weight: 850; }
  .result-media { display: block; overflow: hidden; align-self: start; width: 100%; aspect-ratio: 16 / 9; border-radius: 9px; background: var(--color-bg-soft); }
  .result-media img { width: 100%; height: 100%; object-fit: cover; transition: transform .25s ease; }
  .search-result-link:hover .result-media img { transform: scale(1.025); }
  .result-media-placeholder { display: grid; place-items: center; color: var(--color-primary); font-size: 1.45rem; font-weight: 900; background: linear-gradient(135deg, rgba(var(--color-primary-rgb), .13), rgba(var(--color-green-rgb), .11)); }
  .search-message { display: grid; justify-items: center; gap: .65rem; margin-top: 1rem; padding: 2.2rem 1rem; text-align: center; border: 1px dashed var(--color-border); border-radius: 12px; color: var(--color-text-muted); }
  .search-message h2 { margin: 0; color: var(--color-text); font-size: 1.25rem; }
  .search-message p { max-width: 55ch; margin: 0; }
  .search-message div { display: flex; justify-content: center; gap: .6rem; flex-wrap: wrap; margin-top: .35rem; }
  @media (max-width: 900px) { .primary-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); } .control-actions { grid-column: 1 / -1; } .advanced-filter-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) {
    .search-result-link { grid-template-columns: minmax(0, 1fr) 112px; gap: .8rem; padding: 1rem 0; }
    .result-summary { font-size: .84rem; -webkit-line-clamp: 2; }
    .result-footer { display: block; padding-top: .55rem; }
    .result-read { display: inline-block; margin-top: .4rem; }
    .result-media { border-radius: 7px; }
  }
  @media (max-width: 540px) {
    .primary-filters, .advanced-filter-grid { grid-template-columns: 1fr; }
    .control-actions { display: grid; grid-column: auto; }
    .control-actions .btn, .search-message .btn { width: 100%; }
    .search-message div { width: 100%; }
    .result-heading { align-items: flex-start; }
    .result-heading p { white-space: normal; text-align: right; }
    .result-facts { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  }
</style>
