  .search-hero h1 { margin: .45rem 0; font-size: clamp(2rem, 5vw, 3.7rem); }
  .search-hero p:not(.eyebrow) { max-width: 66ch; color: var(--color-text-muted); font-size: 1.05rem; }
  .search-hero small { display: block; max-width: 75ch; margin-top: .8rem; color: var(--color-text-muted); line-height: 1.55; }
  .search-layout { max-width: 1120px; }
  .search-controls { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 16px; background: var(--color-surface); }
  .search-controls label { display: grid; gap: .35rem; min-width: 0; }
  .search-controls label > span { color: var(--color-text-muted); font-size: .73rem; font-weight: 800; }
  .search-controls input, .search-controls select { width: 100%; min-width: 0; min-height: 46px; padding: .65rem .75rem; border: 1px solid var(--color-border); border-radius: 9px; background: var(--color-bg); color: var(--color-text); font: inherit; }
  .query-field { grid-column: 1 / -1; }
  .query-field > div { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: .5rem; padding-left: .75rem; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-bg); }
  .query-field > div:focus-within { border-color: var(--color-primary); outline: 2px solid rgba(var(--color-primary-rgb), .15); }
  .query-field input { border: 0; padding-left: 0; font-size: 1.03rem; outline: 0; }
  .control-actions { display: flex; align-items: end; gap: .6rem; grid-column: span 2; }
  .control-actions .btn { min-height: 46px; }
  .verification-note { display: flex; align-items: flex-start; gap: .55rem; margin: 1rem 0; padding: .85rem 1rem; border-left: 4px solid var(--color-green); border-radius: 8px; background: rgba(var(--color-green-rgb), .07); color: var(--color-text-muted); font-size: .82rem; }
  .verification-note svg { flex: 0 0 auto; color: var(--color-green-text); }
  .active-filters { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; margin: 1rem 0; }
  .active-filters strong { margin-right: .25rem; font-size: .78rem; }
  .active-filters button { min-height: 36px; padding: .35rem .65rem; border: 1px solid var(--color-border); border-radius: 999px; background: var(--color-surface); color: var(--color-text); font-size: .75rem; font-weight: 750; }
  .active-filters button:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .result-heading { margin: 1.35rem 0 .75rem; font-weight: 850; }
  .search-page-results { display: grid; gap: .8rem; }
  .search-result-card { display: grid; gap: .4rem; padding: 1.05rem 1.15rem; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface); transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease; }
  .search-result-card:hover, .search-result-card:focus-visible { transform: translateY(-2px); border-color: var(--color-primary); box-shadow: var(--shadow-md); }
  .search-result-card strong { color: var(--color-text); font-size: 1.05rem; }
  .result-meta { color: var(--color-green-text); font-size: .7rem; font-weight: 850; }
  .result-summary { color: var(--color-text-muted); font-size: .86rem; line-height: 1.5; }
  .result-facts { padding-top: .25rem; border-top: 1px solid var(--color-border); color: var(--color-text-muted); font-size: .7rem; }
  .search-message { display: grid; justify-items: center; gap: .65rem; padding: 2.2rem 1rem; text-align: center; border: 1px dashed var(--color-border); border-radius: 12px; color: var(--color-text-muted); }
  .search-message h2 { margin: 0; color: var(--color-text); font-size: 1.25rem; }
  .search-message p { max-width: 55ch; margin: 0; }
  .search-message div { display: flex; justify-content: center; gap: .6rem; flex-wrap: wrap; margin-top: .35rem; }
  @media (max-width: 900px) { .search-controls { grid-template-columns: repeat(2, minmax(0, 1fr)); } .control-actions { grid-column: 1 / -1; } }
  @media (max-width: 540px) { .search-controls { grid-template-columns: 1fr; } .control-actions { display: grid; grid-column: auto; } .control-actions .btn, .search-message .btn { width: 100%; } .search-message div { width: 100%; } }
