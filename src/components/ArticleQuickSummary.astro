---
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  items?: string[];
}

const { locale, items = [] } = Astro.props;
const visibleItems = items.map((item) => item.trim()).filter(Boolean).slice(0, 3);
const labels: Record<Locale, string> = {
  en: 'Key points',
  bn: 'মূল তথ্য',
  hi: 'मुख्य बातें'
};
---

{visibleItems.length > 0 && (
  <aside class="article-quick-summary" aria-labelledby="article-quick-summary-title">
    <h2 id="article-quick-summary-title">{labels[locale]}</h2>
    <ul>
      {visibleItems.map((item) => <li>{item}</li>)}
    </ul>
  </aside>
)}

<script>
  const quickSummary = document.querySelector<HTMLElement>('.article-quick-summary');
  const content = quickSummary?.closest<HTMLElement>('.article-content');
  const firstParagraph = content
    ? Array.from(content.children).find((element) => element.tagName === 'P')
    : undefined;

  if (quickSummary && firstParagraph) {
    firstParagraph.insertAdjacentElement('afterend', quickSummary);
  }
</script>

<style>
  .article-quick-summary {
    margin: 1.2rem 0 1.35rem;
    padding: 1rem 1.1rem;
    border: 1px solid rgba(var(--color-primary-rgb), .18);
    border-left: 4px solid var(--color-primary);
    border-radius: 0 14px 14px 0;
    background: color-mix(in srgb, var(--color-surface) 88%, var(--color-primary) 12%);
  }

  .article-quick-summary h2 {
    margin: 0 0 .55rem;
    font-family: var(--font-body);
    font-size: .82rem;
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-primary);
  }

  .article-quick-summary ul {
    display: grid;
    gap: .42rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-quick-summary li {
    position: relative;
    padding-left: 1.15rem;
    font-size: .98rem;
    line-height: 1.58;
  }

  .article-quick-summary li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-green-text);
    font-weight: 800;
  }

  @media (max-width: 680px) {
    .article-quick-summary {
      margin: .75rem 0 1rem;
      padding: .72rem .8rem;
      border-radius: 0 11px 11px 0;
    }

    .article-quick-summary h2 {
      margin-bottom: .35rem;
      font-size: .76rem;
    }

    .article-quick-summary ul {
      gap: .26rem;
    }

    .article-quick-summary li {
      padding-left: 1rem;
      font-size: .9rem;
      line-height: 1.48;
    }
  }
</style>
