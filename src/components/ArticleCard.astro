---
import type { CollectionEntry } from 'astro:content';
import { getCategoryData, categoryName } from '@lib/content';
import { deadlineLabel, deadlineState } from '@lib/deadline';
import { normalizeRegionLabel, regionName } from '@lib/regions';
import Icon from './Icon.astro';
import { dateLocale, localizedPath, type Locale, ui, verificationLabels } from '../i18n';

export interface Props {
  article: CollectionEntry<'articles'>;
  locale: Locale;
  compact?: boolean;
}

const { article, locale, compact = false } = Astro.props;
const category = await getCategoryData(article.data.category);
const categoryLabel = category ? categoryName(category, locale) : article.data.category;
const t = ui(locale);
const route = (value = '') => {
  const path = localizedPath(locale, value);
  return locale === 'en' ? path.replace('/en/', '/') : path;
};
const displayDate = article.data.updated || article.data.date;
const formatter = new Intl.DateTimeFormat(dateLocale(locale), {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
const state = deadlineState(article.data.deadline);
const normalizedLevel =
  article.data.governmentLevel === 'central' ? 'central' : article.data.governmentLevel ? 'state' : '';
const stateId =
  article.data.state ||
  (article.data.governmentLevel === 'west-bengal'
    ? 'west-bengal'
    : normalizeRegionLabel(article.data.regionLabel));
const localizedRegion = regionName(stateId, locale);
const levelLabel =
  normalizedLevel === 'central'
    ? t.centralGovernment
    : localizedRegion || article.data.regionLabel || (normalizedLevel === 'state' ? t.stateGovernments : '');

const copy = {
  en: {
    vacancies: 'Vacancies',
    qualification: 'Qualification',
    salary: 'Salary',
    benefit: 'Benefit',
    forWhom: 'For',
    institution: 'Institution',
    programme: 'Programme',
    provider: 'Provider',
    service: 'Service',
    action: 'Action',
    deadline: 'Last date',
    status: 'Status',
    official: 'Official source',
    updated: 'Updated',
    application: 'Application'
  },
  bn: {
    vacancies: 'শূন্যপদ',
    qualification: 'যোগ্যতা',
    salary: 'বেতন',
    benefit: 'সুবিধা',
    forWhom: 'যাদের জন্য',
    institution: 'প্রতিষ্ঠান',
    programme: 'কোর্স',
    provider: 'প্রদানকারী',
    service: 'পরিষেবা',
    action: 'করণীয়',
    deadline: 'শেষ তারিখ',
    status: 'স্ট্যাটাস',
    official: 'অফিসিয়াল সূত্র',
    updated: 'আপডেট',
    application: 'আবেদন'
  },
  hi: {
    vacancies: 'रिक्तियाँ',
    qualification: 'योग्यता',
    salary: 'वेतन',
    benefit: 'लाभ',
    forWhom: 'किसके लिए',
    institution: 'संस्थान',
    programme: 'कार्यक्रम',
    provider: 'प्रदाता',
    service: 'सेवा',
    action: 'कार्रवाई',
    deadline: 'अंतिम तिथि',
    status: 'स्थिति',
    official: 'आधिकारिक स्रोत',
    updated: 'अपडेट',
    application: 'आवेदन'
  }
}[locale];

const facts: Array<{ label: string; value: string }> = [];
let statusText = article.data.deadline
  ? deadlineLabel(state, locale)
  : verificationLabels[locale][article.data.verificationStatus];
let officialUrl = article.data.officialNoticeUrl || article.data.applicationUrl;

if (article.data.job) {
  facts.push({ label: copy.vacancies, value: article.data.job.totalVacancies.toLocaleString(locale) });
  facts.push({ label: copy.qualification, value: article.data.job.qualification[0] });
  if (article.data.job.salaryMinimum || article.data.job.salaryMaximum) {
    const minimum = article.data.job.salaryMinimum ? `₹${article.data.job.salaryMinimum.toLocaleString(locale)}` : '';
    const maximum = article.data.job.salaryMaximum ? `₹${article.data.job.salaryMaximum.toLocaleString(locale)}` : '';
    facts.push({ label: copy.salary, value: [minimum, maximum].filter(Boolean).join(' – ') });
  }
  statusText = article.data.job.recruitmentStatus.replaceAll('-', ' ');
  officialUrl = article.data.job.officialNotificationUrl;
} else if (article.data.scheme) {
  facts.push({
    label: copy.benefit,
    value: article.data.scheme.benefitAmount || article.data.scheme.benefitType[0]
  });
  facts.push({ label: copy.forWhom, value: article.data.scheme.targetBeneficiaries[0] });
  facts.push({ label: copy.application, value: article.data.scheme.applicationMode });
  statusText = article.data.scheme.schemeStatus.replaceAll('-', ' ');
  officialUrl = article.data.scheme.officialPortal;
} else if (article.data.admission) {
  facts.push({ label: copy.institution, value: article.data.admission.institution });
  facts.push({ label: copy.programme, value: article.data.admission.programme });
  facts.push({ label: copy.qualification, value: article.data.admission.eligibilityCriteria[0] });
  statusText = article.data.admission.admissionStatus.replaceAll('-', ' ');
  officialUrl = article.data.admission.officialProspectusUrl;
} else if (article.data.scholarship) {
  facts.push({ label: copy.provider, value: article.data.scholarship.provider });
  facts.push({ label: copy.benefit, value: article.data.scholarship.benefitAmount });
  facts.push({ label: copy.forWhom, value: article.data.scholarship.targetStudents[0] });
  statusText = article.data.scholarship.scholarshipStatus.replaceAll('-', ' ');
  officialUrl = article.data.scholarship.officialPortal;
} else if (article.data.service) {
  facts.push({ label: copy.service, value: article.data.service.serviceName });
  facts.push({ label: copy.action, value: article.data.service.serviceActions.join(', ').replaceAll('-', ' ') });
  if (article.data.service.processingTime) {
    facts.push({ label: copy.status, value: article.data.service.processingTime });
  }
  statusText = article.data.service.serviceStatus.replaceAll('-', ' ');
  officialUrl = article.data.service.officialPortal;
} else {
  if (article.data.amountOrVacancies) facts.push({ label: t.amount, value: article.data.amountOrVacancies });
  if (article.data.qualification[0]) facts.push({ label: copy.qualification, value: article.data.qualification[0] });
  if (article.data.quickSummary[0]) facts.push({ label: copy.status, value: article.data.quickSummary[0] });
}

if (article.data.deadline && !facts.some((fact) => fact.label === copy.deadline)) {
  facts.push({ label: copy.deadline, value: formatter.format(article.data.deadline) });
}

const visibleFacts = facts.slice(0, compact ? 2 : 4);
const statusClass = article.data.deadline
  ? `deadline-${state}`
  : `verification-${article.data.verificationStatus}`;
---

<article class:list={['utility-card', { compact }]}>
  <div class="utility-card-top">
    <div class="utility-card-context">
      <span>{categoryLabel}</span>
      {levelLabel && <span>{levelLabel}</span>}
    </div>
    <span class:list={['utility-status', statusClass]}>{statusText}</span>
  </div>

  <div class="utility-card-main">
    <p class="utility-verification">
      <Icon name="check" size={14} />{verificationLabels[locale][article.data.verificationStatus]}
    </p>
    <h3><a href={route(`articles/${article.data.urlSlug}`)}>{article.data.title}</a></h3>
    {!compact && <p class="utility-description">{article.data.description}</p>}

    {visibleFacts.length > 0 && (
      <dl class="utility-facts">
        {visibleFacts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>

  <div class="utility-card-footer">
    <span><Icon name="clock" size={15} />{copy.updated}: {formatter.format(displayDate)}</span>
    <div>
      {officialUrl && (
        <a href={officialUrl} target="_blank" rel="noopener noreferrer">
          {copy.official}<Icon name="external" size={16} />
        </a>
      )}
      <a class="utility-details" href={route(`articles/${article.data.urlSlug}`)}>
        {t.readMore}<Icon name="arrow" size={17} />
      </a>
    </div>
  </div>
</article>

<style>
  .utility-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 11px;
    background: var(--color-surface);
  }
  .utility-card:hover { border-color: rgba(var(--color-primary-rgb), .55); }
  .utility-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    min-height: 42px;
    padding: .55rem .85rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-alt);
  }
  .utility-card-context {
    display: flex;
    flex-wrap: wrap;
    gap: .35rem .75rem;
    color: var(--color-primary);
    font-size: .66rem;
    font-weight: 850;
    text-transform: uppercase;
    letter-spacing: .025em;
  }
  .utility-card-context span + span { color: var(--color-text-muted); }
  .utility-status {
    flex: 0 0 auto;
    padding: .22rem .48rem;
    border-radius: 999px;
    background: rgba(var(--color-primary-rgb), .09);
    color: var(--color-primary);
    font-size: .64rem;
    font-weight: 850;
    text-transform: capitalize;
  }
  .deadline-open,
  .verification-officially-confirmed {
    background: rgba(var(--color-green-rgb), .1);
    color: var(--color-green-text);
  }
  .deadline-closing-soon,
  .deadline-urgent {
    background: rgba(var(--color-orange-rgb), .13);
    color: #9a5600;
  }
  .deadline-closed,
  .verification-closed,
  .verification-withdrawn {
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
  }
  .utility-card-main {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem;
  }
  .utility-verification {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    margin: 0 0 .45rem;
    color: var(--color-green-text);
    font-size: .67rem;
    font-weight: 800;
  }
  .utility-card h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.08rem;
    line-height: 1.35;
  }
  .utility-card h3 a:hover { color: var(--color-primary); }
  .utility-description {
    display: -webkit-box;
    margin: .45rem 0 .85rem;
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: .86rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .utility-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .55rem;
    margin-top: auto;
    padding-top: .85rem;
    border-top: 1px solid var(--color-border);
  }
  .utility-facts div {
    min-width: 0;
    padding: .55rem;
    border-radius: 8px;
    background: var(--color-surface-alt);
  }
  .utility-facts dt {
    margin-bottom: .12rem;
    color: var(--color-text-muted);
    font-size: .62rem;
    font-weight: 750;
  }
  .utility-facts dd {
    overflow: hidden;
    font-size: .77rem;
    font-weight: 820;
    line-height: 1.35;
    text-overflow: ellipsis;
  }
  .utility-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: .7rem .85rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: .68rem;
  }
  .utility-card-footer > span,
  .utility-card-footer a {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
  }
  .utility-card-footer > div {
    display: flex;
    align-items: center;
    gap: .75rem;
  }
  .utility-card-footer a {
    color: var(--color-primary);
    font-weight: 820;
  }
  .compact .utility-description { display: none; }
  .compact .utility-card-main { padding: .85rem; }
  .compact .utility-card-footer > div a:first-child { display: none; }

  @media (max-width: 520px) {
    .utility-facts { grid-template-columns: 1fr; }
    .utility-card-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
