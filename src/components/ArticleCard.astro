---
import type { CollectionEntry } from 'astro:content';
import { getCategoryData, categoryName } from '@lib/content';
import { deadlineLabel, deadlineState } from '@lib/deadline';
import { normalizeRegionLabel, regionName } from '@lib/regions';
import Icon from './Icon.astro';
import { dateLocale, localizedPath, type Locale, ui, verificationLabels } from '../i18n';

export interface Props { article: CollectionEntry<'articles'>; locale: Locale; compact?: boolean; }
const { article, locale, compact = false } = Astro.props;
const category = await getCategoryData(article.data.category);
const categoryLabel = category ? categoryName(category, locale) : article.data.category;
const t = ui(locale);
const displayDate = article.data.updated || article.data.date;
const date = new Intl.DateTimeFormat(dateLocale(locale), { year: 'numeric', month: 'short', day: 'numeric' }).format(displayDate);
const state = deadlineState(article.data.deadline);
const fallbackIcon: Record<string,string> = { jobs:'briefcase', projects:'schemes', exams:'exams', notices:'notices', affairs:'services', materials:'education' };
const normalizedLevel = article.data.governmentLevel === 'central' ? 'central' : article.data.governmentLevel ? 'state' : '';
const stateId = article.data.state || (article.data.governmentLevel === 'west-bengal' ? 'west-bengal' : normalizeRegionLabel(article.data.regionLabel));
const localizedRegion = regionName(stateId, locale);
const levelLabel = normalizedLevel === 'central' ? t.centralGovernment : localizedRegion || article.data.regionLabel || (normalizedLevel === 'state' ? t.stateGovernments : '');
---
<a href={localizedPath(locale, `articles/${article.data.urlSlug}`)} class:list={['article-card', { compact }]} data-category={article.data.category} data-level={normalizedLevel} data-state={stateId} data-status={state} data-verification={article.data.verificationStatus} data-date={displayDate.toISOString()} data-deadline={article.data.deadline?.toISOString() || ''}>
  <div class="article-media">{article.data.featuredImage ? <img src={article.data.featuredImage} alt={article.data.featuredImageAlt || article.data.title} width="640" height="360" loading="lazy" decoding="async" /> : <div class="article-fallback"><Icon name={fallbackIcon[article.data.category] || 'updates'} size={48} /></div>} {levelLabel && <span class="level-label">{levelLabel}</span>}</div>
  <div class="article-card-body"><div class="article-card-meta"><span class="article-card-category">{categoryLabel}</span><span class={`verification-dot status-${article.data.verificationStatus}`}>{verificationLabels[locale][article.data.verificationStatus]}</span></div><h3>{article.data.title}</h3><p>{article.data.description}</p><div class="article-dates"><span>{article.data.updated ? t.updated : t.published}: {date}</span>{article.data.deadline && <span class={`deadline status-${state}`}>{deadlineLabel(state, locale)} · {new Intl.DateTimeFormat(dateLocale(locale), { day:'numeric', month:'short', year:'numeric' }).format(article.data.deadline)}</span>}</div><span class="article-link">{t.readMore}<Icon name="arrow" size={18} /></span></div>
</a>
<style>
  .article-card{background:var(--color-surface);border:1px solid var(--color-border);border-radius:20px;overflow:hidden;display:flex;flex-direction:column;min-height:100%;transition:transform var(--transition-base),box-shadow var(--transition-base),border-color var(--transition-base)}.article-card:hover,.article-card:focus-visible{transform:translateY(-4px);box-shadow:var(--shadow-lg);border-color:rgba(var(--color-primary-rgb),.3)}.article-media{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,#092b4b,var(--color-primary))}.article-media img{width:100%;height:100%;object-fit:cover}.article-fallback{height:100%;display:grid;place-items:center;color:#fff}.level-label{position:absolute;left:.75rem;top:.75rem;padding:.3rem .6rem;background:rgba(9,43,75,.88);color:#fff;border-radius:999px;font-size:.68rem;font-weight:800}.article-card-body{padding:1.1rem;display:flex;flex-direction:column;flex:1}.article-card-meta{display:flex;justify-content:space-between;gap:.6rem;align-items:center;margin-bottom:.65rem}.article-card-category{font-size:.7rem;font-weight:800;color:var(--color-primary);text-transform:uppercase}.verification-dot{font-size:.67rem;font-weight:800;color:var(--color-text-muted);display:flex;align-items:center;gap:.3rem}.verification-dot::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--color-orange)}.status-officially-confirmed::before{background:var(--color-green)}.status-withdrawn::before,.status-closed::before{background:#7f8a99}.article-card h3{font-size:1.08rem;color:var(--color-text);margin-bottom:.4rem}.article-card p{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--color-text-muted);font-size:.9rem;margin-bottom:1rem}.article-dates{display:grid;gap:.35rem;margin-top:auto;font-size:.75rem;color:var(--color-text-muted)}.deadline{width:max-content;padding:.2rem .5rem;border-radius:999px;font-weight:800}.deadline.status-open{color:#0b6b2a;background:rgba(var(--color-green-rgb),.1)}.deadline.status-closing-soon{color:#9a5600;background:rgba(var(--color-orange-rgb),.13)}.deadline.status-urgent{color:#b42318;background:rgba(180,35,24,.1)}.deadline.status-closed{color:#667085;background:var(--color-surface-alt)}.article-link{display:flex;align-items:center;gap:.25rem;margin-top:.8rem;color:var(--color-primary);font-weight:800;font-size:.84rem}.compact{display:grid;grid-template-columns:110px 1fr}.compact .article-media{aspect-ratio:auto;min-height:100%}.compact .article-card-body{padding:1rem}.compact p{display:none}@media(max-width:440px){.compact{grid-template-columns:90px 1fr}.compact .verification-dot{display:none}}
</style>
