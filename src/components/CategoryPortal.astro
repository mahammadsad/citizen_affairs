---
import type { CollectionEntry } from 'astro:content';
import { categoryDescription, categoryName } from '@lib/content';
import { deadlineState } from '@lib/deadline';
import { localizedPath, type Locale, ui } from '../i18n';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';

type Article = CollectionEntry<'articles'>;
type Category = CollectionEntry<'categories'>;

interface Props {
  locale: Locale;
  category: Category;
  articles: Article[];
}

const { locale, category, articles } = Astro.props;
const t = ui(locale);
const name = categoryName(category, locale);
const description = categoryDescription(category, locale) || name;
const route = (value = '') => {
  const path = localizedPath(locale, value);
  return locale === 'en' ? path.replace('/en/', '/') : path;
};

const copy = {
  en: {
    back: 'All sections', filters: 'Filter', all: 'All', official: 'Official', open: 'Open now', central: 'Central', state: 'State',
    resultPattern: '{count} updates', noMatch: 'No updates match this filter.',
    emptyTitle: 'No current updates yet', emptyBody: 'New verified information will appear here after publication checks.', policy: 'Verification policy'
  },
  bn: {
    back: 'সব বিভাগ', filters: 'ফিল্টার', all: 'সব', official: 'অফিসিয়াল', open: 'এখন খোলা', central: 'কেন্দ্রীয়', state: 'রাজ্য',
    resultPattern: '{count}টি আপডেট', noMatch: 'এই ফিল্টারে কোনো আপডেট নেই।',
    emptyTitle: 'এখনও কোনো বর্তমান আপডেট নেই', emptyBody: 'যাচাই শেষ হলে নতুন তথ্য এখানে প্রকাশিত হবে।', policy: 'যাচাই নীতি'
  },
  hi: {
    back: 'सभी अनुभाग', filters: 'फ़िल्टर', all: 'सभी', official: 'आधिकारिक', open: 'अभी खुला', central: 'केंद्रीय', state: 'राज्य',
    resultPattern: '{count} अपडेट', noMatch: 'इस फ़िल्टर में कोई अपडेट नहीं है।',
    emptyTitle: 'अभी कोई वर्तमान अपडेट नहीं', emptyBody: 'सत्यापन पूरा होने के बाद नई जानकारी यहाँ दिखाई देगी।', policy: 'सत्यापन नीति'
  }
}[locale];

const icon = category.id === 'jobs' ? 'briefcase' : category.id === 'projects' ? 'schemes' : category.id === 'exams' ? 'exams' : category.id === 'materials' ? 'education' : category.id === 'notices' ? 'notices' : category.id === 'affairs' ? 'services' : 'categories';
const isActionable = (article: Article) => {
  if (['open', 'closing-soon', 'urgent'].includes(deadlineState(article.data.deadline))) return true;
  const status = article.data.job?.recruitmentStatus || article.data.scheme?.schemeStatus || article.data.admission?.admissionStatus || article.data.scholarship?.scholarshipStatus || article.data.service?.serviceStatus || '';
  return ['open', 'closing-soon', 'active', 'application-open', 'available', 'upcoming'].includes(status);
};
const governmentGroup = (article: Article) => article.data.governmentLevel === 'central' ? 'central' : 'state';
const officialCount = articles.filter((article) => article.data.verificationStatus === 'officially-confirmed').length;
const actionableCount = articles.filter(isActionable).length;
const centralCount = articles.filter((article) => governmentGroup(article) === 'central').length;
const stateCount = articles.length - centralCount;
---

<section class="category-portal" data-category-portal data-result-pattern={copy.resultPattern}>
  <header class="category-hero">
    <div class="container category-hero-inner">
      <a class="category-back" href={route('categories')}><Icon name="arrow" size={16} />{copy.back}</a>
      <p class="category-kicker"><Icon name={icon} size={17} />Citizen Affairs</p>
      <h1>{name}</h1>
      <p class="category-description">{description}</p>
    </div>
  </header>

  <div class="container category-content">
    {articles.length > 0 ? (
      <>
        <div class="category-toolbar">
          <div class="category-filter-group">
            <span>{copy.filters}</span>
            <div class="category-filters" role="group" aria-label={copy.filters}>
              <button type="button" data-category-filter="all" aria-pressed="true">{copy.all}<strong>{articles.length}</strong></button>
              <button type="button" data-category-filter="official" aria-pressed="false">{copy.official}<strong>{officialCount}</strong></button>
              <button type="button" data-category-filter="open" aria-pressed="false">{copy.open}<strong>{actionableCount}</strong></button>
              <button type="button" data-category-filter="central" aria-pressed="false">{copy.central}<strong>{centralCount}</strong></button>
              <button type="button" data-category-filter="state" aria-pressed="false">{copy.state}<strong>{stateCount}</strong></button>
            </div>
          </div>
          <p class="category-result-count" data-category-result-count aria-live="polite">{copy.resultPattern.replace('{count}', String(articles.length))}</p>
        </div>

        <div class="category-results">
          {articles.map((article) => (
            <div
              data-category-card
              data-official={article.data.verificationStatus === 'officially-confirmed' ? 'true' : 'false'}
              data-open={isActionable(article) ? 'true' : 'false'}
              data-central={governmentGroup(article) === 'central' ? 'true' : 'false'}
              data-state={governmentGroup(article) === 'state' ? 'true' : 'false'}
            >
              <ArticleCard {article} {locale} />
            </div>
          ))}
        </div>
        <p class="category-no-match" data-category-no-match hidden>{copy.noMatch}</p>
      </>
    ) : (
      <section class="category-empty" aria-labelledby="category-empty-title">
        <Icon name="updates" size={26} />
        <h2 id="category-empty-title">{copy.emptyTitle}</h2>
        <p>{copy.emptyBody}</p>
        <div>
          <a href={route('articles')}>{t.latestNav}<Icon name="arrow" size={16} /></a>
          <a href={route('editorial-policy')}>{copy.policy}<Icon name="arrow" size={16} /></a>
        </div>
      </section>
    )}
  </div>
</section>

<script>
  const portal = document.querySelector<HTMLElement>('[data-category-portal]');
  const buttons = [...(portal?.querySelectorAll<HTMLButtonElement>('[data-category-filter]') || [])];
  const cards = [...(portal?.querySelectorAll<HTMLElement>('[data-category-card]') || [])];
  const resultCount = portal?.querySelector<HTMLElement>('[data-category-result-count]');
  const noMatch = portal?.querySelector<HTMLElement>('[data-category-no-match]');

  const applyFilter = (filter: string) => {
    let visibleCount = 0;
    cards.forEach((card) => {
      const visible = filter === 'all' || card.dataset[filter] === 'true';
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.categoryFilter === filter)));
    if (resultCount && portal?.dataset.resultPattern) resultCount.textContent = portal.dataset.resultPattern.replace('{count}', String(visibleCount));
    if (noMatch) noMatch.hidden = visibleCount !== 0;
  };

  buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.categoryFilter || 'all')));
</script>

<style>
  .category-portal { padding-bottom: 4rem; }
  .category-hero {
    padding: clamp(1.7rem, 4vw, 3rem) 0 clamp(1.5rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .category-hero-inner { max-width: 980px; }
  .category-back,
  .category-kicker {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
  }
  .category-back {
    color: var(--color-text-muted);
    font-size: .78rem;
    font-weight: 600;
  }
  .category-back :global(svg) { transform: rotate(180deg); }
  .category-kicker {
    margin: 1rem 0 .45rem;
    color: var(--color-primary);
    font-size: .72rem;
    font-weight: 650;
  }
  .category-hero h1 {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.1rem, 4.5vw, 3.65rem);
    line-height: 1.08;
  }
  .category-description {
    max-width: 66ch;
    margin-top: .75rem;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.65;
  }
  .category-content { padding-top: 1.3rem; }
  .category-toolbar {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: .8rem;
    border-bottom: 1px solid var(--color-border);
  }
  .category-filter-group > span {
    display: block;
    margin-bottom: .4rem;
    color: var(--color-text-muted);
    font-size: .72rem;
    font-weight: 600;
  }
  .category-filters { display: flex; gap: .4rem; flex-wrap: wrap; }
  .category-filters button {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    min-height: 38px;
    padding: .4rem .65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: .76rem;
    font-weight: 600;
    cursor: pointer;
  }
  .category-filters button strong {
    display: grid;
    min-width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 999px;
    background: var(--color-surface-alt);
    font-size: .68rem;
    font-weight: 650;
  }
  .category-filters button[aria-pressed='true'] {
    border-color: rgba(var(--color-primary-rgb), .5);
    background: rgba(var(--color-primary-rgb), .07);
    color: var(--color-primary);
  }
  .category-result-count {
    flex: 0 0 auto;
    margin: 0;
    color: var(--color-text-muted);
    font-size: .76rem;
  }
  .category-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .category-results > div[hidden] { display: none; }
  .category-no-match,
  .category-empty {
    padding: 2.2rem 1rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
    color: var(--color-text-muted);
  }
  .category-empty { max-width: 720px; margin: 0 auto; }
  .category-empty :global(svg) { color: var(--color-primary); }
  .category-empty h2 { margin: .65rem 0 .35rem; color: var(--color-text); }
  .category-empty p { max-width: 55ch; margin: 0 auto; }
  .category-empty div { display: flex; justify-content: center; gap: .75rem 1rem; flex-wrap: wrap; margin-top: 1rem; }
  .category-empty a { display: inline-flex; align-items: center; gap: .35rem; color: var(--color-primary); font-weight: 650; }

  @media (max-width: 980px) {
    .category-results { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .category-portal { padding-bottom: 2rem; }
    .category-hero { padding: .85rem 0 .75rem; }
    .category-back { display: none; }
    .category-kicker { margin: 0 0 .3rem; font-size: .7rem; }
    .category-hero h1 { max-width: none; font-size: clamp(1.8rem, 8vw, 2.25rem); line-height: 1.12; }
    .category-description {
      display: -webkit-box;
      margin-top: .4rem;
      overflow: hidden;
      font-size: .92rem;
      line-height: 1.5;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
    .category-content { padding-top: .75rem; }
    .category-toolbar { align-items: flex-start; flex-direction: column; gap: .45rem; margin-bottom: .7rem; }
    .category-filter-group { width: 100%; min-width: 0; }
    .category-filters {
      width: calc(100% + 1rem);
      margin-right: -1rem;
      padding: 0 1rem .2rem 0;
      overflow-x: auto;
      flex-wrap: nowrap;
    }
    .category-filters button { flex: 0 0 auto; min-height: 36px; }
    .category-results { grid-template-columns: 1fr; gap: .75rem; }
  }
</style>
