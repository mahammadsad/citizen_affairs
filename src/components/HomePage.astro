---
import MainLayout from '@layouts/MainLayout.astro';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { getLocalizedArticles, getUpcomingDeadlines, categoryDescription, categoryName } from '@lib/content';
import { deadlineLabel, deadlineState } from '@lib/deadline';
import { ACTIVE_CATEGORY_IDS, resolveAssetPath, SITE } from '@utils/constants';
import {
  locales,
  localizedPath,
  trustPagePath,
  type Locale,
  ui,
  verificationLabels,
  dateLocale
} from '../i18n';

const { locale } = Astro.props as { locale: Locale; isRoot?: boolean };
const t = ui(locale);
const route = (value = '') => {
  const path = localizedPath(locale, value);
  return locale === 'en' ? path.replace('/en/', '/') : path;
};

const allArticles = await getLocalizedArticles(locale);
const categories = await getCollection('categories');
const activeCategories = categories
  .filter((category) => ACTIVE_CATEGORY_IDS.includes(category.id))
  .sort((a, b) => ACTIVE_CATEGORY_IDS.indexOf(a.id) - ACTIVE_CATEGORY_IDS.indexOf(b.id));
const latestArticles = allArticles.slice(0, 8);
const upcoming = await getUpcomingDeadlines(locale, 6);
const featured = allArticles.find((article) => article.data.featured) || allArticles[0];
const importantToday = allArticles.filter((article) => article.id !== featured?.id).slice(0, 5);
const changedArticles = allArticles.filter((article) => article.data.updateHistory.length > 0).slice(0, 4);
const featuredCategory = featured ? categories.find((category) => category.id === featured.data.category) : undefined;
const canonical = locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/` : `${SITE.url}/${lang}/`])
) as Record<Locale, string>;
const formatter = new Intl.DateTimeFormat(dateLocale(locale), {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
const resolveSrcSet = (value?: string) =>
  value
    ?.split(',')
    .map((entry) => {
      const [url, width] = entry.trim().split(/\s+/);
      return `${resolveAssetPath(url)} ${width}`;
    })
    .join(', ');

const iconMap: Record<string, string> = {
  jobs: 'briefcase',
  projects: 'schemes',
  exams: 'exams',
  notices: 'notices',
  affairs: 'services',
  materials: 'education',
  guides: 'book'
};

