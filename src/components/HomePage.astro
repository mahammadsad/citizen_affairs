---
import MainLayout from '@layouts/MainLayout.astro';
import ArticleCard from './ArticleCard.astro';
import AdSlot from './AdSlot.astro';
import { getCollection } from 'astro:content';
import { getLocalizedArticles, categoryDescription, categoryName } from '@lib/content';
import { SITE, SOCIALS } from '@utils/constants';
import type { Locale } from '../i18n';
import { localizedPath, ui } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const articles = (await getLocalizedArticles(locale)).slice(0, 6);
const categories = await getCollection('categories');
const title = locale === 'bn' ? SITE.name : SITE.nameEn;
const description = t.heroDescription;
const canonical = `${SITE.url}/${locale}/`;
const alternateUrl = `${SITE.url}/${locale === 'en' ? 'bn' : 'en'}/`;
const serviceIcons: Record<string, string> = { jobs: '◎', projects: '◇', exams: '✓', notices: '!', affairs: '↗', materials: '▤' };
---

<MainLayout {title} {description} {locale} {canonical} {alternateUrl}>
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <span class="hero-eyebrow"><i></i>{t.independent}</span>
        <h1>{t.heroTitle}</h1>
        <p>{t.heroDescription}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={localizedPath(locale, 'articles')}>{t.explore} <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href={SOCIALS.telegram} target="_blank" rel="noopener">{t.joinTelegram}</a>
        </div>
        <div class="hero-proof" aria-label={locale === 'bn' ? 'সাইটের বৈশিষ্ট্য' : 'Site highlights'}>
          <div><strong>✓</strong><span>{t.verifiedSources}</span></div>
          <div><strong>অ/A</strong><span>{t.bilingual}</span></div>
          <div><strong>₹0</strong><span>{t.freeAccess}</span></div>
        </div>
      </div>

      <aside class="verification-card reveal">
        <div class="verification-card-head">
          <span class="live-dot"></span>
          <span>{locale === 'bn' ? 'প্রকাশের আগে যাচাই' : 'Checked before publishing'}</span>
        </div>
        <div class="verification-source">
          <div class="source-icon">.gov</div>
          <div><strong>{locale === 'bn' ? 'অফিসিয়াল উৎস' : 'Official source'}</strong><span>{locale === 'bn' ? 'বিজ্ঞপ্তি, PDF ও পোর্টাল' : 'Notice, PDF and portal'}</span></div>
          <b>✓</b>
        </div>
        <div class="verification-line"></div>
        <div class="check-list">
          <span><i>✓</i>{locale === 'bn' ? 'তারিখ ও সময়সীমা' : 'Dates and deadlines'}</span>
          <span><i>✓</i>{locale === 'bn' ? 'যোগ্যতা ও সুবিধা' : 'Eligibility and benefits'}</span>
          <span><i>✓</i>{locale === 'bn' ? 'সংশোধনী ও বাতিল নোটিশ' : 'Corrections and withdrawals'}</span>
        </div>
        <div class="verification-result"><span>✓</span><div><strong>{locale === 'bn' ? 'যাচাই সম্পূর্ণ' : 'Verification complete'}</strong><small>{locale === 'bn' ? 'সূত্রসহ প্রকাশের জন্য প্রস্তুত' : 'Ready to publish with sources'}</small></div></div>
      </aside>
    </div>
  </section>

  <section class="section category-section">
    <div class="container">
      <div class="section-head reveal"><span class="eyebrow">{t.whatWeCover}</span><h2>{locale === 'bn' ? 'প্রয়োজনীয় তথ্য দ্রুত খুঁজুন' : 'Find the information you need'}</h2></div>
      <div class="category-grid">
        {categories.map((category) => (
          <a class="category-card reveal" href={localizedPath(locale, `categories/${category.id}`)}>
            <span class={`category-symbol color-${category.data.color || 'primary'}`}>{serviceIcons[category.id] || '•'}</span>
            <div><h3>{categoryName(category, locale)}</h3><p>{categoryDescription(category, locale)}</p></div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head-row reveal">
        <div class="section-head"><span class="eyebrow">{locale === 'bn' ? 'নতুন প্রকাশনা' : 'Freshly published'}</span><h2>{t.latest}</h2><p>{t.latestDescription}</p></div>
        <a class="text-link" href={localizedPath(locale, 'articles')}>{t.viewAll} →</a>
      </div>
      <div class="articles-grid">{articles.map((article) => <ArticleCard {article} {locale} />)}</div>
      {!articles.length && <p class="empty-state">{t.noArticles}</p>}
      <AdSlot position="home-feed" />
    </div>
  </section>

  <section class="section process-section">
    <div class="container process-grid">
      <div class="section-head reveal"><span class="eyebrow">{locale === 'bn' ? 'আমাদের পদ্ধতি' : 'Our method'}</span><h2>{t.howItWorks}</h2><p>{locale === 'bn' ? 'খবর দ্রুত দেওয়ার চেয়ে সঠিক তথ্য দেওয়াকে আমরা বেশি গুরুত্ব দিই।' : 'Accuracy matters more than being first. Every update follows a traceable review process.'}</p></div>
      <ol class="process-list reveal">
        <li><span>01</span><div><strong>{t.stepDiscover}</strong><small>{locale === 'bn' ? 'সরকারি দপ্তর ও অফিসিয়াল পোর্টাল' : 'Government departments and official portals'}</small></div></li>
        <li><span>02</span><div><strong>{t.stepVerify}</strong><small>{locale === 'bn' ? 'তারিখ, অর্থ, যোগ্যতা ও লিঙ্ক' : 'Dates, amounts, eligibility and links'}</small></div></li>
        <li><span>03</span><div><strong>{t.stepExplain}</strong><small>{locale === 'bn' ? 'সাধারণ মানুষের বোঝার মতো ভাষা' : 'Plain language for everyday readers'}</small></div></li>
        <li><span>04</span><div><strong>{t.stepUpdate}</strong><small>{locale === 'bn' ? 'সংশোধন, বাতিল ও deadline tracking' : 'Corrections, withdrawals and deadlines'}</small></div></li>
      </ol>
    </div>
  </section>

  <section class="community-band" id="community">
    <div class="container community-inner reveal">
      <div><span class="eyebrow">{t.community}</span><h2>{t.communityTitle}</h2><p>{t.disclaimerShort}</p></div>
      <div class="community-actions"><a class="btn btn-light" href={SOCIALS.telegram} target="_blank" rel="noopener">Telegram</a><a class="btn btn-whatsapp" href={SOCIALS.whatsapp} target="_blank" rel="noopener">WhatsApp</a></div>
    </div>
  </section>
</MainLayout>

<style>
  .home-hero{padding:clamp(3rem,7vw,6.5rem) 0;background:linear-gradient(135deg,#f7fbff 0%,#fff 52%,#f2fbf5 100%);position:relative;overflow:hidden}.home-hero::before{content:"";position:absolute;width:480px;height:480px;border-radius:50%;right:-220px;top:-260px;border:70px solid rgba(var(--color-primary-rgb),.04)}[data-theme="dark"] .home-hero{background:linear-gradient(135deg,#091526,#0a1220 52%,#0a1d16)}.hero-grid{display:grid;gap:3rem;align-items:center}.hero-copy{max-width:730px}.hero-eyebrow{display:inline-flex;align-items:center;gap:.55rem;padding:.45rem .85rem;border:1px solid rgba(var(--color-green-rgb),.25);border-radius:99px;background:rgba(var(--color-green-rgb),.07);color:var(--color-green-text);font-weight:700;font-size:.82rem;margin-bottom:1.25rem}.hero-eyebrow i,.live-dot{width:8px;height:8px;background:var(--color-green);border-radius:50%;box-shadow:0 0 0 5px rgba(var(--color-green-rgb),.12)}.hero-copy h1{font-size:clamp(2.25rem,5.3vw,4.6rem);line-height:1.08;letter-spacing:-.035em;max-width:16ch;margin-bottom:1.25rem}.hero-copy>p{font-size:clamp(1.02rem,2vw,1.22rem);color:var(--color-text-muted);max-width:63ch}.hero-actions{display:flex;flex-wrap:wrap;gap:.85rem;margin:1.8rem 0}.hero-proof{display:flex;gap:1.25rem;flex-wrap:wrap;padding-top:1.25rem;border-top:1px solid var(--color-border)}.hero-proof div{display:flex;gap:.55rem;align-items:center;color:var(--color-text-muted);font-size:.82rem}.hero-proof strong{color:var(--color-primary)}.verification-card{background:var(--color-surface);border:1px solid var(--color-border);border-radius:28px;padding:1.35rem;box-shadow:0 28px 80px rgba(8,49,92,.14);transform:rotate(1deg)}.verification-card-head{display:flex;align-items:center;gap:.7rem;font-size:.78rem;font-weight:700;color:var(--color-text-muted);padding:.2rem .2rem 1rem}.verification-source{display:grid;grid-template-columns:auto 1fr auto;gap:.85rem;align-items:center;background:var(--color-surface-alt);padding:1rem;border-radius:16px}.source-icon{width:48px;height:48px;border-radius:13px;background:var(--color-navy);color:#fff;display:grid;place-items:center;font-weight:700;font-size:.78rem}.verification-source div:nth-child(2){display:flex;flex-direction:column}.verification-source span,.check-list span small{font-size:.76rem;color:var(--color-text-muted)}.verification-source b{color:var(--color-green-text)}.verification-line{height:28px;width:2px;background:var(--color-border);margin:auto}.check-list{display:grid;gap:.55rem}.check-list span{display:flex;align-items:center;gap:.7rem;font-size:.86rem}.check-list i{width:22px;height:22px;display:grid;place-items:center;border-radius:50%;background:rgba(var(--color-green-rgb),.1);color:var(--color-green-text);font-style:normal;font-weight:700}.verification-result{display:flex;align-items:center;gap:.85rem;margin-top:1rem;padding:1rem;border-radius:16px;background:linear-gradient(135deg,rgba(var(--color-green-rgb),.13),rgba(var(--color-primary-rgb),.08));border:1px solid rgba(var(--color-green-rgb),.2)}.verification-result>span{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;background:var(--color-green);color:white;font-weight:800}.verification-result div{display:flex;flex-direction:column}.verification-result small{color:var(--color-text-muted)}.category-grid{display:grid;gap:1rem}.category-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;padding:1.2rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:18px;transition:.2s ease}.category-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-md);border-color:rgba(var(--color-primary-rgb),.3)}.category-symbol{width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-size:1.25rem;font-weight:800;background:rgba(var(--color-primary-rgb),.09);color:var(--color-primary)}.color-green{background:rgba(var(--color-green-rgb),.1);color:var(--color-green-text)}.color-orange{background:rgba(var(--color-orange-rgb),.13);color:#a85c00}.category-card h3{font-size:1rem}.category-card p{color:var(--color-text-muted);font-size:.8rem;line-height:1.45}.category-card .arrow{color:var(--color-primary);font-weight:800}.section-head-row{display:flex;align-items:end;justify-content:space-between;gap:2rem}.text-link{font-weight:700;color:var(--color-primary);white-space:nowrap;margin-bottom:var(--space-5)}.articles-grid{display:grid;gap:1.15rem}.empty-state{text-align:center;padding:3rem;color:var(--color-text-muted)}.process-grid{display:grid;gap:2rem}.process-list{display:grid;gap:.75rem}.process-list li{display:grid;grid-template-columns:auto 1fr;gap:1rem;align-items:center;padding:1rem;border-bottom:1px solid var(--color-border)}.process-list>li>span{font-weight:800;color:var(--color-primary);font-size:.82rem}.process-list div{display:flex;flex-direction:column}.process-list small{color:var(--color-text-muted)}.community-band{background:linear-gradient(135deg,var(--color-navy),#0b5c91);color:#fff;padding:3.5rem 0}.community-inner{display:grid;gap:1.5rem;align-items:center}.community-band h2{color:#fff;font-size:clamp(1.7rem,4vw,2.6rem);max-width:22ch}.community-band p{color:#d9e8f5;max-width:60ch}.community-actions{display:flex;gap:.75rem;flex-wrap:wrap}.btn-light{background:#fff;color:var(--color-navy)}.btn-whatsapp{background:#1d9f55;color:#fff}@media(min-width:680px){.category-grid{grid-template-columns:repeat(2,1fr)}.articles-grid{grid-template-columns:repeat(2,1fr)}}@media(min-width:960px){.hero-grid{grid-template-columns:minmax(0,1.25fr) minmax(330px,.75fr)}.category-grid{grid-template-columns:repeat(3,1fr)}.articles-grid{grid-template-columns:repeat(3,1fr)}.process-grid{grid-template-columns:.8fr 1.2fr}.community-inner{grid-template-columns:1fr auto}}
</style>
