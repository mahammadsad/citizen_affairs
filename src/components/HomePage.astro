    searchPlaceholder: 'Search jobs, scholarships, schemes, results, Aadhaar services…',
    officialPromise: 'Official sources first',
    lastCheckedPromise: 'Verification dates shown',
    correctionPromise: 'Changes tracked openly',
    actionHeading: 'What do you need today?',
    actionIntro: 'Start with the task you want to complete.',
    importantToday: 'Important today',
    startHere: 'Start with a citizen section',
    startHereBody: 'Choose a section to find official opportunities, benefits and services.',
    deadlines: 'Deadline centre',
    deadlineIntro: 'Applications and registrations closing soon.',
    latest: 'Latest verified updates',
    latestIntro: 'Actionable information with status, deadline and official-source details.',
    changed: 'What changed',
    changedIntro: 'Corrections, extensions and important updates recorded transparently.',
    stateTitle: 'Find information relevant to you',
    stateBody: 'Search by state, qualification, scheme, service or deadline.',
    stateCta: 'Open advanced search',
    methodTitle: 'A citizen-first way to publish public information',
    methodBody:
      'We publish an update only when it changes an opportunity, eligibility rule, entitlement, deadline, required action or access to a public service.',
    methodLink: 'How we verify information',
    browseAll: 'Browse all updates',
    viewDeadlines: 'View all deadlines',
    viewCategories: 'View all sections',
    lastUpdated: 'Last updated',
    noDeadline: 'No deadline',
    actions: [
      ['Find a government job', 'Open recruitment notices by qualification and state.', 'jobs', 'briefcase'],
      ['Find admissions and results', 'Admissions, entrance exams, admit cards and results.', 'exams', 'exams'],
      ['Find a scholarship', 'Scholarships, fellowships and student support.', 'materials', 'education'],
      ['Check welfare schemes', 'Benefits, eligibility and application procedures.', 'projects', 'schemes'],
      ['Use a citizen service', 'Aadhaar, PAN, voter, pension, certificates and more.', 'affairs', 'services'],
      ['See urgent alerts', 'Deadline changes, corrections and service notices.', 'notices', 'notices']
    ],
