---
import MainLayout from '@layouts/MainLayout.astro';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { getLocalizedArticles, getUpcomingDeadlines, categoryDescription, categoryName } from '@lib/content';
import { deadlineLabel, deadlineState } from '@lib/deadline';
import { ACTIVE_CATEGORY_IDS, resolveAssetPath, SITE } from '@utils/constants';
import {
  formatUpdateCount,
  locales,
  localizedPath,
  trustPagePath,
  type Locale,
  ui,
  verificationLabels,
  dateLocale
} from '../i18n';

const { locale } = Astro.props as { locale: Locale; isRoot?: boolean };
const t = ui(locale);
const allArticles = await getLocalizedArticles(locale);
const latestArticles = allArticles.slice(0, 6);
const categories = await getCollection('categories');
const activeCategories = categories.filter((category) => ACTIVE_CATEGORY_IDS.includes(category.id));
const upcoming = await getUpcomingDeadlines(locale, 4);
const featured = allArticles.find((article) => article.data.featured) || allArticles[0];
const featuredCategory = featured ? categories.find((category) => category.id === featured.data.category) : undefined;
const hasPublishedContent = allArticles.length > 0;
const verifiedCount = allArticles.filter((article) => article.data.verificationStatus === 'officially-confirmed').length;
const canonical = locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/` : `${SITE.url}/${lang}/`])
) as Record<Locale, string>;
const iconMap: Record<string, string> = {
  jobs: 'briefcase',
  projects: 'schemes',
  exams: 'exams',
  notices: 'notices',
  affairs: 'services',
  materials: 'education'
};
const formatter = new Intl.DateTimeFormat(dateLocale(locale), {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
const resolveSrcSet = (value?: string) =>
  value
    ?.split(',')
    .map((entry) => {
      const [url, width] = entry.trim().split(/\s+/);
      return `${resolveAssetPath(url)} ${width}`;
    })
    .join(', ');

const copy = {
  en: {
    kicker: 'Independent public-information platform',
    heroNote: 'Official sources first. Clear explanations. Transparent corrections.',
    quickJobs: 'Government jobs',
    quickSchemes: 'Welfare schemes',
    quickDeadlines: 'Upcoming deadlines',
    verified: 'Officially verified',
    published: 'Published guides',
    activeTopics: 'Active sections',
    thisWeek: 'Important this week',
    noFeaturedTitle: 'Start with trusted information',
    noFeaturedBody:
      'Browse focused guides for government jobs and welfare schemes while new verified updates are prepared.',
    latestIntro: 'Recently verified information, presented with source and update details.',
    emptyLatestTitle: 'More verified updates are being prepared',
    emptyLatestBody:
      'The site stays intentionally selective: an update is published only after its source and status are recorded.',
    promiseSources: 'Official-source links',
    promiseDates: 'Last-verified dates',
    promiseCorrections: 'Transparent corrections',
    deadlineIntro: 'Do not miss the application and registration dates that matter.',
    processTitle: 'A clearer way to use public information',
    processBody:
      'Every guide is designed to help you understand the update, verify the source and take the correct next step.',
    learnMethod: 'Read our verification method',
    browseAll: 'Browse all updates'
  },
  bn: {
    kicker: 'স্বাধীন জনতথ্য প্ল্যাটফর্ম',
    heroNote: 'আগে অফিসিয়াল সূত্র। সহজ ব্যাখ্যা। স্বচ্ছ সংশোধন।',
    quickJobs: 'সরকারি চাকরি',
    quickSchemes: 'কল্যাণমূলক প্রকল্প',
    quickDeadlines: 'আসন্ন শেষ তারিখ',
    verified: 'অফিসিয়ালি যাচাইকৃত',
    published: 'প্রকাশিত গাইড',
    activeTopics: 'সক্রিয় বিভাগ',
    thisWeek: 'এই সপ্তাহের গুরুত্বপূর্ণ তথ্য',
    noFeaturedTitle: 'বিশ্বস্ত তথ্য দিয়ে শুরু করুন',
    noFeaturedBody:
      'নতুন যাচাইকৃত আপডেট প্রস্তুত হওয়ার সময় সরকারি চাকরি ও কল্যাণমূলক প্রকল্পের গাইড দেখুন।',
    latestIntro: 'সূত্র, যাচাই ও আপডেটের তারিখসহ সাম্প্রতিক তথ্য।',
    emptyLatestTitle: 'আরও যাচাইকৃত আপডেট প্রস্তুত হচ্ছে',
    emptyLatestBody:
      'প্রতিটি তথ্যের সূত্র ও যাচাইয়ের অবস্থা নথিভুক্ত হওয়ার পরেই তা প্রকাশ করা হয়।',
    promiseSources: 'অফিসিয়াল সূত্রের লিঙ্ক',
    promiseDates: 'সর্বশেষ যাচাইয়ের তারিখ',
    promiseCorrections: 'স্বচ্ছ সংশোধন',
    deadlineIntro: 'গুরুত্বপূর্ণ আবেদন ও নিবন্ধনের শেষ তারিখ মিস করবেন না।',
    processTitle: 'জনতথ্য ব্যবহারের আরও পরিষ্কার উপায়',
    processBody:
      'প্রতিটি গাইড তথ্যটি বোঝা, সূত্র যাচাই করা এবং সঠিক পরবর্তী পদক্ষেপ নিতে সাহায্য করে।',
    learnMethod: 'যাচাই পদ্ধতি পড়ুন',
    browseAll: 'সব আপডেট দেখুন'
  },
  hi: {
    kicker: 'स्वतंत्र जन-सूचना मंच',
    heroNote: 'पहले आधिकारिक स्रोत। स्पष्ट व्याख्या। पारदर्शी सुधार।',
    quickJobs: 'सरकारी नौकरियाँ',
    quickSchemes: 'कल्याण योजनाएँ',
    quickDeadlines: 'आगामी अंतिम तिथियाँ',
    verified: 'आधिकारिक रूप से सत्यापित',
    published: 'प्रकाशित गाइड',
    activeTopics: 'सक्रिय अनुभाग',
    thisWeek: 'इस सप्ताह की महत्वपूर्ण जानकारी',
    noFeaturedTitle: 'विश्वसनीय जानकारी से शुरुआत करें',
    noFeaturedBody:
      'नई सत्यापित जानकारी तैयार होने तक सरकारी नौकरियों और कल्याण योजनाओं की उपयोगी गाइड देखें।',
    latestIntro: 'स्रोत, सत्यापन और अपडेट की तारीख के साथ हाल की जानकारी।',
    emptyLatestTitle: 'और सत्यापित अपडेट तैयार किए जा रहे हैं',
    emptyLatestBody:
      'किसी जानकारी को उसके स्रोत और सत्यापन स्थिति दर्ज होने के बाद ही प्रकाशित किया जाता है।',
    promiseSources: 'आधिकारिक स्रोत लिंक',
    promiseDates: 'अंतिम सत्यापन तारीख',
    promiseCorrections: 'पारदर्शी सुधार',
    deadlineIntro: 'महत्वपूर्ण आवेदन और पंजीकरण की अंतिम तिथियाँ न चूकें।',
    processTitle: 'जन-सूचना उपयोग करने का अधिक स्पष्ट तरीका',
    processBody:
      'हर गाइड आपको जानकारी समझने, स्रोत जाँचने और सही अगला कदम लेने में मदद करती है।',
    learnMethod: 'हमारी सत्यापन पद्धति पढ़ें',
    browseAll: 'सभी अपडेट देखें'
  }
}[locale];
---

<MainLayout title={t.nationwide} description={t.heroDescription} {locale} {canonical} {alternateUrls}>
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-kicker"><span aria-hidden="true"></span>{copy.kicker}</span>
        <h1>{t.heroTitle}</h1>
        <p class="hero-description">{t.heroDescription}</p>

        <form
          class="hero-search"
          action={locale === 'en' ? localizedPath(locale, 'search').replace('/en/', '/') : localizedPath(locale, 'search')}
        >
          <Icon name="search" />
          <input name="q" type="search" placeholder={t.searchPlaceholder} aria-label={t.search} />
          <button type="submit">{t.search}</button>
        </form>

        <nav class="hero-quick-links" aria-label={t.categories}>
          <a href={localizedPath(locale, 'categories/jobs')}><Icon name="briefcase" size={18} />{copy.quickJobs}</a>
          <a href={localizedPath(locale, 'categories/projects')}><Icon name="schemes" size={18} />{copy.quickSchemes}</a>
          <a href={localizedPath(locale, 'deadlines')}><Icon name="clock" size={18} />{copy.quickDeadlines}</a>
        </nav>

        <p class="hero-note"><Icon name="check" size={18} />{copy.heroNote}</p>
      </div>

      <aside class="featured-update" aria-label={copy.thisWeek}>
        {featured ? (
          <>
            <div class="featured-image">
              {featured.data.featuredImage ? (
                <picture>
                  {featured.data.featuredImageAvif && (
                    <source
                      srcset={
                        resolveSrcSet(featured.data.featuredImageAvifSrcSet) ||
                        resolveAssetPath(featured.data.featuredImageAvif)
                      }
                      sizes="(max-width: 980px) calc(100vw - 2rem), 520px"
                      type="image/avif"
                    />
                  )}
                  <img
                    src={resolveAssetPath(featured.data.featuredImage)}
                    srcset={resolveSrcSet(featured.data.featuredImageSrcSet)}
                    sizes="(max-width: 980px) calc(100vw - 2rem), 520px"
                    alt={featured.data.featuredImageAlt || featured.data.title}
                    width={featured.data.featuredImageWidth || 1200}
                    height={featured.data.featuredImageHeight || 675}
                    fetchpriority="high"
                    decoding="async"
                  />
                </picture>
              ) : (
                <div class="image-fallback"><Icon name={iconMap[featured.data.category] || 'updates'} size={64} /></div>
              )}
              <span>{featured.data.featured ? t.featured : t.latest}</span>
            </div>
            <div class="featured-body">
              <div class="featured-badges">
                <span>{featuredCategory ? categoryName(featuredCategory, locale) : featured.data.category}</span>
                <span><Icon name="check" size={14} />{verificationLabels[locale][featured.data.verificationStatus]}</span>
              </div>
              <h2>{featured.data.title}</h2>
              <p>{featured.data.description}</p>
              <dl>
                {featured.data.deadline && (
                  <div>
                    <dt>{t.deadline}</dt>
                    <dd>{formatter.format(featured.data.deadline)} · {deadlineLabel(deadlineState(featured.data.deadline), locale)}</dd>
                  </div>
                )}
                <div>
                  <dt>{t.updated}</dt>
                  <dd>{formatter.format(featured.data.updated || featured.data.date)}</dd>
                </div>
              </dl>
              <div class="featured-actions">
                <a class="btn btn-primary btn-sm" href={localizedPath(locale, `articles/${featured.data.urlSlug}`)}>
                  {t.readMore}<Icon name="arrow" size={18} />
                </a>
                {featured.data.applicationUrl && (
                  <a
                    class="btn btn-secondary btn-sm"
                    href={featured.data.applicationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {t.apply}<Icon name="external" size={18} />
                  </a>
                )}
              </div>
            </div>
          </>
        ) : (
          <div class="empty-showcase">
            <span class="empty-showcase-icon"><Icon name="check" size={38} /></span>
            <span class="eyebrow">{copy.thisWeek}</span>
            <h2>{copy.noFeaturedTitle}</h2>
            <p>{copy.noFeaturedBody}</p>
            <div class="empty-showcase-links">
              <a href={localizedPath(locale, 'categories/jobs')}>{copy.quickJobs}<Icon name="arrow" size={18} /></a>
              <a href={localizedPath(locale, 'categories/projects')}>{copy.quickSchemes}<Icon name="arrow" size={18} /></a>
            </div>
          </div>
        )}
      </aside>
    </div>

    <div class="container hero-metrics" aria-label={t.verifiedSources}>
      <div><strong>{verifiedCount}</strong><span>{copy.verified}</span></div>
      <div><strong>{allArticles.length}</strong><span>{copy.published}</span></div>
      <div><strong>{activeCategories.length}</strong><span>{copy.activeTopics}</span></div>
    </div>
  </section>

  <section class="section category-section" id="categories">
    <div class="container">
      <div class="section-heading-row">
        <div class="section-head">
          <span class="eyebrow">{t.categories}</span>
          <h2>{t.whatWeCover}</h2>
        </div>
        <a href={localizedPath(locale, 'categories')}>{t.viewAll}<Icon name="arrow" size={18} /></a>
      </div>
      <div class="category-grid">
        {activeCategories.map((category) => {
          const count = allArticles.filter((article) => article.data.category === category.id).length;
          return (
            <a class="category-card" href={localizedPath(locale, `categories/${category.id}`)}>
              <span class="category-icon"><Icon name={iconMap[category.id] || 'book'} size={28} /></span>
              <div>
                <h3>{categoryName(category, locale)}</h3>
                <p>{categoryDescription(category, locale)}</p>
                <small>{count > 0 ? formatUpdateCount(locale, count) : t.regularlyUpdated}</small>
              </div>
              <Icon name="arrow" size={20} />
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section section-alt latest-section">
    <div class="container">
      <div class="section-heading-row">
        <div class="section-head">
          <span class="eyebrow">{t.latest}</span>
          <h2>{t.latest}</h2>
          <p>{copy.latestIntro}</p>
        </div>
        {hasPublishedContent && (
          <a href={localizedPath(locale, 'articles')}>{copy.browseAll}<Icon name="arrow" size={18} /></a>
        )}
      </div>

      {hasPublishedContent ? (
        <div class="articles-grid">{latestArticles.map((article) => <ArticleCard {article} {locale} />)}</div>
      ) : (
        <div class="editorial-empty-state">
          <div>
            <span class="empty-state-icon"><Icon name="services" size={32} /></span>
            <h3>{copy.emptyLatestTitle}</h3>
            <p>{copy.emptyLatestBody}</p>
          </div>
          <ul>
            <li><Icon name="external" size={18} />{copy.promiseSources}</li>
            <li><Icon name="clock" size={18} />{copy.promiseDates}</li>
            <li><Icon name="check" size={18} />{copy.promiseCorrections}</li>
          </ul>
          <a class="btn btn-primary btn-sm" href={localizedPath(locale, 'categories')}>
            {t.categories}<Icon name="arrow" size={18} />
          </a>
        </div>
      )}
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="section deadline-section">
      <div class="container">
        <div class="section-heading-row">
          <div class="section-head">
            <span class="eyebrow"><Icon name="clock" size={18} />{t.deadlines}</span>
            <h2>{t.deadlines}</h2>
            <p>{copy.deadlineIntro}</p>
          </div>
          <a href={localizedPath(locale, 'deadlines')}>{t.viewAll}<Icon name="arrow" size={18} /></a>
        </div>
        <div class="deadline-grid">{upcoming.map((article) => <ArticleCard {article} {locale} compact />)}</div>
      </div>
    </section>
  )}

  <section class="section verification-section" id="about">
    <div class="container verification-layout">
      <div class="verification-heading">
        <span class="eyebrow">{t.independent}</span>
        <h2>{copy.processTitle}</h2>
        <p>{copy.processBody}</p>
        <a href={localizedPath(locale, 'editorial-policy')}>
          {copy.learnMethod}<Icon name="arrow" size={18} />
        </a>
      </div>
      <ol class="verification-timeline">
        <li><span>01</span><Icon name="services" /><strong>{t.stepDiscover}</strong></li>
        <li><span>02</span><Icon name="check" /><strong>{t.stepVerify}</strong></li>
        <li><span>03</span><Icon name="book" /><strong>{t.stepExplain}</strong></li>
        <li><span>04</span><Icon name="clock" /><strong>{t.stepUpdate}</strong></li>
      </ol>
      <div class="independence-note">
        <Icon name="about" size={28} />
        <div>
          <strong>{t.independent}</strong>
          <span>{t.disclaimerShort}</span>
          <a href={trustPagePath(locale, 'about')}>{t.learnMoreAbout}<Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 6.5rem) 0 1.5rem;
    background:
      radial-gradient(circle at 88% 8%, rgba(var(--color-primary-rgb), .16), transparent 30%),
      radial-gradient(circle at 4% 92%, rgba(var(--color-green-rgb), .10), transparent 28%),
      linear-gradient(150deg, var(--color-surface), var(--color-bg));
  }
  .home-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(rgba(var(--color-primary-rgb), .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--color-primary-rgb), .035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, #000, transparent 78%);
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero-copy { max-width: 720px; }
  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: .65rem;
    margin-bottom: 1.2rem;
    color: var(--color-green-text);
    font-weight: 800;
    font-size: .84rem;
    letter-spacing: .02em;
  }
  .hero-kicker span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 0 5px rgba(var(--color-green-rgb), .12);
  }
  .hero-copy h1 {
    max-width: 15ch;
    font-size: clamp(2.55rem, 6.4vw, 5.15rem);
    line-height: 1.01;
    letter-spacing: -.045em;
  }
  .hero-description {
    max-width: 62ch;
    margin: 1.25rem 0 1.5rem;
    color: var(--color-text-muted);
    font-size: clamp(1.05rem, 1rem + .35vw, 1.24rem);
  }
  .hero-search {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .7rem;
    max-width: 710px;
    padding: .5rem .5rem .5rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: var(--color-surface);
    box-shadow: 0 18px 46px rgba(11, 29, 58, .11);
  }
  .hero-search > svg { color: var(--color-primary); }
  .hero-search input {
    width: 100%;
    min-width: 0;
    padding: .75rem 0;
    border: 0;
    outline: 0;
    background: transparent;
  }
  .hero-search button {
    min-height: 48px;
    padding: 0 1.4rem;
    border-radius: 13px;
    background: var(--color-primary);
    color: #fff;
    font-weight: 800;
  }
  .hero-quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-top: .85rem;
  }
  .hero-quick-links a {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    min-height: 42px;
    padding: .45rem .8rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: rgba(255, 255, 255, .62);
    color: var(--color-text);
    font-size: .82rem;
    font-weight: 750;
  }
  [data-theme="dark"] .hero-quick-links a { background: rgba(16, 26, 44, .72); }
  .hero-note {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: 1.2rem;
    color: var(--color-text-muted);
    font-size: .86rem;
  }
  .hero-note svg { color: var(--color-green-text); }

  .featured-update {
    overflow: hidden;
    border: 1px solid rgba(var(--color-primary-rgb), .15);
    border-radius: 28px;
    background: var(--color-surface);
    box-shadow: 0 28px 70px rgba(11, 29, 58, .15);
  }
  .featured-image {
    position: relative;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--color-navy), var(--color-primary));
  }
  .featured-image picture,
  .featured-image img { width: 100%; height: 100%; }
  .featured-image img { object-fit: cover; }
  .featured-image > span {
    position: absolute;
    top: 1rem;
    left: 1rem;
    padding: .4rem .75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, .94);
    color: #0b1d3a;
    font-size: .72rem;
    font-weight: 900;
    box-shadow: var(--shadow-sm);
  }
  .image-fallback {
    height: 100%;
    display: grid;
    place-items: center;
    color: #fff;
  }
  .featured-body { padding: clamp(1.25rem, 3vw, 1.75rem); }
  .featured-badges {
    display: flex;
    justify-content: space-between;
    gap: .7rem;
    color: var(--color-green-text);
    font-size: .72rem;
    font-weight: 850;
  }
