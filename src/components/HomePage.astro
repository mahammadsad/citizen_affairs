---

<MainLayout title={copy.title} description={copy.description} {locale} {canonical} {alternateUrls}>
  <section class="portal-hero">
    <div class="container portal-hero-grid">
      <div class="portal-hero-copy">
        <span class="portal-label"><Icon name="check" size={17} />{copy.label}</span>
        <h1>{copy.title}</h1>
        <p>{copy.description}</p>
        <form class="portal-search" action={route('search')}>
          <Icon name="search" size={23} />
          <input name="q" type="search" placeholder={copy.searchPlaceholder} aria-label={t.search} />
          <button type="submit">{t.search}</button>
        </form>
        <div class="portal-promises" aria-label={t.verificationMethod}>
          <span><Icon name="external" size={16} />{copy.officialPromise}</span>
          <span><Icon name="clock" size={16} />{copy.lastCheckedPromise}</span>
          <span><Icon name="check" size={16} />{copy.correctionPromise}</span>
        </div>
      </div>

      <aside class="portal-today">
        <div class="portal-section-label">
          <span>{copy.importantToday}</span>
          {allArticles.length > 0 && <a href={route('articles')}>{copy.browseAll}<Icon name="arrow" size={17} /></a>}
        </div>
        {featured ? (
          <article class="portal-lead">
            {featured.data.featuredImage && (
              <picture>
                {featured.data.featuredImageAvif && (
                  <source
                    srcset={resolveSrcSet(featured.data.featuredImageAvifSrcSet) || resolveAssetPath(featured.data.featuredImageAvif)}
                    type="image/avif"
                  />
                )}
                <img
                  src={resolveAssetPath(featured.data.featuredImage)}
                  srcset={resolveSrcSet(featured.data.featuredImageSrcSet)}
                  alt={featured.data.featuredImageAlt || featured.data.title}
                  width={featured.data.featuredImageWidth || 1200}
                  height={featured.data.featuredImageHeight || 675}
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
            )}
            <div>
              <div class="portal-lead-meta">
                <span>{featuredCategory ? categoryName(featuredCategory, locale) : featured.data.category}</span>
                <span><Icon name="check" size={14} />{verificationLabels[locale][featured.data.verificationStatus]}</span>
              </div>
              <h2><a href={route(`articles/${featured.data.urlSlug}`)}>{featured.data.title}</a></h2>
              <p>{featured.data.description}</p>
              <dl>
                {featured.data.deadline && (
                  <div>
                    <dt>{t.deadline}</dt>
                    <dd>{formatter.format(featured.data.deadline)} · {deadlineLabel(deadlineState(featured.data.deadline), locale)}</dd>
                  </div>
                )}
                <div>
                  <dt>{copy.lastUpdated}</dt>
                  <dd>{formatter.format(featured.data.updated || featured.data.date)}</dd>
                </div>
              </dl>
              <a class="portal-primary-link" href={route(`articles/${featured.data.urlSlug}`)}>
                {t.readMore}<Icon name="arrow" size={18} />
              </a>
            </div>
          </article>
        ) : (
          <div class="portal-start">
            <span class="portal-start-icon"><Icon name="categories" size={30} /></span>
            <h2>{copy.startHere}</h2>
            <p>{copy.startHereBody}</p>
            <div>
              {activeCategories.slice(0, 4).map((category) => (
                <a href={route(`categories/${category.id}`)}>
                  <Icon name={iconMap[category.id] || 'book'} size={18} />
                  {categoryName(category, locale)}
                </a>
              ))}
            </div>
          </div>
        )}

        {importantToday.length > 0 && (
          <ol class="portal-headlines">
            {importantToday.map((article) => {
              const articleCategory = categories.find((category) => category.id === article.data.category);
              return (
                <li>
                  <a href={route(`articles/${article.data.urlSlug}`)}>
                    <span>{articleCategory ? categoryName(articleCategory, locale) : article.data.category}</span>
                    <strong>{article.data.title}</strong>
                    <small>{formatter.format(article.data.updated || article.data.date)}</small>
                  </a>
                </li>
              );
            })}
          </ol>
        )}
      </aside>
    </div>
  </section>

  <section class="portal-actions section">
    <div class="container">
      <div class="portal-heading">
        <span>{t.quickLinks}</span>
        <h2>{copy.actionHeading}</h2>
        <p>{copy.actionIntro}</p>
      </div>
      <div class="portal-action-grid">
        {copy.actions.map(([title, description, category, icon]) => (
          <a href={route(`categories/${category}`)}>
            <span><Icon name={icon} size={25} /></span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
            <Icon name="arrow" size={19} />
          </a>
        ))}
      </div>
    </div>
  </section>

  {upcoming.length > 0 && (
    <section class="portal-deadlines section">
      <div class="container">
        <div class="portal-heading-row">
          <div class="portal-heading">
            <span>{t.deadlines}</span>
            <h2>{copy.deadlines}</h2>
            <p>{copy.deadlineIntro}</p>
          </div>
          <a href={route('deadlines')}>{copy.viewDeadlines}<Icon name="arrow" size={18} /></a>
        </div>
        <div class="portal-deadline-list">
          {upcoming.map((article) => {
            const articleCategory = categories.find((category) => category.id === article.data.category);
            return (
              <a href={route(`articles/${article.data.urlSlug}`)}>
                <div>
                  <span>{articleCategory ? categoryName(articleCategory, locale) : article.data.category}</span>
                  <strong>{article.data.title}</strong>
                </div>
                <div>
                  <small>{deadlineLabel(deadlineState(article.data.deadline), locale)}</small>
                  <time datetime={article.data.deadline?.toISOString()}>{article.data.deadline ? formatter.format(article.data.deadline) : copy.noDeadline}</time>
                </div>
                <Icon name="arrow" size={19} />
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="portal-sections section">
    <div class="container">
      <div class="portal-heading-row">
        <div class="portal-heading">
          <span>{t.categories}</span>
          <h2>{copy.startHere}</h2>
          <p>{copy.startHereBody}</p>
        </div>
        <a href={route('categories')}>{copy.viewCategories}<Icon name="arrow" size={18} /></a>
      </div>
      <div class="portal-category-grid">
        {activeCategories.map((category) => {
          const count = allArticles.filter((article) => article.data.category === category.id).length;
          return (
            <a href={route(`categories/${category.id}`)}>
              <span class="portal-category-icon"><Icon name={iconMap[category.id] || 'book'} size={27} /></span>
              <div>
                <h3>{categoryName(category, locale)}</h3>
                <p>{categoryDescription(category, locale)}</p>
                {count > 0 && <small>{count} {t.articles.toLowerCase()}</small>}
              </div>
              <Icon name="arrow" size={20} />
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {latestArticles.length > 0 && (
    <section class="portal-latest section">
      <div class="container">
        <div class="portal-heading-row">
          <div class="portal-heading">
            <span>{t.latest}</span>
            <h2>{copy.latest}</h2>
            <p>{copy.latestIntro}</p>
          </div>
          <a href={route('articles')}>{copy.browseAll}<Icon name="arrow" size={18} /></a>
        </div>
        <div class="portal-article-grid">
          {latestArticles.map((article) => <ArticleCard {article} {locale} />)}
        </div>
      </div>
    </section>
  )}

  {changedArticles.length > 0 && (
    <section class="portal-changes section">
      <div class="container">
        <div class="portal-heading">
          <span>{t.updated}</span>
          <h2>{copy.changed}</h2>
          <p>{copy.changedIntro}</p>
        </div>
        <div class="portal-change-grid">
          {changedArticles.map((article) => (
            <a href={route(`articles/${article.data.urlSlug}`)}>
              <span><Icon name="clock" size={19} /></span>
              <div>
                <h3>{article.data.title}</h3>
                <p>{article.data.updateHistory[0]}</p>
              </div>
              <Icon name="arrow" size={18} />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="portal-discovery section">
    <div class="container portal-discovery-grid">
      <div>
        <span class="portal-label"><Icon name="search" size={17} />{t.search}</span>
        <h2>{copy.stateTitle}</h2>
        <p>{copy.stateBody}</p>
        <form class="portal-search portal-search-compact" action={route('search')}>
          <Icon name="search" size={21} />
          <input name="q" type="search" placeholder={copy.searchPlaceholder} aria-label={t.search} />
          <button type="submit">{copy.stateCta}</button>
        </form>
      </div>
      <nav aria-label={t.popularSearches}>
        {copy.popularNeeds.map(([label, category]) => (
          <a href={route(`categories/${category}`)}>{label}<Icon name="arrow" size={17} /></a>
        ))}
      </nav>
    </div>
  </section>

  <section class="portal-method section">
    <div class="container portal-method-grid">
      <div>
        <span class="portal-label"><Icon name="check" size={17} />{t.verificationMethod}</span>
        <h2>{copy.methodTitle}</h2>
        <p>{copy.methodBody}</p>
        <a href={route('editorial-policy')}>{copy.methodLink}<Icon name="arrow" size={18} /></a>
      </div>
      <ol>
        <li><span>01</span><strong>{t.stepDiscover}</strong></li>
        <li><span>02</span><strong>{t.stepVerify}</strong></li>
        <li><span>03</span><strong>{t.stepExplain}</strong></li>
        <li><span>04</span><strong>{t.stepUpdate}</strong></li>
      </ol>
      <aside>
        <Icon name="about" size={24} />
        <p>{t.disclaimerShort}</p>
        <a href={trustPagePath(locale, 'about')}>{t.learnMoreAbout}<Icon name="arrow" size={17} /></a>
      </aside>
    </div>
  </section>
</MainLayout>

