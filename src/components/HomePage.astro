---
import MainLayout from '@layouts/MainLayout.astro';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';
import { getLocalizedArticles, getUpcomingDeadlines, categoryDescription, categoryName } from '@lib/content';
import { deadlineLabel, deadlineState } from '@lib/deadline';
import { ACTIVE_CATEGORY_IDS, resolveAssetPath, SITE, SOCIALS } from '@utils/constants';
import { formatUpdateCount, locales, localizedPath, trustPagePath, type Locale, ui, verificationLabels, dateLocale } from '../i18n';

const { locale } = Astro.props as { locale: Locale; isRoot?: boolean };
const t = ui(locale);
const allArticles = await getLocalizedArticles(locale);
const hasPublishedContent = allArticles.length > 0;
const latestArticles = allArticles.slice(0, 6);
const categories = await getCollection('categories');
const activeCategories = categories.filter((category) => ACTIVE_CATEGORY_IDS.includes(category.id));
const upcoming = await getUpcomingDeadlines(locale, 4);
const featured = allArticles.find((article) => article.data.featured) || allArticles[0];
const canonical = locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/`;
const alternateUrls = Object.fromEntries(locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/` : `${SITE.url}/${lang}/`])) as Record<Locale, string>;
const iconMap: Record<string, string> = { jobs: 'briefcase', projects: 'schemes', exams: 'exams', notices: 'notices', affairs: 'services', materials: 'education' };
const popularSearches = t.popularSearchTerms;
const popularCategories = activeCategories;
const featuredCategory = featured ? categories.find((category) => category.id === featured.data.category) : undefined;
const formatter = new Intl.DateTimeFormat(dateLocale(locale), { year: 'numeric', month: 'short', day: 'numeric' });
const resolveSrcSet = (value?: string) => value?.split(',').map((entry) => { const [url, width] = entry.trim().split(/\s+/); return `${resolveAssetPath(url)} ${width}`; }).join(', ');
---
<MainLayout title={t.nationwide} description={t.heroDescription} {locale} {canonical} {alternateUrls}>
  <section class="home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="hero-eyebrow"><i></i>{t.nationwide}</span>
        <h1>{t.heroTitle}</h1>
        <p>{t.heroDescription}</p>
        <form class="hero-search" action={locale === 'en' ? localizedPath(locale, 'search').replace('/en/', '/') : localizedPath(locale, 'search')}><Icon name="search" /><input name="q" type="search" placeholder={t.searchPlaceholder} aria-label={t.search} /><button type="submit">{t.search}</button></form>
        <div class="popular-chips" aria-label={t.popularSearches}>{popularSearches.map((term) => <button type="button" data-search-term={term}>{term}</button>)}</div>
        <div class="hero-actions"><a class="btn btn-primary" href={localizedPath(locale, 'articles')}>{t.explore}<Icon name="arrow" /></a><a class="btn btn-secondary" href={SOCIALS.telegram} target="_blank" rel="noopener noreferrer">{t.joinTelegram}<Icon name="external" /></a></div>
        <div class="trust-row"><span><Icon name="check" />{t.verifiedSources}</span><span><Icon name="globe" />{t.threeLanguages}</span><span><strong>₹0</strong>{t.freeAccess}</span><span><Icon name="clock" />{t.regularlyUpdated}</span></div>
      </div>
      <aside class="featured-update">
        {featured ? <>
          <div class="featured-image">{featured.data.featuredImage ? <picture>{featured.data.featuredImageAvif&&<source srcset={resolveSrcSet(featured.data.featuredImageAvifSrcSet)||resolveAssetPath(featured.data.featuredImageAvif)} sizes="(max-width: 980px) calc(100vw - 2rem), 520px" type="image/avif"/>}<img src={resolveAssetPath(featured.data.featuredImage)} srcset={resolveSrcSet(featured.data.featuredImageSrcSet)} sizes="(max-width: 980px) calc(100vw - 2rem), 520px" alt={featured.data.featuredImageAlt || featured.data.title} width={featured.data.featuredImageWidth || 1200} height={featured.data.featuredImageHeight || 675} fetchpriority="high" decoding="async" /></picture> : <div class="image-fallback"><Icon name={iconMap[featured.data.category] || 'updates'} size={58} /></div>}<span>{featured.data.featured ? t.featured : t.latest}</span></div>
          <div class="featured-body"><div class="featured-badges"><span>{featuredCategory ? categoryName(featuredCategory, locale) : featured.data.category}</span><span>{verificationLabels[locale][featured.data.verificationStatus]}</span></div><h2>{featured.data.title}</h2><p>{featured.data.description}</p><dl>{featured.data.deadline && <div><dt>{t.deadline}</dt><dd>{formatter.format(featured.data.deadline)} · {deadlineLabel(deadlineState(featured.data.deadline), locale)}</dd></div>}<div><dt>{t.updated}</dt><dd>{formatter.format(featured.data.updated || featured.data.date)}</dd></div></dl><div class="featured-actions"><a class="btn btn-primary btn-sm" href={localizedPath(locale, `articles/${featured.data.urlSlug}`)}>{t.readMore}</a>{featured.data.applicationUrl && <a class="btn btn-secondary btn-sm" href={featured.data.applicationUrl} target="_blank" rel="noopener noreferrer">{t.apply}</a>}</div></div>
        </> : <div class="empty-feature"><div class="image-fallback"><Icon name="updates" size={64} /></div><h2>{t.featuredEmptyTitle}</h2><p>{t.featuredEmptyBody}</p><div class="featured-actions"><a class="btn btn-primary btn-sm" href={SOCIALS.telegram} target="_blank" rel="noopener noreferrer">{t.telegramUpdates}<Icon name="external" /></a><a class="btn btn-secondary btn-sm" href={SOCIALS.whatsapp} target="_blank" rel="noopener noreferrer">{t.whatsappUpdates}<Icon name="external" /></a></div></div>}
      </aside>
    </div>
  </section>

  <section class="section" id="categories"><div class="container"><div class="section-head"><span class="eyebrow">{t.categories}</span><h2>{t.whatWeCover}</h2></div><div class="category-grid">{activeCategories.map((category) => { const count = allArticles.filter((article) => article.data.category === category.id).length; return <a class="category-card" href={localizedPath(locale, `categories/${category.id}`)}><span class="category-icon"><Icon name={iconMap[category.id] || 'book'} size={26} /></span><div><h3>{categoryName(category, locale)}</h3><p>{categoryDescription(category, locale)}</p>{count > 0 && <small>{formatUpdateCount(locale, count)}</small>}</div><Icon name="arrow" /></a>; })}</div></div></section>

  {hasPublishedContent && <section class="section section-alt"><div class="container"><div class="section-heading-row"><div class="section-head"><span class="eyebrow">{t.latest}</span><h2>{t.latest}</h2><p>{t.latestDescription}</p></div><a href={localizedPath(locale, 'articles')}>{t.viewAll}<Icon name="arrow" /></a></div><div class="articles-grid">{latestArticles.map((article) => <ArticleCard {article} {locale} />)}</div></div></section>}

  {upcoming.length > 0 && <section class="section"><div class="container"><div class="section-heading-row"><div class="section-head"><span class="eyebrow"><Icon name="clock" />{t.deadlines}</span><h2>{t.deadlines}</h2></div><a href={localizedPath(locale, 'deadlines')}>{t.viewAll}<Icon name="arrow" /></a></div><div class="deadline-grid">{upcoming.map((article) => <ArticleCard {article} {locale} compact />)}</div></div></section>}

  {hasPublishedContent && <section class="section section-alt"><div class="container"><div class="section-head"><span class="eyebrow">{t.services}</span><h2>{t.popularServices}</h2></div><div class="service-grid">{popularCategories.map((category) => <a href={localizedPath(locale, `categories/${category.id}`)}><Icon name={iconMap[category.id] || 'services'} size={30} /><div><h3>{categoryName(category, locale)}</h3><p>{categoryDescription(category, locale)}</p></div><Icon name="arrow" /></a>)}</div></div></section>}

  <section class="section verification-section" id="about"><div class="container"><div class="verification-heading"><span class="eyebrow">{t.independent}</span><h2>{t.howItWorks}</h2><p>{t.disclaimerShort}</p></div><ol class="verification-timeline"><li><span>01</span><Icon name="services" /><strong>{t.stepDiscover}</strong></li><li><span>02</span><Icon name="check" /><strong>{t.stepVerify}</strong></li><li><span>03</span><Icon name="book" /><strong>{t.stepExplain}</strong></li><li><span>04</span><Icon name="clock" /><strong>{t.stepUpdate}</strong></li></ol><div class="independence-note"><Icon name="about" /><div><strong>{t.independent}</strong><span>{t.disclaimerShort}</span><a href={trustPagePath(locale, 'about')}>{t.learnMoreAbout}<Icon name="arrow" size={18} /></a></div></div></div></section>

  <section class="community-section" id="community"><div class="container community-inner"><div><span class="eyebrow">{t.community}</span><h2>{t.communityTitle}</h2></div><div class="community-buttons"><a href={SOCIALS.telegram} target="_blank" rel="noopener noreferrer"><Icon name="telegram" />Telegram<Icon name="external" /></a><a href={SOCIALS.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" />WhatsApp<Icon name="external" /></a><a href={SOCIALS.telegramMCQ} target="_blank" rel="noopener noreferrer"><Icon name="group" />MCQ Group<Icon name="external" /></a></div></div></section>
</MainLayout>

<script>
  const openSearch = (term = '') => { const button = document.getElementById('searchToggle'); button?.click(); setTimeout(() => { const input = document.getElementById('searchInput') as HTMLInputElement | null; if (input) { input.value = term; input.dispatchEvent(new Event('input')); } }, 80); };
  document.querySelectorAll('[data-search-term]').forEach((chip) => chip.addEventListener('click', () => openSearch((chip as HTMLElement).dataset.searchTerm || '')));
</script>
<style>
  .featured-image picture{display:block;height:100%}
  .home-hero{padding:clamp(2.5rem,6vw,5.5rem) 0;background:radial-gradient(circle at 90% 0,rgba(var(--color-primary-rgb),.12),transparent 35%),linear-gradient(135deg,var(--color-surface),var(--color-bg))}.hero-grid{display:grid;gap:2rem;align-items:center}.hero-copy h1{font-size:clamp(2.25rem,5vw,4.5rem);line-height:1.06;letter-spacing:-.035em;max-width:17ch}.hero-copy>p{font-size:1.1rem;color:var(--color-text-muted);max-width:65ch;margin:1rem 0}.hero-eyebrow{display:inline-flex;gap:.5rem;align-items:center;margin-bottom:1rem;color:var(--color-green-text);font-weight:800}.hero-eyebrow i{width:8px;height:8px;border-radius:50%;background:var(--color-green)}.hero-search{display:flex;align-items:center;gap:.65rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px;padding:.45rem .45rem .45rem 1rem;max-width:700px;box-shadow:var(--shadow-md)}.hero-search input{flex:1;min-width:0;border:0;outline:0;background:transparent;padding:.7rem 0}.hero-search button{min-height:44px;padding:0 1.2rem;border-radius:12px;background:var(--color-primary);color:#fff;font-weight:800}.popular-chips{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.8rem}.popular-chips button{min-height:36px;padding:.35rem .75rem;border-radius:999px;background:var(--color-surface-alt);border:1px solid var(--color-border);font-size:.78rem}.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin:1.5rem 0}.trust-row{display:flex;gap:1rem;flex-wrap:wrap}.trust-row span{display:flex;align-items:center;gap:.35rem;color:var(--color-text-muted);font-size:.8rem}.trust-row svg,.trust-row strong{color:var(--color-green-text)}.featured-update{background:var(--color-surface);border:1px solid var(--color-border);border-radius:24px;overflow:hidden;box-shadow:var(--shadow-lg)}.featured-image{position:relative;aspect-ratio:16/9;background:linear-gradient(135deg,var(--color-navy),var(--color-primary))}.featured-image img{width:100%;height:100%;object-fit:cover}.featured-image>span{position:absolute;top:1rem;left:1rem;padding:.35rem .7rem;border-radius:999px;background:#fff;color:#092b4b;font-size:.72rem;font-weight:900}.image-fallback{height:100%;display:grid;place-items:center;color:#fff}.featured-body,.empty-feature{padding:1.35rem}.featured-badges{display:flex;justify-content:space-between;gap:.6rem;font-size:.7rem;color:var(--color-green-text);font-weight:800}.featured-body h2,.empty-feature h2{font-size:1.4rem;margin:.65rem 0}.featured-body p,.empty-feature p{color:var(--color-text-muted)}.featured-body dl{display:flex;gap:1rem;flex-wrap:wrap;margin:1rem 0}.featured-body dt{font-size:.68rem;color:var(--color-text-muted)}.featured-body dd{font-weight:800;font-size:.82rem}.featured-actions{display:flex;gap:.6rem;flex-wrap:wrap}.empty-feature .image-fallback{height:190px;border-radius:16px;background:linear-gradient(135deg,var(--color-navy),var(--color-primary));margin-bottom:1rem}.empty-feature .btn{margin-top:1rem}.category-grid,.articles-grid,.deadline-grid,.service-grid{display:grid;gap:1rem}.category-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem;align-items:center;background:var(--color-surface);border:1px solid var(--color-border);border-radius:18px;padding:1.25rem;transition:.2s}.category-card:hover,.category-card:focus-visible{transform:translateY(-3px);box-shadow:var(--shadow-md)}.category-icon{width:52px;height:52px;border-radius:15px;display:grid;place-items:center;background:rgba(var(--color-primary-rgb),.1);color:var(--color-primary)}.category-card h3{font-size:1.05rem}.category-card p{font-size:.85rem;color:var(--color-text-muted);line-height:1.45}.category-card small{color:var(--color-green-text);font-weight:700}.section-heading-row{display:flex;align-items:end;justify-content:space-between;gap:1rem}.section-heading-row>a{display:flex;align-items:center;gap:.3rem;color:var(--color-primary);font-weight:800;margin-bottom:var(--space-5)}.empty-state{display:flex;align-items:center;justify-content:center;gap:.75rem;min-height:130px;padding:2rem;border:1px dashed var(--color-border);border-radius:18px;text-align:center;color:var(--color-text-muted);background:var(--color-surface)}.empty-state svg{flex:0 0 auto;color:var(--color-primary)}.service-grid>a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1.2rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px}.service-grid>a>svg:first-child{color:var(--color-primary)}.service-grid p{font-size:.82rem;color:var(--color-text-muted)}.verification-heading{text-align:center;max-width:680px;margin:auto}.verification-timeline{display:grid;gap:1rem;margin:2rem 0}.verification-timeline li{display:grid;grid-template-columns:auto auto 1fr;gap:.8rem;align-items:center;padding:1rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:16px}.verification-timeline li>span{color:var(--color-primary);font-weight:900}.verification-timeline svg{color:var(--color-green-text)}.independence-note{display:flex;gap:.8rem;align-items:center;max-width:700px;margin:auto;padding:1rem;border-radius:16px;background:rgba(var(--color-orange-rgb),.1);border:1px solid rgba(var(--color-orange-rgb),.25)}.independence-note div{display:flex;flex-direction:column}.independence-note span{font-size:.86rem;color:var(--color-text-muted)}.independence-note a{display:inline-flex;align-items:center;gap:.35rem;width:max-content;margin-top:.45rem;color:var(--color-primary);font-weight:800}.community-section{padding:3rem 0;background:linear-gradient(135deg,#092b4b,#113b60);color:#fff}.community-inner{display:grid;gap:1.5rem;align-items:center}.community-inner h2{color:#fff}.community-buttons{display:grid;gap:.65rem}.community-buttons a{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.6rem;align-items:center;min-height:52px;padding:.75rem 1rem;border-radius:14px;background:rgba(255,255,255,.1)}
  @media(min-width:680px){.category-grid,.deadline-grid{grid-template-columns:repeat(2,1fr)}.articles-grid{grid-template-columns:repeat(2,1fr)}.service-grid{grid-template-columns:repeat(3,1fr)}.verification-timeline{grid-template-columns:repeat(2,1fr)}.community-inner{grid-template-columns:1fr 1fr}}
  @media(min-width:960px){.hero-grid{grid-template-columns:1.15fr .85fr}.category-grid,.articles-grid{grid-template-columns:repeat(3,1fr)}.verification-timeline{grid-template-columns:repeat(4,1fr)}.verification-timeline li{grid-template-columns:1fr;text-align:center;justify-items:center}.community-inner{grid-template-columns:1fr auto}.community-buttons{grid-template-columns:repeat(3,1fr)}}
  @media(max-width:540px){.hero-search button{font-size:0;width:44px;padding:0}.hero-search button::after{content:'→';font-size:1rem}.section-heading-row{align-items:start}.section-heading-row>a{font-size:.8rem}.trust-row{display:grid;grid-template-columns:1fr 1fr}}
</style>
