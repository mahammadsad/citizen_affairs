<script>
  import { shortPathForArticle } from '../lib/short-links.mjs';

  type ArticleShareContext = {
    title: string;
    description: string;
    shortUrl: string;
  };

  (() => {
    const externalCopy = {
      en: { opens: 'Opens external destination in a new tab', destination: 'Destination' },
      bn: { opens: 'নতুন ট্যাবে বাইরের গন্তব্য খুলবে', destination: 'গন্তব্য' },
      hi: { opens: 'बाहरी गंतव्य नए टैब में खुलेगा', destination: 'गंतव्य' }
    } as const;

    const documentLocale = document.documentElement.lang;
    const locale = documentLocale === 'bn' ? 'bn' : documentLocale === 'hi' ? 'hi' : 'en';
    const external = externalCopy[locale];

    const getArticleShareContext = (): ArticleShareContext | null => {
      const article = document.querySelector('[data-article]');
      if (!(article instanceof HTMLElement)) return null;

      const articleId = article.dataset.id || '';
      const separator = articleId.indexOf(':');
      if (separator <= 0) return null;

      const articleLocale = articleId.slice(0, separator);
      const urlSlug = articleId.slice(separator + 1);
      if (!['en', 'bn', 'hi'].includes(articleLocale) || !urlSlug) return null;

      return {
        title: article.dataset.title || document.title,
        description: article.dataset.description || '',
        shortUrl: new URL(shortPathForArticle(articleLocale, urlSlug), location.origin).href,
      };
    };

    const setShortShareHref = (link: HTMLAnchorElement, context: ArticleShareContext) => {
      const shareUrl = encodeURIComponent(context.shortUrl);
      const shareText = encodeURIComponent(context.title);
      const type = link.dataset.share;

      link.href = type === 'whatsapp'
        ? `https://wa.me/?text=${shareText}%20${shareUrl}`
        : type === 'telegram'
          ? `https://t.me/share/url?url=${shareUrl}&text=${shareText}`
          : `https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
    };

    const syncShortShareLinks = () => {
      const context = getArticleShareContext();
      if (!context) return;

      document.querySelectorAll('[data-share]').forEach((link) => {
        if (link instanceof HTMLAnchorElement) setShortShareHref(link, context);
      });
    };

    const copyText = async (value: string) => {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(value);
        return;
      }

      const textarea = document.createElement('textarea');
      textarea.value = value;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.append(textarea);
      textarea.select();
      document.execCommand('copy');
      textarea.remove();
    };

    const handleShortShareClick = async (event: MouseEvent) => {
      const target = event.target instanceof Element
        ? event.target.closest('#nativeShare, #copyLink, [data-share]')
        : null;
      if (!target) return;

      const context = getArticleShareContext();
      if (!context) return;

      if (target instanceof HTMLAnchorElement && target.dataset.share) {
        setShortShareHref(target, context);
        return;
      }

      if (!(target instanceof HTMLButtonElement)) return;

      if (target.id === 'nativeShare') {
        event.preventDefault();
        event.stopImmediatePropagation();
        try {
          if (navigator.share) {
            await navigator.share({
              title: context.title,
              text: context.description,
              url: context.shortUrl,
            });
          } else {
            await copyText(context.shortUrl);
          }
        } catch (error) {
          if (!(error instanceof DOMException && error.name === 'AbortError')) {
            console.warn('Unable to share article', error);
          }
        }
        return;
      }

      if (target.id === 'copyLink') {
        event.preventDefault();
        event.stopImmediatePropagation();
        await copyText(context.shortUrl);
        const label = target.querySelector('span');
        if (label) {
          label.textContent = target.dataset.copiedLabel || 'Copied';
          setTimeout(() => {
            label.textContent = target.dataset.copyLabel || 'Copy link';
          }, 1600);
        }
      }
    };

    const syncDisclosureSemantics = () => {
      document
        .querySelectorAll<HTMLElement>('.portal-language > summary, .portal-more > summary')
        .forEach((summary) => {
          const details = summary.parentElement;
          if (!(details instanceof HTMLDetailsElement)) return;

          const syncExpanded = () => {
            summary.setAttribute('aria-expanded', details.open ? 'true' : 'false');
          };

          summary.setAttribute('role', 'button');
          syncExpanded();

          if (summary.dataset.portalDisclosureReady === 'true') return;
          summary.dataset.portalDisclosureReady = 'true';
          details.addEventListener('toggle', syncExpanded);
        });
    };

    const enhanceSourceAction = (link: HTMLAnchorElement, hostname: string) => {
      if (!link.closest('.source-actions') || link.dataset.sourceActionReady === 'true') return;

      const labelText = (link.textContent || '')
        .replace(/\s*↗\s*$/, '')
        .trim() || external.destination;

      link.dataset.sourceActionReady = 'true';
      link.classList.add('source-action-link');
      link.textContent = '';

      const label = document.createElement('span');
      label.className = 'source-action-label';
      label.textContent = labelText;

      const arrow = document.createElement('span');
      arrow.className = 'source-action-arrow';
      arrow.textContent = '↗';
      arrow.setAttribute('aria-hidden', 'true');

      link.append(label, arrow);

      const item = document.createElement('div');
      item.className = 'source-action-item';
      link.before(item);
      item.append(link);

      if (hostname) {
        const domain = document.createElement('small');
        domain.className = 'source-action-domain';
        domain.textContent = hostname;
        item.append(domain);
      }
    };

    const hardenExternalLinks = () => {
      document
        .querySelectorAll(
          '.source-panel a[target="_blank"], .decision-workspace a[target="_blank"], .utility-card a[target="_blank"]'
        )
        .forEach((link) => {
          if (!(link instanceof HTMLAnchorElement)) return;
          let hostname = '';
          try {
            hostname = new URL(link.href, location.href).hostname.replace(/^www\./, '');
          } catch (_) {}

          const rel = new Set((link.getAttribute('rel') || '').split(/\s+/).filter(Boolean));
          ['noopener', 'noreferrer', 'external'].forEach((value) => rel.add(value));
          link.setAttribute('rel', [...rel].join(' '));
          link.referrerPolicy = 'no-referrer';
          link.dataset.externalSafe = 'true';

          if (!link.getAttribute('aria-label')) {
            const label = link.textContent?.trim() || external.destination;
            link.setAttribute('aria-label', `${label}. ${hostname || external.destination}. ${external.opens}.`);
          }

          if (link.closest('.source-actions')) {
            enhanceSourceAction(link, hostname);
          } else if (link.closest('.source-panel') && hostname && !link.querySelector('.external-domain-cue')) {
            const cue = document.createElement('small');
            cue.className = 'external-domain-cue';
            cue.textContent = hostname;
            link.append(cue);
          }
        });
    };

    const syncPortalSelectors = () => {
      document.querySelector('.action-grid')?.classList.add('portal-action-grid');
      syncDisclosureSemantics();
      hardenExternalLinks();
      syncShortShareLinks();
    };

    document.addEventListener('click', handleShortShareClick, true);

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', syncPortalSelectors, { once: true });
    } else {
      syncPortalSelectors();
    }

    window.addEventListener('pageshow', syncPortalSelectors);
  })();
</script>

