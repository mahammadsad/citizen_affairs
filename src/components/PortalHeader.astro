---
import { getCollection } from 'astro:content';
import { ACTIVE_CATEGORY_IDS, getBrandName } from '@utils/constants';
import { categoryName } from '@lib/content';
import BrandLogo from './BrandLogo.astro';
import Icon from './Icon.astro';
import { localeMeta, locales, localizedPath, type Locale, ui } from '../i18n';

interface Props {
  locale: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
}

const { locale, alternateUrls = {} } = Astro.props;
const t = ui(locale);
const brandName = getBrandName(locale);
const pathname = Astro.url.pathname;
const route = (value = '') => {
  const path = localizedPath(locale, value);
  return locale === 'en' ? path.replace('/en/', '/') : path;
};
const languageUrls = Object.fromEntries(
  locales.map((lang) => {
    const fallback = localizedPath(lang);
    return [lang, alternateUrls[lang] || (lang === 'en' ? fallback.replace('/en/', '/') : fallback)];
  })
) as Record<Locale, string>;
const categories = (await getCollection('categories'))
  .filter((category) => ACTIVE_CATEGORY_IDS.includes(category.id))
  .sort((a, b) => ACTIVE_CATEGORY_IDS.indexOf(a.id) - ACTIVE_CATEGORY_IDS.indexOf(b.id));

const copy = {
  en: {
    jobs: 'Jobs', education: 'Education', schemes: 'Schemes', citizenServices: 'Citizen Services',
    deadlines: 'Deadlines', guides: 'Guides', more: 'More', admissions: 'Admissions, Exams & Results',
    alerts: 'Citizen Alerts', allUpdates: 'Latest Updates', saved: 'Saved',
    officialPolicy: 'Verification policy', closeMenu: 'Close menu'
  },
  bn: {
    jobs: 'চাকরি', education: 'শিক্ষা', schemes: 'প্রকল্প', citizenServices: 'নাগরিক পরিষেবা',
    deadlines: 'সময়সীমা', guides: 'গাইড', more: 'আরও', admissions: 'ভর্তি, পরীক্ষা ও ফলাফল',
    alerts: 'নাগরিক সতর্কতা', allUpdates: 'সর্বশেষ আপডেট', saved: 'সংরক্ষিত',
    officialPolicy: 'যাচাই নীতি', closeMenu: 'মেনু বন্ধ করুন'
  },
  hi: {
    jobs: 'नौकरियाँ', education: 'शिक्षा', schemes: 'योजनाएँ', citizenServices: 'नागरिक सेवाएँ',
    deadlines: 'समय-सीमाएँ', guides: 'मार्गदर्शिकाएँ', more: 'अधिक', admissions: 'प्रवेश, परीक्षाएँ और परिणाम',
    alerts: 'नागरिक अलर्ट', allUpdates: 'नवीनतम अपडेट', saved: 'सहेजे गए',
    officialPolicy: 'सत्यापन नीति', closeMenu: 'मेनू बंद करें'
  }
}[locale];

const primaryLinks = [
  { label: copy.jobs, href: route('categories/jobs'), match: '/categories/jobs' },
  { label: copy.education, href: route('categories/materials'), match: '/categories/materials' },
  { label: copy.schemes, href: route('categories/projects'), match: '/categories/projects' },
  { label: copy.citizenServices, href: route('categories/affairs'), match: '/categories/affairs' },
  { label: copy.deadlines, href: route('deadlines'), match: '/deadlines' },
  { label: copy.guides, href: route('categories/guides'), match: '/categories/guides' }
];

const moreLinks = [
  { label: copy.admissions, href: route('categories/exams'), icon: 'exams' },
  { label: copy.alerts, href: route('categories/notices'), icon: 'notices' },
  { label: copy.allUpdates, href: route('articles'), icon: 'updates' },
  { label: copy.officialPolicy, href: route('editorial-policy'), icon: 'check' }
];

const mobileCategories = categories.map((category) => ({
  label: categoryName(category, locale),
  href: route(`categories/${category.id}`),
  icon:
    category.id === 'jobs'
      ? 'briefcase'
      : category.id === 'projects'
        ? 'schemes'
        : category.id === 'exams'
          ? 'exams'
          : category.id === 'materials'
            ? 'education'
            : category.id === 'affairs'
              ? 'services'
              : category.id === 'notices'
                ? 'notices'
                : 'book'
}));
---

<header class="portal-header">
  <div class="portal-navbar">
    <div class="container portal-navbar-inner">
      <a class="portal-brand" href={route()} aria-label={`${brandName} — ${t.home}`}>
        <BrandLogo variant="horizontal" alt={`${brandName} ${t.logo}`} class="portal-brand-logo" />
      </a>

      <nav class="portal-desktop-nav" aria-label={t.primaryNav}>
        <a href={route()} aria-current={pathname === route() ? 'page' : undefined}>{t.home}</a>
        {primaryLinks.map((item) => (
          <a href={item.href} aria-current={pathname.includes(item.match) ? 'page' : undefined}>{item.label}</a>
        ))}
        <details class="portal-more">
          <summary>{copy.more}<span aria-hidden="true">⌄</span></summary>
          <div>
            {moreLinks.map((item) => (
              <a href={item.href}><Icon name={item.icon} size={18} />{item.label}</a>
            ))}
          </div>
        </details>
      </nav>

      <div class="portal-header-actions">
        <a class="portal-icon-action portal-search-action" href={route('search')} aria-label={t.search}>
          <Icon name="search" />
        </a>
        <a class="portal-icon-action portal-saved-action" href={route('saved')} aria-label={copy.saved}>
          <Icon name="bookmark" />
        </a>
        <details class="portal-language">
          <summary aria-label={`${t.language}: ${localeMeta[locale].nativeName}`}>
            <Icon name="globe" size={19} /><span>{localeMeta[locale].code}</span>
          </summary>
          <div>
            {locales.map((lang) => (
              <a
                href={languageUrls[lang]}
                lang={lang}
                hreflang={lang}
                aria-current={lang === locale ? 'true' : undefined}
              >
                <span>{lang === locale ? '✓' : ''}</span>{localeMeta[lang].nativeName}
              </a>
            ))}
          </div>
        </details>
        <button class="portal-icon-action portal-theme-toggle" type="button" aria-label={t.changeTheme} data-theme-toggle>
          <span class="portal-theme-icons" aria-hidden="true">
            <Icon name="theme" class="portal-theme-icon portal-theme-moon" />
            <svg class="portal-theme-icon portal-theme-sun" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3.5" />
              <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" />
            </svg>
          </span>
        </button>
        <button
          class="portal-icon-action portal-mobile-trigger"
          type="button"
          aria-label={t.menu}
          aria-expanded="false"
          aria-controls="portalMobilePanel"
          data-menu-label={t.menu}
          data-close-label={copy.closeMenu}
        >
          <span class="portal-menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </div>
  </div>

  <div class="portal-mobile-panel" id="portalMobilePanel" aria-hidden="true" inert>
    <div class="portal-mobile-panel-inner">
      <nav class="container" aria-label={t.mobileNav}>
        <a href={route()} aria-current={pathname === route() ? 'page' : undefined}><Icon name="home" size={20} /><span>{t.home}</span><Icon name="arrow" size={17} /></a>
        <a href={route('search')}><Icon name="search" size={20} /><span>{t.search}</span><Icon name="arrow" size={17} /></a>
        <a href={route('articles')}><Icon name="updates" size={20} /><span>{copy.allUpdates}</span><Icon name="arrow" size={17} /></a>
        {mobileCategories.map((item) => (
          <a href={item.href}><Icon name={item.icon} size={20} /><span>{item.label}</span><Icon name="arrow" size={17} /></a>
        ))}
        <a href={route('deadlines')}><Icon name="clock" size={20} /><span>{copy.deadlines}</span><Icon name="arrow" size={17} /></a>
        <a href={route('saved')}><Icon name="bookmark" size={20} /><span>{copy.saved}</span><Icon name="arrow" size={17} /></a>
      </nav>
      <div class="container portal-mobile-settings">
        <button type="button" class="portal-menu-theme-toggle" data-theme-toggle>
          <Icon name="theme" size={19} /><span>{t.changeTheme}</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  const syncThemeChrome = (theme: 'light' | 'dark') => {
    root.style.colorScheme = theme;
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
    if (themeColor) themeColor.content = theme === 'dark' ? '#081321' : '#ffffff';
  };

  const applyTheme = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    syncThemeChrome(theme);
    try { localStorage.setItem('theme', theme); } catch (_) {}
  };

  syncThemeChrome(root.dataset.theme === 'dark' ? 'dark' : 'light');

  themeButtons.forEach((button) => button.addEventListener('click', () => {
    applyTheme(root.dataset.theme === 'dark' ? 'light' : 'dark');
  }));

  document.querySelectorAll<HTMLDetailsElement>('.portal-header details').forEach((details) => {
    details.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => details.removeAttribute('open')));
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Element;
    document.querySelectorAll<HTMLDetailsElement>('.portal-header details[open]').forEach((details) => {
      if (!details.contains(target)) details.removeAttribute('open');
    });
  });
</script>

<style>
  .portal-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, .97);
    backdrop-filter: blur(12px);
  }
  [data-theme="dark"] .portal-header { background: rgba(8, 19, 33, .97); }
  .portal-navbar { position: relative; z-index: 2; background: transparent; }
  .portal-navbar-inner { display: flex; align-items: center; gap: .7rem; min-height: 70px; }
  .portal-brand { flex: 0 1 164px; min-width: 108px; overflow: hidden; }
  :global(.portal-brand-logo) { display: block; width: 164px; max-width: 100%; max-height: 50px; object-fit: contain; }
  .portal-desktop-nav { display: none; align-items: center; gap: clamp(.55rem, 1vw, .95rem); margin-left: auto; }
  .portal-desktop-nav > a,
  .portal-more > summary {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    color: var(--color-text);
    font-size: .8rem;
    font-weight: 650;
    white-space: nowrap;
  }
  .portal-desktop-nav > a:hover,
  .portal-desktop-nav > a[aria-current="page"] { border-bottom-color: var(--color-primary); color: var(--color-primary); }
  .portal-more,
  .portal-language { position: relative; }
  .portal-more summary,
  .portal-language summary { list-style: none; cursor: pointer; }
  .portal-more summary::-webkit-details-marker,
  .portal-language summary::-webkit-details-marker { display: none; }
  .portal-more summary { gap: .25rem; }
  .portal-more > div,
  .portal-language > div {
    position: absolute;
    right: 0;
    top: calc(100% + .4rem);
    min-width: 210px;
    padding: .35rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }
  .portal-more > div a,
  .portal-language > div a {
    display: flex;
    align-items: center;
    gap: .55rem;
    min-height: 42px;
    padding: .55rem .65rem;
    border-radius: 6px;
    font-size: .8rem;
    font-weight: 650;
  }
  .portal-more > div a:hover,
  .portal-language > div a:hover { background: var(--color-surface-alt); color: var(--color-primary); }
  .portal-header-actions { display: flex; align-items: center; gap: .1rem; margin-left: auto; }
  .portal-icon-action,
  .portal-language > summary {
    display: grid;
    place-items: center;
    min-width: 40px;
    min-height: 40px;
    border: 1px solid transparent;
    border-radius: 7px;
    color: var(--color-text);
  }
  .portal-icon-action:hover,
  .portal-language > summary:hover { background: var(--color-surface-alt); }
  .portal-language > summary {
    grid-template-columns: auto auto;
    gap: .22rem;
    border-color: var(--color-border);
    padding-inline: .45rem;
    font-size: .72rem;
    font-weight: 750;
  }
  .portal-language > div { min-width: 170px; }
  .portal-language > div a { display: grid; grid-template-columns: 18px 1fr; }

  .portal-theme-icons { position: relative; display: block; width: 22px; height: 22px; }
  :global(.portal-theme-icon) {
    position: absolute;
    inset: 0;
    transition: opacity 160ms ease, transform 180ms ease;
  }
  :global(.portal-theme-moon) { opacity: 1; transform: scale(1); }
  .portal-theme-sun { opacity: 0; transform: scale(.8); }
  [data-theme="dark"] :global(.portal-theme-moon) { opacity: 0; transform: scale(.8); }
  [data-theme="dark"] .portal-theme-sun { opacity: 1; transform: scale(1); }

  .portal-mobile-trigger { display: grid; }
  .portal-menu-icon { position: relative; display: block; width: 20px; height: 16px; }
  .portal-menu-icon > span {
    position: absolute;
    left: 0;
    width: 20px;
    height: 1.8px;
    border-radius: 999px;
    background: currentColor;
    transform-origin: center;
    transition: top 180ms ease, transform 180ms ease, opacity 120ms ease;
  }
  .portal-menu-icon > span:nth-child(1) { top: 1px; }
  .portal-menu-icon > span:nth-child(2) { top: 7px; }
  .portal-menu-icon > span:nth-child(3) { top: 13px; }
  .portal-mobile-trigger[aria-expanded="true"] .portal-menu-icon > span:nth-child(1) { top: 7px; transform: rotate(45deg); }
  .portal-mobile-trigger[aria-expanded="true"] .portal-menu-icon > span:nth-child(2) { opacity: 0; }
  .portal-mobile-trigger[aria-expanded="true"] .portal-menu-icon > span:nth-child(3) { top: 7px; transform: rotate(-45deg); }

  .portal-mobile-panel { display: none; background: var(--color-surface); }
  .portal-mobile-panel-inner { min-height: 0; overflow: hidden; }
  .portal-mobile-panel nav { padding-block: .25rem .5rem; }
  .portal-mobile-panel nav a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: .72rem;
    min-height: 48px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: .88rem;
    font-weight: 650;
    opacity: 0;
    transform: translateY(-5px);
    transition: color 140ms ease, background-color 140ms ease, opacity 140ms ease, transform 180ms ease;
  }
  .portal-mobile-panel nav a:hover,
  .portal-mobile-panel nav a:focus-visible,
  .portal-mobile-panel nav a[aria-current="page"] { color: var(--color-primary); background: var(--color-surface-alt); }
  .portal-mobile-panel.is-open nav a { opacity: 1; transform: translateY(0); }
  .portal-mobile-settings { padding-block: 0 1rem; }
  .portal-menu-theme-toggle {
    display: none;
    width: 100%;
    min-height: 46px;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: .7rem;
    padding: .55rem .7rem;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: .86rem;
    font-weight: 650;
    text-align: left;
  }

  @media (min-width: 1280px) {
    .portal-desktop-nav { display: flex; }
    .portal-mobile-trigger,
    .portal-mobile-panel { display: none; }
    .portal-header-actions { margin-left: 0; }
  }
  @media (max-width: 1279px) {
    .portal-saved-action { display: none; }
    .portal-mobile-panel {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      visibility: hidden;
      transition: grid-template-rows 200ms ease, opacity 140ms ease, visibility 0s linear 200ms;
    }
    .portal-mobile-panel.is-open {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      transition: grid-template-rows 220ms ease, opacity 160ms ease, visibility 0s linear 0s;
    }
  }
  @media (max-width: 680px) {
    .portal-navbar-inner { min-height: 62px; }
    .portal-brand { flex-basis: 118px; }
    :global(.portal-brand-logo) { width: 118px; max-height: 44px; }
    .portal-header-actions > .portal-theme-toggle { display: none; }
    .portal-menu-theme-toggle { display: grid; }
    .portal-mobile-panel nav a { min-height: 48px; font-size: .86rem; }
  }
  @media (max-width: 390px) {
    .portal-language > summary span { display: none; }
    .portal-language > summary { grid-template-columns: auto; padding-inline: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.portal-theme-icon),
    .portal-menu-icon > span,
    .portal-mobile-panel,
    .portal-mobile-panel nav a { transition-duration: 0.01ms !important; transition-delay: 0ms !important; }
  }
</style>