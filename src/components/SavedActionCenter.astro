    sort: 'সাজান',
    savedFirst: 'সাম্প্রতিক সেভ/দেখা',
    nearest: 'নিকটতম ডেডলাইন',
    titleSort: 'শিরোনাম অনুযায়ী',
    count: '{count}টি তথ্য',
    remove: 'সরান',
    clear: 'এই তালিকা মুছুন',
