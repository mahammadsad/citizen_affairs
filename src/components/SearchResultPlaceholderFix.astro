<script>
  const setupSearchResultPlaceholders = () => {
    const output = document.getElementById('searchPageResults');
    if (!output || output.dataset.placeholderFixReady === 'true') return;

    output.dataset.placeholderFixReady = 'true';

    const cleanPlaceholders = () => {
      output.querySelectorAll<HTMLElement>('.result-media-placeholder:not([data-placeholder-clean])').forEach((placeholder) => {
        placeholder.replaceChildren();
        placeholder.setAttribute('aria-hidden', 'true');
        placeholder.dataset.placeholderClean = 'true';
      });
    };

    const observer = new MutationObserver(cleanPlaceholders);
    observer.observe(output, { childList: true, subtree: true });
    cleanPlaceholders();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchResultPlaceholders, { once: true });
  } else {
    setupSearchResultPlaceholders();
  }
</script>

