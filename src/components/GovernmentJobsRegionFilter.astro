---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n';
import { REGIONS, normalizeRegionLabel } from '../lib/regions';

type Article = CollectionEntry<'articles'>;

interface Props {
  locale: Locale;
  articles: Article[];
}

const { locale, articles } = Astro.props;
const jobs = articles.filter((article) => article.data.contentType === 'job' && article.data.job);

const regionAliases = REGIONS.map((region) => ({
  id: region.id,
  aliases: [region.id, region.en, region.bn, region.hi]
    .map((value) => normalizeRegionLabel(value))
    .filter(Boolean),
}));

const cardRegions = jobs.map((article) => {
  const found = new Set<string>();
  if (article.data.state) found.add(article.data.state);

  for (const location of article.data.job!.jobLocation) {
    const normalizedLocation = normalizeRegionLabel(location);
    if (!normalizedLocation) continue;

    for (const region of regionAliases) {
      if (
        region.aliases.some(
          (alias) =>
            normalizedLocation === alias ||
            normalizedLocation.includes(alias) ||
            alias.includes(normalizedLocation)
        )
      ) {
        found.add(region.id);
      }
    }
  }

  return [...found];
});

const labels = {
  en: {
    field: 'State / Union Territory',
    all: 'All states and UTs',
    states: 'States',
    uts: 'Union Territories',
    apply: 'Show results',
    applyPattern: 'Show {count} updates',
    appliedPattern: '{count} updates shown',
  },
  bn: {
    field: 'রাজ্য / কেন্দ্রশাসিত অঞ্চল',
    all: 'সব রাজ্য ও কেন্দ্রশাসিত অঞ্চল',
    states: 'রাজ্য',
    uts: 'কেন্দ্রশাসিত অঞ্চল',
    apply: 'ফলাফল দেখুন',
    applyPattern: '{count}টি আপডেট দেখুন',
    appliedPattern: '{count}টি আপডেট দেখানো হচ্ছে',
  },
  hi: {
    field: 'राज्य / केंद्र शासित प्रदेश',
    all: 'सभी राज्य और केंद्र शासित प्रदेश',
    states: 'राज्य',
    uts: 'केंद्र शासित प्रदेश',
    apply: 'परिणाम दिखाएँ',
    applyPattern: '{count} अपडेट दिखाएँ',
    appliedPattern: '{count} अपडेट दिखाए जा रहे हैं',
  },
}[locale];

const states = REGIONS.slice(0, 28).map((region) => ({
  id: region.id,
  label: region[locale],
}));
const unionTerritories = REGIONS.slice(28).map((region) => ({
  id: region.id,
  label: region[locale],
}));
---

<script is:inline define:vars={{ cardRegions, states, unionTerritories, labels }}>
  (() => {
    const initRegionFilter = () => {
      const portal = document.querySelector('[data-jobs-portal]');
      if (!portal || portal.dataset.regionFilterReady === 'true') return;
      portal.dataset.regionFilterReady = 'true';

      const filterPanel = portal.querySelector('.jobs-filter-panel');
      const filterDetails = portal.querySelector('[data-job-filter-details]');
      const levelSelect = portal.querySelector('[data-job-filter="level"]');
      const levelField = levelSelect?.closest('label');
      if (!filterPanel || !levelSelect || !levelField) return;

      const field = document.createElement('label');
      field.className = 'jobs-region-field';
      field.dataset.jobRegionField = '';
      field.hidden = true;

      const fieldLabel = document.createElement('span');
      fieldLabel.textContent = labels.field;

      const select = document.createElement('select');
      select.className = 'jobs-region-select';
      select.dataset.jobRegionFilter = '';
      select.disabled = true;
      select.setAttribute('aria-label', labels.field);

      const allOption = document.createElement('option');
      allOption.value = 'all';
      allOption.textContent = labels.all;
      select.append(allOption);

      const appendGroup = (label, options) => {
        const group = document.createElement('optgroup');
        group.label = label;
        options.forEach(({ id, label: optionLabel }) => {
          const option = document.createElement('option');
          option.value = id;
          option.textContent = optionLabel;
          group.append(option);
        });
        select.append(group);
      };

      appendGroup(labels.states, states);
      appendGroup(labels.uts, unionTerritories);
      field.append(fieldLabel, select);
      levelField.insertAdjacentElement('afterend', field);

      const resetButton = filterPanel.querySelector('[data-job-reset]');
      const fields = document.createElement('div');
      fields.className = 'jobs-filter-fields';
      fields.dataset.jobFilterFields = '';

      [...filterPanel.children].forEach((child) => {
        if (child !== resetButton) fields.append(child);
      });

      const actions = document.createElement('div');
      actions.className = 'jobs-filter-actions';
      actions.dataset.jobFilterActions = '';

      const applyButton = document.createElement('button');
      applyButton.type = 'button';
      applyButton.className = 'jobs-filter-apply';
      applyButton.dataset.jobApply = '';
      applyButton.textContent = labels.apply;

      const appliedStatus = document.createElement('span');
      appliedStatus.className = 'sr-only';
      appliedStatus.dataset.jobFilterAppliedStatus = '';
      appliedStatus.setAttribute('role', 'status');
      appliedStatus.setAttribute('aria-live', 'polite');
      appliedStatus.setAttribute('aria-atomic', 'true');

      if (resetButton) {
        resetButton.classList.add('jobs-filter-clear');
        actions.append(resetButton);
      }
      actions.append(applyButton, appliedStatus);

      filterPanel.classList.add('jobs-filter-panel-enhanced');
      filterPanel.append(fields, actions);

      const cards = [...portal.querySelectorAll('[data-job-card]')];
      cards.forEach((card, index) => {
        card.dataset.region = (cardRegions[index] || []).join('|');
      });

      const resultCount = portal.querySelector('[data-job-result-count]');
      const noMatch = portal.querySelector('[data-job-no-match]');
      const activeFilterCount = portal.querySelector('[data-active-filter-count]');
      const baseFilters = [...portal.querySelectorAll('[data-job-filter]')];
      const search = portal.querySelector('[data-job-search]');
      const resetButtons = [...portal.querySelectorAll('[data-job-reset]')];
      const stageButtons = [...portal.querySelectorAll('[data-job-stage]')];

      if (resultCount && !resultCount.id) resultCount.id = 'jobs-filter-result-count';
      if (resultCount) applyButton.setAttribute('aria-controls', resultCount.id);

      const visibleCount = () => cards.filter((card) => !card.hidden).length;

      const syncApplyButton = () => {
        const count = visibleCount();
        const text = labels.applyPattern.replace('{count}', String(count));
        applyButton.textContent = text;
        applyButton.setAttribute('aria-label', text);
      };

      const syncField = () => {
        const stateSelected = levelSelect.value === 'state';
        field.hidden = !stateSelected;
        select.disabled = !stateSelected;
        if (!stateSelected) select.value = 'all';
      };

      const updateSummary = () => {
        const count = visibleCount();
        const pattern = portal.dataset.resultPattern || '{count}';
        if (resultCount) resultCount.textContent = pattern.replace('{count}', String(count));
        if (noMatch) noMatch.hidden = count !== 0;

        const baseCount =
          baseFilters.filter((filter) => filter.value !== 'all').length +
          (search?.value.trim() ? 1 : 0);
        const regionCount = levelSelect.value === 'state' && select.value !== 'all' ? 1 : 0;
        const activeCount = baseCount + regionCount;
        if (activeFilterCount) {
          activeFilterCount.textContent = String(activeCount);
          activeFilterCount.hidden = activeCount === 0;
        }

        syncApplyButton();
      };

      const applyRegionFilter = () => {
        syncField();
        const selected = levelSelect.value === 'state' ? select.value : 'all';

        if (selected !== 'all') {
          cards.forEach((card) => {
            if (card.hidden) return;
            const regions = (card.dataset.region || '').split('|').filter(Boolean);
            if (!regions.includes(selected)) card.hidden = true;
          });
        }

        updateSummary();
      };

      const scheduleApply = () => queueMicrotask(applyRegionFilter);

      select.addEventListener('change', () => {
        levelSelect.dispatchEvent(new Event('change', { bubbles: true }));
      });
      baseFilters.forEach((filter) => filter.addEventListener('change', scheduleApply));
      search?.addEventListener('input', scheduleApply);
      stageButtons.forEach((button) => button.addEventListener('click', scheduleApply));
      resetButtons.forEach((button) => {
        button.addEventListener('click', () => {
          select.value = 'all';
          scheduleApply();
        });
      });

      const resultObserver =
        resultCount && typeof MutationObserver !== 'undefined'
          ? new MutationObserver(syncApplyButton)
          : null;
      resultObserver?.observe(resultCount, {
        childList: true,
        characterData: true,
        subtree: true,
      });

      applyButton.addEventListener('click', () => {
        applyRegionFilter();
        const count = visibleCount();
        appliedStatus.textContent = labels.appliedPattern.replace('{count}', String(count));

        if (filterDetails instanceof HTMLDetailsElement) filterDetails.open = false;

        requestAnimationFrame(() => {
          if (!(resultCount instanceof HTMLElement)) return;
          resultCount.tabIndex = -1;
          resultCount.focus({ preventScroll: true });
          resultCount.scrollIntoView({
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
            block: 'center',
          });
        });
      });

      syncField();
      applyRegionFilter();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRegionFilter, { once: true });
    } else {
      initRegionFilter();
    }
  })();
</script>

<style is:global>
  .jobs-filter-panel.jobs-filter-panel-enhanced {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .jobs-filter-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(170px, 1fr));
    gap: 0.65rem;
    min-height: 0;
  }

  .jobs-filter-panel .jobs-region-field {
    display: grid;
    gap: 0.25rem;
  }

  .jobs-filter-panel .jobs-region-field[hidden] {
    display: none !important;
  }

  .jobs-filter-panel .jobs-region-field > span {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .jobs-filter-panel .jobs-region-select {
    width: 100%;
    min-height: 40px;
    padding: 0 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.82rem;
  }

  .jobs-filter-panel .jobs-region-select:hover {
    border-color: rgba(var(--color-primary-rgb), 0.4);
  }

  .jobs-filter-panel .jobs-region-select:focus-visible {
    outline: 0;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.14);
  }

  .jobs-filter-actions {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: 0.55rem;
    flex: 0 0 auto;
  }

  .jobs-filter-panel .jobs-filter-actions button {
    min-height: 42px;
    border-radius: 10px;
  }

  .jobs-filter-panel .jobs-filter-clear {
    border-color: rgba(var(--color-primary-rgb), 0.28) !important;
    background: transparent !important;
    color: var(--color-primary) !important;
  }

  .jobs-filter-panel .jobs-filter-apply {
    border-color: var(--color-primary) !important;
    background: var(--color-primary) !important;
    color: #fff !important;
    box-shadow: 0 8px 20px rgba(var(--color-primary-rgb), 0.22);
  }

  .jobs-filter-panel .jobs-filter-apply:hover,
  .jobs-filter-panel .jobs-filter-apply:focus-visible {
    border-color: var(--color-primary) !important;
    background: var(--color-primary) !important;
    color: #fff !important;
  }

  @media (max-width: 700px) {
    .jobs-filter-panel {
      z-index: 120 !important;
      bottom: calc(60px + env(safe-area-inset-bottom) + 0.75rem) !important;
      max-height: calc(100vh - 60px - env(safe-area-inset-bottom) - 1.5rem) !important;
      max-height: calc(100dvh - 60px - env(safe-area-inset-bottom) - 1.5rem) !important;
      padding: 1.15rem 1rem 1rem !important;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      border: 1px solid rgba(var(--color-primary-rgb), 0.22) !important;
      border-radius: var(--radius-lg) var(--radius-lg) var(--radius-md) var(--radius-md) !important;
      background:
        linear-gradient(180deg, rgba(var(--color-primary-rgb), 0.055), transparent 4.75rem),
        var(--color-surface) !important;
      box-shadow:
        0 -18px 48px rgba(8, 49, 92, 0.18),
        var(--shadow-lg) !important;
    }

    .jobs-filter-panel.jobs-filter-panel-enhanced {
      overflow: hidden !important;
    }

    .jobs-filter-panel::before {
      position: absolute;
      top: 0.38rem;
      left: 50%;
      width: 3.4rem;
      height: 0.24rem;
      border-radius: var(--radius-pill);
      background: linear-gradient(90deg, var(--color-primary), var(--color-green), var(--color-orange));
      content: '';
      transform: translateX(-50%);
    }

    .jobs-filter-fields {
      grid-template-columns: 1fr 1fr;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      padding: 0.05rem 0.15rem 0.15rem 0.05rem;
    }

    .jobs-filter-panel label,
    .jobs-filter-panel .jobs-region-field {
      gap: 0.38rem !important;
    }

    .jobs-filter-panel label > span,
    .jobs-filter-panel .jobs-region-field > span {
      color: var(--color-text) !important;
      font-size: 0.76rem !important;
      font-weight: 750 !important;
      letter-spacing: 0.005em;
    }

    .jobs-filter-panel select,
    .jobs-filter-panel .jobs-region-select,
    .jobs-filter-panel button {
      min-height: 48px !important;
      border: 1px solid var(--color-border) !important;
      border-radius: 12px !important;
      background: var(--color-bg) !important;
      color: var(--color-text) !important;
      font: inherit !important;
      font-size: 0.9rem !important;
      transition:
        border-color var(--transition-fast),
        box-shadow var(--transition-fast),
        background var(--transition-fast),
        color var(--transition-fast);
    }

    .jobs-filter-panel select,
    .jobs-filter-panel .jobs-region-select {
      padding-inline: 0.85rem !important;
    }

    .jobs-filter-panel select:hover,
    .jobs-filter-panel .jobs-region-select:hover {
      border-color: rgba(var(--color-primary-rgb), 0.42) !important;
    }

    .jobs-filter-panel select:focus-visible,
    .jobs-filter-panel .jobs-region-select:focus-visible {
      outline: 0 !important;
      border-color: var(--color-primary) !important;
      box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.14) !important;
    }

    .jobs-filter-actions {
      position: relative;
      z-index: 2;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(var(--color-primary-rgb), 0.16);
      background: var(--color-surface);
    }

    .jobs-filter-panel .jobs-filter-clear {
      border-color: rgba(var(--color-primary-rgb), 0.28) !important;
      background: transparent !important;
      color: var(--color-primary) !important;
      font-weight: 750 !important;
    }

    .jobs-filter-panel .jobs-filter-apply {
      border-color: var(--color-primary) !important;
      background: var(--color-primary) !important;
      color: #fff !important;
      font-weight: 800 !important;
      box-shadow: 0 8px 20px rgba(var(--color-primary-rgb), 0.24);
    }

    .jobs-filter-panel .jobs-filter-clear:hover,
    .jobs-filter-panel .jobs-filter-clear:focus-visible {
      border-color: var(--color-primary) !important;
      background: rgba(var(--color-primary-rgb), 0.08) !important;
      color: var(--color-primary) !important;
    }

    .jobs-filter-panel .jobs-filter-apply:hover,
    .jobs-filter-panel .jobs-filter-apply:focus-visible {
      border-color: var(--color-primary) !important;
      background: var(--color-primary) !important;
      color: #fff !important;
    }
  }

  @media (max-width: 430px) {
    .jobs-filter-panel {
      right: 0.65rem !important;
      bottom: calc(60px + env(safe-area-inset-bottom) + 0.65rem) !important;
      left: 0.65rem !important;
      max-height: calc(100vh - 60px - env(safe-area-inset-bottom) - 1.3rem) !important;
      max-height: calc(100dvh - 60px - env(safe-area-inset-bottom) - 1.3rem) !important;
    }

    .jobs-filter-fields {
      grid-template-columns: 1fr;
    }
  }
</style>
