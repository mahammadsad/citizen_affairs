---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n';
import { REGIONS, normalizeRegionLabel } from '../lib/regions';

type Article = CollectionEntry<'articles'>;

interface Props {
  locale: Locale;
  articles: Article[];
}

const { locale, articles } = Astro.props;
const jobs = articles.filter((article) => article.data.contentType === 'job' && article.data.job);

const regionAliases = REGIONS.map((region) => ({
  id: region.id,
  aliases: [region.id, region.en, region.bn, region.hi]
    .map((value) => normalizeRegionLabel(value))
    .filter(Boolean),
}));

const cardRegions = jobs.map((article) => {
  const found = new Set<string>();
  if (article.data.state) found.add(article.data.state);

  for (const location of article.data.job!.jobLocation) {
    const normalizedLocation = normalizeRegionLabel(location);
    if (!normalizedLocation) continue;

    for (const region of regionAliases) {
      if (
        region.aliases.some(
          (alias) =>
            normalizedLocation === alias ||
            normalizedLocation.includes(alias) ||
            alias.includes(normalizedLocation)
        )
      ) {
        found.add(region.id);
      }
    }
  }

  return [...found];
});

const labels = {
  en: {
    field: 'State / Union Territory',
    all: 'All states and UTs',
    states: 'States',
    uts: 'Union Territories',
  },
  bn: {
    field: 'রাজ্য / কেন্দ্রশাসিত অঞ্চল',
    all: 'সব রাজ্য ও কেন্দ্রশাসিত অঞ্চল',
    states: 'রাজ্য',
    uts: 'কেন্দ্রশাসিত অঞ্চল',
  },
  hi: {
    field: 'राज्य / केंद्र शासित प्रदेश',
    all: 'सभी राज्य और केंद्र शासित प्रदेश',
    states: 'राज्य',
    uts: 'केंद्र शासित प्रदेश',
  },
}[locale];

const states = REGIONS.slice(0, 28).map((region) => ({
  id: region.id,
  label: region[locale],
}));
const unionTerritories = REGIONS.slice(28).map((region) => ({
  id: region.id,
  label: region[locale],
}));
---

<script is:inline define:vars={{ cardRegions, states, unionTerritories, labels }}>
  (() => {
    const initRegionFilter = () => {
      const portal = document.querySelector('[data-jobs-portal]');
      if (!portal || portal.dataset.regionFilterReady === 'true') return;
      portal.dataset.regionFilterReady = 'true';

      const filterPanel = portal.querySelector('.jobs-filter-panel');
      const levelSelect = portal.querySelector('[data-job-filter="level"]');
      const levelField = levelSelect?.closest('label');
      if (!filterPanel || !levelSelect || !levelField) return;

      const field = document.createElement('label');
      field.className = 'jobs-region-field';
      field.dataset.jobRegionField = '';
      field.hidden = true;

      const fieldLabel = document.createElement('span');
      fieldLabel.textContent = labels.field;

      const select = document.createElement('select');
      select.className = 'jobs-region-select';
      select.dataset.jobRegionFilter = '';
      select.disabled = true;
      select.setAttribute('aria-label', labels.field);

      const allOption = document.createElement('option');
      allOption.value = 'all';
      allOption.textContent = labels.all;
      select.append(allOption);

      const appendGroup = (label, options) => {
        const group = document.createElement('optgroup');
        group.label = label;
        options.forEach(({ id, label: optionLabel }) => {
          const option = document.createElement('option');
          option.value = id;
          option.textContent = optionLabel;
          group.append(option);
        });
        select.append(group);
      };

      appendGroup(labels.states, states);
      appendGroup(labels.uts, unionTerritories);
      field.append(fieldLabel, select);
      levelField.insertAdjacentElement('afterend', field);

      const cards = [...portal.querySelectorAll('[data-job-card]')];
      cards.forEach((card, index) => {
        card.dataset.region = (cardRegions[index] || []).join('|');
      });

      const resultCount = portal.querySelector('[data-job-result-count]');
      const noMatch = portal.querySelector('[data-job-no-match]');
      const activeFilterCount = portal.querySelector('[data-active-filter-count]');
      const baseFilters = [...portal.querySelectorAll('[data-job-filter]')];
      const search = portal.querySelector('[data-job-search]');
      const resetButtons = [...portal.querySelectorAll('[data-job-reset]')];
      const stageButtons = [...portal.querySelectorAll('[data-job-stage]')];

      const syncField = () => {
        const stateSelected = levelSelect.value === 'state';
        field.hidden = !stateSelected;
        select.disabled = !stateSelected;
        if (!stateSelected) select.value = 'all';
      };

      const updateSummary = () => {
        const visibleCount = cards.filter((card) => !card.hidden).length;
        const pattern = portal.dataset.resultPattern || '{count}';
        if (resultCount) resultCount.textContent = pattern.replace('{count}', String(visibleCount));
        if (noMatch) noMatch.hidden = visibleCount !== 0;

        const baseCount =
          baseFilters.filter((filter) => filter.value !== 'all').length +
          (search?.value.trim() ? 1 : 0);
        const regionCount = levelSelect.value === 'state' && select.value !== 'all' ? 1 : 0;
        const count = baseCount + regionCount;
        if (activeFilterCount) {
          activeFilterCount.textContent = String(count);
          activeFilterCount.hidden = count === 0;
        }
      };

      const applyRegionFilter = () => {
        syncField();
        const selected = levelSelect.value === 'state' ? select.value : 'all';

        if (selected !== 'all') {
          cards.forEach((card) => {
            if (card.hidden) return;
            const regions = (card.dataset.region || '').split('|').filter(Boolean);
            if (!regions.includes(selected)) card.hidden = true;
          });
        }

        updateSummary();
      };

      const scheduleApply = () => queueMicrotask(applyRegionFilter);

      select.addEventListener('change', () => {
        levelSelect.dispatchEvent(new Event('change', { bubbles: true }));
      });
      baseFilters.forEach((filter) => filter.addEventListener('change', scheduleApply));
      search?.addEventListener('input', scheduleApply);
      stageButtons.forEach((button) => button.addEventListener('click', scheduleApply));
      resetButtons.forEach((button) => {
        button.addEventListener('click', () => {
          select.value = 'all';
          scheduleApply();
        });
      });

      syncField();
      applyRegionFilter();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRegionFilter, { once: true });
    } else {
      initRegionFilter();
    }
  })();
</script>

<style is:global>
  .jobs-filter-panel .jobs-region-field {
    display: grid;
    gap: 0.25rem;
  }

  .jobs-filter-panel .jobs-region-field[hidden] {
    display: none !important;
  }

  .jobs-filter-panel .jobs-region-field > span {
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .jobs-filter-panel .jobs-region-select {
    width: 100%;
    min-height: 40px;
    padding: 0 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.82rem;
  }

  .jobs-filter-panel .jobs-region-select:hover {
    border-color: rgba(var(--color-primary-rgb), 0.4);
  }

  .jobs-filter-panel .jobs-region-select:focus-visible {
    outline: 0;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.14);
  }

  @media (max-width: 700px) {
    .jobs-filter-panel {
      z-index: 120 !important;
      bottom: calc(60px + env(safe-area-inset-bottom) + 0.75rem) !important;
      max-height: calc(100vh - 60px - env(safe-area-inset-bottom) - 1.5rem) !important;
      max-height: calc(100dvh - 60px - env(safe-area-inset-bottom) - 1.5rem) !important;
      padding: 1.15rem 1rem 1rem !important;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      border: 1px solid rgba(var(--color-primary-rgb), 0.22) !important;
      border-radius: var(--radius-lg) var(--radius-lg) var(--radius-md) var(--radius-md) !important;
      background:
        linear-gradient(180deg, rgba(var(--color-primary-rgb), 0.055), transparent 4.75rem),
        var(--color-surface) !important;
      box-shadow:
        0 -18px 48px rgba(8, 49, 92, 0.18),
        var(--shadow-lg) !important;
    }

    .jobs-filter-panel::before {
      position: absolute;
      top: 0.38rem;
      left: 50%;
      width: 3.4rem;
      height: 0.24rem;
      border-radius: var(--radius-pill);
      background: linear-gradient(90deg, var(--color-primary), var(--color-green), var(--color-orange));
      content: '';
      transform: translateX(-50%);
    }

    .jobs-filter-panel label,
    .jobs-filter-panel .jobs-region-field {
      gap: 0.38rem !important;
    }

    .jobs-filter-panel label > span,
    .jobs-filter-panel .jobs-region-field > span {
      color: var(--color-text) !important;
      font-size: 0.76rem !important;
      font-weight: 750 !important;
      letter-spacing: 0.005em;
    }

    .jobs-filter-panel select,
    .jobs-filter-panel .jobs-region-select,
    .jobs-filter-panel button {
      min-height: 48px !important;
      border: 1px solid var(--color-border) !important;
      border-radius: 12px !important;
      background: var(--color-bg) !important;
      color: var(--color-text) !important;
      font: inherit !important;
      font-size: 0.9rem !important;
      transition:
        border-color var(--transition-fast),
        box-shadow var(--transition-fast),
        background var(--transition-fast),
        color var(--transition-fast);
    }

    .jobs-filter-panel select,
    .jobs-filter-panel .jobs-region-select {
      padding-inline: 0.85rem !important;
    }

    .jobs-filter-panel select:hover,
    .jobs-filter-panel .jobs-region-select:hover {
      border-color: rgba(var(--color-primary-rgb), 0.42) !important;
    }

    .jobs-filter-panel select:focus-visible,
    .jobs-filter-panel .jobs-region-select:focus-visible {
      outline: 0 !important;
      border-color: var(--color-primary) !important;
      box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.14) !important;
    }

    .jobs-filter-panel button {
      border-color: rgba(var(--color-primary-rgb), 0.26) !important;
      background: rgba(var(--color-primary-rgb), 0.065) !important;
      color: var(--color-primary) !important;
      font-weight: 750 !important;
    }

    .jobs-filter-panel button:hover,
    .jobs-filter-panel button:focus-visible {
      border-color: var(--color-primary) !important;
      background: var(--color-primary) !important;
      color: #fff !important;
    }
  }

  @media (max-width: 430px) {
    .jobs-filter-panel {
      right: 0.65rem !important;
      bottom: calc(60px + env(safe-area-inset-bottom) + 0.65rem) !important;
      left: 0.65rem !important;
      max-height: calc(100vh - 60px - env(safe-area-inset-bottom) - 1.3rem) !important;
      max-height: calc(100dvh - 60px - env(safe-area-inset-bottom) - 1.3rem) !important;
    }
  }
</style>
