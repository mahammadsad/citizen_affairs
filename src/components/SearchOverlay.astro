---
import { SITE } from '@utils/constants';
import type { Locale } from '../i18n';
import { ui } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const indexUrl = `${SITE.basePath}${locale}/search-index.json`;
---

<div class="search-overlay" id="searchOverlay" data-index-url={indexUrl} data-search-hint={t.searchHint} data-no-results={t.noResults}>
  <div class="search-box" role="dialog" aria-modal="true" aria-label={t.search}>
    <form id="searchForm">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      <input type="search" id="searchInput" placeholder={t.searchPlaceholder} autocomplete="off" aria-label={t.search} />
      <button type="button" class="icon-btn" id="searchClose" aria-label={locale === 'bn' ? 'সার্চ বন্ধ করুন' : 'Close search'}>×</button>
    </form>
    <div class="search-results" id="searchResults"><p class="search-hint">{t.searchHint}</p></div>
  </div>
</div>

<script>
  const toggle = document.getElementById('searchToggle');
  const overlay = document.getElementById('searchOverlay');
  const close = document.getElementById('searchClose');
  const input = document.getElementById('searchInput') as HTMLInputElement | null;
  const results = document.getElementById('searchResults');
  const indexUrl = overlay?.dataset.indexUrl || '';
  const searchHint = overlay?.dataset.searchHint || '';
  const noResults = overlay?.dataset.noResults || '';
  type SearchItem = { label: string; sub?: string; href: string; keywords?: string[] };
  let indexPromise: Promise<SearchItem[]> | undefined;

  const hint = (text: string) => { if (results) results.innerHTML = `<p class="search-hint"></p>`; const node = results?.querySelector('p'); if (node) node.textContent = text; };
  const load = (): Promise<SearchItem[]> => indexPromise ||= fetch(indexUrl).then(r => r.ok ? r.json() : []).catch(() => []);
  const closeSearch = () => { overlay?.classList.remove('is-open'); toggle?.focus(); };

  toggle?.addEventListener('click', () => { overlay?.classList.add('is-open'); load(); setTimeout(() => input?.focus(), 40); });
  close?.addEventListener('click', closeSearch);
  overlay?.addEventListener('click', (event) => { if (event.target === overlay) closeSearch(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeSearch(); });
  document.getElementById('searchForm')?.addEventListener('submit', (event) => event.preventDefault());
  input?.addEventListener('input', async () => {
    const query = input.value.trim().toLowerCase();
    if (!query) return hint(searchHint);
    const items = await load();
    const matches = items.filter(item => [item.label, item.sub, ...(item.keywords || [])].join(' ').toLowerCase().includes(query)).slice(0, 8);
    if (!results) return;
    results.innerHTML = '';
    if (!matches.length) return hint(noResults);
    matches.forEach(item => {
      const link = document.createElement('a');
      link.href = item.href;
      link.textContent = item.sub ? `${item.label} — ${item.sub}` : item.label;
      results.appendChild(link);
    });
  });
</script>
