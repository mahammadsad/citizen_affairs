<script>
  const setupSearchResultCards = () => {
    const root = document.querySelector<HTMLElement>('[data-search-page]');
    const output = document.getElementById('searchPageResults');
    if (!root || !output || output.dataset.cardEnhancerReady === 'true') return;

    output.dataset.cardEnhancerReady = 'true';

    const language = document.documentElement.lang.toLowerCase();
    const readLabel = language.startsWith('bn')
      ? 'পড়ুন'
      : language.startsWith('hi')
        ? 'पढ़ें'
        : 'Read';

    const cleanText = (value = '') => value
      .replace(/<[^>]*>/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

    const enhanceRows = () => {
      output.querySelectorAll<HTMLElement>('.search-result-row:not([data-card-enhanced])').forEach((row) => {
        const link = row.querySelector<HTMLAnchorElement>('.search-result-link');
        const body = row.querySelector<HTMLElement>('.result-body');
        const media = row.querySelector<HTMLElement>('.result-media');
        if (!link || !body) return;

        const title = body.querySelector<HTMLElement>('h3');
        const meta = body.querySelector<HTMLElement>('.result-meta');
        const summary = body.querySelector<HTMLElement>('.result-summary');
        const facts = body.querySelector<HTMLElement>('.result-facts');
        const read = body.querySelector<HTMLElement>('.result-read');
        const image = media?.querySelector<HTMLImageElement>('img');

        if (media && link.firstElementChild !== media) link.prepend(media);

        if (meta) {
          const primaryLabel = cleanText(meta.textContent || '').split('·')[0]?.trim();
          meta.textContent = primaryLabel || '';
          meta.hidden = !primaryLabel;
        }

        if (summary) {
          const cleanedSummary = cleanText(summary.textContent || '');
          summary.textContent = cleanedSummary;
          summary.hidden = !cleanedSummary;
        }

        if (facts) {
          const deadlineLabel = cleanText(root.dataset.deadlineLabel || '');
          const factParts = cleanText(facts.textContent || '')
            .split(' · ')
            .map((part) => part.trim())
            .filter(Boolean);
          const compactFacts = factParts.filter((part, index) =>
            index === 0 || Boolean(deadlineLabel && part.startsWith(`${deadlineLabel}:`))
          );
          facts.textContent = compactFacts.join(' · ');
          facts.hidden = compactFacts.length === 0;
        }

        if (read) read.textContent = `${readLabel} →`;

        if (image) {
          image.width = 480;
          image.height = 360;
          image.loading = 'lazy';
          image.decoding = 'async';
        }

        if (title?.textContent) link.setAttribute('aria-label', cleanText(title.textContent));
        row.dataset.cardEnhanced = 'true';
      });
    };

    const observer = new MutationObserver(enhanceRows);
    observer.observe(output, { childList: true, subtree: true });
    enhanceRows();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchResultCards, { once: true });
  } else {
    setupSearchResultCards();
  }
</script>

