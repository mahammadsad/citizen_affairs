---
import MainLayout from '@layouts/MainLayout.astro';
import Icon from './Icon.astro';
import { getBrandName, SITE } from '@utils/constants';
import { locales, localizedPath, type Locale } from '../i18n';
import { CAREERS_COPY } from '../i18n/careers';
import { getOpenCareerRequisitions } from '../../scripts/lib/career-requisitions.mjs';

interface Props { locale: Locale; }
const { locale } = Astro.props as Props;
const brandName = getBrandName(locale);
const route = (lang: Locale, value = '') => {
  const path = localizedPath(lang, value);
  return lang === 'en' ? path.replace('/en/', '/') : path;
};
const canonical = `${SITE.url}${route(locale, 'careers')}`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, `${SITE.url}${route(lang, 'careers')}`])
) as Record<Locale, string>;
const contactUrl = route(locale, 'contact');
const copy = CAREERS_COPY[locale];
const openRequisitions = getOpenCareerRequisitions();

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.eyebrow,
  description: copy.intro,
  url: canonical,
  inLanguage: locale,
  isPartOf: { '@type': 'WebSite', name: brandName, url: SITE.url },
  about: { '@type': 'Organization', name: brandName, url: SITE.url }
};
---

<MainLayout title={copy.eyebrow} description={copy.intro} {locale} {canonical} {alternateUrls} structuredData={pageSchema}>
  <article class="career-page">
    <header class="career-hero">
      <div class="container career-hero-grid">
        <div>
          <span class="career-eyebrow"><Icon name="briefcase" size={18} />{copy.eyebrow}</span>
          <h1>{copy.title}</h1>
          <p>{copy.intro}</p>
          <a class="btn btn-secondary" href="#vacancy-status">{copy.primaryAction}<Icon name="arrow" size={18} /></a>
        </div>
        <aside class="career-hero-card" aria-label={copy.principles}>
          <span>{brandName}</span>
          <strong>{copy.principles}</strong>
          <div class="career-signal-grid">
            {copy.signals.map(([icon, label]) => <div><Icon name={icon} /><span>{label}</span></div>)}
          </div>
        </aside>
      </div>
    </header>

    <section class="career-section container" id="vacancy-status" aria-labelledby="vacancy-title">
      <div class="vacancy-status" data-public-vacancy-count={openRequisitions.length}>
        <span class="status-icon"><Icon name="briefcase" size={28} /></span>
        <div>
          <span class="status-label">{copy.statusLabel}</span>
          <h2 id="vacancy-title">{copy.statusTitle}</h2>
          <p>{copy.statusBody}</p>
          <strong>{copy.noResume}</strong>
        </div>
      </div>
    </section>

    <section class="career-standards">
      <div class="container career-section">
        <div class="section-heading">
          <span>{brandName}</span>
          <h2>{copy.futureTitle}</h2>
          <p>{copy.futureIntro}</p>
        </div>
        <div class="standard-grid">
          {copy.requirements.map(([title, body], index) => (
            <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="career-section container" aria-labelledby="process-title">
      <div class="section-heading compact">
        <span>{copy.processLabel}</span>
        <h2 id="process-title">{copy.processTitle}</h2>
      </div>
      <ol class="process-grid">
        {copy.process.map(([number, title, body]) => <li><span>{number}</span><div><h3>{title}</h3><p>{body}</p></div></li>)}
      </ol>
      <aside class="contact-note">
        <Icon name="mail" />
        <div><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p><a href={contactUrl}>{copy.contactAction}<Icon name="arrow" size={17} /></a></div>
      </aside>
    </section>
  </article>
</MainLayout>

<style>
  .career-page{overflow:hidden;background:var(--color-background)}.career-hero{padding:clamp(3.8rem,8vw,7rem) 0;background:radial-gradient(circle at 88% 18%,rgba(24,182,160,.24),transparent 28%),linear-gradient(135deg,#071e34,#0c365c 70%,#0a5aa6 130%);color:#fff}.career-hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);align-items:center;gap:clamp(2rem,7vw,6rem)}.career-eyebrow{display:inline-flex;align-items:center;gap:.5rem;color:#7ce4d7;font-size:.76rem;font-weight:850;letter-spacing:.06em;text-transform:uppercase}.career-hero h1{max-width:780px;margin:.9rem 0 1rem;color:#fff;font-size:clamp(2.6rem,6.2vw,5.2rem);line-height:1;letter-spacing:-.045em}.career-hero p{max-width:65ch;margin-bottom:1.4rem;color:#d6e7f4;font-size:clamp(1rem,2vw,1.18rem);line-height:1.8}.career-hero .btn{display:inline-flex;align-items:center;gap:.55rem}.career-hero-card{padding:1.5rem;border:1px solid rgba(255,255,255,.18);border-radius:24px;background:rgba(255,255,255,.08);box-shadow:0 30px 80px rgba(0,0,0,.24);backdrop-filter:blur(14px)}.career-hero-card>span{color:#7ce4d7;font-size:.72rem;font-weight:850;text-transform:uppercase}.career-hero-card>strong{display:block;margin:.5rem 0 1.2rem;color:#fff;font-size:1.4rem}.career-signal-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.career-signal-grid div{display:flex;align-items:center;gap:.55rem;min-height:60px;padding:.7rem;border-radius:13px;background:rgba(255,255,255,.07);color:#dbeaf5;font-size:.82rem;font-weight:750}.career-signal-grid svg{color:#7ce4d7}.career-section{padding-block:clamp(4rem,7vw,6rem)}.vacancy-status{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:start;gap:1.25rem;padding:clamp(1.4rem,4vw,2.4rem);border:1px solid rgba(11,143,120,.28);border-radius:24px;background:linear-gradient(135deg,rgba(11,143,120,.1),rgba(10,90,166,.05));box-shadow:var(--shadow-md)}.status-icon{display:grid;place-items:center;width:58px;height:58px;border-radius:17px;background:var(--color-primary);color:#fff}.status-label,.section-heading>span{color:var(--color-primary);font-size:.74rem;font-weight:900;letter-spacing:.07em;text-transform:uppercase}.vacancy-status h2{margin:.35rem 0 .65rem;font-size:clamp(1.8rem,4vw,3rem)}.vacancy-status p{max-width:72ch;color:var(--color-text-muted);line-height:1.75}.vacancy-status strong{display:block;margin-top:1rem;color:var(--color-text);font-size:.88rem}.career-standards{background:var(--color-surface-alt)}.section-heading{max-width:780px;margin-bottom:2rem}.section-heading h2{margin:.4rem 0 .7rem;font-size:clamp(2rem,4vw,3.35rem);line-height:1.08}.section-heading p{color:var(--color-text-muted);line-height:1.75}.standard-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.standard-grid article{padding:1.3rem;border:1px solid var(--color-border);border-radius:18px;background:var(--color-surface)}.standard-grid article>span{color:var(--color-primary);font-weight:900}.standard-grid h3{margin:.8rem 0 .45rem;font-size:1.05rem}.standard-grid p{color:var(--color-text-muted);font-size:.84rem;line-height:1.7}.process-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none}.process-grid li{display:grid;grid-template-columns:auto 1fr;gap:.8rem;padding:1.15rem;border:1px solid var(--color-border);border-radius:16px;background:var(--color-surface)}.process-grid li>span{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:rgba(11,143,120,.1);color:var(--color-primary);font-weight:900}.process-grid h3{font-size:1rem}.process-grid p{margin-top:.35rem;color:var(--color-text-muted);font-size:.82rem;line-height:1.65}.contact-note{display:grid;grid-template-columns:auto minmax(0,1fr);gap:1rem;margin-top:1.4rem;padding:1.3rem;border-radius:18px;background:var(--color-navy);color:#fff}.contact-note>svg{color:#7ce4d7}.contact-note h2{color:#fff;font-size:1.2rem}.contact-note p{margin:.35rem 0 .8rem;color:#bfd2e2;line-height:1.7}.contact-note a{display:inline-flex;align-items:center;gap:.4rem;color:#7ce4d7;font-weight:850}
  @media(max-width:900px){.career-hero-grid{grid-template-columns:1fr}.career-hero-card{max-width:640px}.standard-grid,.process-grid{grid-template-columns:1fr}}
  @media(max-width:620px){.career-hero{padding-top:3.2rem}.career-hero h1{font-size:clamp(2.5rem,14vw,4rem)}.career-signal-grid{grid-template-columns:1fr}.vacancy-status{grid-template-columns:1fr}.career-section{padding-block:3.6rem}}
</style>
