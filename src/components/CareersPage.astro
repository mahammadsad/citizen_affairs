---
import MainLayout from '@layouts/MainLayout.astro';
import Icon from './Icon.astro';
import { BRAND, getBrandName, SITE } from '@utils/constants';
import { locales, localizedPath, type Locale } from '../i18n';
import { CAREERS_COPY } from '../i18n/careers';

interface Props { locale: Locale; }

const { locale } = Astro.props as Props;
const brandName = getBrandName(locale);
const route = (lang: Locale, value = '') => {
  const path = localizedPath(lang, value);
  return lang === 'en' ? path.replace('/en/', '/') : path;
};
const canonical = `${SITE.url}${route(locale, 'careers')}`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, `${SITE.url}${route(lang, 'careers')}`])
) as Record<Locale, string>;
const successUrl = `${SITE.url}${route(locale, 'careers')}?sent=1#application-form`;

const copy = CAREERS_COPY[locale];
const jobCount = copy.roles.filter((role) => role.kind === 'job').length;
const internshipCount = copy.roles.filter((role) => role.kind === 'internship').length;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: copy.eyebrow,
  description: copy.intro,
  url: canonical,
  inLanguage: locale,
  isPartOf: { '@type': 'WebSite', name: brandName, url: SITE.url },
  about: { '@type': 'Organization', name: brandName, url: SITE.url }
};
---

<MainLayout title={copy.eyebrow} description={copy.intro} {locale} {canonical} {alternateUrls} structuredData={pageSchema}>
  <article class="career-page">
    <header class="career-hero">
      <div class="container career-hero-grid">
        <div>
          <span class="career-eyebrow"><Icon name="briefcase" size={18} />{copy.eyebrow}</span>
          <h1>{copy.title}</h1>
          <p>{copy.intro}</p>
          <div class="career-actions">
            <a class="btn btn-primary" href="#opportunities">{copy.primaryAction}<Icon name="arrow" size={18} /></a>
            <a class="btn btn-secondary" href="#application-form">{copy.secondaryAction}</a>
          </div>
          <small><Icon name="check" size={16} />{copy.note}</small>
        </div>

        <aside class="career-hero-card" aria-label={copy.valuesTitle}>
          <span>{brandName}</span>
          <strong>{copy.principles}</strong>
          <div class="career-signal-grid">
            {copy.signals.map(([icon, label]) => (
              <div><Icon name={icon} /><span>{label}</span></div>
            ))}
          </div>
        </aside>
      </div>
    </header>

    <section class="career-section container" id="opportunities" aria-labelledby="opportunities-title">
      <div class="section-heading">
        <span>{copy.openLabel}</span>
        <h2 id="opportunities-title">{copy.opportunitiesTitle}</h2>
        <p>{copy.opportunitiesIntro}</p>
      </div>

      <div class="opportunity-toolbar" role="group" aria-label={copy.filterLabel}>
        <button
          class="filter-button is-active"
          type="button"
          data-role-filter="all"
          data-filter-status={copy.allRolesStatus}
          aria-pressed="true"
        >
          <span>{copy.allRolesLabel}</span><strong>{copy.roles.length}</strong>
        </button>
        <button
          class="filter-button"
          type="button"
          data-role-filter="job"
          data-filter-status={copy.jobsStatus}
          aria-pressed="false"
        >
          <span>{copy.jobsLabel}</span><strong>{jobCount}</strong>
        </button>
        <button
          class="filter-button"
          type="button"
          data-role-filter="internship"
          data-filter-status={copy.internshipsStatus}
          aria-pressed="false"
        >
          <span>{copy.internshipsLabel}</span><strong>{internshipCount}</strong>
        </button>
      </div>

      <p class="filter-status" data-filter-status-output role="status" aria-live="polite">
        {copy.allRolesStatus}
      </p>

      <div class="role-grid">
        {copy.roles.map((role) => (
          <article class={`role-card role-${role.kind}`} data-role-card data-role-kind={role.kind}>
            <div class="role-meta">
              <span class={`role-kind role-kind-${role.kind}`}>
                {role.kind === 'job' ? copy.jobLabel : copy.internshipLabel}
              </span>
              <small><Icon name="globe" size={15} />{copy.workMode}</small>
            </div>

            <h3>{role.title}</h3>
            <p class="role-summary">{role.summary}</p>

            <dl class="role-facts">
              <div>
                <dt>{copy.departmentLabel}</dt>
                <dd>{role.department}</dd>
              </div>
              <div>
                <dt>{copy.engagementLabel}</dt>
                <dd>{role.engagement}</dd>
              </div>
              <div>
                <dt>{copy.experienceLabel}</dt>
                <dd>{role.experience}</dd>
              </div>
            </dl>

            <ul class="role-highlights">
              {role.skills.map((skill) => (
                <li><Icon name="check" size={16} />{skill}</li>
              ))}
            </ul>

            <details class="role-details" data-role-details>
              <summary>
                <span>{copy.roleDetailsAction}</span>
                <Icon name="arrow" size={18} />
              </summary>
              <div class="role-details-panel">
                <section>
                  <h4>{copy.responsibilitiesTitle}</h4>
                  <ul>
                    {role.responsibilities.map((item) => (
                      <li><Icon name="check" size={16} />{item}</li>
                    ))}
                  </ul>
                </section>
                <section>
                  <h4>{copy.requirementsTitle}</h4>
                  <ul>
                    {role.requirements.map((item) => (
                      <li><Icon name="check" size={16} />{item}</li>
                    ))}
                  </ul>
                </section>
                <section class="ideal-fit">
                  <h4>{copy.idealForTitle}</h4>
                  <p>{role.idealFor}</p>
                </section>
              </div>
            </details>

            <a class="role-apply" href="#application-form" data-role={role.id}>
              {copy.secondaryAction}<Icon name="arrow" size={17} />
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="career-values">
      <div class="container career-section">
        <div class="section-heading compact"><span>{brandName}</span><h2>{copy.valuesTitle}</h2></div>
        <div class="value-grid">
          {copy.values.map(([title, body], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="career-section container" aria-labelledby="process-title">
      <div class="section-heading compact">
        <span>{copy.formEyebrow}</span>
        <h2 id="process-title">{copy.processTitle}</h2>
      </div>
      <ol class="process-grid">
        {copy.process.map(([number, title, body]) => (
          <li><span>{number}</span><div><h3>{title}</h3><p>{body}</p></div></li>
        ))}
      </ol>
    </section>

    <section class="application-wrap" id="application-form">
      <div class="container application-grid">
        <aside>
          <span class="career-eyebrow"><Icon name="mail" size={18} />{copy.formEyebrow}</span>
          <h2>{copy.formTitle}</h2>
          <p>{copy.formIntro}</p>
          <div class="application-safety">
            <Icon name="check" />
            <div><strong>{copy.safetyTitle}</strong><p>{copy.safetyText}</p></div>
          </div>
        </aside>

        <div class="application-card">
          <div class="success-message" id="applicationSuccess" role="status" hidden>
            <Icon name="check" />{copy.success}
          </div>

          <form action={`https://formsubmit.co/${BRAND.contactEmail}`} method="POST" enctype="multipart/form-data" data-career-form>
            <input type="hidden" name="_subject" value={`New Citizen Affairs career application (${locale.toUpperCase()})`} />
            <input type="hidden" name="_next" value={successUrl} />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_autoresponse" value={copy.success} />
            <div class="honey" aria-hidden="true">
              <label>Website<input type="text" name="_honey" tabindex="-1" autocomplete="off" /></label>
            </div>

            <div class="form-grid">
              <label>
                <span>{copy.labels.name} *</span>
                <input type="text" name="Full name" autocomplete="name" required maxlength="100" />
              </label>
              <label>
                <span>{copy.labels.email} *</span>
                <input type="email" name="email" autocomplete="email" required maxlength="160" />
              </label>
              <label>
                <span>{copy.labels.phone}</span>
                <input type="tel" name="Phone or WhatsApp" autocomplete="tel" maxlength="30" />
              </label>
              <label>
                <span>{copy.labels.location} *</span>
                <input type="text" name="City and state" autocomplete="address-level2" required maxlength="120" />
              </label>
              <label class="span-two">
                <span>{copy.labels.role} *</span>
                <select name="Role" required data-role-select>
                  <option value="">{copy.labels.choose}</option>
                  {copy.roles.map((role) => (
                    <option value={role.title} data-role-id={role.id}>{role.title}</option>
                  ))}
                </select>
              </label>
              <label>
                <span>{copy.labels.experience} *</span>
                <select name="Experience" required>
                  <option value="">{copy.labels.selectExperience}</option>
                  {copy.experienceOptions.map((option) => <option>{option}</option>)}
                </select>
              </label>
              <label>
                <span>{copy.labels.availability} *</span>
                <select name="Availability" required>
                  <option value="">{copy.labels.selectAvailability}</option>
                  {copy.availabilityOptions.map((option) => <option>{option}</option>)}
                </select>
              </label>
              <label class="span-two">
                <span>{copy.labels.languages} *</span>
                <input type="text" name="Working languages" required maxlength="120" placeholder="বাংলা, English, हिन्दी" />
              </label>
              <label class="span-two">
                <span>{copy.labels.portfolio}</span>
                <input type="url" name="Portfolio or LinkedIn" inputmode="url" placeholder="https://" maxlength="300" />
              </label>
              <label class="span-two">
                <span>{copy.labels.message} *</span>
                <textarea name="Fit statement" rows="6" required minlength="80" maxlength="2500"></textarea>
              </label>
              <label class="span-two file-field">
                <span>{copy.labels.resume} *</span>
                <input
                  type="file"
                  name="Resume attachment"
                  accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
                  required
                  data-resume
                />
                <small>{copy.labels.resumeHelp}</small>
                <strong data-file-error role="alert"></strong>
              </label>
            </div>

            <label class="consent">
              <input type="checkbox" name="Consent confirmed" value="Yes" required />
              <span>{copy.labels.consent} *</span>
            </label>
            <button class="btn btn-primary submit-application" type="submit">
              {copy.labels.submit}<Icon name="arrow" size={18} />
            </button>
          </form>
        </div>
      </div>
    </section>

    <section class="career-section container faq-section" aria-labelledby="career-faq-title">
      <div class="section-heading compact"><span>FAQ</span><h2 id="career-faq-title">{copy.faqTitle}</h2></div>
      <div>
        {copy.faq.map(([question, answer]) => (
          <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>
        ))}
      </div>
    </section>
  </article>
</MainLayout>

<script define:vars={{ fileTooLarge: copy.labels.fileTooLarge }}>
  const params = new URLSearchParams(window.location.search);
  if (params.get('sent') === '1') {
    const banner = document.getElementById('applicationSuccess');
    if (banner) banner.hidden = false;
  }

  const roleSelect = document.querySelector('[data-role-select]');
  document.querySelectorAll('[data-role]').forEach((link) => {
    link.addEventListener('click', () => {
      const roleId = link.getAttribute('data-role');
      const option = roleSelect?.querySelector(`option[data-role-id="${roleId}"]`);
      if (roleSelect instanceof HTMLSelectElement && option instanceof HTMLOptionElement) {
        roleSelect.value = option.value;
      }
    });
  });

  const cards = Array.from(document.querySelectorAll('[data-role-card]'));
  const filterButtons = Array.from(document.querySelectorAll('[data-role-filter]'));
  const statusOutput = document.querySelector('[data-filter-status-output]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (!(button instanceof HTMLButtonElement)) return;
      const filter = button.dataset.roleFilter || 'all';

      filterButtons.forEach((candidate) => {
        if (!(candidate instanceof HTMLButtonElement)) return;
        const selected = candidate === button;
        candidate.classList.toggle('is-active', selected);
        candidate.setAttribute('aria-pressed', String(selected));
      });

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;
        const visible = filter === 'all' || card.dataset.roleKind === filter;
        card.hidden = !visible;
      });

      if (statusOutput) statusOutput.textContent = button.dataset.filterStatus || '';
    });
  });

  const roleDetails = Array.from(document.querySelectorAll('[data-role-details]'));
  roleDetails.forEach((details) => {
    details.addEventListener('toggle', () => {
      if (!(details instanceof HTMLDetailsElement) || !details.open) return;
      roleDetails.forEach((candidate) => {
        if (candidate !== details && candidate instanceof HTMLDetailsElement) candidate.open = false;
      });
    });
  });

  const resume = document.querySelector('[data-resume]');
  const error = document.querySelector('[data-file-error]');
  resume?.addEventListener('change', () => {
    const input = resume instanceof HTMLInputElement ? resume : null;
    const file = input?.files?.[0];
    if (error) error.textContent = '';
    input?.setCustomValidity('');
    if (file && file.size > 10 * 1024 * 1024) {
      input?.setCustomValidity(fileTooLarge);
      if (error) error.textContent = fileTooLarge;
      input?.reportValidity();
    }
  });
</script>

<style>
  .career-page {
    overflow: hidden;
    background: var(--color-background);
  }

  .career-hero {
    position: relative;
    padding: clamp(3.5rem, 8vw, 7rem) 0;
    background:
      radial-gradient(circle at 82% 18%, rgba(24, 182, 160, .22), transparent 28%),
      linear-gradient(135deg, #071e34 0%, #0b3153 58%, #0a5aa6 135%);
    color: #fff;
  }

  .career-hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: rgba(255, 255, 255, .15);
  }

  .career-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .career-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: #7ce4d7;
    font-size: .78rem;
    font-weight: 850;
    letter-spacing: .06em;
    text-transform: uppercase;
  }

  .career-hero h1 {
    max-width: 820px;
    margin: .9rem 0 1.1rem;
    color: #fff;
    font-size: clamp(2.5rem, 6.4vw, 5.6rem);
    line-height: .98;
    letter-spacing: -.045em;
  }

  .career-hero p {
    max-width: 68ch;
    color: #d6e7f4;
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.8;
  }

  .career-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .7rem;
    margin: 1.7rem 0 1.1rem;
  }

  .career-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
  }

  .career-actions .btn-secondary {
    border-color: rgba(255, 255, 255, .3);
    background: rgba(255, 255, 255, .08);
    color: #fff;
  }

  .career-hero small {
    display: flex;
    align-items: center;
    gap: .45rem;
    color: #a9c7da;
  }

  .career-hero-card {
    padding: 1.4rem;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 24px;
    background: rgba(255, 255, 255, .08);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .2);
    backdrop-filter: blur(14px);
  }

  .career-hero-card > span {
    color: #7ce4d7;
    font-size: .75rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .career-hero-card > strong {
    display: block;
    margin: .4rem 0 1.2rem;
    font-size: 1.35rem;
  }

  .career-signal-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .7rem;
  }

  .career-signal-grid div {
    display: flex;
    align-items: center;
    gap: .6rem;
    min-height: 82px;
    padding: .8rem;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 15px;
    background: rgba(7, 30, 52, .36);
  }

  .career-signal-grid svg {
    color: #f2b544;
  }

  .career-signal-grid span {
    color: #e4eff7;
    font-size: .82rem;
    font-weight: 750;
    line-height: 1.25;
  }

  .career-section {
    padding-block: clamp(3.8rem, 7vw, 6.5rem);
  }

  .section-heading {
    max-width: 780px;
    margin-bottom: 2rem;
  }

  .section-heading > span {
    display: inline-flex;
    margin-bottom: .55rem;
    color: var(--color-primary);
    font-size: .75rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .section-heading p {
    margin-top: .8rem;
    color: var(--color-text-muted);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .section-heading.compact {
    max-width: 620px;
  }

  .opportunity-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-bottom: .7rem;
    padding: .45rem;
    width: fit-content;
    max-width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 15px;
    background: var(--color-surface-alt);
  }

  .filter-button {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    min-height: 44px;
    padding: .6rem .8rem;
    border: 0;
    border-radius: 11px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: .84rem;
    font-weight: 800;
    cursor: pointer;
  }

  .filter-button strong {
    display: grid;
    place-items: center;
    min-width: 25px;
    height: 25px;
    padding-inline: .35rem;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: .7rem;
  }

  .filter-button.is-active {
    background: var(--color-navy);
    color: #fff;
    box-shadow: var(--shadow-sm);
  }

  .filter-button.is-active strong {
    background: rgba(255, 255, 255, .14);
    color: #fff;
  }

  .filter-button:focus-visible {
    outline: 3px solid rgba(11, 143, 120, .2);
    outline-offset: 2px;
  }

  .filter-status {
    margin-bottom: 1.2rem;
    color: var(--color-text-muted);
    font-size: .82rem;
  }

  .role-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 1rem;
  }

  .role-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }

  .role-card:hover {
    transform: translateY(-3px);
    border-color: rgba(11, 143, 120, .45);
    box-shadow: var(--shadow-lg);
  }

  .role-card[hidden] {
    display: none;
  }

  .role-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    margin-bottom: 1rem;
  }

  .role-kind {
    padding: .3rem .6rem;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 850;
  }

  .role-kind-job {
    background: rgba(11, 143, 120, .11);
    color: var(--color-primary);
  }

  .role-kind-internship {
    background: rgba(191, 121, 18, .13);
    color: #9a5d08;
  }

  .role-meta small {
    display: inline-flex;
    align-items: center;
    gap: .3rem;
    color: var(--color-text-muted);
    font-size: .72rem;
  }

  .role-card h3 {
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .role-summary {
    margin: .65rem 0 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .role-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .55rem;
    margin: 0 0 1rem;
  }

  .role-facts div {
    min-width: 0;
    padding: .65rem;
    border: 1px solid var(--color-border);
    border-radius: 11px;
    background: var(--color-surface-alt);
  }

  .role-facts dt {
    color: var(--color-text-muted);
    font-size: .63rem;
    font-weight: 800;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .role-facts dd {
    margin-top: .25rem;
    overflow-wrap: anywhere;
    color: var(--color-text);
    font-size: .78rem;
    font-weight: 800;
    line-height: 1.35;
  }

  .role-highlights {
    display: grid;
    gap: .45rem;
    margin-bottom: 1rem;
  }

  .role-highlights li,
  .role-details-panel li {
    display: flex;
    align-items: flex-start;
    gap: .45rem;
    color: var(--color-text-muted);
    font-size: .85rem;
    line-height: 1.55;
  }

  .role-highlights li svg,
  .role-details-panel li svg {
    flex: none;
    margin-top: .18rem;
    color: var(--color-primary);
  }

  .role-details {
    margin-top: .15rem;
    border-top: 1px solid var(--color-border);
  }

  .role-details summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .7rem;
    min-height: 50px;
    cursor: pointer;
    list-style: none;
    color: var(--color-text);
    font-size: .88rem;
    font-weight: 850;
  }

  .role-details summary::-webkit-details-marker {
    display: none;
  }

  .role-details summary svg {
    flex: none;
    color: var(--color-primary);
    transition: transform .2s ease;
  }

  .role-details[open] summary svg {
    transform: rotate(90deg);
  }

  .role-details-panel {
    display: grid;
    gap: 1rem;
    padding: .2rem 0 1rem;
  }

  .role-details-panel section {
    padding: .9rem;
