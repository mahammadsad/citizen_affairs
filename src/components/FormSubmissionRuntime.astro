<script>
  type SubmissionFormConfiguration = {
    formSelector: string;
    bannerId: string;
    storageKey: string;
    queryKey: string;
    returnHash: string;
  };

  const submissionForms: SubmissionFormConfiguration[] = [
    {
      formSelector: '[data-career-form]',
      bannerId: 'applicationSuccess',
      storageKey: 'citizen-affairs:career-submission-token',
      queryKey: 'career_submission',
      returnHash: '#application-form'
    },
    {
      formSelector: '[data-contact-form]',
      bannerId: 'contactSuccess',
      storageKey: 'citizen-affairs:contact-submission-token',
      queryKey: 'contact_submission',
      returnHash: '#contact-form'
    }
  ];

  const createSubmissionToken = (): string => {
    if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
      return crypto.randomUUID();
    }

    return `${Date.now().toString(36)}-${Math.random().toString(36).slice(2)}`;
  };

  const readSessionValue = (key: string): string | null => {
    try {
      return window.sessionStorage.getItem(key);
    } catch (_) {
      return null;
    }
  };

  const writeSessionValue = (key: string, value: string): boolean => {
    try {
      window.sessionStorage.setItem(key, value);
      return true;
    } catch (_) {
      return false;
    }
  };

  const removeSessionValue = (key: string): void => {
    try {
      window.sessionStorage.removeItem(key);
    } catch (_) {}
  };

  const setBannerVisibility = (banner: HTMLElement | null, visible: boolean): void => {
    if (!banner) return;

    banner.hidden = !visible;

    if (visible) {
      banner.style.removeProperty('display');
    } else {
      banner.style.setProperty('display', 'none', 'important');
    }
  };

  const removeSubmissionParameters = (queryKeys: string[]): void => {
    const cleanUrl = new URL(window.location.href);
    let changed = false;

    [...queryKeys, 'sent'].forEach((key) => {
      if (!cleanUrl.searchParams.has(key)) return;
      cleanUrl.searchParams.delete(key);
      changed = true;
    });

    if (changed) {
      window.history.replaceState(
        window.history.state,
        '',
        `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`
      );
    }
  };

  const ensureSourceUrl = (form: HTMLFormElement): void => {
    let sourceInput = form.querySelector<HTMLInputElement>('input[name="_url"]');

    if (!sourceInput) {
      sourceInput = document.createElement('input');
      sourceInput.type = 'hidden';
      sourceInput.name = '_url';
      form.append(sourceInput);
    }

    const sourceUrl = new URL(window.location.href);
    sourceUrl.search = '';
    sourceInput.value = sourceUrl.toString();
  };

  const getFirstInvalidControl = (form: HTMLFormElement): HTMLElement | null => {
    return form.querySelector<HTMLElement>('input:invalid, select:invalid, textarea:invalid');
  };

  const revealFirstInvalidControl = (form: HTMLFormElement): void => {
    form.classList.add('submission-attempted');
    const invalidControl = getFirstInvalidControl(form);

    if (!invalidControl) return;

    invalidControl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    window.setTimeout(() => {
      invalidControl.focus({ preventScroll: true });
      if (
        invalidControl instanceof HTMLInputElement ||
        invalidControl instanceof HTMLSelectElement ||
        invalidControl instanceof HTMLTextAreaElement
      ) {
        invalidControl.reportValidity();
      }
    }, 220);
  };

  const setSubmittingState = (form: HTMLFormElement, submitting: boolean): void => {
    const submitButton = form.querySelector<HTMLButtonElement | HTMLInputElement>(
      'button[type="submit"], input[type="submit"]'
    );
    if (!submitButton) return;

    submitButton.disabled = submitting;
    submitButton.setAttribute('aria-busy', String(submitting));
  };

  const initialiseSubmissionForm = (configuration: SubmissionFormConfiguration): void => {
    const form = document.querySelector(configuration.formSelector);
    const banner = document.getElementById(configuration.bannerId);

    if (!(form instanceof HTMLFormElement) && !banner) return;

    const currentUrl = new URL(window.location.href);
    const returnedToken = currentUrl.searchParams.get(configuration.queryKey);
    const expectedToken = readSessionValue(configuration.storageKey);
    const verifiedReturn = Boolean(
      returnedToken &&
      expectedToken &&
      returnedToken === expectedToken
    );

    setBannerVisibility(banner, verifiedReturn);

    if (verifiedReturn) {
      removeSessionValue(configuration.storageKey);
    }

    if (returnedToken || currentUrl.searchParams.has('sent')) {
      removeSubmissionParameters([configuration.queryKey]);
    }

    if (!(form instanceof HTMLFormElement)) return;

    ensureSourceUrl(form);
    setSubmittingState(form, false);

    const submitButton = form.querySelector<HTMLButtonElement | HTMLInputElement>(
      'button[type="submit"], input[type="submit"]'
    );
    submitButton?.addEventListener('click', (event) => {
      if (form.checkValidity()) return;

      event.preventDefault();
      revealFirstInvalidControl(form);
    });

    form.addEventListener('invalid', () => {
      form.classList.add('submission-attempted');
    }, true);

    form.addEventListener('input', () => {
      if (form.checkValidity()) form.classList.remove('submission-attempted');
    });

    form.addEventListener('change', () => {
      if (form.checkValidity()) form.classList.remove('submission-attempted');
    });

    form.addEventListener('submit', () => {
      if (!form.checkValidity()) {
        revealFirstInvalidControl(form);
        return;
      }

      const submissionToken = createSubmissionToken();
      const tokenStored = writeSessionValue(configuration.storageKey, submissionToken);
      const nextInput = form.querySelector<HTMLInputElement>('input[name="_next"]');

      if (nextInput && tokenStored) {
        const returnUrl = new URL(window.location.href);
        returnUrl.search = '';
        returnUrl.hash = configuration.returnHash;
        returnUrl.searchParams.set(configuration.queryKey, submissionToken);
        nextInput.value = returnUrl.toString();
      }

      ensureSourceUrl(form);
      setSubmittingState(form, true);
      setBannerVisibility(banner, false);
    });
  };

  const initialiseSubmissionForms = (): void => {
    submissionForms.forEach(initialiseSubmissionForm);
  };

  const scheduleInitialisation = (): void => {
    window.requestAnimationFrame(initialiseSubmissionForms);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleInitialisation, { once: true });
  } else {
    scheduleInitialisation();
  }

  window.addEventListener('pageshow', (event: PageTransitionEvent) => {
    submissionForms.forEach(({ formSelector, bannerId }) => {
      const form = document.querySelector(formSelector);
      if (form instanceof HTMLFormElement) setSubmittingState(form, false);
      if (event.persisted) setBannerVisibility(document.getElementById(bannerId), false);
    });
  });
</script>

<style is:global>
  #applicationSuccess[hidden],
  #contactSuccess[hidden] {
    display: none !important;
  }

  [data-career-form] :is(input, select, textarea),
  [data-contact-form] :is(input, select, textarea) {
    scroll-margin-block: 120px;
  }

  [data-career-form].submission-attempted :is(input, select, textarea):invalid,
  [data-contact-form].submission-attempted :is(input, select, textarea):invalid {
    border-color: #b42318 !important;
    box-shadow: 0 0 0 3px rgba(180, 35, 24, .12) !important;
  }

  [data-career-form] button[type="submit"][aria-busy="true"],
  [data-contact-form] button[type="submit"][aria-busy="true"] {
    cursor: wait;
    opacity: .72;
  }

  @media (max-width: 680px) {
    [data-career-form],
    [data-contact-form] {
      padding-bottom: 1rem;
    }

    [data-career-form] button[type="submit"],
    [data-contact-form] button[type="submit"] {
      scroll-margin-bottom: 120px;
    }
  }
</style>
