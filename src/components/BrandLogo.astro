---
import { resolveAssetPath } from '@utils/constants';

type Variant = 'full' | 'horizontal' | 'monogram' | 'circular';

interface Props {
  variant?: Variant;
  alt?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const variants: Record<Variant, { src: string; width: number; height: number }> = {
  full: { src: 'assets/brand/citizen-affairs-full.svg', width: 920, height: 260 },
  horizontal: { src: 'assets/brand/citizen-affairs-horizontal.svg', width: 560, height: 132 },
  monogram: { src: 'assets/brand/citizen-affairs-monogram.svg', width: 512, height: 512 },
  circular: { src: 'assets/brand/citizen-affairs-circular.svg', width: 512, height: 512 }
};

const { variant = 'horizontal', alt = 'Citizen Affairs', class: className, loading = 'eager' } = Astro.props;
const asset = variants[variant];
---
<img
  src={resolveAssetPath(asset.src)}
  width={asset.width}
  height={asset.height}
  alt={alt}
  class={className}
  loading={loading}
  decoding="async"
/>
<style>
  img { display: block; max-width: 100%; height: auto; object-fit: contain; }
</style>
