---
import { SITE } from '@utils/constants';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  en: {
    title: 'You are offline',
    description: 'Citizen Affairs cannot reach the network right now.',
    guidance: 'Previously opened pages may still be available. Reconnect before relying on a deadline or submitting personal information.',
    retry: 'Try again',
    home: 'Open cached home page'
  },
  bn: {
    title: 'আপনি অফলাইনে আছেন',
    description: 'Citizen Affairs এখন নেটওয়ার্কে সংযোগ করতে পারছে না।',
    guidance: 'আগে খোলা পৃষ্ঠা এখনও পাওয়া যেতে পারে। কোনো শেষ তারিখের উপর নির্ভর করা বা ব্যক্তিগত তথ্য জমা দেওয়ার আগে আবার সংযোগ করুন।',
    retry: 'আবার চেষ্টা করুন',
    home: 'সংরক্ষিত হোম পৃষ্ঠা খুলুন'
  },
  hi: {
    title: 'आप ऑफलाइन हैं',
    description: 'Citizen Affairs अभी नेटवर्क से संपर्क नहीं कर पा रहा है।',
    guidance: 'पहले खोले गए पृष्ठ अभी भी उपलब्ध हो सकते हैं। किसी अंतिम तिथि पर भरोसा करने या निजी जानकारी भेजने से पहले दोबारा कनेक्ट करें।',
    retry: 'फिर प्रयास करें',
    home: 'सहेजा हुआ होम पेज खोलें'
  }
}[locale];
const homePath = locale === 'en' ? SITE.basePath : `${SITE.basePath}${locale}/`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0A4D8C" />
    <title>{copy.title} | Citizen Affairs</title>
    <style is:inline>
      :root { color-scheme: light dark; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      * { box-sizing: border-box; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; padding: 1.25rem; background: #f5f7fa; color: #17202e; }
      main { width: min(100%, 36rem); padding: clamp(1.5rem, 5vw, 3rem); border: 1px solid #dbe3ec; border-radius: 1.25rem; background: #fff; box-shadow: 0 18px 48px rgba(8,49,92,.12); }
      .mark { width: 3rem; height: 3rem; display: grid; place-items: center; border-radius: 50%; background: #e8f3ff; color: #0a4d8c; font-size: 1.55rem; font-weight: 800; }
      h1 { margin: 1rem 0 .5rem; font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.15; }
      p { margin: .65rem 0; color: #526071; line-height: 1.65; }
      .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
      button, a { min-height: 44px; display: inline-flex; align-items: center; justify-content: center; padding: .75rem 1.1rem; border-radius: 999px; font: inherit; font-weight: 750; cursor: pointer; }
      button { border: 0; background: #0a4d8c; color: #fff; }
      a { border: 1px solid #0a4d8c; color: #0a4d8c; text-decoration: none; }
      button:focus-visible, a:focus-visible { outline: 3px solid #f39c12; outline-offset: 3px; }
      @media (prefers-color-scheme: dark) {
        body { background: #0a1220; color: #eef3f8; }
        main { background: #101a2c; border-color: #293951; box-shadow: none; }
        p { color: #acb8c8; }
        .mark { background: #173451; color: #8fc7ff; }
        a { border-color: #8fc7ff; color: #8fc7ff; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="mark" aria-hidden="true">!</div>
      <h1>{copy.title}</h1>
      <p><strong>{copy.description}</strong></p>
      <p>{copy.guidance}</p>
      <div class="actions">
        <button id="retry" type="button">{copy.retry}</button>
        <a href={homePath}>{copy.home}</a>
      </div>
    </main>
    <script is:inline>
      document.getElementById('retry')?.addEventListener('click', () => location.reload());
    </script>
  </body>
</html>
