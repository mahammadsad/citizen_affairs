---
import { SITE, SOCIALS } from '@utils/constants';
import type { Locale } from '../i18n';
import { localizedPath, ui } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const brandName = locale === 'bn' ? SITE.name : SITE.nameEn;
---

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src={`${SITE.basePath}assets/logo-mark.svg`} alt="" width="42" height="42" />
          <span class="brand-text"><span class="brand-name">{brandName}</span><span class="brand-tagline">{locale === 'bn' ? SITE.tagline : SITE.taglineEn}</span></span>
        </div>
        <p class="footer-about">{t.disclaimerShort}</p>
        <a href={`mailto:${SOCIALS.email}`} class="footer-email">{SOCIALS.email}</a>
      </div>
      <div class="footer-col">
        <h4>{t.articles}</h4>
        <ul><li><a href={localizedPath(locale, 'articles')}>{t.latest}</a></li><li><a href={localizedPath(locale, 'categories')}>{t.categories}</a></li></ul>
      </div>
      <div class="footer-col">
        <h4>{locale === 'bn' ? 'বিশ্বাস ও নীতি' : 'Trust & policies'}</h4>
        <ul>
          <li><a href={localizedPath(locale, 'privacy')}>{t.privacy}</a></li>
          <li><a href={localizedPath(locale, 'disclaimer')}>{t.disclaimer}</a></li>
          <li><a href={localizedPath(locale, 'terms')}>{t.terms}</a></li>
          <li><a href={localizedPath(locale, 'editorial-policy')}>{t.editorial}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.community}</h4>
        <ul><li><a href={SOCIALS.telegram} target="_blank" rel="noopener">Telegram Channel</a></li><li><a href={SOCIALS.telegramMCQ} target="_blank" rel="noopener">MCQ Practice Group</a></li><li><a href={SOCIALS.whatsapp} target="_blank" rel="noopener">WhatsApp Channel</a></li></ul>
      </div>
    </div>
    <div class="footer-bottom"><p>{t.disclaimerShort}</p><p>© 2026 {brandName}</p></div>
  </div>
</footer>
