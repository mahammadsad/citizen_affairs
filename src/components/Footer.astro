---
/**
 * Footer
 */
import { SITE, SOCIALS } from '@utils/constants';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-brand">
          <img src="/sarkari-tathya-kendra/assets/logo-mark.svg" alt="" width="40" height="40" />
          <span class="brand-text">
            <span class="brand-name">{SITE.name}</span>
            <span class="brand-tagline">{SITE.tagline}</span>
          </span>
        </div>
        <p class="footer-about">{SITE.description}</p>
        <div class="footer-social">
          <a href={SOCIALS.telegram} target="_blank" rel="noopener" aria-label="Telegram">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 3 3 10.5l7 2.5 2 7z"/>
              <path d="M21 3 12.5 13"/>
            </svg>
          </a>
          <a href={SOCIALS.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp">
            <svg class="icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.5 17.5 4 20l2.6-.7A8 8 0 1 0 4 12a8 8 0 0 0 2.5 5.5z"/>
              <path d="M9 10.5c.3 2 2.5 4.2 4.5 4.5.8.1 1.5-.4 1.7-1"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="footer-col">
        <h4>দ্রুত লিঙ্ক</h4>
        <ul>
          <li><a href="/sarkari-tathya-kendra/">হোম</a></li>
          <li><a href="/sarkari-tathya-kendra/#channel">চ্যানেল</a></li>
          <li><a href="/sarkari-tathya-kendra/#services">সেবাসমূহ</a></li>
          <li><a href="/sarkari-tathya-kendra/articles/">আর্টিকেল</a></li>
          <li><a href="/sarkari-tathya-kendra/#contact">যোগাযোগ</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>প্রয়োজনীয় লিঙ্ক</h4>
        <ul>
          <li><a href="/sarkari-tathya-kendra/privacy/">Privacy Policy</a></li>
          <li><a href="/sarkari-tathya-kendra/disclaimer/">Disclaimer</a></li>
          <li><a href="/sarkari-tathya-kendra/terms/">Terms</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>কমিউনিটি</h4>
        <ul>
          <li><a href={SOCIALS.telegram} target="_blank" rel="noopener">Telegram Channel</a></li>
          <li><a href={SOCIALS.telegramMCQ} target="_blank" rel="noopener">MCQ Group</a></li>
          <li><a href={SOCIALS.whatsapp} target="_blank" rel="noopener">WhatsApp Channel</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclaimer">
        <strong>দাবিত্যাগ:</strong> সরকারি তথ্যকেন্দ্র কোনো সরকারি প্রতিষ্ঠান বা কর্তৃপক্ষের অংশ নয়। এটি একটি স্বাধীন কমিউনিটি প্ল্যাটফর্ম।
      </p>
      <p>© <span id="year"></span> {SITE.name}। সর্বস্বত্ব সংরক্ষিত।</p>
    </div>
  </div>
</footer>

<button class="back-to-top" id="backToTop" aria-label="উপরে ফিরে যান">
  <svg class="icon" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
    <line x1="12" y1="19" x2="12" y2="5"/>
    <path d="M6 11l6-6 6 6"/>
  </svg>
</button>

<script>
  // Footer year
  const yearEl = document.getElementById('year');
  if (yearEl) yearEl.textContent = new Date().getFullYear().toString();

  // Back to top
  const backToTop = document.getElementById('backToTop');
  if (backToTop) {
    window.addEventListener('scroll', () => {
      backToTop.classList.toggle('is-visible', window.scrollY > 480);
    }, { passive: true });

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
