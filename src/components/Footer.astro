---
import { getBrandName, SOCIALS } from '@utils/constants';
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import SocialFollow from './SocialFollow.astro';
import type { Locale } from '../i18n';
import { localizedPath, trustPagePath, ui } from '../i18n';

const { locale } = Astro.props as { locale: Locale };
const t = ui(locale);
const brandName = getBrandName(locale);
const route = (value = '') => {
  const path = localizedPath(locale, value);
  return locale === 'en' ? path.replace('/en/', '/') : path;
};
const careersLabel = { en: 'Careers', bn: 'ক্যারিয়ার', hi: 'करियर' }[locale];
const teamLabel = { en: 'Our Team', bn: 'আমাদের টিম', hi: 'हमारी टीम' }[locale];
const transparencyLabel = { en: 'Transparency', bn: 'স্বচ্ছতা', hi: 'पारदर्शिता' }[locale];
const communityLabel = { en: 'MCQ Group', bn: 'MCQ গ্রুপ', hi: 'MCQ समूह' }[locale];

const footerLinks = [
  { label: t.latestNav, href: route('articles') },
  { label: t.deadlines, href: route('deadlines') },
  { label: t.categories, href: route('categories') },
  { label: t.saved, href: route('saved') },
  { label: careersLabel, href: route('careers') },
  { label: teamLabel, href: route('team') },
  { label: t.about, href: trustPagePath(locale, 'about') },
  { label: t.contact, href: trustPagePath(locale, 'contact') }
];

const policies = [
  { label: transparencyLabel, href: route('transparency') },
  { label: t.editorial, href: route('editorial-policy') },
  { label: t.corrections, href: trustPagePath(locale, 'corrections') },
  { label: t.privacy, href: route('privacy') },
  { label: t.terms, href: route('terms') },
  { label: t.disclaimer, href: route('disclaimer') }
];
---

<section class="prefooter container" aria-labelledby="stayUpdatedTitle">
  <div>
    <span>{t.stayUpdated}</span>
    <h2 id="stayUpdatedTitle">{t.stayUpdatedText}</h2>
  </div>
  <div class="prefooter-actions">
    <a href={SOCIALS.telegram} target="_blank" rel="noopener noreferrer"><Icon name="telegram" />{t.telegramUpdates}</a>
    <a href={SOCIALS.whatsapp} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" />{t.whatsappUpdates}</a>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-main">
    <section class="footer-intro">
      <a class="footer-brand" href={route()}>
        <BrandLogo variant="full" alt={`${brandName} ${t.logo}`} class="footer-brand-logo" loading="lazy" />
      </a>
      <p>{t.disclaimerShort}</p>
      <a class="community-link" href={SOCIALS.telegramMCQ} target="_blank" rel="noopener noreferrer">
        <Icon name="group" size={17} />{communityLabel}<Icon name="external" size={15} />
      </a>
    </section>

    <section class="footer-column">
      <h3>{t.exploreFooter}</h3>
      <nav class="footer-links" aria-label={t.exploreFooter}>
        {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </section>

    <section class="footer-column">
      <h3>{t.trustPolicies}</h3>
      <nav class="footer-links" aria-label={t.trustPolicies}>
        {policies.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </section>
  </div>

  <SocialFollow {locale} variant="footer" titleId="footerSocialTitle" />

  <div class="container footer-bottom">
    <div><strong>© 2026 {brandName}</strong><span>{t.independentService} · {t.notGovernmentWebsite}</span></div>
    <nav aria-label={`${t.trustPolicies} · ${t.language}`}>
      <a href={route('privacy')}>{t.privacy}</a>
      <a href={route('terms')}>{t.terms}</a>
      <a href="#languageTrigger" data-footer-language>{t.language}</a>
      <a href="#top">↑ {t.backToTop}</a>
    </nav>
  </div>
</footer>

<script>
  document.querySelector('[data-footer-language]')?.addEventListener('click', (event) => {
    event.preventDefault();
    document.getElementById('languageTrigger')?.click();
  });
</script>

<style>
  :global(.footer-brand-logo){display:block;width:100%;height:auto}
  .prefooter{display:flex;align-items:center;justify-content:space-between;gap:1.25rem;margin-top:2rem;padding:1rem 1.15rem;border:1px solid rgba(255,255,255,.14);border-radius:10px;background:var(--color-navy);color:#fff}
  .prefooter span{color:#9adbd0;font-size:.78rem;font-weight:700}.prefooter h2{margin-top:.15rem;color:#fff;font-size:clamp(1.05rem,2vw,1.35rem);font-weight:700}.prefooter-actions{display:flex;flex-wrap:wrap;gap:.5rem}.prefooter-actions a{display:inline-flex;align-items:center;gap:.45rem;min-height:42px;padding:.55rem .75rem;border:1px solid rgba(255,255,255,.18);border-radius:7px;font-weight:700}.prefooter-actions a:hover,.prefooter-actions a:focus-visible{background:rgba(255,255,255,.08)}
  .site-footer{padding:3rem 0 1.35rem;background:var(--footer-bg);color:#d9e8f5}.footer-main{display:grid;grid-template-columns:minmax(260px,1.2fr) repeat(2,minmax(170px,.75fr));gap:clamp(1.5rem,5vw,4rem)}.footer-brand{display:flex;width:min(100%,280px);padding:.45rem;border-radius:8px;background:#fff}.footer-intro>p{max-width:43ch;margin:1rem 0;color:#b9cee0;font-size:.9rem;line-height:1.6}.community-link{display:inline-flex;align-items:center;gap:.4rem;color:#d7e6f2;font-size:.82rem;font-weight:700}.community-link:hover,.community-link:focus-visible{color:#fff}.site-footer h3{margin-bottom:.75rem;color:#fff;font-size:.92rem}.footer-links{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.15rem .8rem}.footer-links a{min-height:36px;display:flex;align-items:center;color:#c7d7e5;font-size:.82rem}.footer-links a:hover,.footer-links a:focus-visible{color:#fff}.footer-bottom{display:flex;align-items:end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:1.5rem;padding-top:1.1rem;border-top:1px solid rgba(255,255,255,.12);color:#9fbad0;font-size:.76rem}.footer-bottom>div{display:grid;gap:.12rem}.footer-bottom strong{color:#fff}.footer-bottom nav{display:flex;flex-wrap:wrap;gap:1rem}.footer-bottom a:hover,.footer-bottom a:focus-visible{color:#fff}
  @media(max-width:840px){.footer-main{grid-template-columns:1fr 1fr}.footer-intro{grid-column:1/-1}.footer-links{grid-template-columns:1fr 1fr}}
  @media(max-width:620px){.prefooter{align-items:flex-start;flex-direction:column;margin-inline:1rem}.prefooter-actions{width:100%}.prefooter-actions a{flex:1;justify-content:center}.site-footer{padding-top:2.4rem}.footer-main{grid-template-columns:1fr;gap:1.5rem}.footer-intro{grid-column:auto}.footer-brand{width:min(100%,250px)}.footer-column{padding-top:1rem;border-top:1px solid rgba(255,255,255,.12)}.footer-links{grid-template-columns:1fr 1fr}.footer-bottom{align-items:flex-start;flex-direction:column}}
</style>
