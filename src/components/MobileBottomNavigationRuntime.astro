<script is:inline>
  (() => {
    const navigation = document.querySelector('.portal-mobile-bottom');
    if (!(navigation instanceof HTMLElement)) return;
    if (navigation.dataset.scrollVisibilityReady === 'true') return;

    navigation.dataset.scrollVisibilityReady = 'true';

    const mobileViewport = window.matchMedia('(max-width: 680px)');
    const scrollStopDelay = 180;
    let scrollStopTimer = 0;
    let animationFrame = 0;

    const clearPendingWork = () => {
      if (scrollStopTimer) {
        window.clearTimeout(scrollStopTimer);
        scrollStopTimer = 0;
      }
      if (animationFrame) {
        window.cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }
    };

    const showNavigation = () => {
      clearPendingWork();
      navigation.classList.remove('is-scroll-hidden');
    };

    const hideNavigation = () => {
      if (
        !mobileViewport.matches ||
        document.documentElement.classList.contains('portal-menu-open') ||
        navigation.matches(':focus-within')
      ) {
        showNavigation();
        return;
      }

      if (!animationFrame) {
        animationFrame = window.requestAnimationFrame(() => {
          animationFrame = 0;
          navigation.classList.add('is-scroll-hidden');
        });
      }

      if (scrollStopTimer) window.clearTimeout(scrollStopTimer);
      scrollStopTimer = window.setTimeout(showNavigation, scrollStopDelay);
    };

    window.addEventListener('scroll', hideNavigation, { passive: true });

    if ('onscrollend' in window) {
      window.addEventListener('scrollend', showNavigation, { passive: true });
    }

    navigation.addEventListener('focusin', showNavigation);
    navigation.addEventListener('pointerdown', showNavigation, { passive: true });
    mobileViewport.addEventListener?.('change', showNavigation);
    window.addEventListener('pageshow', showNavigation);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') showNavigation();
    });
  })();
</script>

<style is:global>
  @media (max-width: 680px) {
    .portal-mobile-bottom {
      transform: translateY(0);
      opacity: 1;
      transition:
        transform 170ms ease,
        opacity 140ms ease;
    }

    .portal-mobile-bottom.is-scroll-hidden {
      transform: translateY(calc(100% + env(safe-area-inset-bottom)));
      opacity: 0;
      pointer-events: none;
      will-change: transform, opacity;
    }

    .portal-mobile-bottom:focus-within {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
  }

  @media (max-width: 680px) and (prefers-reduced-motion: reduce) {
    .portal-mobile-bottom {
      transition: none;
    }
  }
</style>
