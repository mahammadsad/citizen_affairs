---
import MainLayout from '@layouts/MainLayout.astro';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import { getLocalizedArticles, getUpcomingDeadlines } from '@lib/content';
import { localizedPath, locales, type Locale } from '../i18n';
import { SITE } from '@utils/constants';

const { locale } = Astro.props as { locale: Locale };
const articles = await getLocalizedArticles(locale);
const latest = articles.slice(0, 8);
const featured = articles.find((article) => article.data.featured) || articles[0];
const deadlines = await getUpcomingDeadlines(locale, 6);
const now = new Date();
const soon = deadlines.filter((article) => {
  const deadline = article.data.deadline;
  if (!deadline) return false;
  const days = Math.ceil((deadline.getTime() - now.getTime()) / 86400000);
  return days >= 0 && days <= 7;
});
const canonical = locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/`;
const alternateUrls = Object.fromEntries(locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/` : `${SITE.url}/${lang}/`]));
const dateFormat = new Intl.DateTimeFormat(locale === 'bn' ? 'bn-IN' : locale === 'hi' ? 'hi-IN' : 'en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

const copy = {
  en: {
    title: 'What can we help you do today?',
    intro: 'Verified government opportunities, benefits, deadlines and public services — explained clearly for citizens of India.',
    search: 'Search jobs, admissions, scholarships, schemes or services',
    searchButton: 'Search',
    important: 'Important today',
    action: 'Citizen action centre',
    actionIntro: 'Start with what you need to accomplish.',
    latest: 'Latest verified updates',
    deadlines: 'Deadline centre',
    deadlinesIntro: 'Applications and registrations that need your attention.',
    allDeadlines: 'View all deadlines',
    browse: 'Browse all updates',
    trust: 'Official sources first',
    trustBody: 'Every published update records its verification status, source and last-checked date.',
    emptyTitle: 'Verified updates are being prepared',
    emptyBody: 'The portal structure is ready. Sections appear automatically as current verified information is published.',
    hubs: [
      ['Find a government job', 'Jobs by qualification, department and state', 'briefcase', 'categories/jobs'],
      ['Find an admission', 'Admissions, entrance exams and counselling', 'education', 'categories/exams'],
      ['Find a scholarship', 'Scholarships, fellowships and student benefits', 'education', 'categories/materials'],
      ['Find a welfare scheme', 'Benefits for families, students, farmers and seniors', 'schemes', 'categories/projects'],
      ['Use a citizen service', 'Aadhaar, PAN, voter, passport, EPFO and certificates', 'services', 'categories/affairs'],
      ['Check notices and alerts', 'Deadline changes, results and official corrections', 'notices', 'categories/notices'],
      ['Read step-by-step guides', 'Eligibility, documents and application help', 'updates', 'categories/guides'],
      ['See upcoming deadlines', 'Closing today, this week and later', 'clock', 'deadlines']
    ]
  },
  bn: {
    title: 'আজ আপনাকে কী কাজে সাহায্য করতে পারি?',
    intro: 'ভারতের নাগরিকদের জন্য যাচাইকৃত সরকারি সুযোগ, সুবিধা, শেষ তারিখ ও জনপরিষেবা — সহজ ভাষায়।',
    search: 'চাকরি, ভর্তি, স্কলারশিপ, প্রকল্প বা পরিষেবা খুঁজুন',
    searchButton: 'খুঁজুন',
    important: 'আজকের গুরুত্বপূর্ণ তথ্য',
    action: 'নাগরিক অ্যাকশন সেন্টার',
    actionIntro: 'আপনার প্রয়োজনীয় কাজটি বেছে নিয়ে শুরু করুন।',
    latest: 'সর্বশেষ যাচাইকৃত আপডেট',
    deadlines: 'শেষ তারিখ কেন্দ্র',
    deadlinesIntro: 'যেসব আবেদন ও নিবন্ধনের দিকে এখনই নজর দেওয়া প্রয়োজন।',
    allDeadlines: 'সব শেষ তারিখ দেখুন',
    browse: 'সব আপডেট দেখুন',
    trust: 'অফিসিয়াল সূত্র আগে',
    trustBody: 'প্রতিটি প্রকাশিত আপডেটে যাচাইয়ের অবস্থা, সূত্র ও সর্বশেষ পরীক্ষার তারিখ দেখানো হয়।',
    emptyTitle: 'যাচাইকৃত আপডেট প্রস্তুত হচ্ছে',
    emptyBody: 'পোর্টালের কাঠামো প্রস্তুত। বর্তমান যাচাইকৃত তথ্য প্রকাশিত হলে বিভাগগুলি স্বয়ংক্রিয়ভাবে দেখা যাবে।',
    hubs: [
      ['সরকারি চাকরি খুঁজুন', 'যোগ্যতা, দপ্তর ও রাজ্য অনুযায়ী চাকরি', 'briefcase', 'categories/jobs'],
      ['ভর্তি খুঁজুন', 'ভর্তি, প্রবেশিকা পরীক্ষা ও কাউন্সেলিং', 'education', 'categories/exams'],
      ['স্কলারশিপ খুঁজুন', 'স্কলারশিপ, ফেলোশিপ ও ছাত্র সুবিধা', 'education', 'categories/materials'],
      ['কল্যাণ প্রকল্প খুঁজুন', 'পরিবার, ছাত্র, কৃষক ও প্রবীণদের সুবিধা', 'schemes', 'categories/projects'],
      ['নাগরিক পরিষেবা ব্যবহার করুন', 'আধার, প্যান, ভোটার, পাসপোর্ট, EPFO ও সার্টিফিকেট', 'services', 'categories/affairs'],
      ['নোটিশ ও সতর্কতা দেখুন', 'শেষ তারিখ পরিবর্তন, ফলাফল ও সরকারি সংশোধন', 'notices', 'categories/notices'],
      ['ধাপে ধাপে গাইড পড়ুন', 'যোগ্যতা, নথি ও আবেদন সহায়তা', 'updates', 'categories/guides'],
      ['আসন্ন শেষ তারিখ দেখুন', 'আজ, এই সপ্তাহ ও পরে বন্ধ হবে', 'clock', 'deadlines']
    ]
  },
  hi: {
    title: 'आज हम आपका कौन-सा काम आसान करें?',
    intro: 'भारत के नागरिकों के लिए सत्यापित सरकारी अवसर, लाभ, अंतिम तिथियाँ और सार्वजनिक सेवाएँ — सरल भाषा में।',
    search: 'नौकरी, प्रवेश, छात्रवृत्ति, योजना या सेवा खोजें',
    searchButton: 'खोजें',
    important: 'आज की महत्वपूर्ण जानकारी',
    action: 'नागरिक एक्शन सेंटर',
    actionIntro: 'जिस काम को पूरा करना है, उससे शुरुआत करें।',
    latest: 'नवीनतम सत्यापित अपडेट',
    deadlines: 'अंतिम तिथि केंद्र',
    deadlinesIntro: 'वे आवेदन और पंजीकरण जिन पर अभी ध्यान देना आवश्यक है।',
    allDeadlines: 'सभी अंतिम तिथियाँ देखें',
    browse: 'सभी अपडेट देखें',
    trust: 'पहले आधिकारिक स्रोत',
    trustBody: 'हर प्रकाशित अपडेट में सत्यापन स्थिति, स्रोत और अंतिम जाँच की तारीख दर्ज होती है।',
    emptyTitle: 'सत्यापित अपडेट तैयार किए जा रहे हैं',
    emptyBody: 'पोर्टल संरचना तैयार है। वर्तमान सत्यापित जानकारी प्रकाशित होते ही अनुभाग स्वतः दिखाई देंगे।',
    hubs: [
      ['सरकारी नौकरी खोजें', 'योग्यता, विभाग और राज्य के अनुसार नौकरियाँ', 'briefcase', 'categories/jobs'],
      ['प्रवेश खोजें', 'प्रवेश, प्रवेश परीक्षा और काउंसलिंग', 'education', 'categories/exams'],
      ['छात्रवृत्ति खोजें', 'छात्रवृत्ति, फेलोशिप और विद्यार्थी लाभ', 'education', 'categories/materials'],
      ['कल्याण योजना खोजें', 'परिवार, विद्यार्थी, किसान और वरिष्ठ नागरिक लाभ', 'schemes', 'categories/projects'],
      ['नागरिक सेवा उपयोग करें', 'आधार, पैन, मतदाता, पासपोर्ट, EPFO और प्रमाणपत्र', 'services', 'categories/affairs'],
      ['नोटिस और अलर्ट देखें', 'अंतिम तिथि बदलाव, परिणाम और आधिकारिक सुधार', 'notices', 'categories/notices'],
      ['चरणबद्ध गाइड पढ़ें', 'पात्रता, दस्तावेज़ और आवेदन सहायता', 'updates', 'categories/guides'],
      ['आगामी अंतिम तिथियाँ देखें', 'आज, इस सप्ताह और बाद में बंद होने वाले आवेदन', 'clock', 'deadlines']
    ]
  }
}[locale];
---

<MainLayout title={copy.title} description={copy.intro} {locale} {canonical} {alternateUrls}>
  <section class="portal-hero">
    <div class="container portal-hero-grid">
      <div>
        <p class="portal-eyebrow"><Icon name="check" size={16} /> Citizen Affairs</p>
        <h1>{copy.title}</h1>
        <p class="portal-intro">{copy.intro}</p>
        <form class="portal-search" action={localizedPath(locale, 'search')}>
          <Icon name="search" />
          <input type="search" name="q" placeholder={copy.search} aria-label={copy.search} />
          <button type="submit">{copy.searchButton}</button>
        </form>
        <div class="trust-line"><Icon name="check" size={18} /><strong>{copy.trust}</strong><span>{copy.trustBody}</span></div>
      </div>

      <aside class="today-panel">
        <div class="panel-heading"><span>{copy.important}</span><time>{dateFormat.format(now)}</time></div>
        {featured ? (
          <a class="lead-update" href={localizedPath(locale, `articles/${featured.data.urlSlug}`)}>
            <span class="status">{featured.data.verificationStatus.replaceAll('-', ' ')}</span>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <div class="lead-meta">
              {featured.data.deadline && <span><Icon name="clock" size={16} />{dateFormat.format(featured.data.deadline)}</span>}
              <span><Icon name="arrow" size={16} />{copy.browse}</span>
            </div>
          </a>
        ) : (
          <div class="empty-state"><Icon name="updates" size={42} /><h2>{copy.emptyTitle}</h2><p>{copy.emptyBody}</p></div>
        )}
      </aside>
    </div>
  </section>

  <section class="portal-section action-section">
    <div class="container">
      <header class="portal-heading"><div><span>{copy.action}</span><h2>{copy.action}</h2><p>{copy.actionIntro}</p></div></header>
      <div class="action-grid">
        {copy.hubs.map(([title, description, icon, path]) => (
          <a class="action-card" href={localizedPath(locale, path)}>
            <span class="action-icon"><Icon name={icon} size={25} /></span>
            <span><strong>{title}</strong><small>{description}</small></span>
            <Icon name="arrow" size={19} />
          </a>
        ))}
      </div>
    </div>
  </section>

  {soon.length > 0 && (
    <section class="portal-section deadline-section">
      <div class="container">
        <header class="portal-heading split"><div><span>{copy.deadlines}</span><h2>{copy.deadlines}</h2><p>{copy.deadlinesIntro}</p></div><a href={localizedPath(locale, 'deadlines')}>{copy.allDeadlines}<Icon name="arrow" size={18} /></a></header>
        <div class="deadline-list">
          {soon.map((article) => (
            <a href={localizedPath(locale, `articles/${article.data.urlSlug}`)}>
              <div><strong>{article.data.title}</strong><small>{article.data.description}</small></div>
              <time>{article.data.deadline && dateFormat.format(article.data.deadline)}</time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {latest.length > 0 && (
    <section class="portal-section latest-section">
      <div class="container">
        <header class="portal-heading split"><div><span>{copy.latest}</span><h2>{copy.latest}</h2></div><a href={localizedPath(locale, 'articles')}>{copy.browse}<Icon name="arrow" size={18} /></a></header>
        <div class="latest-grid">{latest.map((article) => <ArticleCard {article} {locale} />)}</div>
      </div>
    </section>
  )}
</MainLayout>

<style>
  .portal-hero{padding:clamp(2rem,5vw,4.5rem) 0;background:linear-gradient(180deg,var(--color-surface),var(--color-bg));border-bottom:1px solid var(--color-border)}
  .portal-hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(320px,.85fr);gap:clamp(1.5rem,4vw,4rem);align-items:center}
  .portal-eyebrow{display:inline-flex;align-items:center;gap:.45rem;color:var(--color-primary);font-weight:800;font-size:.84rem;text-transform:uppercase;letter-spacing:.08em;margin-bottom:1rem}
  .portal-hero h1{font-size:clamp(2.25rem,5vw,4.5rem);max-width:14ch;letter-spacing:-.045em;line-height:1.06;color:var(--color-navy)}
  .portal-intro{font-size:clamp(1.05rem,1rem + .35vw,1.28rem);max-width:62ch;color:var(--color-text-muted);margin:1.25rem 0 1.5rem}
  .portal-search{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.75rem;max-width:760px;background:var(--color-surface);border:2px solid var(--color-primary);border-radius:12px;padding:.38rem .4rem .38rem .9rem;box-shadow:var(--shadow-sm)}
  .portal-search input{min-width:0;border:0;outline:0;background:transparent;padding:.8rem 0}.portal-search button{background:var(--color-primary);color:#fff;padding:.8rem 1.2rem;border-radius:8px;font-weight:800}
  .trust-line{display:flex;align-items:flex-start;gap:.55rem;flex-wrap:wrap;margin-top:1rem;color:var(--color-text-muted);font-size:.88rem}.trust-line strong{color:var(--color-text)}
  .today-panel{border:1px solid var(--color-border);background:var(--color-surface);border-radius:14px;overflow:hidden;box-shadow:var(--shadow-md)}
  .panel-heading{display:flex;justify-content:space-between;gap:1rem;padding:.8rem 1rem;background:var(--color-navy);color:#fff;font-size:.8rem;font-weight:800}.lead-update,.empty-state{display:block;padding:1.35rem}.lead-update .status{display:inline-block;color:var(--color-green-text);background:rgba(var(--color-green-rgb),.1);padding:.25rem .55rem;border-radius:999px;font-size:.68rem;font-weight:800;text-transform:uppercase}.lead-update h2,.empty-state h2{font-size:clamp(1.35rem,2.6vw,2rem);margin:.8rem 0 .55rem;color:var(--color-text)}.lead-update p,.empty-state p{color:var(--color-text-muted)}.lead-meta{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-top:1.2rem;color:var(--color-primary);font-size:.82rem;font-weight:800}.lead-meta span{display:flex;align-items:center;gap:.35rem}
  .portal-section{padding:clamp(3rem,6vw,5rem) 0}.portal-heading{margin-bottom:1.5rem}.portal-heading>div>span{font-size:.75rem;font-weight:800;color:var(--color-primary);text-transform:uppercase;letter-spacing:.08em}.portal-heading h2{font-size:clamp(1.65rem,3vw,2.5rem);margin:.25rem 0}.portal-heading p{color:var(--color-text-muted)}.portal-heading.split{display:flex;align-items:end;justify-content:space-between;gap:1rem}.portal-heading>a{display:flex;align-items:center;gap:.35rem;color:var(--color-primary);font-weight:800}
  .action-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.8rem}.action-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:.8rem;min-height:112px;padding:1rem;border:1px solid var(--color-border);border-radius:11px;background:var(--color-surface);transition:border-color .16s ease,background .16s ease}.action-card:hover,.action-card:focus-visible{border-color:var(--color-primary);background:rgba(var(--color-primary-rgb),.035)}.action-icon{width:46px;height:46px;display:grid;place-items:center;border-radius:10px;background:rgba(var(--color-primary-rgb),.09);color:var(--color-primary)}.action-card strong,.action-card small{display:block}.action-card strong{line-height:1.3}.action-card small{color:var(--color-text-muted);font-size:.78rem;line-height:1.45;margin-top:.25rem}
  .deadline-section{background:var(--color-surface-alt);border-block:1px solid var(--color-border)}.deadline-list{display:grid;gap:.55rem}.deadline-list a{display:grid;grid-template-columns:1fr auto;gap:1rem;align-items:center;padding:1rem 1.1rem;background:var(--color-surface);border:1px solid var(--color-border);border-left:4px solid var(--color-orange);border-radius:8px}.deadline-list strong,.deadline-list small{display:block}.deadline-list small{color:var(--color-text-muted);margin-top:.2rem}.deadline-list time{font-weight:800;color:#9a5600;white-space:nowrap}
  .latest-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}
  @media(max-width:1050px){.action-grid,.latest-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.portal-hero-grid{grid-template-columns:1fr}.portal-hero h1{max-width:18ch}}
  @media(max-width:620px){.portal-hero{padding-top:1.5rem}.portal-hero h1{font-size:2.25rem}.portal-search{grid-template-columns:auto 1fr}.portal-search button{grid-column:1/-1;width:100%}.action-grid,.latest-grid{grid-template-columns:1fr}.action-card{min-height:96px}.portal-heading.split{align-items:flex-start;flex-direction:column}.deadline-list a{grid-template-columns:1fr}.today-panel{border-radius:10px}}
</style>
