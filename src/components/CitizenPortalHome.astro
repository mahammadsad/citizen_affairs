---
import MainLayout from '@layouts/MainLayout.astro';
import Icon from './Icon.astro';
import StoryImage from './StoryImage.astro';
import { categoryName, getCategoryData, getLocalizedArticles } from '@lib/content';
import { localizedPath, locales, type Locale, verificationLabels } from '../i18n';
import { ACTIVE_CATEGORY_IDS, SITE } from '@utils/constants';

const { locale } = Astro.props as { locale: Locale };
const articles = await getLocalizedArticles(locale);
const latest = articles.slice(0, 12);
const lead = articles.find((article) => article.data.featured) || articles[0];
const supportingStories = latest.filter((article) => article.id !== lead?.id).slice(0, 4);
const topStoryIds = new Set([lead?.id, ...supportingStories.map((article) => article.id)].filter(Boolean));

const canonical = locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/` : `${SITE.url}/${lang}/`]),
);
const dateFormat = new Intl.DateTimeFormat(locale === 'bn' ? 'bn-IN' : locale === 'hi' ? 'hi-IN' : 'en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const route = (value = '') => {
  const path = localizedPath(locale, value);
  return locale === 'en' ? path.replace('/en/', '/') : path;
};

const categoryEntries = await Promise.all(
  ACTIVE_CATEGORY_IDS.map(async (id) => ({ id, category: await getCategoryData(id) })),
);
const categoryLabels = new Map(
  categoryEntries.map(({ id, category }) => [id, category ? categoryName(category, locale) : id]),
);
const categoryLabel = (categoryId: string) => categoryLabels.get(categoryId) || categoryId;
const articleDate = (article: (typeof articles)[number]) => dateFormat.format(article.data.updated || article.data.date);

const sectionNews = categoryEntries
  .map(({ id }) => {
    const categoryArticles = articles.filter((article) => article.data.category === id);
    const freshArticles = categoryArticles.filter((article) => !topStoryIds.has(article.id));
    return {
      id,
      label: categoryLabels.get(id) || id,
      articles: (freshArticles.length > 0 ? freshArticles : categoryArticles).slice(0, 3),
    };
  })
  .filter((section) => section.articles.length > 0);

const copy = {
  en: {
    metaTitle: 'Latest citizen news and verified government updates',
    description:
      'Latest government jobs, admissions, scholarships, welfare schemes and citizen-service news verified against official sources.',
    pageTitle: 'Latest news',
    leadLabel: 'Top story',
    latest: 'Latest',
    allNews: 'All news',
    sectionNews: 'More news',
    viewSection: 'View all',
    readStory: 'Read story',
    emptyTitle: 'No published stories yet',
    emptyBody: 'New verified reports will appear here after editorial review.',
  },
  bn: {
    metaTitle: 'সর্বশেষ নাগরিক সংবাদ ও যাচাইকৃত সরকারি আপডেট',
    description:
      'সরকারি চাকরি, ভর্তি, স্কলারশিপ, কল্যাণ প্রকল্প ও নাগরিক পরিষেবার সর্বশেষ যাচাইকৃত খবর।',
    pageTitle: 'সর্বশেষ খবর',
    leadLabel: 'প্রধান খবর',
    latest: 'সর্বশেষ',
    allNews: 'সব খবর',
    sectionNews: 'আরও খবর',
    viewSection: 'সব দেখুন',
    readStory: 'বিস্তারিত পড়ুন',
    emptyTitle: 'এখনও কোনো খবর প্রকাশিত হয়নি',
    emptyBody: 'সম্পাদকীয় যাচাইয়ের পর নতুন খবর এখানে প্রকাশিত হবে।',
  },
  hi: {
    metaTitle: 'नवीनतम नागरिक समाचार और सत्यापित सरकारी अपडेट',
    description:
      'सरकारी नौकरियों, प्रवेश, छात्रवृत्ति, कल्याण योजनाओं और नागरिक सेवाओं की नवीनतम सत्यापित खबरें।',
    pageTitle: 'ताज़ा खबरें',
    leadLabel: 'मुख्य खबर',
    latest: 'नवीनतम',
    allNews: 'सभी खबरें',
    sectionNews: 'और खबरें',
    viewSection: 'सभी देखें',
    readStory: 'पूरी खबर पढ़ें',
    emptyTitle: 'अभी कोई खबर प्रकाशित नहीं हुई',
    emptyBody: 'संपादकीय समीक्षा के बाद नई सत्यापित खबरें यहाँ दिखाई देंगी।',
  },
}[locale];
---

<MainLayout title={copy.metaTitle} description={copy.description} {locale} {canonical} {alternateUrls}>
  <main class="news-home">
    <h1 class="visually-hidden">{copy.pageTitle}</h1>

    <section class="top-news" aria-labelledby="latest-news-heading">
      <div class="container">
        <header class="section-title-row">
          <h2 id="latest-news-heading">{copy.pageTitle}</h2>
          <a href={route('articles')}>{copy.allNews}<Icon name="arrow" size={17} /></a>
        </header>

        {lead ? (
          <div class="top-stories-grid">
            <a
              class:list={['lead-story', { 'has-image': Boolean(lead.data.featuredImage) }]}
              href={route(`articles/${lead.data.urlSlug}`)}
            >
              <StoryImage article={lead} variant="lead" priority />
              <div class="lead-story-copy">
                <div class="story-kicker">
                  <strong>{copy.leadLabel}</strong>
                  <span>{categoryLabel(lead.data.category)}</span>
                </div>
                <h2>{lead.data.title}</h2>
                <p>{lead.data.description}</p>
                <div class="story-meta">
                  <span>{verificationLabels[locale][lead.data.verificationStatus]}</span>
                  <time datetime={(lead.data.updated || lead.data.date).toISOString()}>{articleDate(lead)}</time>
                  <strong>{copy.readStory}<Icon name="arrow" size={16} /></strong>
                </div>
              </div>
            </a>

            <aside class="latest-rail" aria-label={copy.latest}>
              <h2>{copy.latest}</h2>
              <div class="latest-rail-list">
                {supportingStories.map((article) => (
                  <a
                    class:list={['latest-rail-story', { 'has-image': Boolean(article.data.featuredImage) }]}
                    href={route(`articles/${article.data.urlSlug}`)}
                  >
                    <StoryImage article={article} variant="thumbnail" />
                    <div>
                      <span>{categoryLabel(article.data.category)}</span>
                      <h3>{article.data.title}</h3>
                      <time datetime={(article.data.updated || article.data.date).toISOString()}>{articleDate(article)}</time>
                    </div>
                  </a>
                ))}
              </div>
            </aside>
          </div>
        ) : (
          <div class="news-empty">
            <h2>{copy.emptyTitle}</h2>
            <p>{copy.emptyBody}</p>
          </div>
        )}
      </div>
    </section>

    {sectionNews.length > 0 && (
      <section class="news-sections" aria-labelledby="more-news-heading">
        <div class="container">
          <h2 id="more-news-heading" class="visually-hidden">{copy.sectionNews}</h2>

          <div class="news-section-list">
            {sectionNews.map((section) => (
              <section class="news-section-block">
                <header>
                  <h3>{section.label}</h3>
                  <a href={route(`categories/${section.id}`)}>{copy.viewSection}<Icon name="arrow" size={16} /></a>
                </header>

                <div class="section-story-grid">
                  {section.articles.map((article, index) => (
                    <a
                      class:list={[
                        'section-story',
                        { featured: index === 0, 'has-image': Boolean(article.data.featuredImage) },
                      ]}
                      href={route(`articles/${article.data.urlSlug}`)}
                    >
                      {index === 0 && article.data.featuredImage && (
                        <StoryImage article={article} variant="section" />
                      )}
                      <div class="section-story-copy">
                        <span>{verificationLabels[locale][article.data.verificationStatus]}</span>
                        <h4>{article.data.title}</h4>
                        {index === 0 && <p>{article.data.description}</p>}
                        <time datetime={(article.data.updated || article.data.date).toISOString()}>{articleDate(article)}</time>
                      </div>
                    </a>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</MainLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .news-home {
    --color-primary: #08756f;
    background: var(--color-bg);
  }

  :global(html[data-theme='dark']) .news-home {
    --color-primary: #70ddd1;
  }

  .top-news {
    padding: clamp(1.2rem, 3vw, 2.2rem) 0 clamp(2rem, 4vw, 3.5rem);
  }

  .section-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 4px solid var(--color-navy);
  }

  .section-title-row h2 {
    color: var(--color-text);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.15;
  }

  .section-title-row a,
  .news-section-block > header a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 850;
  }

  .top-stories-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(290px, 0.75fr);
    gap: 1rem;
    align-items: start;
  }

  .lead-story {
    display: flex;
    min-width: 0;
    min-height: 390px;
    overflow: hidden;
    flex-direction: column;
    justify-content: end;
    border-top: 5px solid var(--color-primary);
    background: var(--color-navy);
    color: #fff;
  }

  .lead-story.has-image {
    min-height: 0;
    border: 1px solid var(--color-border);
    border-top: 5px solid var(--color-primary);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .lead-story :global(.story-picture-lead) {
    border-bottom: 1px solid var(--color-border);
  }

  .lead-story-copy {
    display: flex;
    min-height: 390px;
    flex-direction: column;
    justify-content: end;
    padding: clamp(1.35rem, 3vw, 2.35rem);
  }

  .lead-story.has-image .lead-story-copy {
    min-height: 0;
  }

  .story-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.8rem;
    margin-bottom: auto;
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .story-kicker strong {
    color: #82e8dc;
  }

  .story-kicker span {
    color: rgba(255, 255, 255, 0.68);
  }

  .lead-story.has-image .story-kicker {
    margin-bottom: 0;
  }

  .lead-story.has-image .story-kicker strong {
    color: var(--color-primary);
  }

  .lead-story.has-image .story-kicker span {
    color: var(--color-text-muted);
  }

  .lead-story h2 {
    max-width: 20ch;
    margin-top: 2.2rem;
    color: #fff;
    font-size: clamp(2rem, 4vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .lead-story.has-image h2 {
    max-width: 25ch;
    margin-top: 0.65rem;
    color: var(--color-text);
    font-size: clamp(1.8rem, 3.3vw, 3rem);
  }

  .lead-story-copy > p {
    max-width: 68ch;
    margin-top: 0.85rem;
    color: rgba(255, 255, 255, 0.76);
    line-height: 1.55;
  }

  .lead-story.has-image .lead-story-copy > p {
    color: var(--color-text-muted);
  }

  .story-meta {
    display: flex;
    align-items: center;
    gap: 0.55rem 0.9rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.72rem;
  }

  .lead-story.has-image .story-meta {
    color: var(--color-text-muted);
  }

  .story-meta strong {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: auto;
    color: #fff;
  }

  .lead-story.has-image .story-meta strong {
    color: var(--color-primary);
  }

  .latest-rail {
    min-width: 0;
    border-top: 5px solid var(--color-navy);
    background: var(--color-surface);
  }

  .latest-rail > h2 {
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--color-border);
    border-top: 0;
    font-size: 1.1rem;
  }

  .latest-rail-list {
    border-inline: 1px solid var(--color-border);
  }

  .latest-rail-story {
    display: block;
    padding: 0.9rem;
    border-bottom: 1px solid var(--color-border);
  }

  .latest-rail-story.has-image {
    display: grid;
    grid-template-columns: minmax(96px, 34%) minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }

  .latest-rail-story :global(.story-picture-thumbnail) {
    border-radius: 3px;
  }

  .latest-rail-story span,
  .section-story-copy > span {
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 850;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .latest-rail-story h3 {
    margin: 0.28rem 0 0.5rem;
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .latest-rail-story time,
  .section-story time {
    color: var(--color-text-muted);
    font-size: 0.7rem;
  }

  .latest-rail-story:hover h3,
  .section-story:hover h4 {
    color: var(--color-primary);
  }

  .news-empty {
    padding: 3rem 1rem;
    border-block: 1px solid var(--color-border);
    text-align: center;
  }

  .news-empty p {
    margin-top: 0.35rem;
    color: var(--color-text-muted);
  }

  .news-sections {
    padding: 0 0 clamp(3rem, 6vw, 5rem);
  }

  .news-section-list {
    display: grid;
    gap: clamp(2rem, 5vw, 3.8rem);
  }

  .news-section-block {
    min-width: 0;
    padding-top: 0.85rem;
    border-top: 5px solid var(--color-navy);
  }

  .news-section-block > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .news-section-block > header h3 {
    color: var(--color-text);
    font-size: clamp(1.35rem, 2.8vw, 1.9rem);
  }

  .section-story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) repeat(2, minmax(0, 0.75fr));
    border-block: 1px solid var(--color-border);
  }

  .section-story {
    min-width: 0;
    padding: 1rem;
    border-right: 1px solid var(--color-border);
  }

  .section-story:last-child {
    border-right: 0;
  }

  .section-story.featured {
    padding: 0;
  }

  .section-story.featured .section-story-copy {
    padding: 1rem;
  }

  .section-story :global(.story-picture-section) {
    border-bottom: 1px solid var(--color-border);
  }

  .section-story h4 {
    margin: 0.32rem 0 0.55rem;
    font-size: 1.05rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .section-story.featured h4 {
    font-size: clamp(1.2rem, 2.3vw, 1.55rem);
  }

  .section-story p {
    margin-bottom: 0.65rem;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .top-stories-grid {
      grid-template-columns: 1fr;
    }

    .latest-rail-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .latest-rail-story:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }

    .section-story-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .section-story.featured {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
  }

  @media (max-width: 680px) {
    .top-news {
      padding-top: 0.9rem;
    }

    .section-title-row {
      margin-bottom: 0.75rem;
      padding-bottom: 0.55rem;
    }

    .section-title-row h2 {
      font-size: 1.45rem;
    }

    .lead-story {
      min-height: 310px;
    }

    .lead-story-copy {
      min-height: 310px;
      padding: 1rem;
    }

    .lead-story.has-image .lead-story-copy {
      min-height: 0;
    }

    .lead-story h2,
    .lead-story.has-image h2 {
      margin-top: 0.55rem;
      font-size: clamp(1.65rem, 7vw, 2.2rem);
      line-height: 1.12;
    }

    .lead-story-copy > p {
      margin-top: 0.65rem;
      font-size: 0.94rem;
    }

    .story-meta strong {
      width: 100%;
      margin-left: 0;
    }

    .latest-rail-list,
    .section-story-grid {
      grid-template-columns: 1fr;
    }

    .latest-rail-story:nth-child(odd),
    .section-story {
      border-right: 0;
    }

    .section-story {
      border-bottom: 1px solid var(--color-border);
    }

    .section-story:last-child {
      border-bottom: 0;
    }

    .section-story.featured {
      grid-column: auto;
    }

    .news-section-block > header {
      align-items: baseline;
    }
  }
</style>
