---
import MainLayout from '@layouts/MainLayout.astro';
import Icon from './Icon.astro';
import StoryImage from './StoryImage.astro';
import { categoryName, getCategoryData, getLocalizedArticles, getUpcomingDeadlines } from '@lib/content';
import { localizedPath, locales, type Locale, verificationLabels } from '../i18n';
import { ACTIVE_CATEGORY_IDS, SITE } from '@utils/constants';

const { locale } = Astro.props as { locale: Locale };
const articles = await getLocalizedArticles(locale);
const latest = articles.slice(0, 9);
const lead = articles.find((article) => article.data.featured) || articles[0];
const supportingStories = latest.filter((article) => article.id !== lead?.id).slice(0, 3);
const trending = latest.slice(0, 5);
const deadlines = await getUpcomingDeadlines(locale, 6);
const now = new Date();
const soon = deadlines.filter((article) => {
  const deadline = article.data.deadline;
  if (!deadline) return false;
  const days = Math.ceil((deadline.getTime() - now.getTime()) / 86400000);
  return days >= 0 && days <= 7;
});
const canonical = locale === 'en' ? `${SITE.url}/` : `${SITE.url}/${locale}/`;
const alternateUrls = Object.fromEntries(
  locales.map((lang) => [lang, lang === 'en' ? `${SITE.url}/` : `${SITE.url}/${lang}/`]),
);
const dateFormat = new Intl.DateTimeFormat(locale === 'bn' ? 'bn-IN' : locale === 'hi' ? 'hi-IN' : 'en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const route = (value = '') => {
  const path = localizedPath(locale, value);
  return locale === 'en' ? path.replace('/en/', '/') : path;
};
const categoryEntries = await Promise.all(
  ACTIVE_CATEGORY_IDS.map(async (id) => ({ id, category: await getCategoryData(id) })),
);
const categoryLabels = new Map(
  categoryEntries.map(({ id, category }) => [id, category ? categoryName(category, locale) : id]),
);
const sectionNews = categoryEntries.map(({ id }) => ({
  id,
  label: categoryLabels.get(id) || id,
  articles: articles.filter((article) => article.data.category === id).slice(0, 3),
}));
const categoryLabel = (categoryId: string) => categoryLabels.get(categoryId) || categoryId;
const articleDate = (article: (typeof articles)[number]) => dateFormat.format(article.data.updated || article.data.date);

const copy = {
  en: {
    metaTitle: 'Latest citizen news and verified government updates',
    title: 'Latest citizen news and verified updates',
    intro: 'Government jobs, education, welfare schemes, citizen services and public alerts—reviewed against official sources before publication.',
    eyebrow: 'Citizen Affairs newsroom',
    latest: 'Latest',
    leadLabel: 'Top story',
    readStory: 'Read full story',
    allUpdates: 'View all updates',
    trending: 'Trending now',
    trendingIntro: 'The newest verified stories across Citizen Affairs. This list is ordered by recency, not personal tracking.',
    sections: 'Latest from every section',
    sectionsIntro: 'Browse the newest published story in each division of the portal.',
    viewSection: 'View section',
    noSectionNews: 'No verified public story is available in this section yet.',
    deadlines: 'Closing soon',
    deadlineIntro: 'Applications and registrations that need attention within seven days.',
    allDeadlines: 'View all deadlines',
    trust: 'Official sources first',
    trustBody: 'Every published story displays its verification status, sources and last-checked date.',
    emptyTitle: 'Verified stories are being prepared',
    emptyBody: 'Published news will appear here after source review and protected approval.',
  },
  bn: {
    metaTitle: 'সর্বশেষ নাগরিক সংবাদ ও যাচাইকৃত সরকারি আপডেট',
    title: 'সর্বশেষ নাগরিক সংবাদ ও যাচাইকৃত আপডেট',
    intro: 'সরকারি চাকরি, শিক্ষা, কল্যাণ প্রকল্প, নাগরিক পরিষেবা ও জনসতর্কতা—প্রকাশের আগে অফিসিয়াল সূত্রে যাচাই করা হয়।',
    eyebrow: 'Citizen Affairs নিউজরুম',
    latest: 'সর্বশেষ',
    leadLabel: 'প্রধান খবর',
    readStory: 'পুরো খবর পড়ুন',
    allUpdates: 'সব আপডেট দেখুন',
    trending: 'ট্রেন্ডিং এখন',
    trendingIntro: 'Citizen Affairs-এর নতুন যাচাইকৃত খবর। তালিকাটি সাম্প্রতিকতার ভিত্তিতে সাজানো, ব্যক্তিগত tracking-এর ভিত্তিতে নয়।',
    sections: 'প্রতিটি বিভাগের সর্বশেষ খবর',
    sectionsIntro: 'পোর্টালের প্রতিটি বিভাগ থেকে সর্বশেষ প্রকাশিত যাচাইকৃত খবর দেখুন।',
    viewSection: 'বিভাগ দেখুন',
    noSectionNews: 'এই বিভাগে এখনও কোনো যাচাইকৃত প্রকাশিত খবর নেই।',
    deadlines: 'শিগগির শেষ হচ্ছে',
    deadlineIntro: 'সাত দিনের মধ্যে শেষ হতে পারে এমন আবেদন ও নিবন্ধন।',
    allDeadlines: 'সব শেষ তারিখ দেখুন',
    trust: 'অফিসিয়াল সূত্র আগে',
    trustBody: 'প্রতিটি প্রকাশিত খবরে যাচাইয়ের অবস্থা, সূত্র ও সর্বশেষ পরীক্ষার তারিখ দেখানো হয়।',
    emptyTitle: 'যাচাইকৃত খবর প্রস্তুত হচ্ছে',
    emptyBody: 'সূত্র যাচাই ও সুরক্ষিত অনুমোদনের পরে প্রকাশিত খবর এখানে দেখা যাবে।',
  },
  hi: {
    metaTitle: 'नवीनतम नागरिक समाचार और सत्यापित सरकारी अपडेट',
    title: 'नवीनतम नागरिक समाचार और सत्यापित अपडेट',
    intro: 'सरकारी नौकरियाँ, शिक्षा, कल्याण योजनाएँ, नागरिक सेवाएँ और सार्वजनिक अलर्ट—प्रकाशन से पहले आधिकारिक स्रोतों से जाँचे जाते हैं।',
    eyebrow: 'Citizen Affairs न्यूज़रूम',
    latest: 'नवीनतम',
    leadLabel: 'मुख्य समाचार',
    readStory: 'पूरी खबर पढ़ें',
    allUpdates: 'सभी अपडेट देखें',
    trending: 'अभी ट्रेंडिंग',
    trendingIntro: 'Citizen Affairs की नवीनतम सत्यापित खबरें। सूची हाल की तारीख के आधार पर है, व्यक्तिगत ट्रैकिंग पर नहीं।',
    sections: 'हर अनुभाग की नवीनतम खबर',
    sectionsIntro: 'पोर्टल के प्रत्येक अनुभाग से नवीनतम प्रकाशित सत्यापित खबर देखें।',
    viewSection: 'अनुभाग देखें',
    noSectionNews: 'इस अनुभाग में अभी कोई सत्यापित सार्वजनिक खबर उपलब्ध नहीं है।',
    deadlines: 'जल्द बंद होने वाले',
    deadlineIntro: 'सात दिनों के भीतर ध्यान देने योग्य आवेदन और पंजीकरण।',
    allDeadlines: 'सभी अंतिम तिथियाँ देखें',
    trust: 'पहले आधिकारिक स्रोत',
    trustBody: 'हर प्रकाशित खबर में सत्यापन स्थिति, स्रोत और अंतिम जाँच की तारीख दिखाई जाती है।',
    emptyTitle: 'सत्यापित खबरें तैयार की जा रही हैं',
    emptyBody: 'स्रोत समीक्षा और सुरक्षित स्वीकृति के बाद प्रकाशित खबरें यहाँ दिखाई देंगी।',
  },
}[locale];
---

<MainLayout title={copy.metaTitle} description={copy.intro} {locale} {canonical} {alternateUrls}>
  <section class="news-hero">
    <div class="container">
      <header class="news-masthead">
        <div>
          <p class="news-eyebrow"><Icon name="check" size={17} />{copy.eyebrow}</p>
          <h1>{copy.title}</h1>
          <p>{copy.intro}</p>
        </div>
        <a class="all-updates-link" href={route('articles')}>{copy.allUpdates}<Icon name="arrow" size={18} /></a>
      </header>

      {lead ? (
        <div class="top-stories-grid">
          <a
            class:list={['lead-story', { 'has-image': Boolean(lead.data.featuredImage) }]}
            href={route(`articles/${lead.data.urlSlug}`)}
          >
            <StoryImage article={lead} variant="lead" priority />
            <div class="lead-story-copy">
              <div class="story-context">
                <span>{copy.leadLabel}</span>
                <span>{categoryLabel(lead.data.category)}</span>
              </div>
              <h2>{lead.data.title}</h2>
              <p>{lead.data.description}</p>
              <div class="story-meta">
                <span>{verificationLabels[locale][lead.data.verificationStatus]}</span>
                <time>{articleDate(lead)}</time>
                <strong>{copy.readStory}<Icon name="arrow" size={17} /></strong>
              </div>
            </div>
          </a>

          <div class="supporting-stories" aria-label={copy.latest}>
            <h2>{copy.latest}</h2>
            {supportingStories.map((article) => (
              <a
                class:list={['supporting-story', { 'has-image': Boolean(article.data.featuredImage) }]}
                href={route(`articles/${article.data.urlSlug}`)}
              >
                <StoryImage article={article} variant="thumbnail" />
                <div class="supporting-story-copy">
                  <span>{categoryLabel(article.data.category)}</span>
                  <h3>{article.data.title}</h3>
                  <time>{articleDate(article)}</time>
                </div>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <div class="news-empty">
          <Icon name="updates" size={44} />
          <h2>{copy.emptyTitle}</h2>
          <p>{copy.emptyBody}</p>
        </div>
      )}
    </div>
  </section>

  {trending.length > 0 && (
    <section class="trending-section">
      <div class="container trending-layout">
        <header>
          <span>{copy.trending}</span>
          <h2>{copy.trending}</h2>
          <p>{copy.trendingIntro}</p>
        </header>
        <ol class="trending-list">
          {trending.map((article, index) => (
            <li>
              <a href={route(`articles/${article.data.urlSlug}`)}>
                <span class="trend-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="trend-copy">
                  <small>{categoryLabel(article.data.category)}</small>
                  <strong>{article.data.title}</strong>
                </span>
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="section-news">
    <div class="container">
      <header class="section-heading">
        <span>{copy.sections}</span>
        <h2>{copy.sections}</h2>
        <p>{copy.sectionsIntro}</p>
      </header>
      <div class="section-news-grid">
        {sectionNews.map((section) => (
          <section class="section-news-block">
            <header>
              <h3>{section.label}</h3>
              <a href={route(`categories/${section.id}`)}>{copy.viewSection}<Icon name="arrow" size={16} /></a>
            </header>
            {section.articles.length > 0 ? (
              <div class="section-story-list">
                {section.articles.map((article, index) => (
                  <a class:list={['section-story', { primary: index === 0 }]} href={route(`articles/${article.data.urlSlug}`)}>
                    {index === 0 && article.id !== lead?.id && article.data.featuredImage && (
                      <StoryImage article={article} variant="section" />
                    )}
                    <div class="section-story-copy">
                      <span>{verificationLabels[locale][article.data.verificationStatus]}</span>
                      <h4>{article.data.title}</h4>
                      {index === 0 && <p>{article.data.description}</p>}
                      <time>{articleDate(article)}</time>
                    </div>
                  </a>
                ))}
              </div>
            ) : (
              <div class="section-empty">
                <Icon name="updates" size={23} />
                <p>{copy.noSectionNews}</p>
              </div>
            )}
          </section>
        ))}
      </div>
    </div>
  </section>

  {soon.length > 0 && (
    <section class="deadline-section">
      <div class="container">
        <header class="deadline-heading">
          <div><span>{copy.deadlines}</span><h2>{copy.deadlines}</h2><p>{copy.deadlineIntro}</p></div>
          <a href={route('deadlines')}>{copy.allDeadlines}<Icon name="arrow" size={18} /></a>
        </header>
        <div class="deadline-list">
          {soon.map((article) => (
            <a href={route(`articles/${article.data.urlSlug}`)}>
              <div><strong>{article.data.title}</strong><small>{article.data.description}</small></div>
              <time>{article.data.deadline && dateFormat.format(article.data.deadline)}</time>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="news-trust">
    <div class="container">
      <Icon name="check" size={24} />
      <div><strong>{copy.trust}</strong><p>{copy.trustBody}</p></div>
    </div>
  </section>
</MainLayout>

<style>
  .news-hero {
    padding: clamp(1.75rem, 4vw, 3.5rem) 0;
    border-bottom: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-surface), var(--color-bg));
  }

  .news-masthead {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: clamp(1.25rem, 3vw, 2.25rem);
  }

  .news-masthead > div {
    min-width: 0;
  }

  .news-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.65rem;
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }

  .news-masthead h1 {
    max-width: 18ch;
    color: var(--color-navy);
    font-size: clamp(2.15rem, 5vw, 4.3rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .news-masthead > div > p:last-child {
    max-width: 70ch;
    margin-top: 0.85rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 1rem + 0.25vw, 1.18rem);
    line-height: 1.6;
  }

  .all-updates-link,
  .deadline-heading > a {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primary);
    font-size: 0.83rem;
    font-weight: 850;
  }

  .top-stories-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(300px, 0.75fr);
    gap: 1rem;
    align-items: start;
  }

  .lead-story {
    display: flex;
    min-width: 0;
    min-height: 390px;
    overflow: hidden;
    flex-direction: column;
    justify-content: end;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: linear-gradient(145deg, var(--color-navy), #133866);
    color: #fff;
    box-shadow: var(--shadow-lg);
  }

  .lead-story.has-image {
    min-height: 0;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .lead-story :global(.story-picture-lead) {
    border-bottom: 1px solid var(--color-border);
  }

  .lead-story-copy {
    display: flex;
    min-height: 390px;
    flex-direction: column;
    justify-content: end;
    padding: clamp(1.4rem, 4vw, 3rem);
  }

  .lead-story.has-image .lead-story-copy {
    min-height: 0;
    padding: clamp(1.15rem, 3vw, 2rem);
  }

  .story-context {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin-bottom: auto;
    color: #89e8dd;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .lead-story.has-image .story-context {
    margin-bottom: 0;
    color: var(--color-primary);
  }

  .story-context span + span {
    color: rgba(255, 255, 255, 0.72);
  }

  .lead-story.has-image .story-context span + span {
    color: var(--color-text-muted);
  }

  .lead-story h2 {
    max-width: 19ch;
    margin-top: 2.5rem;
    color: #fff;
    font-size: clamp(2rem, 4.4vw, 4rem);
    line-height: 1.06;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .lead-story.has-image h2 {
    max-width: 24ch;
    margin-top: 0.65rem;
    color: var(--color-navy);
    font-size: clamp(1.8rem, 3.4vw, 3.25rem);
  }

  .lead-story-copy > p {
    max-width: 64ch;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.6;
  }

  .lead-story.has-image .lead-story-copy > p {
    color: var(--color-text-muted);
  }

  .story-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem 1rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.76rem;
  }

  .lead-story.has-image .story-meta {
    color: var(--color-text-muted);
  }

  .story-meta strong {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
    color: #fff;
  }

  .lead-story.has-image .story-meta strong {
    color: var(--color-primary);
  }

  .supporting-stories {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
  }

  .supporting-stories > h2 {
    padding: 0.9rem 1rem;
    border-bottom: 4px solid var(--color-primary);
    font-size: 1.15rem;
  }

  .supporting-story {
    display: block;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .supporting-story.has-image {
    display: grid;
    grid-template-columns: minmax(96px, 34%) minmax(0, 1fr);
    align-items: start;
    gap: 0.85rem;
  }

  .supporting-story :global(.story-picture-thumbnail) {
    border-radius: 6px;
  }

  .supporting-story:last-child {
    border-bottom: 0;
  }

  .supporting-story:hover h3 {
    color: var(--color-primary);
  }

  .supporting-story span,
  .section-story-copy > span {
    color: var(--color-primary);
    font-size: 0.67rem;
    font-weight: 850;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  .supporting-story h3 {
    margin: 0.35rem 0 0.65rem;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .supporting-story time,
  .section-story time {
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .news-empty {
    padding: 3rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    text-align: center;
  }

  .news-empty h2 {
    margin: 0.7rem 0 0.35rem;
  }

  .news-empty p {
    color: var(--color-text-muted);
  }

  .trending-section {
    padding: clamp(2.75rem, 5vw, 4.5rem) 0;
    background: var(--color-navy);
    color: #fff;
  }

  .trending-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.55fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .trending-layout > header > span,
  .section-heading > span,
  .deadline-heading span {
    color: var(--color-primary);
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .trending-layout > header > span {
    color: #7ce4d7;
  }

  .trending-layout h2 {
    margin: 0.4rem 0 0.8rem;
    color: #fff;
    font-size: clamp(1.9rem, 3vw, 2.8rem);
  }

  .trending-layout header p {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  .trending-list {
    list-style: none;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .trending-list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .trending-list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-height: 86px;
    color: #fff;
  }

  .trend-number {
    color: #7ce4d7;
