const jobs = articles.filter((article) => article.data.contentType === 'job' && article.data.job);
const formatter = new Intl.DateTimeFormat(locale === 'bn' ? 'bn-BD' : locale === 'hi' ? 'hi-IN' : 'en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<section
  class="jobs-page"
  data-jobs-portal
  data-result-pattern={copy.resultPattern}
  data-no-match={copy.noMatch}
>
  <main class="container jobs-main">
    <section class="jobs-listing" aria-labelledby="jobs-page-title">
      <div class="jobs-controls">
        <label class="jobs-search">
          <span class="sr-only">{copy.searchLabel}</span>
          <Icon name="search" size={18} />
          <input type="search" placeholder={copy.searchPlaceholder} autocomplete="off" data-job-search />
        </label>

        <details class="jobs-filter-details" data-job-filter-details>
          <summary data-job-filter-trigger>
            <Icon name="filter" size={18} class="jobs-filter-icon" />
            {copy.filters}
            <span data-active-filter-count hidden>0</span>
          </summary>
          <div class="jobs-filter-panel">
            <label>
              <span>{copy.qualification}</span>
              <select data-job-filter="qualification">
                <option value="all">{copy.allQualifications}</option>
                {Object.entries(copy.qualificationOptions).map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </label>
            <label>
              <span>{copy.sector}</span>
              <select data-job-filter="sector">
                <option value="all">{copy.allSectors}</option>
                {Object.entries(copy.sectorOptions).map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </label>
            <label>
              <span>{copy.governmentLevel}</span>
              <select data-job-filter="level">
                <option value="all">{copy.allLevels}</option>
                <option value="central">{copy.centralOption}</option>
                <option value="state">{copy.stateOption}</option>
              </select>
            </label>
            <label>
              <span>{copy.status}</span>
              <select data-job-filter="status">
                <option value="all">{copy.allStatuses}</option>
                <option value="open">{copy.openOption}</option>
                <option value="closing-soon">{copy.closingOption}</option>
                <option value="upcoming">{copy.upcomingOption}</option>
                <option value="closed">{copy.closedOption}</option>
              </select>
            </label>
            <label>
              <span>{copy.sort}</span>
              <select data-job-sort>
                <option value="newest">{copy.newestSort}</option>
                <option value="deadline">{copy.deadlineSort}</option>
                <option value="vacancies">{copy.vacancySort}</option>
              </select>
            </label>
            <button type="button" data-job-reset>{copy.reset}</button>
          </div>
        </details>
      </div>

      <div class="jobs-stage-tabs" role="group" aria-label={copy.allStages}>
        <button type="button" data-job-stage="application" aria-pressed="true">{copy.applications}</button>
        <button type="button" data-job-stage="admit-card" aria-pressed="false">{copy.admitCards}</button>
        <button type="button" data-job-stage="answer-key" aria-pressed="false">{copy.answerKeys}</button>
        <button type="button" data-job-stage="result" aria-pressed="false">{copy.results}</button>
        <button type="button" data-job-stage="all" aria-pressed="false">{copy.allStages}</button>
      </div>

      <div class="jobs-result-line">
        <h1 id="jobs-page-title">{name}</h1>
        <p data-job-result-count aria-live="polite">{copy.resultPattern.replace('{count}', String(jobs.length))}</p>
      </div>

      {jobs.length > 0 ? (
        <>
          <div class="jobs-results" data-job-results>
            {jobs.map((article) => {
              const job = article.data.job!;
              const level = article.data.governmentLevel === 'central' ? 'central' : 'state';
              const searchable = [
                article.data.title,
                article.data.description,
                job.postName,
                job.recruitingOrganization,
                job.notificationNumber,
                ...job.qualification,
                ...job.jobLocation,
              ].join(' ').toLocaleLowerCase(locale);
              const employerLabel = copy.employerOptions[job.employerType];
              return (
                <article
                  class="jobs-result"
                  data-job-card
                  data-stage={job.recruitmentStage}
                  data-qualification={job.qualificationLevel.join('|')}
                  data-sector={job.recruitmentSector}
                  data-level={level}
                  data-status={job.recruitmentStatus}
                  data-search={searchable}
                  data-newest={(article.data.updated || article.data.date).getTime()}
                  data-deadline={job.applicationDeadline.getTime()}
                  data-vacancies={job.totalVacancies}
                >
                  <div class="jobs-result-meta">
                    <span><Icon name="briefcase" size={13} />{job.recruitingOrganization}</span>
                    <span>{copy.notification}: {job.notificationNumber}</span>
                    <span>{copy.employerType}: {employerLabel}</span>
                    <span>{formatter.format(job.applicationDeadline)}</span>
                  </div>
                  <ArticleCard {article} {locale} compact />
                </article>
              );
            })}
          </div>
          <div class="jobs-no-match" data-job-no-match hidden>
            <Icon name="search" size={24} />
            <p>{copy.noMatch}</p>
            <button type="button" data-job-reset>{copy.reset}</button>
          </div>
        </>
      ) : (
        <div class="jobs-empty">
          <Icon name="briefcase" size={28} />
          <h2>{copy.emptyTitle}</h2>
          <p>{copy.emptyBody}</p>
        </div>
      )}
    </section>

    <details class="jobs-trust-note">
      <summary><Icon name="check" size={16} />{copy.trustSummary}</summary>
      <div>
        <p><strong>{copy.promise}</strong> — {copy.promiseBody}</p>
        <span><Icon name="check" size={14} />{copy.privateBlocked}</span>
        <a href={route('editorial-policy')}>{copy.policy}<Icon name="arrow" size={14} /></a>
      </div>
    </details>
  </main>
</section>

<script>
  const portal = document.querySelector<HTMLElement>('[data-jobs-portal]');
  const search = portal?.querySelector<HTMLInputElement>('[data-job-search]');
  const filters = [...(portal?.querySelectorAll<HTMLSelectElement>('[data-job-filter]') || [])];
  const sort = portal?.querySelector<HTMLSelectElement>('[data-job-sort]');
  const stageButtons = [...(portal?.querySelectorAll<HTMLButtonElement>('[data-job-stage]') || [])];
  const cards = [...(portal?.querySelectorAll<HTMLElement>('[data-job-card]') || [])];
  const results = portal?.querySelector<HTMLElement>('[data-job-results]');
  const resultCount = portal?.querySelector<HTMLElement>('[data-job-result-count]');
  const noMatch = portal?.querySelector<HTMLElement>('[data-job-no-match]');
  const activeFilterCount = portal?.querySelector<HTMLElement>('[data-active-filter-count]');
  const resetButtons = [...(portal?.querySelectorAll<HTMLButtonElement>('[data-job-reset]') || [])];
  let activeStage = 'application';

  const numeric = (card: HTMLElement, key: 'newest' | 'deadline' | 'vacancies') => Number(card.dataset[key] || 0);

  const applyFilters = () => {
    const query = search?.value.trim().toLocaleLowerCase() || '';
    const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.jobFilter || '', filter.value]));
    let visibleCount = 0;

    cards.forEach((card) => {
      const stageMatches = activeStage === 'all' || card.dataset.stage === activeStage;
      const searchMatches = !query || (card.dataset.search || '').includes(query);
      const qualificationMatches = selected.qualification === 'all' || (card.dataset.qualification || '').split('|').includes(selected.qualification);
      const sectorMatches = selected.sector === 'all' || card.dataset.sector === selected.sector;
      const levelMatches = selected.level === 'all' || card.dataset.level === selected.level;
      const statusMatches = selected.status === 'all' || card.dataset.status === selected.status;
      const visible = stageMatches && searchMatches && qualificationMatches && sectorMatches && levelMatches && statusMatches;
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    const sortMode = sort?.value || 'newest';
    const sortedCards = [...cards].sort((a, b) => {
      if (sortMode === 'deadline') return numeric(a, 'deadline') - numeric(b, 'deadline');
      if (sortMode === 'vacancies') return numeric(b, 'vacancies') - numeric(a, 'vacancies');
      return numeric(b, 'newest') - numeric(a, 'newest');
    });
    sortedCards.forEach((card) => results?.append(card));

    const pattern = portal?.dataset.resultPattern || '{count}';
    if (resultCount) resultCount.textContent = pattern.replace('{count}', String(visibleCount));
    if (noMatch) noMatch.hidden = visibleCount !== 0;

    const filterCount = filters.filter((filter) => filter.value !== 'all').length + (query ? 1 : 0);
    if (activeFilterCount) {
      activeFilterCount.textContent = String(filterCount);
      activeFilterCount.hidden = filterCount === 0;
    }
  };

  stageButtons.forEach((button) => {
    button.addEventListener('click', () => {
      activeStage = button.dataset.jobStage || 'application';
      stageButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      applyFilters();
    });
  });

  search?.addEventListener('input', applyFilters);
  filters.forEach((filter) => filter.addEventListener('change', applyFilters));
  sort?.addEventListener('change', applyFilters);
  resetButtons.forEach((button) => {
    button.addEventListener('click', () => {
      if (search) search.value = '';
      filters.forEach((filter) => { filter.value = 'all'; });
      if (sort) sort.value = 'newest';
      activeStage = 'application';
      stageButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.jobStage === 'application')));
      applyFilters();
    });
  });

  applyFilters();
</script>

