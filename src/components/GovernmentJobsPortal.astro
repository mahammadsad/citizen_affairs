const jobArticles = articles.filter((article) =>
  article.data.contentType === 'job' &&
  Boolean(article.data.job) &&
  !['withdrawn', 'cancelled'].includes(article.data.job?.recruitmentStatus || '')
);
const guideArticles = articles.filter((article) => article.data.contentType !== 'job' || !article.data.job);
const openStatuses = new Set(['open', 'closing-soon']);
const openCount = jobArticles.filter((article) => openStatuses.has(article.data.job!.recruitmentStatus)).length;
const closingCount = jobArticles.filter((article) => article.data.job!.recruitmentStatus === 'closing-soon').length;
const centralCount = jobArticles.filter((article) => article.data.governmentLevel === 'central').length;
const stateCount = jobArticles.length - centralCount;
const officialCount = jobArticles.filter((article) => article.data.verificationStatus === 'officially-confirmed').length;
const qualificationEntries = Object.entries(copy.qualificationOptions);
const sectorEntries = Object.entries(copy.sectorOptions);
---

<section class="government-jobs" data-government-jobs data-result-pattern={copy.resultPattern}>
  <header class="jobs-hero">
    <div class="container jobs-hero-grid">
      <div class="jobs-hero-copy">
        <a class="jobs-back" href={route('categories')}><Icon name="arrow" size={17} />{copy.back}</a>
        <p class="jobs-kicker"><Icon name="briefcase" size={18} />{copy.kicker}</p>
        <h1>{name}</h1>
        <p class="jobs-description">{description}</p>
        <div class="jobs-boundary">
          <Icon name="check" size={20} />
          <div><strong>{copy.promise}</strong><span>{copy.promiseBody}</span></div>
        </div>
      </div>

      <aside class="jobs-trust" aria-labelledby="jobs-trust-title">
        <p class="jobs-trust-label"><Icon name="check" size={15} />{copy.verified}</p>
        <h2 id="jobs-trust-title">{copy.accepted}</h2>
        <ul>{copy.acceptedItems.map((item) => <li>{item}</li>)}</ul>
        <p class="jobs-private-block"><Icon name="notices" size={17} />{copy.privateBlocked}</p>
        <div class="jobs-trust-actions">
          <a href={route('deadlines')}>{copy.deadlines}<Icon name="arrow" size={16} /></a>
          <a href={route('editorial-policy')}>{copy.policy}<Icon name="arrow" size={16} /></a>
        </div>
      </aside>
    </div>
  </header>

  <div class="container jobs-summary" aria-label={copy.total}>
    <div><strong>{jobArticles.length}</strong><span>{copy.total}</span></div>
    <div><strong>{openCount}</strong><span>{copy.open}</span></div>
    <div><strong>{closingCount}</strong><span>{copy.closing}</span></div>
    <div><strong>{centralCount}</strong><span>{copy.central}</span></div>
    <div><strong>{stateCount}</strong><span>{copy.state}</span></div>
  </div>

  <main class="container jobs-main">
    <section class="jobs-discovery" aria-labelledby="jobs-discovery-title">
      <div class="jobs-discovery-heading">
        <div>
          <p>{copy.verified}: {officialCount}/{jobArticles.length}</p>
          <h2 id="jobs-discovery-title">{copy.browseTitle}</h2>
          <span>{copy.browseBody}</span>
        </div>
      </div>

      <div class="jobs-stage-tabs" role="group" aria-label={copy.browseTitle}>
        <button type="button" data-job-stage="all" aria-pressed="true">{copy.allStages}</button>
        <button type="button" data-job-stage="application" aria-pressed="false">{copy.applications}</button>
        <button type="button" data-job-stage="admit-card" aria-pressed="false">{copy.admitCards}</button>
        <button type="button" data-job-stage="answer-key" aria-pressed="false">{copy.answerKeys}</button>
        <button type="button" data-job-stage="result" aria-pressed="false">{copy.results}</button>
      </div>

      <div class="jobs-filter-panel">
        <label class="jobs-search">
          <span>{copy.searchLabel}</span>
          <span class="jobs-search-control"><Icon name="search" size={18} /><input type="search" data-job-search placeholder={copy.searchPlaceholder} autocomplete="off" /></span>
        </label>

        <div class="jobs-select-grid">
          <label><span>{copy.qualification}</span><select data-job-filter="qualification"><option value="">{copy.allQualifications}</option>{qualificationEntries.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
          <label><span>{copy.sector}</span><select data-job-filter="sector"><option value="">{copy.allSectors}</option>{sectorEntries.map(([value, label]) => <option value={value}>{label}</option>)}</select></label>
          <label><span>{copy.governmentLevel}</span><select data-job-filter="level"><option value="">{copy.allLevels}</option><option value="central">{copy.centralOption}</option><option value="state">{copy.stateOption}</option></select></label>
          <label><span>{copy.status}</span><select data-job-filter="status"><option value="">{copy.allStatuses}</option><option value="open">{copy.openOption}</option><option value="closing-soon">{copy.closingOption}</option><option value="upcoming">{copy.upcomingOption}</option><option value="closed">{copy.closedOption}</option></select></label>
          <label><span>{copy.sort}</span><select data-job-sort><option value="deadline">{copy.deadlineSort}</option><option value="newest">{copy.newestSort}</option><option value="vacancies">{copy.vacancySort}</option></select></label>
          <button class="jobs-reset" type="button" data-job-reset>{copy.reset}</button>
        </div>
      </div>

      <div class="jobs-results-bar">
        <p data-job-result-count aria-live="polite">{copy.resultPattern.replace('{count}', String(jobArticles.length))}</p>
      </div>

      {jobArticles.length > 0 ? (
        <>
          <div class="jobs-results" data-job-results>
            {jobArticles.map((article) => {
              const job = article.data.job!;
              const level = article.data.governmentLevel === 'central' ? 'central' : 'state';
              const searchText = [article.data.title, article.data.description, job.recruitingOrganization, job.postName, job.notificationNumber, job.department, ...job.qualification, ...job.jobLocation].filter(Boolean).join(' ').toLocaleLowerCase();
              return (
                <div
                  class="jobs-result-card"
                  data-job-card
                  data-search={searchText}
                  data-stage={job.recruitmentStage}
                  data-qualification={job.qualificationLevel.join(' ')}
                  data-sector={job.recruitmentSector}
                  data-level={level}
                  data-status={job.recruitmentStatus}
                  data-deadline={String(job.applicationDeadline.getTime())}
                  data-newest={String((article.data.updated || article.data.date).getTime())}
                  data-vacancies={String(job.totalVacancies)}
                >
                  <div class="jobs-card-identity">
                    <span><strong>{job.recruitingOrganization}</strong></span>
                    <span>{copy.notification}: {job.notificationNumber}</span>
                    <span>{copy.employerType}: {copy.employerOptions[job.employerType]}</span>
                  </div>
                  <ArticleCard {article} {locale} />
                </div>
              );
            })}
          </div>
          <p class="jobs-no-match" data-job-no-match hidden>{copy.noMatch}</p>
        </>
      ) : (
        <section class="jobs-empty" aria-labelledby="jobs-empty-title">
          <Icon name="briefcase" size={32} />
          <h2 id="jobs-empty-title">{copy.emptyTitle}</h2>
          <p>{copy.emptyBody}</p>
          <div><a href={route('deadlines')}>{copy.deadlines}<Icon name="arrow" size={16} /></a><a href={route('editorial-policy')}>{copy.policy}<Icon name="arrow" size={16} /></a></div>
        </section>
      )}
    </section>

    {guideArticles.length > 0 && (
      <section class="jobs-guides" aria-labelledby="jobs-guides-title">
        <div><p>{copy.verified}</p><h2 id="jobs-guides-title">{copy.guidesTitle}</h2><span>{copy.guideBody}</span></div>
        <div class="jobs-guide-grid">{guideArticles.map((article) => <ArticleCard {article} {locale} compact />)}</div>
      </section>
    )}
  </main>
</section>

<script>
  const portal = document.querySelector<HTMLElement>('[data-government-jobs]');
  if (portal) {
    const stageButtons = [...portal.querySelectorAll<HTMLButtonElement>('[data-job-stage]')];
    const search = portal.querySelector<HTMLInputElement>('[data-job-search]');
    const filters = [...portal.querySelectorAll<HTMLSelectElement>('[data-job-filter]')];
    const sort = portal.querySelector<HTMLSelectElement>('[data-job-sort]');
    const reset = portal.querySelector<HTMLButtonElement>('[data-job-reset]');
    const results = portal.querySelector<HTMLElement>('[data-job-results]');
    const cards = [...portal.querySelectorAll<HTMLElement>('[data-job-card]')];
    const count = portal.querySelector<HTMLElement>('[data-job-result-count]');
    const noMatch = portal.querySelector<HTMLElement>('[data-job-no-match]');
    const pattern = portal.dataset.resultPattern || '{count}';
    let activeStage = 'all';

    const apply = () => {
      const query = search?.value.trim().toLocaleLowerCase() || '';
      const selected = Object.fromEntries(filters.map((filter) => [filter.dataset.jobFilter || '', filter.value]));
      let visibleCount = 0;

      cards.forEach((card) => {
        const matchesSearch = !query || (card.dataset.search || '').includes(query);
        const matchesStage = activeStage === 'all' || card.dataset.stage === activeStage;
        const matchesQualification = !selected.qualification || (card.dataset.qualification || '').split(' ').includes(selected.qualification);
        const matchesSector = !selected.sector || card.dataset.sector === selected.sector;
        const matchesLevel = !selected.level || card.dataset.level === selected.level;
        const matchesStatus = !selected.status || card.dataset.status === selected.status;
        const visible = matchesSearch && matchesStage && matchesQualification && matchesSector && matchesLevel && matchesStatus;
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (results && sort) {
        const direction = sort.value === 'deadline' ? 1 : -1;
        const field = sort.value === 'deadline' ? 'deadline' : sort.value === 'vacancies' ? 'vacancies' : 'newest';
        [...cards]
          .sort((a, b) => direction * (Number(a.dataset[field] || 0) - Number(b.dataset[field] || 0)))
          .forEach((card) => results.append(card));
      }

      if (count) count.textContent = pattern.replace('{count}', String(visibleCount));
      if (noMatch) noMatch.hidden = visibleCount !== 0;
    };

    stageButtons.forEach((button) => button.addEventListener('click', () => {
      activeStage = button.dataset.jobStage || 'all';
      stageButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      apply();
    }));
    search?.addEventListener('input', apply);
    filters.forEach((filter) => filter.addEventListener('change', apply));
    sort?.addEventListener('change', apply);
    reset?.addEventListener('click', () => {
      activeStage = 'all';
      stageButtons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === 0)));
      if (search) search.value = '';
      filters.forEach((filter) => { filter.value = ''; });
      if (sort) sort.value = 'deadline';
      apply();
      search?.focus();
    });
    apply();
  }
</script>

