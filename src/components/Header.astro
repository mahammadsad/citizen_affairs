---
import { SITE } from '@utils/constants';
import SearchOverlay from './SearchOverlay.astro';
import type { Locale } from '../i18n';
import { localizedPath, replaceLocale, ui } from '../i18n';

interface Props {
  locale: Locale;
  languageSwitchUrl?: string;
}

const { locale, languageSwitchUrl } = Astro.props;
const t = ui(locale);
const otherLocale: Locale = locale === 'en' ? 'bn' : 'en';
const switchUrl = languageSwitchUrl || replaceLocale(Astro.url.pathname, otherLocale);
const brandName = locale === 'bn' ? SITE.name : SITE.nameEn;
const brandTagline = locale === 'bn' ? SITE.tagline : SITE.taglineEn;
---

<header class="site-header">
  <nav class="navbar container" aria-label={locale === 'bn' ? 'প্রধান নেভিগেশন' : 'Primary navigation'}>
    <a href={localizedPath(locale)} class="brand" aria-label={`${brandName} — ${t.home}`}>
      <img src={`${SITE.basePath}assets/logo-mark.svg`} alt="" class="brand-logo" width="44" height="44" />
      <span class="brand-text">
        <span class="brand-name">{brandName}</span>
        <span class="brand-tagline">{brandTagline}</span>
      </span>
    </a>

    <ul class="nav-links">
      <li><a href={localizedPath(locale)}>{t.home}</a></li>
      <li><a href={localizedPath(locale, 'articles')}>{t.articles}</a></li>
      <li><a href={localizedPath(locale, 'categories')}>{t.categories}</a></li>
      <li><a href={`${localizedPath(locale)}#community`}>{t.community}</a></li>
      <li><a href={`${localizedPath(locale)}#contact`}>{t.contact}</a></li>
    </ul>

    <div class="nav-actions">
      <a class="language-toggle" href={switchUrl} lang={otherLocale} hreflang={otherLocale}>
        <span aria-hidden="true">文</span> {t.switchLanguage}
      </a>
      <button class="icon-btn" id="searchToggle" aria-label={t.search} aria-haspopup="dialog">
        <svg class="icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
      </button>
      <button class="icon-btn" id="themeToggle" aria-label={locale === 'bn' ? 'থিম পরিবর্তন করুন' : 'Change colour theme'} aria-pressed="false">
        <svg class="icon" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9c0-.5 0-1-.1-1.5A7 7 0 0 1 12 3Z"/></svg>
      </button>
      <button class="icon-btn menu-toggle" id="menuToggle" aria-label={locale === 'bn' ? 'মেনু খুলুন' : 'Open menu'} aria-expanded="false" aria-controls="mobileMenu">
        <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>

  <div class="trust-strip">
    <div class="container trust-strip-inner">
      <strong>{locale === 'bn' ? 'তথ্য যাচাই নীতি' : 'Verification policy'}</strong>
      <span>•</span>
      <span>{locale === 'bn' ? 'Official source → Fact check → সহজ ব্যাখ্যা → Update tracking' : 'Official source → Fact check → Clear explanation → Update tracking'}</span>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <ul>
    <li><a href={localizedPath(locale)}>{t.home}</a></li>
    <li><a href={localizedPath(locale, 'articles')}>{t.articles}</a></li>
    <li><a href={localizedPath(locale, 'categories')}>{t.categories}</a></li>
    <li><a href={`${localizedPath(locale)}#community`}>{t.community}</a></li>
    <li><a href={`${localizedPath(locale)}#contact`}>{t.contact}</a></li>
  </ul>
  <a class="language-toggle mobile-language" href={switchUrl} lang={otherLocale} hreflang={otherLocale}>{t.switchLanguage}</a>
</div>

<SearchOverlay {locale} />

<script>
  const root = document.documentElement;
  const themeToggle = document.getElementById('themeToggle');
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');

  themeToggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    themeToggle.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
    try { localStorage.setItem('theme', next); } catch (_) {}
  });

  function closeMenu() {
    mobileMenu?.classList.remove('is-open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    menuToggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', () => {
    const open = !mobileMenu?.classList.contains('is-open');
    mobileMenu?.classList.toggle('is-open', open);
    mobileMenu?.setAttribute('aria-hidden', open ? 'false' : 'true');
    menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.style.overflow = open ? 'hidden' : '';
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));

  const revealEls = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window && revealEls.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: .08 });
    revealEls.forEach((el) => observer.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }
</script>

<style>
  .language-toggle { display:inline-flex; align-items:center; gap:.45rem; min-height:42px; padding:.55rem .85rem; border:1px solid var(--color-border); border-radius:var(--radius-pill); color:var(--color-primary); background:var(--color-surface); font-weight:700; font-size:.86rem; }
  .trust-strip { border-top:1px solid var(--color-border); background:linear-gradient(90deg, rgba(var(--color-green-rgb),.09), rgba(var(--color-primary-rgb),.06)); }
  .trust-strip-inner { min-height:38px; display:flex; align-items:center; gap:.65rem; font-size:.78rem; color:var(--color-text-muted); white-space:nowrap; overflow:hidden; }
  .trust-strip strong { color:var(--color-green-text); }
  .mobile-language { justify-content:center; margin-top:1rem; }
  @media (max-width: 760px) { .nav-actions > .language-toggle { display:none; } }
</style>
