---
import { getCollection } from 'astro:content';
import { categoryName } from '@lib/content';
import { ACTIVE_CATEGORY_IDS, getBrandName, SITE } from '@utils/constants';
import SearchOverlay from './SearchOverlay.astro';
import LatestTicker from './LatestTicker.astro';
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { localeMeta, locales, localizedPath, trustPagePath, type Locale, ui } from '../i18n';

interface Props { locale: Locale; alternateUrls?: Partial<Record<Locale, string>>; }
const { locale, alternateUrls = {} } = Astro.props;
const t = ui(locale);
const brandName = getBrandName(locale);
const pathname = Astro.url.pathname;
const languageUrls = Object.fromEntries(locales.map((lang) => [lang, alternateUrls[lang] || localizedPath(lang)])) as Record<Locale, string>;
const desktopNav = [
  { label: t.home, href: localizedPath(locale), active: pathname === localizedPath(locale) || (locale === 'en' && pathname === SITE.basePath) },
  { label: t.governmentJobs, href: localizedPath(locale, 'categories/jobs'), active: pathname.includes(`/${locale}/categories/jobs`) },
  { label: t.welfareSchemes, href: localizedPath(locale, 'categories/projects'), active: pathname.includes(`/${locale}/categories/projects`) },
  { label: t.deadlines, href: localizedPath(locale, 'deadlines'), active: pathname.includes(`/${locale}/deadlines`) },
  { label: t.latestNav, href: localizedPath(locale, 'articles'), active: pathname.includes(`/${locale}/articles`) },
];
const quickLinks = [
  { ...desktopNav[0], icon: 'home' },
  { ...desktopNav[1], icon: 'briefcase' },
  { ...desktopNav[3], icon: 'clock' },
  { label: t.saved, href: localizedPath(locale, 'saved'), active: pathname.includes(`/${locale}/saved`), icon: 'bookmark' }
];
const categoryIcon: Record<string, string> = { jobs: 'briefcase', projects: 'schemes', exams: 'exams', materials: 'education', notices: 'notices', affairs: 'services' };
const categoryOrder = ['jobs', 'projects', 'exams', 'materials', 'notices', 'affairs'];
const categoryEntries = (await getCollection('categories')).filter((category) => ACTIVE_CATEGORY_IDS.includes(category.id)).sort((a, b) => categoryOrder.indexOf(a.id) - categoryOrder.indexOf(b.id));
---
<header class="site-header">
  <nav class="navbar container" aria-label={t.primaryNav}>
    <a href={localizedPath(locale)} class="brand" aria-label={`${brandName} — ${t.home}`}>
      <BrandLogo variant="monogram" alt={`${brandName} ${t.logo}`} class="brand-logo brand-logo-mobile" />
      <BrandLogo variant="horizontal" alt={`${brandName} ${t.logo}`} class="brand-logo-horizontal" />
    </a>
    <ul class="nav-links">
      {desktopNav.map((item) => <li><a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <button class="icon-btn" id="searchToggle" aria-label={t.search} aria-haspopup="dialog"><Icon name="search" /></button>
      <div class="language-picker">
        <button class="language-trigger" id="languageTrigger" aria-label={`${t.language}: ${localeMeta[locale].nativeName}`} aria-haspopup="menu" aria-expanded="false" aria-controls="languageMenu">
          <Icon name="globe" /><span class="language-code">{localeMeta[locale].code}</span><span class="chevron" aria-hidden="true">⌄</span>
        </button>
        <div class="language-menu" id="languageMenu" role="menu" hidden>
          {locales.map((lang) => <a role="menuitem" href={languageUrls[lang]} lang={lang} hreflang={lang} data-language={lang} aria-current={lang === locale ? 'true' : undefined}><span>{lang === locale ? '✓' : ''}</span>{localeMeta[lang].nativeName}</a>)}
        </div>
      </div>
      <button class="icon-btn theme-toggle desktop-theme" aria-label={t.changeTheme}><Icon name="theme" /></button>
      <button class="icon-btn menu-toggle" id="menuToggle" aria-label={t.menu} data-open-label={t.menu} data-close-label={t.closeMenu} aria-expanded="false" aria-controls="mobileMenu"><Icon name="menu" /></button>
    </div>
  </nav>
  <LatestTicker {locale} />
</header>

<!-- Kept outside the filtered sticky header so fixed positioning is viewport-relative. -->
<div class="mobile-backdrop" id="mobileBackdrop" hidden></div>
<nav class="mobile-drawer" id="mobileMenu" aria-label={t.mobileNav} aria-hidden="true" hidden>
  <div class="drawer-head">
    <a href={localizedPath(locale)} class="drawer-brand">
      <BrandLogo variant="horizontal" alt={`${brandName} ${t.logo}`} class="drawer-brand-logo" />
    </a>
    <button class="drawer-close" id="menuClose" type="button" aria-label={t.closeMenu}><span aria-hidden="true">×</span></button>
  </div>

  <div class="drawer-scroll">
    <section aria-labelledby="quickLinksTitle">
      <h2 id="quickLinksTitle">{t.quickLinks}</h2>
      <ul class="drawer-quick-links">
        {quickLinks.map((item) => <li><a href={item.href} aria-current={item.active ? 'page' : undefined}><Icon name={item.icon} /><span>{item.label}</span><Icon name="arrow" size={18} /></a></li>)}
      </ul>
    </section>

    <section aria-labelledby="categoryLinksTitle">
      <h2 id="categoryLinksTitle">{t.categories}</h2>
      <ul class="drawer-category-links">
        {categoryEntries.map((category) => {
          const href = localizedPath(locale, `categories/${category.id}`);
          const active = pathname.includes(`/${locale}/categories/${category.id}`);
          return <li><a href={href} aria-current={active ? 'page' : undefined}><span class="drawer-category-icon"><Icon name={categoryIcon[category.id] || 'categories'} /></span><span>{categoryName(category, locale)}</span><Icon name="arrow" size={18} /></a></li>;
        })}
      </ul>
    </section>

    <section aria-labelledby="languageLinksTitle">
      <h2 id="languageLinksTitle">{t.language}</h2>
      <div class="drawer-languages">
        {locales.map((lang) => <a href={languageUrls[lang]} lang={lang} hreflang={lang} data-language={lang} aria-current={lang === locale ? 'true' : undefined}>{lang === locale && <span aria-hidden="true">✓</span>}{localeMeta[lang].nativeName}</a>)}
      </div>
    </section>

    <div class="drawer-secondary-links">
      <a href={localizedPath(locale, 'editorial-policy')}><Icon name="check" />{t.verificationMethod}<Icon name="arrow" size={18} /></a>
      <a href={trustPagePath(locale, 'corrections')}><Icon name="notices" />{t.corrections}<Icon name="arrow" size={18} /></a>
      <a href={trustPagePath(locale, 'about')}><Icon name="about" />{t.about}<Icon name="arrow" size={18} /></a>
      <a href={trustPagePath(locale, 'contact')}><Icon name="mail" />{t.contact}<Icon name="arrow" size={18} /></a>
      <button class="mobile-theme theme-toggle" type="button"><Icon name="theme" />{t.changeTheme}</button>
    </div>
  </div>
</nav>

<SearchOverlay {locale} />

<script>
  import { trapFocus } from '@lib/focusTrap';

  const root = document.documentElement;
  const languageTrigger = document.getElementById('languageTrigger');
  const languageMenu = document.getElementById('languageMenu');
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const menuClose = document.getElementById('menuClose');
  const mobileBackdrop = document.getElementById('mobileBackdrop');
  const desktopQuery = window.matchMedia('(min-width: 860px)');
  let drawerOpen = false;
  let releaseFocusTrap: (() => void) | undefined;
  let originalBodyPaddingRight = '';

  const closeLanguage = (restoreFocus = false) => {
    const wasOpen = !languageMenu?.hasAttribute('hidden');
    languageMenu?.setAttribute('hidden', '');
    languageTrigger?.setAttribute('aria-expanded', 'false');
    if (restoreFocus && wasOpen) languageTrigger?.focus();
  };

  const syncLanguagePreference = () => {
    const current = document.documentElement.lang;
    if (!['en', 'bn', 'hi'].includes(current)) return;
    try { localStorage.setItem('site-language', current); } catch (_) {}
  };

  const finishClosingDrawer = () => {
    if (drawerOpen) return;
    mobileMenu?.setAttribute('hidden', '');
    mobileBackdrop?.setAttribute('hidden', '');
  };

  const closeDrawer = (restoreFocus = true) => {
    if (!drawerOpen && mobileMenu?.hasAttribute('hidden')) return;
    drawerOpen = false;
    mobileMenu?.classList.remove('is-open');
    mobileBackdrop?.classList.remove('is-open');
    mobileMenu?.setAttribute('aria-hidden', 'true');
    menuToggle?.setAttribute('aria-expanded', 'false');
    if (menuToggle instanceof HTMLElement) menuToggle.setAttribute('aria-label', menuToggle.dataset.openLabel || 'Menu');
    document.body.classList.remove('menu-open');
    document.body.style.paddingRight = originalBodyPaddingRight;
    releaseFocusTrap?.();
    releaseFocusTrap = undefined;
    finishClosingDrawer();
    if (restoreFocus && menuToggle instanceof HTMLElement && !desktopQuery.matches) menuToggle.focus();
  };

  const openDrawer = () => {
    if (desktopQuery.matches || drawerOpen) return;
    closeLanguage();
    drawerOpen = true;
    mobileMenu?.removeAttribute('hidden');
    mobileBackdrop?.removeAttribute('hidden');
    mobileMenu?.setAttribute('aria-hidden', 'false');
    menuToggle?.setAttribute('aria-expanded', 'true');
    if (menuToggle instanceof HTMLElement) menuToggle.setAttribute('aria-label', menuToggle.dataset.closeLabel || 'Close menu');
    originalBodyPaddingRight = document.body.style.paddingRight;
    const scrollbarGap = Math.max(0, window.innerWidth - document.documentElement.clientWidth);
    if (scrollbarGap) {
      const currentPadding = Number.parseFloat(getComputedStyle(document.body).paddingRight) || 0;
      document.body.style.paddingRight = `${currentPadding + scrollbarGap}px`;
    }
    document.body.classList.add('menu-open');
    if (!drawerOpen) return;
    mobileMenu?.classList.add('is-open');
    mobileBackdrop?.classList.add('is-open');
    if (mobileMenu instanceof HTMLElement) {
      releaseFocusTrap = trapFocus(mobileMenu);
      menuClose?.focus();
    }
  };

  languageTrigger?.addEventListener('click', () => {
    const open = languageMenu?.hasAttribute('hidden');
    if (open) {
      languageMenu?.removeAttribute('hidden');
      requestAnimationFrame(() => languageMenu?.querySelector<HTMLElement>('[aria-current="true"]')?.focus());
    } else {
      languageMenu?.setAttribute('hidden', '');
    }
    languageTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  const languageItems = [...(languageMenu?.querySelectorAll<HTMLAnchorElement>('[role="menuitem"]') || [])];
  languageMenu?.addEventListener('keydown', (event) => {
    const current = languageItems.indexOf(document.activeElement as HTMLAnchorElement);
    let next = current;
    if (event.key === 'ArrowDown') next = (current + 1) % languageItems.length;
    else if (event.key === 'ArrowUp') next = (current - 1 + languageItems.length) % languageItems.length;
    else if (event.key === 'Home') next = 0;
    else if (event.key === 'End') next = languageItems.length - 1;
    else if (event.key === 'Escape') { event.preventDefault(); closeLanguage(true); return; }
    else return;
    event.preventDefault();
    languageItems[next]?.focus();
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => link.addEventListener('click', () => {
    try { localStorage.setItem('site-language', link.dataset.language || 'en'); } catch (_) {}
    closeLanguage();
  }));
  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('.language-picker')) closeLanguage(true);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { closeLanguage(true); closeDrawer(); }
  });
  menuToggle?.addEventListener('click', () => drawerOpen ? closeDrawer() : openDrawer());
  menuClose?.addEventListener('click', () => closeDrawer());
  mobileBackdrop?.addEventListener('click', () => closeDrawer());
  mobileMenu?.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', () => closeDrawer(false)));
  desktopQuery.addEventListener('change', (event) => { if (event.matches) closeDrawer(false); });
  window.addEventListener('resize', () => { if (desktopQuery.matches) closeDrawer(false); });
  window.visualViewport?.addEventListener('resize', () => { if (desktopQuery.matches) closeDrawer(false); });
  window.addEventListener('popstate', () => { closeLanguage(); closeDrawer(false); syncLanguagePreference(); });
  window.addEventListener('pageshow', () => { closeLanguage(); closeDrawer(false); syncLanguagePreference(); });
  syncLanguagePreference();
  document.querySelectorAll('.theme-toggle').forEach((button) => button.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (_) {}
  }));
</script>

<style>
  .site-header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.88);backdrop-filter:blur(16px);border-bottom:1px solid var(--color-border)}
  [data-theme="dark"] .site-header{background:rgba(10,18,32,.9)}
  .navbar{position:relative;z-index:5;height:74px;overflow:visible}.brand-logo{width:46px;height:46px;object-fit:contain}.brand-logo-horizontal{display:none;width:132px;height:auto}.nav-links{display:none}.nav-actions{display:flex;align-items:center;gap:.25rem}.icon-btn,.language-trigger{min-width:44px;min-height:44px}
  .language-picker{position:relative;z-index:2}.language-trigger{display:flex;align-items:center;justify-content:center;gap:.35rem;padding:0 .65rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-surface);font-weight:800}.chevron{font-size:.8rem}.language-menu{position:absolute;z-index:20;right:0;top:calc(100% + .55rem);min-width:174px;max-width:min(240px,calc(100vw - 1.5rem));padding:.45rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:14px;box-shadow:var(--shadow-lg);pointer-events:auto;isolation:isolate}.language-menu[hidden]{display:none;pointer-events:none}.language-menu a{display:grid;grid-template-columns:20px 1fr;gap:.5rem;align-items:center;min-height:44px;padding:.65rem .75rem;border-radius:10px;font-weight:700}.language-menu a:hover,.language-menu a:focus-visible,.language-menu a[aria-current="true"]{background:var(--color-surface-alt);color:var(--color-primary)}
  .desktop-theme{display:none}

  .mobile-backdrop{position:fixed;inset:0;z-index:200;background:rgba(5,14,28,.58);opacity:1;visibility:visible;backdrop-filter:blur(2px)}
  .mobile-backdrop.is-open{opacity:1;visibility:visible}
  .mobile-drawer{position:fixed;inset-block:0;inset-inline-end:0;z-index:210;width:min(90vw,390px);max-width:100vw;height:100vh;max-height:100vh;display:flex;flex-direction:column;background:var(--color-surface);border-inline-start:1px solid var(--color-border);box-shadow:-18px 0 48px rgba(4,18,36,.24);transform:none;overflow:hidden;contain:layout style;isolation:isolate}
  @supports (height:100dvh){.mobile-drawer{height:100dvh;max-height:100dvh}}
  .mobile-drawer.is-open{transform:none}
  .mobile-drawer[hidden],.mobile-backdrop[hidden]{display:none}
  .drawer-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex:0 0 auto;min-height:74px;padding:max(.7rem,env(safe-area-inset-top)) 1rem .7rem;border-bottom:1px solid var(--color-border)}
  .drawer-brand{display:flex;align-items:center;gap:.65rem;min-width:0}.drawer-brand-logo{display:block;width:132px;height:auto;max-height:56px;object-fit:contain}
  .drawer-close{display:grid;place-items:center;flex:0 0 auto;width:44px;height:44px;border:1px solid var(--color-border);border-radius:50%;background:var(--color-surface-alt)}.drawer-close span{font-size:1.8rem;line-height:1;transform:translateY(-1px)}
  .drawer-scroll{flex:1;min-height:0;overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;padding:1rem max(1rem,env(safe-area-inset-right)) max(1.25rem,env(safe-area-inset-bottom))}
  .drawer-scroll section+section{margin-top:1.25rem}.drawer-scroll h2{font-family:var(--font-body);font-size:.76rem;letter-spacing:.04em;text-transform:uppercase;color:var(--color-text-muted);margin:0 0 .55rem .25rem}
  .drawer-quick-links,.drawer-category-links{display:grid;gap:.4rem}.drawer-quick-links a,.drawer-category-links a,.drawer-secondary-links>a{display:grid;grid-template-columns:24px minmax(0,1fr) 18px;align-items:center;gap:.7rem;min-height:50px;padding:.65rem .75rem;border:1px solid transparent;border-radius:12px;font-weight:700;line-height:1.3}.drawer-quick-links a:hover,.drawer-quick-links a:focus-visible,.drawer-category-links a:hover,.drawer-category-links a:focus-visible,.drawer-secondary-links>a:hover,.drawer-secondary-links>a:focus-visible{background:var(--color-surface-alt);border-color:var(--color-border)}.drawer-quick-links a[aria-current="page"],.drawer-category-links a[aria-current="page"]{color:var(--color-primary);background:rgba(var(--color-primary-rgb),.09);border-color:rgba(var(--color-primary-rgb),.18)}
  .drawer-category-icon{display:grid;place-items:center;color:var(--color-primary)}
  .drawer-languages{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem}.drawer-languages a{display:flex;align-items:center;justify-content:center;gap:.3rem;min-height:46px;padding:.5rem;border:1px solid var(--color-border);border-radius:11px;font-weight:700}.drawer-languages a[aria-current="true"]{color:var(--color-primary);background:rgba(var(--color-primary-rgb),.09);border-color:rgba(var(--color-primary-rgb),.25)}
  .drawer-secondary-links{display:grid;gap:.35rem;margin-top:1.25rem;padding-top:1rem;border-top:1px solid var(--color-border)}
  .mobile-theme{display:flex;align-items:center;gap:.7rem;width:100%;min-height:50px;padding:.65rem .75rem;border:1px solid var(--color-border);border-radius:12px;font-weight:700;background:var(--color-surface-alt)}
  :global(body.menu-open){overflow:hidden;overscroll-behavior:none}

  @media(max-width:520px){.language-code,.chevron{display:none}.language-trigger{width:44px;padding:0}.navbar{padding-inline:1rem}}
  @media(max-width:350px){.navbar{padding-inline:.7rem}.nav-actions{gap:.1rem}.mobile-drawer{width:100vw}.drawer-languages{grid-template-columns:1fr}}
  @media(min-width:620px){.brand-logo-mobile{display:none}.brand-logo-horizontal{display:block}}
  @media(min-width:860px){.nav-links{display:flex}.menu-toggle{display:none}.desktop-theme{display:inline-flex}.mobile-drawer,.mobile-backdrop{display:none!important}}
</style>
