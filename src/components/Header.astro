---
import { getCollection } from 'astro:content';
import { categoryName } from '@lib/content';
import { ACTIVE_CATEGORY_IDS, getBrandName, SITE } from '@utils/constants';
import SearchOverlay from './SearchOverlay.astro';
import LatestTicker from './LatestTicker.astro';
import Icon from './Icon.astro';
import BrandLogo from './BrandLogo.astro';
import { localeMeta, locales, localizedPath, trustPagePath, type Locale, ui } from '../i18n';

interface Props {
  locale: Locale;
  alternateUrls?: Partial<Record<Locale, string>>;
}

const { locale, alternateUrls = {} } = Astro.props;
const t = ui(locale);
const brandName = getBrandName(locale);
const pathname = Astro.url.pathname;
const languageUrls = Object.fromEntries(
  locales.map((lang) => [lang, alternateUrls[lang] || localizedPath(lang)])
) as Record<Locale, string>;

const labels = {
  en: {
    education: 'Education',
    schemes: 'Schemes',
    services: 'Citizen Services',
    guides: 'Guides',
    menuHeading: 'Explore Citizen Affairs',
    menuDescription: 'Verified opportunities, benefits, deadlines and public services.',
    search: 'Search',
    alerts: 'Notices & Alerts'
  },
  bn: {
    education: 'শিক্ষা',
    schemes: 'প্রকল্প',
    services: 'নাগরিক পরিষেবা',
    guides: 'গাইড',
    menuHeading: 'সিটিজেন অ্যাফেয়ার্স দেখুন',
    menuDescription: 'যাচাইকৃত সুযোগ, সুবিধা, শেষ তারিখ ও জনপরিষেবা।',
    search: 'খুঁজুন',
    alerts: 'নোটিশ ও সতর্কতা'
  },
  hi: {
    education: 'शिक्षा',
    schemes: 'योजनाएँ',
    services: 'नागरिक सेवाएँ',
    guides: 'गाइड',
    menuHeading: 'सिटिजन अफेयर्स देखें',
    menuDescription: 'सत्यापित अवसर, लाभ, अंतिम तिथियाँ और सार्वजनिक सेवाएँ।',
    search: 'खोजें',
    alerts: 'नोटिस और अलर्ट'
  }
}[locale];

const navItems = [
  { label: t.governmentJobs, href: localizedPath(locale, 'categories/jobs'), icon: 'briefcase', key: 'jobs' },
  { label: labels.education, href: localizedPath(locale, 'categories/exams'), icon: 'education', key: 'exams' },
  { label: labels.schemes, href: localizedPath(locale, 'categories/projects'), icon: 'schemes', key: 'projects' },
  { label: labels.services, href: localizedPath(locale, 'categories/affairs'), icon: 'services', key: 'affairs' },
  { label: t.deadlines, href: localizedPath(locale, 'deadlines'), icon: 'clock', key: 'deadlines' },
  { label: labels.guides, href: localizedPath(locale, 'categories/guides'), icon: 'updates', key: 'guides' }
].map((item) => ({
  ...item,
  active:
    item.key === 'deadlines'
      ? pathname.includes('/deadlines')
      : pathname.includes(`/categories/${item.key}`)
}));

const categoryIcon: Record<string, string> = {
  jobs: 'briefcase',
  projects: 'schemes',
  exams: 'education',
  materials: 'education',
  notices: 'notices',
  affairs: 'services',
  guides: 'updates'
};
const categoryOrder = ['jobs', 'exams', 'materials', 'projects', 'affairs', 'notices', 'guides'];
const categoryEntries = (await getCollection('categories'))
  .filter((category) => ACTIVE_CATEGORY_IDS.includes(category.id))
  .sort((a, b) => categoryOrder.indexOf(a.id) - categoryOrder.indexOf(b.id));
const homeActive = pathname === localizedPath(locale) || (locale === 'en' && pathname === SITE.basePath);
---

<header class="site-header portal-header">
  <nav class="navbar container portal-navbar-inner" aria-label={t.primaryNav}>
    <a
      href={localizedPath(locale)}
      class="brand portal-brand"
      aria-label={`${brandName} — ${t.home}`}
      aria-current={homeActive ? 'page' : undefined}
    >
      <BrandLogo
        variant="horizontal"
        alt={`${brandName} ${t.logo}`}
        class="header-brand-logo portal-brand-logo"
      />
    </a>

    <ul class="portal-desktop-nav">
      {navItems.map((item) => (
        <li>
          <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>

    <div class="portal-header-actions">
      <button
        class="portal-icon-button"
        id="searchToggle"
        type="button"
        aria-label={t.search}
        aria-haspopup="dialog"
        aria-controls="searchOverlay"
        aria-expanded="false"
      >
        <Icon name="search" />
      </button>

      <details class="portal-language-picker">
        <summary aria-label={`${t.language}: ${localeMeta[locale].nativeName}`}>
          <Icon name="globe" />
          <span>{localeMeta[locale].code}</span>
        </summary>
        <div class="portal-language-panel">
          {locales.map((lang) => (
            <a
              href={languageUrls[lang]}
              lang={lang}
              hreflang={lang}
              data-language={lang}
              aria-current={lang === locale ? 'true' : undefined}
            >
              <span aria-hidden="true">{lang === locale ? '✓' : ''}</span>
              {localeMeta[lang].nativeName}
            </a>
          ))}
        </div>
      </details>

      <button
        class="portal-icon-button portal-theme-toggle theme-toggle"
        type="button"
        aria-label={t.changeTheme}
      >
        <Icon name="theme" />
      </button>
    </div>
  </nav>
  <LatestTicker {locale} />
</header>

<SearchOverlay {locale} />

<nav class="portal-mobile-bottom" aria-label={t.mobileNav}>
  <a href={localizedPath(locale)} aria-current={homeActive ? 'page' : undefined}>
    <Icon name="home" size={21} />
    <span>{t.home}</span>
  </a>
  <a href={localizedPath(locale, 'search')}>
    <Icon name="search" size={21} />
    <span>{labels.search}</span>
  </a>
  <a href={localizedPath(locale, 'deadlines')} aria-current={pathname.includes('/deadlines') ? 'page' : undefined}>
    <Icon name="clock" size={21} />
    <span>{t.deadlines}</span>
  </a>
  <a href={localizedPath(locale, 'saved')} aria-current={pathname.includes('/saved') ? 'page' : undefined}>
    <Icon name="bookmark" size={21} />
    <span>{t.saved}</span>
  </a>

  <details class="portal-mobile-menu">
    <summary>
      <Icon name="menu" size={21} />
      <span>{t.menu}</span>
    </summary>
    <div class="portal-mobile-panel">
      <div class="portal-mobile-head">
        <div>
          <strong>{labels.menuHeading}</strong>
          <p>{labels.menuDescription}</p>
        </div>
        <button type="button" class="portal-mobile-close" aria-label={t.closeMenu}>×</button>
      </div>

      <nav aria-label={t.categories}>
        {categoryEntries.map((category) => {
          const href = localizedPath(locale, `categories/${category.id}`);
          const active = pathname.includes(`/categories/${category.id}`);
          return (
            <a href={href} aria-current={active ? 'page' : undefined}>
              <span><Icon name={categoryIcon[category.id] || 'categories'} size={20} /></span>
              <strong>{categoryName(category, locale)}</strong>
              <Icon name="arrow" size={17} />
            </a>
          );
        })}
        <a href={localizedPath(locale, 'articles')}>
          <span><Icon name="updates" size={20} /></span>
          <strong>{t.latestNav}</strong>
          <Icon name="arrow" size={17} />
        </a>
      </nav>

      <div class="portal-mobile-languages" aria-label={t.language}>
        {locales.map((lang) => (
          <a
            href={languageUrls[lang]}
            lang={lang}
            hreflang={lang}
            data-language={lang}
            aria-current={lang === locale ? 'true' : undefined}
          >
            {localeMeta[lang].nativeName}
          </a>
        ))}
      </div>

      <div class="portal-mobile-secondary">
        <a href={localizedPath(locale, 'editorial-policy')}><Icon name="check" size={18} />{t.verificationMethod}</a>
        <a href={trustPagePath(locale, 'corrections')}><Icon name="notices" size={18} />{t.corrections}</a>
        <a href={trustPagePath(locale, 'about')}><Icon name="about" size={18} />{t.about}</a>
        <a href={trustPagePath(locale, 'contact')}><Icon name="mail" size={18} />{t.contact}</a>
      </div>
    </div>
  </details>
</nav>

<script>
  const root = document.documentElement;
  const syncLanguagePreference = () => {
    const current = root.lang;
    if (!['en', 'bn', 'hi'].includes(current)) return;
    try {
      localStorage.setItem('site-language', current);
    } catch (_) {}
  };

  document.querySelectorAll<HTMLElement>('.theme-toggle').forEach((button) => {
    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch (_) {}
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('site-language', link.dataset.language || 'en');
      } catch (_) {}
    });
  });

  document.querySelectorAll<HTMLDetailsElement>('.portal-mobile-menu').forEach((menu) => {
    const close = menu.querySelector<HTMLButtonElement>('.portal-mobile-close');
    close?.addEventListener('click', () => {
      menu.open = false;
      menu.querySelector<HTMLElement>('summary')?.focus();
    });
    menu.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((details) => {
      details.open = false;
    });
  });

  window.addEventListener('pageshow', syncLanguagePreference);
  syncLanguagePreference();
</script>

<style>
  .portal-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, .96);
    backdrop-filter: blur(16px);
  }

  :global(html[data-theme='dark']) .portal-header {
    background: rgba(15, 27, 46, .97);
  }

  .portal-navbar-inner {
    position: relative;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: clamp(.7rem, 2vw, 1.6rem);
    height: 64px;
    overflow: visible;
  }

  .portal-brand {
    display: flex;
    align-items: center;
    flex: 0 0 150px;
    min-width: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }

  :global(.portal-brand-logo) {
    width: 148px;
    max-height: 40px;
  }

  .portal-desktop-nav {
    display: flex;
    align-items: stretch;
    justify-content: center;
    align-self: stretch;
    gap: clamp(.2rem, .7vw, .65rem);
    flex: 1;
    min-width: 0;
  }

  .portal-desktop-nav li,
  .portal-desktop-nav a {
    display: flex;
    align-items: center;
  }

  .portal-desktop-nav a {
    position: relative;
    padding: 0 .55rem;
    color: var(--color-text);
    font-size: clamp(.78rem, .72rem + .16vw, .9rem);
    font-weight: 750;
    white-space: nowrap;
  }

  .portal-desktop-nav a::after {
    content: '';
    position: absolute;
    inset-inline: .55rem;
    bottom: 0;
    height: 3px;
    border-radius: 999px 999px 0 0;
    background: var(--color-primary);
    transform: scaleX(0);
    transition: transform .16s ease;
  }

  .portal-desktop-nav a:hover,
  .portal-desktop-nav a:focus-visible,
  .portal-desktop-nav a[aria-current='page'] {
    color: var(--color-primary);
  }

  .portal-desktop-nav a:hover::after,
  .portal-desktop-nav a:focus-visible::after,
  .portal-desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .portal-header-actions {
    display: flex;
    align-items: center;
    gap: .25rem;
    flex: 0 0 auto;
  }

  .portal-icon-button,
  .portal-language-picker > summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    min-width: 44px;
    height: 44px;
    padding: 0 .65rem;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: var(--color-surface);
    color: var(--color-text);
  }

  .portal-icon-button:hover,
  .portal-language-picker > summary:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .portal-language-picker {
    position: relative;
  }

  .portal-language-picker > summary {
    list-style: none;
    cursor: pointer;
    font-size: .78rem;
    font-weight: 800;
  }

  .portal-language-picker > summary::-webkit-details-marker {
    display: none;
  }

  .portal-language-panel {
    position: absolute;
    top: calc(100% + .5rem);
    inset-inline-end: 0;
    z-index: 20;
    min-width: 180px;
    padding: .4rem;
    border: 1px solid var(--color-border);
    border-radius: 11px;
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .portal-language-panel a {
    display: grid;
    grid-template-columns: 20px 1fr;
    align-items: center;
    gap: .45rem;
    min-height: 44px;
    padding: .6rem .7rem;
    border-radius: 8px;
    color: var(--color-text);
    font-weight: 700;
  }

  .portal-language-panel a:hover,
  .portal-language-panel a[aria-current='true'] {
    background: var(--color-surface-alt);
    color: var(--color-primary);
  }

  .portal-mobile-bottom {
    display: none;
  }

  @media (max-width: 1080px) {
    .portal-desktop-nav a {
      padding-inline: .35rem;
      font-size: .76rem;
    }

    .portal-desktop-nav a::after {
      inset-inline: .35rem;
    }
  }

  @media (max-width: 859px) {
    :global(body) {
      padding-bottom: calc(66px + env(safe-area-inset-bottom));
    }

    .portal-navbar-inner {
      height: 64px;
      padding-inline: .9rem;
    }

    .portal-brand {
      flex-basis: min(47vw, 158px);
    }

    :global(.portal-brand-logo) {
      width: min(46vw, 156px);
      max-height: 38px;
    }

    .portal-desktop-nav {
      display: none;
    }

    .portal-header-actions {
      margin-inline-start: auto;
      gap: .1rem;
    }

    .portal-language-picker > summary span {
      display: none;
    }

    .portal-language-picker > summary {
      width: 44px;
      padding: 0;
    }

    .portal-mobile-bottom {
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 180;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      min-height: calc(64px + env(safe-area-inset-bottom));
      padding: .35rem .3rem env(safe-area-inset-bottom);
      border-top: 1px solid var(--color-border);
      background: var(--color-surface);
      box-shadow: 0 -8px 24px rgba(8, 20, 36, .08);
    }

    .portal-mobile-bottom > a,
    .portal-mobile-menu > summary {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: .15rem;
      min-width: 0;
      min-height: 56px;
      padding: .25rem .1rem;
      border-radius: 8px;
      color: var(--color-text);
      font-size: .65rem;
      font-weight: 750;
      line-height: 1.1;
      text-align: center;
    }

    .portal-mobile-bottom > a[aria-current='page'],
    .portal-mobile-bottom > a:hover,
    .portal-mobile-menu > summary:hover,
    .portal-mobile-menu[open] > summary {
      color: var(--color-primary);
      background: rgba(var(--color-primary-rgb), .08);
    }

    .portal-mobile-menu {
      min-width: 0;
    }

    .portal-mobile-menu > summary {
      list-style: none;
      cursor: pointer;
    }

    .portal-mobile-menu > summary::-webkit-details-marker {
      display: none;
    }

    .portal-mobile-panel {
      position: fixed;
      inset-inline: .65rem;
      bottom: calc(68px + env(safe-area-inset-bottom));
      z-index: 190;
      max-height: min(72vh, 650px);
      overflow-y: auto;
      padding: .9rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
      background: var(--color-surface);
      color: var(--color-text);
      box-shadow: 0 22px 60px rgba(4, 18, 36, .28);
    }

    .portal-mobile-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: .2rem .2rem .85rem;
      border-bottom: 1px solid var(--color-border);
    }

    .portal-mobile-head strong {
      display: block;
      color: var(--color-text);
      font-size: 1rem;
    }

    .portal-mobile-head p {
      margin-top: .25rem;
      color: var(--color-text-muted);
      font-size: .78rem;
      line-height: 1.45;
    }

    .portal-mobile-close {
      flex: 0 0 auto;
      width: 40px;
      height: 40px;
      border: 1px solid var(--color-border);
      border-radius: 50%;
      background: var(--color-surface-alt);
      color: var(--color-text);
      font-size: 1.5rem;
      line-height: 1;
    }

    .portal-mobile-panel nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .45rem;
      padding-block: .8rem;
    }

    .portal-mobile-panel nav a {
      display: grid;
      grid-template-columns: 32px 1fr auto;
      align-items: center;
      gap: .5rem;
      min-height: 54px;
      padding: .55rem .6rem;
      border: 1px solid var(--color-border);
      border-radius: 9px;
      background: var(--color-surface-alt);
      color: var(--color-text);
      font-size: .78rem;
      line-height: 1.25;
    }

    .portal-mobile-panel nav a > span {
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(var(--color-primary-rgb), .1);
      color: var(--color-primary);
    }

    .portal-mobile-panel nav a[aria-current='page'] {
      border-color: var(--color-primary);
      color: var(--color-primary);
    }

    .portal-mobile-languages {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: .4rem;
      padding-top: .8rem;
      border-top: 1px solid var(--color-border);
    }

    .portal-mobile-languages a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: .4rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      color: var(--color-text);
      font-size: .76rem;
      font-weight: 700;
    }

    .portal-mobile-languages a[aria-current='true'] {
      border-color: var(--color-primary);
      background: rgba(var(--color-primary-rgb), .08);
      color: var(--color-primary);
    }

    .portal-mobile-secondary {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .25rem .6rem;
      padding-top: .75rem;
    }

    .portal-mobile-secondary a {
      display: flex;
      align-items: center;
      gap: .4rem;
      min-height: 38px;
      color: var(--color-text-muted);
      font-size: .72rem;
      font-weight: 650;
    }
  }

  @media (max-width: 420px) {
    .portal-header-actions .portal-icon-button:first-child {
      display: none;
    }

    .portal-mobile-panel nav {
      grid-template-columns: 1fr;
    }
  }
</style>
