---
import { BRAND, SITE } from '@utils/constants';
import SearchOverlay from './SearchOverlay.astro';
import LatestTicker from './LatestTicker.astro';
import Icon from './Icon.astro';
import { localeMeta, locales, localizedPath, type Locale, ui } from '../i18n';

interface Props { locale: Locale; alternateUrls?: Partial<Record<Locale, string>>; }
const { locale, alternateUrls = {} } = Astro.props;
const t = ui(locale);
const pathname = Astro.url.pathname;
const languageUrls = Object.fromEntries(locales.map((lang) => [lang, alternateUrls[lang] || localizedPath(lang)])) as Record<Locale, string>;
const nav = [
  { label: t.home, href: localizedPath(locale), active: pathname === localizedPath(locale) || (locale === 'en' && pathname === SITE.basePath) },
  { label: t.latestNav, href: localizedPath(locale, 'articles'), active: pathname.includes(`/${locale}/articles`) },
  { label: t.categories, href: localizedPath(locale, 'categories'), active: pathname.includes(`/${locale}/categories`) },
  { label: t.about, href: `${localizedPath(locale)}#about`, active: false }
];
---
<header class="site-header">
  <nav class="navbar container" aria-label={locale === 'bn' ? 'প্রধান নেভিগেশন' : locale === 'hi' ? 'मुख्य नेविगेशन' : 'Primary navigation'}>
    <a href={localizedPath(locale)} class="brand" aria-label={`${BRAND.brandName} — ${t.home}`}>
      <img src={SITE.logo} alt={`${BRAND.brandName} logo`} class="brand-logo" width="46" height="46" />
      <span class="brand-text"><span class="brand-name">{BRAND.brandName}</span><span class="brand-tagline">{BRAND.brandTagline}</span></span>
    </a>
    <ul class="nav-links">
      {nav.map((item) => <li><a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a></li>)}
    </ul>
    <div class="nav-actions">
      <button class="icon-btn" id="searchToggle" aria-label={t.search} aria-haspopup="dialog"><Icon name="search" /></button>
      <div class="language-picker">
        <button class="language-trigger" id="languageTrigger" aria-haspopup="menu" aria-expanded="false" aria-controls="languageMenu">
          <Icon name="globe" /><span class="language-code">{localeMeta[locale].code}</span><span class="chevron" aria-hidden="true">⌄</span>
        </button>
        <div class="language-menu" id="languageMenu" role="menu" hidden>
          {locales.map((lang) => <a role="menuitem" href={languageUrls[lang]} lang={lang} hreflang={lang} data-language={lang} aria-current={lang === locale ? 'true' : undefined}><span>{lang === locale ? '✓' : ''}</span>{localeMeta[lang].nativeName}</a>)}
        </div>
      </div>
      <button class="icon-btn theme-toggle desktop-theme" aria-label={locale === 'bn' ? 'থিম পরিবর্তন' : locale === 'hi' ? 'थीम बदलें' : 'Change theme'}><Icon name="theme" /></button>
      <button class="icon-btn menu-toggle" id="menuToggle" aria-label={t.menu} aria-expanded="false" aria-controls="mobileMenu"><Icon name="menu" /></button>
    </div>
  </nav>
  <div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <ul>{nav.map((item) => <li><a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a></li>)}</ul>
    <button class="mobile-theme theme-toggle"><Icon name="theme" />{locale === 'bn' ? 'থিম পরিবর্তন' : locale === 'hi' ? 'थीम बदलें' : 'Change theme'}</button>
  </div>
  <LatestTicker {locale} />
</header>
<SearchOverlay {locale} />

<script>
  const root = document.documentElement;
  const languageTrigger = document.getElementById('languageTrigger');
  const languageMenu = document.getElementById('languageMenu');
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const closeLanguage = () => { languageMenu?.setAttribute('hidden', ''); languageTrigger?.setAttribute('aria-expanded', 'false'); };
  languageTrigger?.addEventListener('click', () => { const open = languageMenu?.hasAttribute('hidden'); if (open) languageMenu?.removeAttribute('hidden'); else languageMenu?.setAttribute('hidden', ''); languageTrigger.setAttribute('aria-expanded', open ? 'true' : 'false'); });
  languageMenu?.querySelectorAll('[data-language]').forEach((link) => link.addEventListener('click', () => { try { localStorage.setItem('site-language', (link as HTMLElement).dataset.language || 'en'); } catch (_) {} }));
  document.addEventListener('click', (event) => { if (!(event.target as Element).closest('.language-picker')) closeLanguage(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { closeLanguage(); mobileMenu?.classList.remove('is-open'); menuToggle?.setAttribute('aria-expanded', 'false'); } });
  menuToggle?.addEventListener('click', () => { const open = !mobileMenu?.classList.contains('is-open'); mobileMenu?.classList.toggle('is-open', open); mobileMenu?.setAttribute('aria-hidden', open ? 'false' : 'true'); menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false'); });
  document.querySelectorAll('.theme-toggle').forEach((button) => button.addEventListener('click', () => { const next = root.dataset.theme === 'dark' ? 'light' : 'dark'; root.dataset.theme = next; try { localStorage.setItem('theme', next); } catch (_) {} }));
</script>
<style>
  .site-header{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.88);backdrop-filter:blur(16px);border-bottom:1px solid var(--color-border)}
  [data-theme="dark"] .site-header{background:rgba(10,18,32,.9)}
  .navbar{height:74px}.brand-logo{width:46px;height:46px}.nav-links{display:none}.nav-actions{display:flex;align-items:center;gap:.25rem}.icon-btn,.language-trigger{min-width:44px;min-height:44px}
  .language-picker{position:relative}.language-trigger{display:flex;align-items:center;justify-content:center;gap:.35rem;padding:0 .65rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-surface);font-weight:800}.chevron{font-size:.8rem}.language-menu{position:absolute;right:0;top:calc(100% + .55rem);min-width:174px;padding:.45rem;background:var(--color-surface);border:1px solid var(--color-border);border-radius:14px;box-shadow:var(--shadow-lg)}.language-menu a{display:grid;grid-template-columns:20px 1fr;gap:.5rem;align-items:center;padding:.65rem .75rem;border-radius:10px;font-weight:700}.language-menu a:hover,.language-menu a:focus-visible,.language-menu a[aria-current="true"]{background:var(--color-surface-alt);color:var(--color-primary)}
  .mobile-menu{top:74px;padding-bottom:5rem}.mobile-theme{display:flex;align-items:center;gap:.65rem;width:100%;min-height:48px;margin-top:1rem;padding:.75rem;border:1px solid var(--color-border);border-radius:12px}.desktop-theme{display:none}
  @media(max-width:520px){.brand-text{display:none}.language-code,.chevron{display:none}.language-trigger{width:44px;padding:0}.navbar{padding-inline:1rem}}
  @media(min-width:860px){.nav-links{display:flex}.menu-toggle{display:none}.desktop-theme{display:inline-flex}.mobile-menu{display:none!important}.brand-tagline{display:none}}
  @media(min-width:1080px){.brand-tagline{display:block}}
</style>
