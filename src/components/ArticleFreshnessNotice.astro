---
import Icon from './Icon.astro';
import { getArticleFreshness, type ArticleFreshnessState } from '@lib/freshness';
import { dateLocale, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  contentType: 'job' | 'scheme' | 'admission' | 'scholarship' | 'service' | 'alert' | 'explainer';
  workflowStatus:
    | 'published'
    | 'corrected'
    | 'closed'
    | 'withdrawn'
    | 'archived'
    | string;
  verificationStatus:
    | 'officially-confirmed'
    | 'partially-confirmed'
    | 'under-verification'
    | 'corrected'
    | 'withdrawn'
    | 'closed';
  lastVerified?: Date;
  nextReviewDate?: Date;
  deadline?: Date;
}

const {
  locale,
  contentType,
  workflowStatus,
  verificationStatus,
  lastVerified,
  nextReviewDate,
  deadline,
} = Astro.props;

const freshness = getArticleFreshness({
  contentType,
  workflowStatus: workflowStatus as never,
  verificationStatus,
  lastVerified,
  nextReviewDate,
  deadline,
});

const copy = {
  en: {
    current: ['Recently verified', 'The verification date is within the current review window. Recheck the official destination before submitting personal details.'],
    'review-soon': ['Review approaching', 'This information is approaching its next editorial review. Confirm the latest instructions on the official destination.'],
    'review-overdue': ['Re-verification overdue', 'The scheduled editorial review date has passed. Treat the article as guidance and confirm every actionable detail on the official destination.'],
    stale: ['Verification is old', 'The source verification is more than 90 days old. Do not rely on deadlines, fees or eligibility without checking the official destination.'],
    expired: ['Application window closed', 'The stated deadline has passed or the record is closed. This page remains available for reference, corrections and results; application actions are not shown.'],
    verified: 'Last verified',
    review: 'Next review',
    deadline: 'Recorded deadline',
  },
  bn: {
    current: ['সাম্প্রতিক যাচাই', 'যাচাইয়ের তারিখ বর্তমান পর্যালোচনা সময়সীমার মধ্যে আছে। ব্যক্তিগত তথ্য জমা দেওয়ার আগে অফিসিয়াল গন্তব্য আবার দেখুন।'],
    'review-soon': ['পর্যালোচনার সময় কাছাকাছি', 'তথ্যটির পরবর্তী সম্পাদকীয় পর্যালোচনার সময় আসছে। অফিসিয়াল গন্তব্যে সর্বশেষ নির্দেশনা নিশ্চিত করুন।'],
    'review-overdue': ['পুনরায় যাচাই বাকি', 'নির্ধারিত সম্পাদকীয় পর্যালোচনার তারিখ পেরিয়ে গেছে। নিবন্ধটিকে নির্দেশিকা হিসেবে ব্যবহার করুন এবং অফিসিয়াল গন্তব্যে প্রতিটি করণীয় তথ্য নিশ্চিত করুন।'],
    stale: ['যাচাইয়ের তথ্য পুরোনো', 'সূত্রটি ৯০ দিনের বেশি আগে যাচাই করা হয়েছে। অফিসিয়াল গন্তব্য না দেখে শেষ তারিখ, ফি বা যোগ্যতার উপর নির্ভর করবেন না।'],
    expired: ['আবেদনের সময় শেষ', 'উল্লিখিত শেষ তারিখ পেরিয়ে গেছে বা রেকর্ডটি বন্ধ। রেফারেন্স, সংশোধন ও ফলাফলের জন্য পেজটি রাখা হয়েছে; আবেদন করার লিংক দেখানো হচ্ছে না।'],
    verified: 'সর্বশেষ যাচাই',
    review: 'পরবর্তী পর্যালোচনা',
    deadline: 'নথিভুক্ত শেষ তারিখ',
  },
  hi: {
    current: ['हाल में सत्यापित', 'सत्यापन तारीख वर्तमान समीक्षा अवधि के भीतर है। व्यक्तिगत जानकारी जमा करने से पहले आधिकारिक गंतव्य फिर जाँचें।'],
    'review-soon': ['समीक्षा निकट है', 'इस जानकारी की अगली संपादकीय समीक्षा निकट है। आधिकारिक गंतव्य पर नवीनतम निर्देशों की पुष्टि करें।'],
    'review-overdue': ['पुनः सत्यापन लंबित', 'निर्धारित संपादकीय समीक्षा तिथि बीत चुकी है। लेख को मार्गदर्शन मानें और हर कार्रवाई योग्य विवरण आधिकारिक गंतव्य पर जाँचें।'],
    stale: ['सत्यापन पुराना है', 'स्रोत सत्यापन 90 दिनों से अधिक पुराना है। आधिकारिक गंतव्य जाँचे बिना अंतिम तिथि, शुल्क या पात्रता पर भरोसा न करें।'],
    expired: ['आवेदन अवधि समाप्त', 'दर्ज अंतिम तिथि बीत चुकी है या रिकॉर्ड बंद है। यह पृष्ठ संदर्भ, सुधार और परिणामों के लिए उपलब्ध है; आवेदन कार्रवाई नहीं दिखाई जाती।'],
    verified: 'अंतिम सत्यापन',
    review: 'अगली समीक्षा',
    deadline: 'दर्ज अंतिम तिथि',
  },
}[locale];

const [title, body] = copy[freshness.state as ArticleFreshnessState];
const formatter = new Intl.DateTimeFormat(dateLocale(locale), {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<aside class:list={['article-freshness', `freshness-${freshness.state}`]} data-article-freshness={freshness.state} role="status">
  <Icon name={freshness.state === 'expired' ? 'notices' : freshness.state === 'current' ? 'check' : 'clock'} size={21} />
  <div>
    <strong>{title}</strong>
    <p>{body}</p>
    <dl>
      {lastVerified && <div><dt>{copy.verified}</dt><dd>{formatter.format(lastVerified)}</dd></div>}
      {nextReviewDate && <div><dt>{copy.review}</dt><dd>{formatter.format(nextReviewDate)}</dd></div>}
      {deadline && <div><dt>{copy.deadline}</dt><dd>{formatter.format(deadline)}</dd></div>}
    </dl>
  </div>
</aside>

<style>
  .article-freshness {
    display: flex;
    gap: .75rem;
    margin: 1.2rem 0;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-green-text);
    border-radius: 12px;
    background: rgba(var(--color-green-rgb), .06);
  }
  .article-freshness > svg { flex: 0 0 auto; color: var(--color-green-text); }
  .article-freshness strong { font-size: .92rem; }
  .article-freshness p { margin: .25rem 0 .65rem; color: var(--color-text-muted); font-size: .82rem; line-height: 1.55; }
  .article-freshness dl { display: flex; flex-wrap: wrap; gap: .45rem 1rem; margin: 0; }
  .article-freshness dl div { display: flex; gap: .35rem; font-size: .7rem; }
  .article-freshness dt { color: var(--color-text-muted); }
  .article-freshness dd { margin: 0; font-weight: 850; }
  .freshness-review-soon { border-left-color: var(--color-orange); background: rgba(var(--color-orange-rgb), .07); }
  .freshness-review-soon > svg { color: #9a5600; }
  .freshness-review-overdue,
  .freshness-stale,
  .freshness-expired { border-left-color: #b42318; background: rgba(180, 35, 24, .06); }
  .freshness-review-overdue > svg,
  .freshness-stale > svg,
  .freshness-expired > svg { color: #b42318; }
  @media (max-width: 520px) {
    .article-freshness dl { display: grid; gap: .25rem; }
  }
</style>
