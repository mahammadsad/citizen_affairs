{
  "name": "sarkari-tathya-kendra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static multilingual public-information website",
  "author": "Mahammad Sad",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "type-check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:html": "node scripts/validate-html.mjs",
    "thumbnail": "node scripts/render-thumbnail.mjs",
    "test:visual": "playwright test",
    "validate": "npm run format:check && npm test && npm run check && npm run validate:content && npm run build && npm run validate:html",
    "format": "node scripts/format-check.mjs --write",
    "format:check": "node scripts/format-check.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@playwright/test": "1.58.2",
    "@supabase/supabase-js": "2.110.7",
    "astro": "7.1.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@supabase/server": "1.4.0",
    "@types/node": "^20.11.0",
    "prettier": "^3.9.0",
    "typescript": "^5.7.0",
    "yaml": "2.9.0"
  }
}
